{
  "name": "lightlike",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"]
    }
  }
}
