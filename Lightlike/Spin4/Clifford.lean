import Lightlike.Spin4.SO4

/-!
# Spin(4) = SU(2) × SU(2) is the Clifford-algebra spin group

Mathlib defines the spin group of a quadratic form `Q` inside the Clifford algebra `Cl(Q)`
(`spinGroup Q`: even elements of the Lipschitz group, the group generated by the invertible
vectors, that are unitary for the Clifford conjugation). We take `ℝ⁴ = ℍ` with the negative
definite form `Q v = -|v|²` (so that `v² = -|v|²` in `Cl(Q)`, as for imaginary quaternions) and
prove `spinGroup Q ≃* SU(2) × SU(2) = Spin4` (`spinEquiv`). The same holds for the Euclidean form
`Q v = +|v|²` (`spinEquivP`, section E), with `v ↦ [[0, v], [v̄, 0]]` and Clifford conjugation
becoming `X ↦ J Xᴴ J`, `J = diag(1, -1)`. For both forms the isomorphism carries the action
`v ↦ x v x⁻¹` on vectors to the double cover `toSO4` (`spinGroup_conj_ι`, `spinGroupP_conj_ι`).

## Construction

* `cliffordToMat : Cl(Q) →ₐ[ℝ] M₂(ℍ)`, the algebra homomorphism with `v ↦ [[0, v], [-v̄, 0]]`
  (this squares to `-|v|²`). It sends Clifford conjugation to the quaternionic conjugate
  transpose (`cliffordToMat_star`), is surjective (`cliffordToMat_surjective`), and is
  therefore bijective, since both algebras have dimension 16 (`finrank_clifford`, via Mathlib's
  linear equivalence of the Clifford and exterior algebras and the basis of the exterior
  algebra indexed by the subsets of `{1, i, j, k}`).
* Even elements go to diagonal matrices `diag(a, b)`, and elements of the spin group to pairs
  of unit quaternions. `spinToUnit : spinGroup Q →* unitary ℍ × unitary ℍ` is injective, and
  surjective because every unit quaternion is a commutator `c d c⁻¹ d⁻¹` (`exists_commutator`)
  and the products `v w` of unit vectors give the pairs `(-v w̄, -v̄ w)`.

## References

* H. B. Lawson, M.-L. Michelsohn, *Spin Geometry*, Princeton University Press (1989), Ch. I
  (Clifford algebras, the groups Pin and Spin, and Spin(4) ≅ Sp(1) × Sp(1)).
-/

open Quaternion Matrix CliffordAlgebra

namespace Lightlike.Spin4

/-! ## A. The quadratic form and the matrix representation -/

/-- The negative definite form `Q v = -|v|²` on `ℝ⁴ = ℍ`. -/
noncomputable def Qℍ : QuadraticForm ℝ ℍ := -(LinearMap.BilinMap.toQuadraticMap (innerₗ ℍ))

lemma Qℍ_apply (v : ℍ) : Qℍ v = -normSq v := by
  simp [Qℍ, LinearMap.BilinMap.toQuadraticMap_apply, normSq_eq_norm_mul_self, sq]

/-- The vector `v` as the matrix `[[0, v], [-v̄, 0]]`. -/
def vecMat : ℍ →ₗ[ℝ] Matrix (Fin 2) (Fin 2) ℍ where
  toFun v := !![0, v; -star v, 0]
  map_add' u v := Matrix.ext fun i j => by fin_cases i <;> fin_cases j <;> simp [add_comm]
  map_smul' r v := Matrix.ext fun i j => by fin_cases i <;> fin_cases j <;> simp

lemma vecMat_apply (v : ℍ) : vecMat v = !![0, v; -star v, 0] := rfl

lemma vecMat_mul_self (v : ℍ) : vecMat v * vecMat v = algebraMap ℝ _ (Qℍ v) := by
  rw [Qℍ_apply, vecMat_apply, Algebra.algebraMap_eq_smul_one]
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, Quaternion.self_mul_star, Quaternion.star_mul_self,
      Algebra.smul_def]

/-- **The Clifford algebra of `(ℍ, -|·|²)` as `2 × 2` quaternionic matrices**: the algebra
homomorphism with `ι v ↦ [[0, v], [-v̄, 0]]`. -/
noncomputable def cliffordToMat : CliffordAlgebra Qℍ →ₐ[ℝ] Matrix (Fin 2) (Fin 2) ℍ :=
  CliffordAlgebra.lift Qℍ ⟨vecMat, vecMat_mul_self⟩

lemma cliffordToMat_ι (v : ℍ) : cliffordToMat (ι Qℍ v) = vecMat v :=
  CliffordAlgebra.lift_ι_apply _ _ _

/-- Clifford conjugation becomes the quaternionic conjugate transpose. -/
lemma cliffordToMat_star (x : CliffordAlgebra Qℍ) :
    cliffordToMat (star x) = (cliffordToMat x)ᴴ := by
  induction x using CliffordAlgebra.induction with
  | algebraMap r =>
    rw [star_algebraMap, AlgHom.commutes, Matrix.algebraMap_eq_diagonal, diagonal_conjTranspose]
    congr 1
    funext i
    simp
  | ι v =>
    rw [star_ι, map_neg, cliffordToMat_ι, vecMat_apply]
    refine Matrix.ext fun i j => ?_
    fin_cases i <;> fin_cases j <;> simp
  | mul a b ha hb => rw [star_mul, map_mul, map_mul, ha, hb, conjTranspose_mul]
  | add a b ha hb => rw [star_add, map_add, map_add, ha, hb, conjTranspose_add]

/-! ## B. `cliffordToMat` is an isomorphism -/

/-- `dim Cl(ℝ⁴) = 2⁴ = 16`. -/
lemma finrank_clifford : Module.finrank ℝ (CliffordAlgebra Qℍ) = 16 := by
  rw [(CliffordAlgebra.equivExterior Qℍ).finrank_eq,
    Module.finrank_eq_card_basis (basisH.ExteriorAlgebra), Fintype.card_finset, Fintype.card_fin]
  norm_num

/-- `dim M₂(ℍ) = 16`. -/
lemma finrank_mat : Module.finrank ℝ (Matrix (Fin 2) (Fin 2) ℍ) = 16 := by
  rw [Module.finrank_matrix, Quaternion.finrank_eq_four]
  simp

/-- The quaternion units `i`, `j`, `k`. -/
def qi : ℍ := ⟨0, 1, 0, 0⟩
/-- The quaternion unit `j`. -/
def qj : ℍ := ⟨0, 0, 1, 0⟩
/-- The quaternion unit `k`. -/
def qk : ℍ := ⟨0, 0, 0, 1⟩

lemma cliffordToMat_ι_mul_ι (u w : ℍ) :
    cliffordToMat (ι Qℍ u * ι Qℍ w) = !![-(u * star w), 0; 0, -(star u * w)] := by
  rw [map_mul, cliffordToMat_ι, cliffordToMat_ι, vecMat_apply, vecMat_apply]
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- **`cliffordToMat` is surjective.** -/
lemma cliffordToMat_surjective : Function.Surjective cliffordToMat := by
  have hR : ∀ M, M ∈ cliffordToMat.range → ∀ N, N ∈ cliffordToMat.range →
      M * N ∈ cliffordToMat.range := fun M hM N hN => Subalgebra.mul_mem _ hM hN
  have hvec : ∀ v, vecMat v ∈ cliffordToMat.range := fun v => ⟨ι Qℍ v, cliffordToMat_ι v⟩
  have hpair : ∀ u w, (!![-(u * star w), 0; 0, -(star u * w)] : Matrix (Fin 2) (Fin 2) ℍ) ∈
      cliffordToMat.range := fun u w => ⟨ι Qℍ u * ι Qℍ w, cliffordToMat_ι_mul_ι u w⟩
  -- `diag(w, w̄)`
  have hD : ∀ w : ℍ, (!![w, 0; 0, star w] : Matrix (Fin 2) (Fin 2) ℍ) ∈ cliffordToMat.range := by
    intro w
    have := hpair 1 (-star w)
    simpa using this
  -- `diag(1, 0)`
  have hP0 : (!![1, 0; 0, 0] : Matrix (Fin 2) (Fin 2) ℍ) ∈ cliffordToMat.range := by
    have h1 := hR _ (hD qi) _ (hpair qj qk)
    have h2 : (!![1, 0; 0, 0] : Matrix (Fin 2) (Fin 2) ℍ) =
        (1 / 2 : ℝ) • (1 - !![qi, 0; 0, star qi] * !![-(qj * star qk), 0; 0, -(star qj * qk)]) := by
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> ext <;> norm_num [qi, qj, qk]
    rw [h2]
    exact Subalgebra.smul_mem _ (Subalgebra.sub_mem _ (Subalgebra.one_mem _) h1) _
  have hP1 : (!![0, 0; 0, 1] : Matrix (Fin 2) (Fin 2) ℍ) ∈ cliffordToMat.range := by
    have : (!![0, 0; 0, 1] : Matrix (Fin 2) (Fin 2) ℍ) = 1 - !![1, 0; 0, 0] := by
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp
    rw [this]
    exact Subalgebra.sub_mem _ (Subalgebra.one_mem _) hP0
  have hsingle : ∀ (a b : Fin 2) (w : ℍ), Matrix.single a b w ∈ cliffordToMat.range := by
    intro a b w
    fin_cases a <;> fin_cases b
    · convert hR _ hP0 _ (hD w) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply]
    · convert hR _ hP0 _ (hvec w) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, vecMat_apply]
    · convert hR _ hP1 _ (hvec (-star w)) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, vecMat_apply]
    · convert hR _ hP1 _ (hD (star w)) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply]
  intro M
  have hM : M ∈ cliffordToMat.range := by
    rw [Matrix.matrix_eq_sum_single M]
    exact Subalgebra.sum_mem _ fun a _ => Subalgebra.sum_mem _ fun b _ => hsingle a b (M a b)
  obtain ⟨x, hx⟩ := hM
  exact ⟨x, hx⟩

/-- **`cliffordToMat` is injective** (a surjection between spaces of equal dimension 16). -/
lemma cliffordToMat_injective : Function.Injective cliffordToMat := by
  have : FiniteDimensional ℝ (CliffordAlgebra Qℍ) :=
    Module.finite_of_finrank_pos (by rw [finrank_clifford]; norm_num)
  have h := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := cliffordToMat.toLinearMap) (finrank_clifford.trans finrank_mat.symm)).mpr
    cliffordToMat_surjective
  exact h

/-! ## C. Every unit quaternion is a commutator -/

/-- `c₀ = |p|² - q p` (`p`, `q` the pure parts of `x`, `y`) satisfies `c₀ x = y c₀` when `x` and
`y` have the same real part and pure parts of the same length. -/
lemma conj_witness (x y : ℍ) (hre : x.re = y.re)
    (hs : x.imI ^ 2 + x.imJ ^ 2 + x.imK ^ 2 = y.imI ^ 2 + y.imJ ^ 2 + y.imK ^ 2) :
    ((x.imI ^ 2 + x.imJ ^ 2 + x.imK ^ 2) • (1 : ℍ) - (y - (y.re : ℍ)) * (x - (x.re : ℍ))) * x =
      y * ((x.imI ^ 2 + x.imJ ^ 2 + x.imK ^ 2) • (1 : ℍ) -
        (y - (y.re : ℍ)) * (x - (x.re : ℍ))) := by
  ext <;> simp <;> rw [hre] <;>
    first
    | ring1
    | linear_combination x.imI * hs | linear_combination (-x.imI) * hs
    | linear_combination x.imJ * hs | linear_combination (-x.imJ) * hs
    | linear_combination x.imK * hs

/-- A nonzero intertwiner `c x = y c` can be normalised to a unit quaternion `u` with
`u x ū = y`. -/
lemma conj_of_mul_eq {c x y : ℍ} (hc : c ≠ 0) (h : c * x = y * c) :
    ∃ u : ℍ, normSq u = 1 ∧ u * x * star u = y := by
  have hN : normSq c ≠ 0 := normSq_ne_zero.mpr hc
  set t : ℝ := (Real.sqrt (normSq c))⁻¹
  have ht : t * t * normSq c = 1 := by
    have h0 : 0 ≤ normSq c := normSq_nonneg
    simp only [t]
    rw [← mul_inv, Real.mul_self_sqrt h0, inv_mul_cancel₀ hN]
  refine ⟨(t : ℍ) * c, ?_, ?_⟩
  · rw [map_mul, normSq_coe, sq]; exact ht
  · calc (t : ℍ) * c * x * star ((t : ℍ) * c)
        = (t : ℍ) * ((c * x) * star c) * t := by rw [star_mul, star_coe]; simp only [mul_assoc]
      _ = (t : ℍ) * (y * (c * star c)) * t := by rw [h]; simp only [mul_assoc]
      _ = y * ((t * t * normSq c : ℝ) : ℍ) := by
          rw [self_mul_star]
          ext <;> simp <;> ring
      _ = y := by rw [ht, coe_one, mul_one]

/-- **Unit quaternions with the same real part are conjugate.** -/
lemma exists_conj {x y : ℍ} (hx : normSq x = 1) (hy : normSq y = 1) (hre : x.re = y.re) :
    ∃ u : ℍ, normSq u = 1 ∧ u * x * star u = y := by
  have hs : x.imI ^ 2 + x.imJ ^ 2 + x.imK ^ 2 = y.imI ^ 2 + y.imJ ^ 2 + y.imK ^ 2 := by
    rw [normSq_def'] at hx hy; rw [hre] at hx; linarith
  set c := (x.imI ^ 2 + x.imJ ^ 2 + x.imK ^ 2) • (1 : ℍ) - (y - (y.re : ℍ)) * (x - (x.re : ℍ))
  by_cases hc : c ≠ 0
  · exact conj_of_mul_eq hc (conj_witness x y hre hs)
  push Not at hc
  -- `c = 0` forces `y = x̄`-type: the pure parts are opposite
  have hre0 := congrArg (fun z : ℍ => z.re) hc
  simp only [c] at hre0
  simp at hre0
  have hpq : y.imI = -x.imI ∧ y.imJ = -x.imJ ∧ y.imK = -x.imK := by
    have : (y.imI + x.imI) ^ 2 + (y.imJ + x.imJ) ^ 2 + (y.imK + x.imK) ^ 2 = 0 := by
      nlinarith [hre0, hs]
    refine ⟨?_, ?_, ?_⟩ <;> nlinarith [sq_nonneg (y.imI + x.imI), sq_nonneg (y.imJ + x.imJ),
      sq_nonneg (y.imK + x.imK)]
  obtain ⟨h1, h2, h3⟩ := hpq
  have hy' : y = ⟨x.re, -x.imI, -x.imJ, -x.imK⟩ := by ext <;> simp [h1, h2, h3, hre]
  rw [hy']
  by_cases hp : x.imJ = 0 ∧ x.imK = 0
  · by_cases hp1 : x.imI = 0
    · refine ⟨1, by simp, ?_⟩
      ext <;> simp [hp1, hp.1, hp.2]
    · refine conj_of_mul_eq (c := ⟨0, 0, 1, 0⟩) (by simp [Quaternion.ext_iff]) ?_
      ext <;> simp [hp.1, hp.2]
  · refine conj_of_mul_eq (c := ⟨0, 0, x.imK, -x.imJ⟩) ?_ ?_
    · intro h0
      apply hp
      have := congrArg (fun z : ℍ => (z.imJ, z.imK)) h0
      simp at this
      exact ⟨by linarith [this.2], this.1⟩
    · ext <;> simp <;> ring

/-- **Every unit quaternion is a commutator** `c d c̄ d̄` of unit quaternions. -/
lemma exists_commutator {a : ℍ} (ha : normSq a = 1) :
    ∃ c d : ℍ, normSq c = 1 ∧ normSq d = 1 ∧ c * d * star c * star d = a := by
  -- a unit `d` with `Re(a d) = Re d`: `d̄ ⊥ a - 1`
  obtain ⟨e, he, he0⟩ : ∃ e : ℍ, e ∈ (ℝ ∙ (a - 1))ᗮ ∧ e ≠ 0 := by
    apply Submodule.exists_mem_ne_zero_of_ne_bot
    intro hbot
    have h1 := Submodule.finrank_add_finrank_orthogonal (ℝ ∙ (a - 1))
    rw [hbot, finrank_bot, add_zero, Quaternion.finrank_eq_four] at h1
    have h2 := finrank_span_le_card (R := ℝ) ({a - 1} : Set ℍ)
    simp at h2
    omega
  have he0' : 0 < normSq e := lt_of_le_of_ne normSq_nonneg (Ne.symm (normSq_ne_zero.mpr he0))
  set t : ℝ := (Real.sqrt (normSq e))⁻¹
  set d : ℍ := (t : ℍ) * star e
  have hd : normSq d = 1 := by
    simp only [d, map_mul, normSq_coe, normSq_star, t, inv_pow, Real.sq_sqrt he0'.le]
    exact inv_mul_cancel₀ he0'.ne'
  have hred : (a * d).re = d.re := by
    rw [Submodule.mem_orthogonal_singleton_iff_inner_right, inner_def] at he
    have h1 : (a * star e).re = (star e).re := by
      rw [sub_mul, one_mul, re_sub] at he; linarith
    have e1 : a * d = (t : ℍ) * (a * star e) := by
      simp only [d]; rw [← mul_assoc, ← coe_commutes, mul_assoc]
    rw [e1]
    simp only [d, coe_mul_eq_smul, re_smul, smul_eq_mul, h1]
  have had : normSq (a * d) = 1 := by rw [map_mul, ha, hd, one_mul]
  obtain ⟨c, hc, hcd⟩ := exists_conj hd had hred.symm
  refine ⟨c, d, hc, hd, ?_⟩
  rw [hcd, mul_assoc, self_mul_star, hd, coe_one, mul_one]

/-! ## D. The spin group -/

/-- Even elements of `Cl(Q)` are diagonal matrices. -/
lemma cliffordToMat_offdiag {x : CliffordAlgebra Qℍ} (hx : x ∈ evenOdd Qℍ 0) :
    cliffordToMat x 0 1 = 0 ∧ cliffordToMat x 1 0 = 0 := by
  induction x, hx using CliffordAlgebra.even_induction with
  | algebraMap r => simp [Matrix.algebraMap_eq_diagonal]
  | add x y hx hy ihx ihy => simp [ihx.1, ihy.1, ihx.2, ihy.2]
  | ι_mul_ι_mul m₁ m₂ x hx ih =>
    rw [map_mul, cliffordToMat_ι_mul_ι]
    simp [Matrix.mul_apply, Fin.sum_univ_two, ih.1, ih.2]

lemma offdiag_of_spin (x : spinGroup Qℍ) :
    cliffordToMat (x : CliffordAlgebra Qℍ) 0 1 = 0 ∧
      cliffordToMat (x : CliffordAlgebra Qℍ) 1 0 = 0 :=
  cliffordToMat_offdiag (spinGroup.mem_even x.2)

/-- The `(k, k)` entry of a product of two elements of the spin group. -/
lemma diag_mul (x y : spinGroup Qℍ) (k : Fin 2) :
    cliffordToMat ((x : CliffordAlgebra Qℍ) * y) k k =
      cliffordToMat (x : CliffordAlgebra Qℍ) k k * cliffordToMat (y : CliffordAlgebra Qℍ) k k := by
  rw [map_mul, Matrix.mul_apply, Fin.sum_univ_two]
  obtain ⟨hx1, hx2⟩ := offdiag_of_spin x
  fin_cases k <;> simp [hx1, hx2]

/-- The diagonal entries of an element of the spin group are unit quaternions. -/
lemma diag_mem_unitary (x : spinGroup Qℍ) (k : Fin 2) :
    cliffordToMat (x : CliffordAlgebra Qℍ) k k ∈ unitary ℍ := by
  obtain ⟨hx1, hx2⟩ := offdiag_of_spin x
  have h1 := congrArg (fun M => M k k)
    (congrArg cliffordToMat (spinGroup.star_mul_self_of_mem x.2))
  have h2 := congrArg (fun M => M k k)
    (congrArg cliffordToMat (spinGroup.mul_star_self_of_mem x.2))
  simp only [map_mul, cliffordToMat_star, map_one, Matrix.mul_apply, Fin.sum_univ_two,
    conjTranspose_apply] at h1 h2
  rw [Unitary.mem_iff]
  fin_cases k <;> simp_all

/-- **The spin group as pairs of unit quaternions**: `x ↦ (a, b)` where `x ↦ diag(a, b)`. -/
noncomputable def spinToUnit : spinGroup Qℍ →* unitary ℍ × unitary ℍ where
  toFun x := (⟨_, diag_mem_unitary x 0⟩, ⟨_, diag_mem_unitary x 1⟩)
  map_one' := Prod.ext (Subtype.ext (by simp)) (Subtype.ext (by simp))
  map_mul' x y := Prod.ext (Subtype.ext (diag_mul x y 0)) (Subtype.ext (diag_mul x y 1))

/-- `spinToUnit` is injective, since `cliffordToMat` is and spin elements are diagonal. -/
lemma spinToUnit_injective : Function.Injective spinToUnit := by
  intro x y h
  have h0 := congrArg (fun p : unitary ℍ × unitary ℍ => (p.1 : ℍ)) h
  have h1 := congrArg (fun p : unitary ℍ × unitary ℍ => (p.2 : ℍ)) h
  simp only [spinToUnit, MonoidHom.coe_mk, OneHom.coe_mk] at h0 h1
  obtain ⟨hx1, hx2⟩ := offdiag_of_spin x
  obtain ⟨hy1, hy2⟩ := offdiag_of_spin y
  apply Subtype.ext
  apply cliffordToMat_injective
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp_all

/-- A unit vector is in the pin group. -/
lemma ι_mem_pinGroup {u : ℍ} (hu : normSq u = 1) : ι Qℍ u ∈ pinGroup Qℍ := by
  have hsq : ι Qℍ u * ι Qℍ u = -1 := by
    rw [ι_sq_scalar, Qℍ_apply, hu, map_neg, map_one]
  refine ⟨⟨⟨ι Qℍ u, -ι Qℍ u, by rw [mul_neg, hsq, neg_neg], by rw [neg_mul, hsq, neg_neg]⟩,
    Subgroup.subset_closure ⟨u, rfl⟩, rfl⟩, ?_⟩
  change ι Qℍ u ∈ unitary (CliffordAlgebra Qℍ)
  rw [Unitary.mem_iff, star_ι]
  exact ⟨by rw [neg_mul, hsq, neg_neg], by rw [mul_neg, hsq, neg_neg]⟩

/-- The product of two unit vectors is in the spin group. -/
lemma ι_mul_ι_mem_spinGroup {u w : ℍ} (hu : normSq u = 1) (hw : normSq w = 1) :
    ι Qℍ u * ι Qℍ w ∈ spinGroup Qℍ :=
  ⟨Submonoid.mul_mem _ (ι_mem_pinGroup hu) (ι_mem_pinGroup hw),
    ι_mul_ι_mem_evenOdd_zero Qℍ u w⟩

/-- The pairs `(-u w̄, -ū w)`, for unit `u`, `w`, are in the image. -/
lemma pair_mem_range {u w : ℍ} (hu : normSq u = 1) (hw : normSq w = 1)
    (h1 : -(u * star w) ∈ unitary ℍ) (h2 : -(star u * w) ∈ unitary ℍ) :
    (⟨_, h1⟩, ⟨_, h2⟩) ∈ spinToUnit.range :=
  ⟨⟨_, ι_mul_ι_mem_spinGroup hu hw⟩, by
    ext <;> simp [spinToUnit, cliffordToMat_ι_mul_ι]⟩

/-- `(c, c̄)` is in the image. -/
lemma conj_pair_mem_range (c : unitary ℍ) : (c, star c) ∈ spinToUnit.range := by
  have hc := normSq_unitary c
  have hw : normSq (-star (c : ℍ)) = 1 := by rw [normSq_neg, normSq_star, hc]
  obtain ⟨x, hx⟩ := pair_mem_range (u := 1) (w := -star (c : ℍ)) (by simp) hw
    (by simp) (by simp)
  refine ⟨x, ?_⟩
  rw [hx]
  ext <;> simp

/-- A subgroup of `Sp(1) × Sp(1)` containing every pair `(c, c̄)` is everything (every unit
quaternion is a commutator, and `(c, c̄)(d, d̄)(c̄ d̄, d c) = (c d c̄ d̄, 1)`). -/
lemma eq_top_of_conj_pairs (H : Subgroup (unitary ℍ × unitary ℍ))
    (hH : ∀ c : unitary ℍ, (c, star c) ∈ H) : H = ⊤ := by
  -- `(a, 1)` for every unit `a`, from `a = c d c̄ d̄`
  have hleft : ∀ a : unitary ℍ, (a, 1) ∈ H := by
    intro a
    obtain ⟨c, d, hc, hd, hcd⟩ := exists_commutator (normSq_unitary a)
    let c' : unitary ℍ := ⟨c, mem_unitary_of_normSq hc⟩
    let d' : unitary ℍ := ⟨d, mem_unitary_of_normSq hd⟩
    have := H.mul_mem (H.mul_mem (hH c') (hH d')) (hH (star c' * star d'))
    convert this using 1
    refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
    · simp only [Prod.fst_mul, Submonoid.coe_mul, Unitary.coe_star, c', d']
      rw [← hcd]; simp only [mul_assoc]
    · simp only [Prod.snd_mul, Submonoid.coe_mul, Unitary.coe_star, star_mul, star_star, c', d',
        OneMemClass.coe_one]
      rw [show star c * star d * (d * c) = star c * (star d * d) * c by simp only [mul_assoc],
        Unitary.star_mul_self_of_mem d'.2, mul_one, Unitary.star_mul_self_of_mem c'.2]
  rw [eq_top_iff]
  rintro ⟨a, b⟩ -
  -- `(1, b) = (b̄, b) (b, 1)`
  have hb : ((1 : unitary ℍ), b) ∈ H := by
    have := H.mul_mem (hH (star b)) (hleft b)
    convert this using 1
    refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
    · simp
    · simp
  have := H.mul_mem (hleft a) hb
  convert this using 1
  refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_) <;> simp

/-- **The spin group is all pairs of unit quaternions.** -/
lemma spinToUnit_surjective : Function.Surjective spinToUnit := by
  rw [← MonoidHom.range_eq_top]
  exact eq_top_of_conj_pairs _ conj_pair_mem_range

/-- **Mathlib's Clifford-algebra spin group of `(ℝ⁴, -|·|²)` is `Spin4 = SU(2) × SU(2)`.** -/
noncomputable def spinEquiv : spinGroup Qℍ ≃* Spin4 :=
  (MulEquiv.ofBijective spinToUnit ⟨spinToUnit_injective, spinToUnit_surjective⟩).trans
    (MulEquiv.prodCongr quatEquiv quatEquiv)

/-- **The isomorphism is the double cover.** Conjugating a vector by `x` in the Clifford algebra is
the rotation `toSO4 (spinEquiv x)` of `ℝ⁴ = ℍ`: `x v x⁻¹ = p v q⁻¹`. -/
theorem spinGroup_conj_ι (x : spinGroup Qℍ) (v : ℍ) :
    (x : CliffordAlgebra Qℍ) * ι Qℍ v * star (x : CliffordAlgebra Qℍ) =
      ι Qℍ ((toSO4 (spinEquiv x) : ℍ ≃ₗᵢ[ℝ] ℍ) v) := by
  apply cliffordToMat_injective
  obtain ⟨h01, h10⟩ := offdiag_of_spin x
  have hs1 : (spinEquiv x).1 = quatEquiv (spinToUnit x).1 := rfl
  have hs2 : (spinEquiv x).2 = quatEquiv (spinToUnit x).2 := rfl
  rw [toSO4_apply, hs1, hs2, MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply]
  rw [map_mul, map_mul, cliffordToMat_star, cliffordToMat_ι, cliffordToMat_ι]
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, vecMat_apply, h01, h10, spinToUnit, mul_assoc]

/-! ## E. The positive definite form `Q v = +|v|²` -/

/-- The positive definite (Euclidean) form `Q v = |v|²` on `ℝ⁴ = ℍ`. -/
noncomputable def Qℍp : QuadraticForm ℝ ℍ := LinearMap.BilinMap.toQuadraticMap (innerₗ ℍ)

lemma Qℍp_apply (v : ℍ) : Qℍp v = normSq v := by
  simp [Qℍp, LinearMap.BilinMap.toQuadraticMap_apply, normSq_eq_norm_mul_self, sq]

/-- The vector `v` as the matrix `[[0, v], [v̄, 0]]` (which squares to `+|v|²`). -/
def vecMatP : ℍ →ₗ[ℝ] Matrix (Fin 2) (Fin 2) ℍ where
  toFun v := !![0, v; star v, 0]
  map_add' u v := Matrix.ext fun i j => by fin_cases i <;> fin_cases j <;> simp
  map_smul' r v := Matrix.ext fun i j => by fin_cases i <;> fin_cases j <;> simp

lemma vecMatP_apply (v : ℍ) : vecMatP v = !![0, v; star v, 0] := rfl

lemma vecMatP_mul_self (v : ℍ) : vecMatP v * vecMatP v = algebraMap ℝ _ (Qℍp v) := by
  rw [Qℍp_apply, vecMatP_apply, Algebra.algebraMap_eq_smul_one]
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, Quaternion.self_mul_star, Quaternion.star_mul_self,
      Algebra.smul_def]

/-- `Cl(ℍ, +|·|²)` as `2 × 2` quaternionic matrices: `ι v ↦ [[0, v], [v̄, 0]]`. -/
noncomputable def cliffordToMatP : CliffordAlgebra Qℍp →ₐ[ℝ] Matrix (Fin 2) (Fin 2) ℍ :=
  CliffordAlgebra.lift Qℍp ⟨vecMatP, vecMatP_mul_self⟩

lemma cliffordToMatP_ι (v : ℍ) : cliffordToMatP (ι Qℍp v) = vecMatP v :=
  CliffordAlgebra.lift_ι_apply _ _ _

/-- The signature matrix `J = diag(1, -1)`. -/
def sigJ : Matrix (Fin 2) (Fin 2) ℍ := !![1, 0; 0, -1]

lemma sigJ_mul_self : sigJ * sigJ = 1 := by
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp [sigJ, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] lemma sigJ_00 : sigJ 0 0 = 1 := rfl
@[simp] lemma sigJ_11 : sigJ 1 1 = -1 := rfl

lemma sigJ_mul_apply (M : Matrix (Fin 2) (Fin 2) ℍ) (i j : Fin 2) :
    (sigJ * M) i j = sigJ i i * M i j := by
  rw [Matrix.mul_apply, Fin.sum_univ_two]
  fin_cases i <;> simp [sigJ]

lemma mul_sigJ_apply (M : Matrix (Fin 2) (Fin 2) ℍ) (i j : Fin 2) :
    (M * sigJ) i j = M i j * sigJ j j := by
  rw [Matrix.mul_apply, Fin.sum_univ_two]
  fin_cases j <;> simp [sigJ]

/-- Entries of `J Xᴴ J`. -/
lemma sigJ_conj_apply (X : Matrix (Fin 2) (Fin 2) ℍ) (i j : Fin 2) :
    (sigJ * Xᴴ * sigJ) i j = sigJ i i * star (X j i) * sigJ j j := by
  rw [mul_sigJ_apply, sigJ_mul_apply, conjTranspose_apply]

/-- Clifford conjugation becomes `X ↦ J Xᴴ J`. -/
lemma cliffordToMatP_star (x : CliffordAlgebra Qℍp) :
    cliffordToMatP (star x) = sigJ * (cliffordToMatP x)ᴴ * sigJ := by
  induction x using CliffordAlgebra.induction with
  | algebraMap r =>
    rw [star_algebraMap, AlgHom.commutes]
    refine Matrix.ext fun i j => ?_
    rw [sigJ_conj_apply]
    fin_cases i <;> fin_cases j <;> simp [Matrix.algebraMap_matrix_apply]
  | ι v =>
    rw [star_ι, map_neg, cliffordToMatP_ι, vecMatP_apply]
    refine Matrix.ext fun i j => ?_
    rw [sigJ_conj_apply]
    fin_cases i <;> fin_cases j <;> simp
  | mul a b ha hb =>
    rw [star_mul, map_mul, map_mul, ha, hb, conjTranspose_mul]
    simp only [Matrix.mul_assoc]
    rw [← Matrix.mul_assoc sigJ sigJ, sigJ_mul_self, Matrix.one_mul]
  | add a b ha hb => rw [star_add, map_add, map_add, ha, hb, conjTranspose_add,
      Matrix.mul_add, Matrix.add_mul]

lemma finrank_cliffordP : Module.finrank ℝ (CliffordAlgebra Qℍp) = 16 := by
  rw [(CliffordAlgebra.equivExterior Qℍp).finrank_eq,
    Module.finrank_eq_card_basis (basisH.ExteriorAlgebra), Fintype.card_finset, Fintype.card_fin]
  norm_num

lemma cliffordToMatP_ι_mul_ι (u w : ℍ) :
    cliffordToMatP (ι Qℍp u * ι Qℍp w) = !![u * star w, 0; 0, star u * w] := by
  rw [map_mul, cliffordToMatP_ι, cliffordToMatP_ι, vecMatP_apply, vecMatP_apply]
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- `cliffordToMatP` is surjective. -/
lemma cliffordToMatP_surjective : Function.Surjective cliffordToMatP := by
  have hR : ∀ M, M ∈ cliffordToMatP.range → ∀ N, N ∈ cliffordToMatP.range →
      M * N ∈ cliffordToMatP.range := fun M hM N hN => Subalgebra.mul_mem _ hM hN
  have hvec : ∀ v, vecMatP v ∈ cliffordToMatP.range := fun v => ⟨ι Qℍp v, cliffordToMatP_ι v⟩
  have hpair : ∀ u w, (!![u * star w, 0; 0, star u * w] : Matrix (Fin 2) (Fin 2) ℍ) ∈
      cliffordToMatP.range := fun u w => ⟨ι Qℍp u * ι Qℍp w, cliffordToMatP_ι_mul_ι u w⟩
  have hD : ∀ w : ℍ, (!![w, 0; 0, star w] : Matrix (Fin 2) (Fin 2) ℍ) ∈
      cliffordToMatP.range := by
    intro w
    have := hpair 1 (star w)
    simpa using this
  have hP0 : (!![1, 0; 0, 0] : Matrix (Fin 2) (Fin 2) ℍ) ∈ cliffordToMatP.range := by
    have h1 := hR _ (hD qi) _ (hpair qj qk)
    have h2 : (!![1, 0; 0, 0] : Matrix (Fin 2) (Fin 2) ℍ) =
        (1 / 2 : ℝ) • (1 + !![qi, 0; 0, star qi] * !![qj * star qk, 0; 0, star qj * qk]) := by
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> ext <;> norm_num [qi, qj, qk]
    rw [h2]
    exact Subalgebra.smul_mem _ (Subalgebra.add_mem _ (Subalgebra.one_mem _) h1) _
  have hP1 : (!![0, 0; 0, 1] : Matrix (Fin 2) (Fin 2) ℍ) ∈ cliffordToMatP.range := by
    have : (!![0, 0; 0, 1] : Matrix (Fin 2) (Fin 2) ℍ) = 1 - !![1, 0; 0, 0] := by
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp
    rw [this]
    exact Subalgebra.sub_mem _ (Subalgebra.one_mem _) hP0
  have hsingle : ∀ (a b : Fin 2) (w : ℍ), Matrix.single a b w ∈ cliffordToMatP.range := by
    intro a b w
    fin_cases a <;> fin_cases b
    · convert hR _ hP0 _ (hD w) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply]
    · convert hR _ hP0 _ (hvec w) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, vecMatP_apply]
    · convert hR _ hP1 _ (hvec (star w)) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, vecMatP_apply]
    · convert hR _ hP1 _ (hD (star w)) using 1
      refine Matrix.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply]
  intro M
  have hM : M ∈ cliffordToMatP.range := by
    rw [Matrix.matrix_eq_sum_single M]
    exact Subalgebra.sum_mem _ fun a _ => Subalgebra.sum_mem _ fun b _ => hsingle a b (M a b)
  obtain ⟨x, hx⟩ := hM
  exact ⟨x, hx⟩

/-- `cliffordToMatP` is injective (a surjection between spaces of dimension 16). -/
lemma cliffordToMatP_injective : Function.Injective cliffordToMatP := by
  have : FiniteDimensional ℝ (CliffordAlgebra Qℍp) :=
    Module.finite_of_finrank_pos (by rw [finrank_cliffordP]; norm_num)
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := cliffordToMatP.toLinearMap) (finrank_cliffordP.trans finrank_mat.symm)).mpr
    cliffordToMatP_surjective

/-- Even elements of `Cl(+|·|²)` are diagonal matrices. -/
lemma cliffordToMatP_offdiag {x : CliffordAlgebra Qℍp} (hx : x ∈ evenOdd Qℍp 0) :
    cliffordToMatP x 0 1 = 0 ∧ cliffordToMatP x 1 0 = 0 := by
  induction x, hx using CliffordAlgebra.even_induction with
  | algebraMap r => simp [Matrix.algebraMap_eq_diagonal]
  | add x y hx hy ihx ihy => simp [ihx.1, ihy.1, ihx.2, ihy.2]
  | ι_mul_ι_mul m₁ m₂ x hx ih =>
    rw [map_mul, cliffordToMatP_ι_mul_ι]
    simp [Matrix.mul_apply, Fin.sum_univ_two, ih.1, ih.2]

lemma offdiagP_of_spin (x : spinGroup Qℍp) :
    cliffordToMatP (x : CliffordAlgebra Qℍp) 0 1 = 0 ∧
      cliffordToMatP (x : CliffordAlgebra Qℍp) 1 0 = 0 :=
  cliffordToMatP_offdiag (spinGroup.mem_even x.2)

lemma diagP_mul (x y : spinGroup Qℍp) (k : Fin 2) :
    cliffordToMatP ((x : CliffordAlgebra Qℍp) * y) k k =
      cliffordToMatP (x : CliffordAlgebra Qℍp) k k *
        cliffordToMatP (y : CliffordAlgebra Qℍp) k k := by
  rw [map_mul, Matrix.mul_apply, Fin.sum_univ_two]
  obtain ⟨hx1, hx2⟩ := offdiagP_of_spin x
  fin_cases k <;> simp [hx1, hx2]

lemma diagP_mem_unitary (x : spinGroup Qℍp) (k : Fin 2) :
    cliffordToMatP (x : CliffordAlgebra Qℍp) k k ∈ unitary ℍ := by
  obtain ⟨hx1, hx2⟩ := offdiagP_of_spin x
  have h1 := congrArg (fun M => M k k)
    (congrArg cliffordToMatP (spinGroup.star_mul_self_of_mem x.2))
  have h2 := congrArg (fun M => M k k)
    (congrArg cliffordToMatP (spinGroup.mul_star_self_of_mem x.2))
  simp only [map_mul, cliffordToMatP_star, map_one, Matrix.mul_apply (M := sigJ * _ * sigJ),
    Matrix.mul_apply (N := sigJ * _ * sigJ), Fin.sum_univ_two, sigJ_conj_apply] at h1 h2
  rw [Unitary.mem_iff]
  fin_cases k <;> simp_all

/-- The spin group of `+|·|²` as pairs of unit quaternions: `x ↦ (a, b)` where
`x ↦ diag(a, b)`. -/
noncomputable def spinToUnitP : spinGroup Qℍp →* unitary ℍ × unitary ℍ where
  toFun x := (⟨_, diagP_mem_unitary x 0⟩, ⟨_, diagP_mem_unitary x 1⟩)
  map_one' := Prod.ext (Subtype.ext (by simp)) (Subtype.ext (by simp))
  map_mul' x y := Prod.ext (Subtype.ext (diagP_mul x y 0)) (Subtype.ext (diagP_mul x y 1))

/-- `spinToUnitP` is injective. -/
lemma spinToUnitP_injective : Function.Injective spinToUnitP := by
  intro x y h
  have h0 := congrArg (fun p : unitary ℍ × unitary ℍ => (p.1 : ℍ)) h
  have h1 := congrArg (fun p : unitary ℍ × unitary ℍ => (p.2 : ℍ)) h
  simp only [spinToUnitP, MonoidHom.coe_mk, OneHom.coe_mk] at h0 h1
  obtain ⟨hx1, hx2⟩ := offdiagP_of_spin x
  obtain ⟨hy1, hy2⟩ := offdiagP_of_spin y
  apply Subtype.ext
  apply cliffordToMatP_injective
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp_all

/-- The product of two unit vectors is in the spin group of `+|·|²`. (A single unit vector is
not: `v̄ v = -v² = -1` for the Clifford conjugation.) -/
lemma ι_mul_ι_mem_spinGroupP {u w : ℍ} (hu : normSq u = 1) (hw : normSq w = 1) :
    ι Qℍp u * ι Qℍp w ∈ spinGroup Qℍp := by
  have hsq : ∀ {v : ℍ}, normSq v = 1 → ι Qℍp v * ι Qℍp v = 1 := fun hv => by
    rw [ι_sq_scalar, Qℍp_apply, hv, map_one]
  let U : ∀ {v : ℍ}, normSq v = 1 → (CliffordAlgebra Qℍp)ˣ := fun {v} hv =>
    ⟨ι Qℍp v, ι Qℍp v, hsq hv, hsq hv⟩
  have hUL : ∀ {v : ℍ} (hv : normSq v = 1), U hv ∈ lipschitzGroup Qℍp := fun {v} _ =>
    Subgroup.subset_closure ⟨v, rfl⟩
  refine ⟨⟨⟨U hu * U hw, Subgroup.mul_mem _ (hUL hu) (hUL hw), rfl⟩, ?_⟩,
    ι_mul_ι_mem_evenOdd_zero Qℍp u w⟩
  change ι Qℍp u * ι Qℍp w ∈ unitary (CliffordAlgebra Qℍp)
  rw [Unitary.mem_iff, star_mul, star_ι, star_ι, neg_mul_neg]
  constructor
  · rw [show ι Qℍp w * ι Qℍp u * (ι Qℍp u * ι Qℍp w) =
        ι Qℍp w * (ι Qℍp u * ι Qℍp u) * ι Qℍp w by simp only [mul_assoc],
      hsq hu, mul_one, hsq hw]
  · rw [show ι Qℍp u * ι Qℍp w * (ι Qℍp w * ι Qℍp u) =
        ι Qℍp u * (ι Qℍp w * ι Qℍp w) * ι Qℍp u by simp only [mul_assoc],
      hsq hw, mul_one, hsq hu]

/-- `(c, c̄)` is in the image. -/
lemma conj_pairP_mem_range (c : unitary ℍ) : (c, star c) ∈ spinToUnitP.range := by
  have hw : normSq (star (c : ℍ)) = 1 := by rw [normSq_star, normSq_unitary]
  refine ⟨⟨_, ι_mul_ι_mem_spinGroupP (u := 1) (w := star (c : ℍ)) (by simp) hw⟩, ?_⟩
  refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_) <;>
    simp [spinToUnitP, cliffordToMatP_ι_mul_ι]

/-- **Mathlib's Clifford-algebra spin group of the Euclidean `(ℝ⁴, +|·|²)` is `Spin4`.** -/
noncomputable def spinEquivP : spinGroup Qℍp ≃* Spin4 :=
  (MulEquiv.ofBijective spinToUnitP ⟨spinToUnitP_injective, by
    rw [← MonoidHom.range_eq_top]
    exact eq_top_of_conj_pairs _ conj_pairP_mem_range⟩).trans
    (MulEquiv.prodCongr quatEquiv quatEquiv)

/-- **The isomorphism is the double cover**, for `+|·|²`: `x v x⁻¹ = p v q⁻¹`. -/
theorem spinGroupP_conj_ι (x : spinGroup Qℍp) (v : ℍ) :
    (x : CliffordAlgebra Qℍp) * ι Qℍp v * star (x : CliffordAlgebra Qℍp) =
      ι Qℍp ((toSO4 (spinEquivP x) : ℍ ≃ₗᵢ[ℝ] ℍ) v) := by
  apply cliffordToMatP_injective
  obtain ⟨h01, h10⟩ := offdiagP_of_spin x
  have hs1 : (spinEquivP x).1 = quatEquiv (spinToUnitP x).1 := rfl
  have hs2 : (spinEquivP x).2 = quatEquiv (spinToUnitP x).2 := rfl
  rw [toSO4_apply, hs1, hs2, MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply]
  rw [map_mul, map_mul, cliffordToMatP_star, cliffordToMatP_ι, cliffordToMatP_ι]
  refine Matrix.ext fun i j => ?_
  rw [Matrix.mul_apply, Fin.sum_univ_two, sigJ_conj_apply, sigJ_conj_apply]
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, vecMatP_apply, h01, h10, spinToUnitP, mul_assoc]

end Lightlike.Spin4
