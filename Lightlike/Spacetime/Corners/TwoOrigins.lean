import Mathlib
import Lightlike.Spacetime.PullbackForm
import Lightlike.Spacetime.Lorentzian
import Lightlike.Spacetime.Corners.CurvatureSymmetries
import Lightlike.Spacetime.Corners.BianchiSecond
import Lightlike.Spacetime.Corners.LeviCivitaSmooth
import Lightlike.Spacetime.Corners.DivergenceFree

/-!
# The line with two origins

The standard non-Hausdorff manifold: `TwoOrigins = Option ℝ`, with `some x` the point `x` of the line, the origin `A`
being `some 0` and the second origin `B` being `none`. Two charts to the model `Fin 1 → ℝ` (the model of the Corners layer of
the curvature): `chartA` on `{some x}` (`some x ↦ x`) and `chartB` on `{some x | x ≠ 0} ∪ {none}` (`some x ↦ x`,
`none ↦ 0`). The transition maps are the identity of `ℝ ∖ {0}`. The topology is the one generated by the charts
(`ChartedSpaceCore`). `not_t2_twoOrigins`: the space is not Hausdorff.
-/

open Set Function Manifold Topology
open scoped ContDiff

noncomputable section

namespace Lightlike

/-- The line with two origins. -/
abbrev TwoOrigins : Type := Option ℝ

/-- The point `x` of the real line as a vector of the model. -/
def vecOf (x : ℝ) : Fin 1 → ℝ := fun _ => x

/-- The chart that contains the origin `some 0`. -/
def chartA : PartialEquiv TwoOrigins (Fin 1 → ℝ) where
  toFun p := vecOf (p.getD 0)
  invFun v := some (v 0)
  source := {p | p.isSome}
  target := univ
  map_source' _ _ := mem_univ _
  map_target' _ _ := rfl
  left_inv' p hp := by
    cases p with
    | none => simp at hp
    | some x => rfl
  right_inv' v _ := by
    ext i
    simp [vecOf, Subsingleton.elim i 0]

/-- The chart that contains the second origin `none`. -/
def chartB : PartialEquiv TwoOrigins (Fin 1 → ℝ) where
  toFun p := vecOf (p.getD 0)
  invFun v := if v 0 = 0 then none else some (v 0)
  source := {p | p = none ∨ ∃ x : ℝ, x ≠ 0 ∧ p = some x}
  target := univ
  map_source' _ _ := mem_univ _
  map_target' _ _ := by
    rename_i v _
    by_cases hx : v 0 = 0
    · simp [hx]
    · exact Or.inr ⟨v 0, hx, by simp [hx]⟩
  left_inv' p hp := by
    rcases hp with rfl | ⟨x, hx, rfl⟩
    · simp [vecOf]
    · simp [hx, vecOf]
  right_inv' v _ := by
    ext i
    by_cases hx : v 0 = 0 <;> simp [vecOf, hx, Subsingleton.elim i 0]

/-- The atlas of two charts. -/
def twoOriginsAtlas : Set (PartialEquiv TwoOrigins (Fin 1 → ℝ)) := {chartA, chartB}

/-- The preferred chart: `chartB` at the second origin, `chartA` elsewhere. -/
def chartAtT (p : TwoOrigins) : PartialEquiv TwoOrigins (Fin 1 → ℝ) :=
  match p with
  | none => chartB
  | some _ => chartA

lemma trans_eq_id {e e' : PartialEquiv TwoOrigins (Fin 1 → ℝ)} (he : e ∈ twoOriginsAtlas)
    (he' : e' ∈ twoOriginsAtlas) (v : Fin 1 → ℝ) (hv : v ∈ (e.symm.trans e').source) :
    (e.symm.trans e') v = v := by
  rcases he with rfl | rfl <;> rcases he' with rfl | rfl <;>
  · by_cases h0 : v 0 = 0 <;>
    · ext i
      simp [PartialEquiv.trans_source, PartialEquiv.trans_apply, chartA, chartB, vecOf, h0,
        Subsingleton.elim i 0] at hv ⊢

lemma trans_source_open {e e' : PartialEquiv TwoOrigins (Fin 1 → ℝ)} (he : e ∈ twoOriginsAtlas)
    (he' : e' ∈ twoOriginsAtlas) : IsOpen (e.symm.trans e').source := by
  have h0 : IsOpen {v : Fin 1 → ℝ | v 0 ≠ 0} := isOpen_ne_fun (continuous_apply 0) continuous_const
  rcases he with rfl | rfl <;> rcases he' with rfl | rfl
  · have : (chartA.symm.trans chartA).source = univ := by
      ext v; simp [PartialEquiv.trans_source, chartA]
    rw [this]; exact isOpen_univ
  · have : (chartA.symm.trans chartB).source = {v : Fin 1 → ℝ | v 0 ≠ 0} := by
      ext v; simp [PartialEquiv.trans_source, chartA, chartB]
    rw [this]; exact h0
  · have : (chartB.symm.trans chartA).source = {v : Fin 1 → ℝ | v 0 ≠ 0} := by
      ext v; by_cases hv : v 0 = 0 <;> simp [PartialEquiv.trans_source, chartA, chartB, hv]
    rw [this]; exact h0
  · have : (chartB.symm.trans chartB).source = univ := by
      ext v; by_cases hv : v 0 = 0 <;> simp [PartialEquiv.trans_source, chartB, hv]
    rw [this]; exact isOpen_univ

/-- The charted-space structure without topology. -/
def twoOriginsCore : ChartedSpaceCore (Fin 1 → ℝ) TwoOrigins where
  atlas := twoOriginsAtlas
  chartAt := chartAtT
  mem_chart_source p := by
    cases p <;> simp [chartAtT, chartA, chartB]
  chart_mem_atlas p := by
    cases p <;> simp [chartAtT, twoOriginsAtlas]
  open_source _ _ he he' := trans_source_open he he'
  continuousOn_toFun e e' he he' :=
    continuous_id.continuousOn.congr fun x hx => trans_eq_id he he' x hx

instance : TopologicalSpace TwoOrigins := twoOriginsCore.toTopologicalSpace

instance : ChartedSpace (Fin 1 → ℝ) TwoOrigins := twoOriginsCore.toChartedSpace

lemma chartAt_some_apply (y : ℝ) (p : TwoOrigins) :
    (chartAt (Fin 1 → ℝ) (some y : TwoOrigins)) p = vecOf (p.getD 0) := rfl

lemma chartAt_none_apply (p : TwoOrigins) :
    (chartAt (Fin 1 → ℝ) (none : TwoOrigins)) p = vecOf (p.getD 0) := rfl

lemma chartAt_some_source (y : ℝ) :
    (chartAt (Fin 1 → ℝ) (some y : TwoOrigins)).source = {p | p.isSome} := rfl

lemma chartAt_none_source :
    (chartAt (Fin 1 → ℝ) (none : TwoOrigins)).source =
      {p | p = none ∨ ∃ x : ℝ, x ≠ 0 ∧ p = some x} := rfl

/-- **The line with two origins is not Hausdorff**: the two origins have no disjoint neighbourhoods. -/
theorem not_t2_twoOrigins : ¬ T2Space TwoOrigins := by
  intro h
  have hne : (some 0 : TwoOrigins) ≠ none := by simp
  obtain ⟨U, V, hU, hV, hxU, hxV, hUV⟩ := t2_separation hne
  set eA := chartAt (Fin 1 → ℝ) (some 0 : TwoOrigins) with heA
  set eB := chartAt (Fin 1 → ℝ) (none : TwoOrigins) with heB
  have hAsrc : (some 0 : TwoOrigins) ∈ eA.source := mem_chart_source _ _
  have hBsrc : (none : TwoOrigins) ∈ eB.source := mem_chart_source _ _
  have hA0 : eA (some 0) = vecOf 0 := rfl
  have hB0 : eB none = vecOf 0 := rfl
  have hWA : IsOpen (eA '' (U ∩ eA.source)) :=
    eA.isOpen_image_of_subset_source (hU.inter eA.open_source) inter_subset_right
  have hWB : IsOpen (eB '' (V ∩ eB.source)) :=
    eB.isOpen_image_of_subset_source (hV.inter eB.open_source) inter_subset_right
  obtain ⟨ε, hε, hεA⟩ := Metric.isOpen_iff.1 hWA (vecOf 0) ⟨some 0, ⟨hxU, hAsrc⟩, hA0⟩
  obtain ⟨δ, hδ, hδB⟩ := Metric.isOpen_iff.1 hWB (vecOf 0) ⟨none, ⟨hxV, hBsrc⟩, hB0⟩
  set x : ℝ := min ε δ / 2 with hx
  have hxpos : 0 < x := by positivity
  have hnorm : ‖vecOf x - vecOf 0‖ = x := by
    have e : vecOf x - vecOf 0 = fun _ => x := by ext; simp [vecOf]
    rw [e, pi_norm_const, Real.norm_eq_abs, abs_of_pos hxpos]
  have hxε : vecOf x ∈ Metric.ball (vecOf 0) ε := by
    rw [mem_ball_iff_norm, hnorm]
    have := min_le_left ε δ
    linarith [lt_min hε hδ]
  have hxδ : vecOf x ∈ Metric.ball (vecOf 0) δ := by
    rw [mem_ball_iff_norm, hnorm]
    have := min_le_right ε δ
    linarith [lt_min hε hδ]
  obtain ⟨p, ⟨hpU, hpsrc⟩, hpx⟩ := hεA hxε
  obtain ⟨q, ⟨hqV, hqsrc⟩, hqx⟩ := hδB hxδ
  have vinj : ∀ a b : ℝ, vecOf a = vecOf b → a = b := fun a b h => congrFun h 0
  have hp : p = some x := by
    cases p with
    | none =>
      rw [heA, chartAt_some_source] at hpsrc
      exact absurd hpsrc (by simp)
    | some y =>
      have := vinj _ _ (by simpa [heA, chartAt_some_apply] using hpx)
      simp [this]
  have hq : q = some x := by
    cases q with
    | none =>
      exfalso
      have : (0 : ℝ) = x := vinj _ _ (by simpa [heB, chartAt_none_apply] using hqx)
      exact hxpos.ne this
    | some y =>
      have := vinj _ _ (by simpa [heB, chartAt_none_apply] using hqx)
      simp [this]
  exact Set.disjoint_left.1 hUV hpU (by rw [hp, ← hq]; exact hqV)

instance : HasGroupoid TwoOrigins (contDiffGroupoid ∞ 𝓘(ℝ, Fin 1 → ℝ)) where
  compatible := by
    intro e e' he he'
    change e ∈ ⋃ (e : PartialEquiv TwoOrigins (Fin 1 → ℝ)) (he : e ∈ twoOriginsCore.atlas),
      {twoOriginsCore.openPartialHomeomorph e he} at he
    change e' ∈ ⋃ (e : PartialEquiv TwoOrigins (Fin 1 → ℝ)) (he : e ∈ twoOriginsCore.atlas),
      {twoOriginsCore.openPartialHomeomorph e he} at he'
    simp only [mem_iUnion, mem_singleton_iff] at he he'
    obtain ⟨e₀, he₀, rfl⟩ := he
    obtain ⟨e₁, he₁, rfl⟩ := he'
    have hopen : IsOpen (e₀.symm.trans e₁).source := trans_source_open he₀ he₁
    refine StructureGroupoid.mem_of_eqOnSource _
      (ofSet_mem_contDiffGroupoid (I := 𝓘(ℝ, Fin 1 → ℝ)) (n := ∞) hopen) ?_
    refine ⟨?_, fun x hx => ?_⟩
    · rfl
    · exact trans_eq_id he₀ he₁ x hx

instance : IsManifold 𝓘(ℝ, Fin 1 → ℝ) ∞ TwoOrigins := { }

/-- The coordinate `π p = x` of the point `some x` (both origins go to `0`). -/
def piT (p : TwoOrigins) : ℝ := p.getD 0

lemma piT_eq_chart (x p : TwoOrigins) (hp : p ∈ (chartAt (Fin 1 → ℝ) x).source) :
    piT p = (extChartAt 𝓘(ℝ, Fin 1 → ℝ) x p) 0 := by
  cases x <;> cases p <;> simp [piT, extChartAt, chartAt_some_apply, chartAt_none_apply, vecOf]

theorem contMDiff_piT : ContMDiff 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, ℝ) ∞ piT := by
  intro x
  have hx : x ∈ (chartAt (Fin 1 → ℝ) x).source := mem_chart_source _ _
  have h1 : ContMDiffAt 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, Fin 1 → ℝ) ∞ (extChartAt 𝓘(ℝ, Fin 1 → ℝ) x) x :=
    contMDiffAt_extChartAt' hx
  have h2 : ContMDiffAt 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, ℝ) ∞ (fun p => (extChartAt 𝓘(ℝ, Fin 1 → ℝ) x p) 0) x :=
    ((by fun_prop : ContDiff ℝ ∞ fun f : Fin 1 → ℝ => f 0).contMDiff.contMDiffAt).comp x h1
  refine h2.congr_of_eventuallyEq ?_
  filter_upwards [(chartAt (Fin 1 → ℝ) x).open_source.mem_nhds hx] with p hp
  exact piT_eq_chart x p hp

theorem hasMFDerivAt_piT (x : TwoOrigins) :
    HasMFDerivAt 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, ℝ) piT x
      ((ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 1 => ℝ) 0).comp
        (mfderiv 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, Fin 1 → ℝ) (chartAt (Fin 1 → ℝ) x) x)) := by
  have hx : x ∈ (chartAt (Fin 1 → ℝ) x).source := mem_chart_source _ _
  have h1 := hasMFDerivAt_extChartAt (I := 𝓘(ℝ, Fin 1 → ℝ)) hx
  have h2 : HasMFDerivAt 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, ℝ) (fun f : Fin 1 → ℝ => f 0) (extChartAt 𝓘(ℝ, Fin 1 → ℝ) x x)
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 1 => ℝ) 0) :=
    (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 1 => ℝ) 0).hasFDerivAt.hasMFDerivAt
  have h3 := h2.comp x h1
  refine h3.congr_of_eventuallyEq ?_
  filter_upwards [(chartAt (Fin 1 → ℝ) x).open_source.mem_nhds hx] with p hp
  exact piT_eq_chart x p hp

theorem mfderiv_piT (x : TwoOrigins) (v : TangentSpace 𝓘(ℝ, Fin 1 → ℝ) x) :
    mfderiv 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, ℝ) piT x v = (v : Fin 1 → ℝ) 0 := by
  rw [(hasMFDerivAt_piT x).mfderiv]
  have hx : x ∈ (chartAt (Fin 1 → ℝ) x).source := mem_chart_source _ _
  have h4 := mfderiv_chartAt_eq_tangentCoordChange (I := 𝓘(ℝ, Fin 1 → ℝ)) hx
  have h5 : tangentCoordChange 𝓘(ℝ, Fin 1 → ℝ) x x x (v : Fin 1 → ℝ) = (v : Fin 1 → ℝ) :=
    tangentCoordChange_self (I := 𝓘(ℝ, Fin 1 → ℝ)) (x := x) (z := x) (v := v)
      (by simp [extChartAt])
  have h6 : (mfderiv 𝓘(ℝ, Fin 1 → ℝ) 𝓘(ℝ, Fin 1 → ℝ) (chartAt (Fin 1 → ℝ) x) x) v = (v : Fin 1 → ℝ) := by
    rw [h4]; exact h5
  exact congrArg (fun f : Fin 1 → ℝ => f 0) h6

/-- **The metric `dx²` of the line with two origins**: the pullback of the product of reals by `piT`
(both origins carry the metric `dx²` of the line). -/
def twoOriginsMetric : NondegMetric 𝓘(ℝ, Fin 1 → ℝ) TwoOrigins where
  g := pullbackForm (I := 𝓘(ℝ, Fin 1 → ℝ)) (ContinuousLinearMap.mul ℝ ℝ) piT
  symm x v w := pullbackForm_symm (fun a b => mul_comm a b) _ x v w
  nondegenerate x v h := by
    have h0 := h v
    rw [pullbackForm_apply] at h0
    have h1 : dι (I := 𝓘(ℝ, Fin 1 → ℝ)) piT x v = (v : Fin 1 → ℝ) 0 := mfderiv_piT x v
    rw [h1] at h0
    have h2 : (v : Fin 1 → ℝ) 0 = 0 := mul_self_eq_zero.1 h0
    exact funext fun i => by simp [Subsingleton.elim i 0, h2]; rfl
  contMDiff := contMDiff_pullbackForm _ contMDiff_piT

section Identities

variable (cov : Connection 𝓘(ℝ, Fin 1 → ℝ) TwoOrigins) [LocallySmoothConnectionW cov]

/-- **The identities of the Corners layer on a non-Hausdorff manifold**: for a locally smooth Levi-Civita connection of
`twoOriginsMetric` on the line with two origins, at every point (both origins included), the first and second Bianchi
identities, the pair symmetry, the symmetry of the Ricci tensor and the vanishing divergence of the Einstein tensor. -/
theorem twoOrigins_identities (h : cov.IsLeviCivita twoOriginsMetric) (x : TwoOrigins) :
    (∀ X Y Z : TangentSpace 𝓘(ℝ, Fin 1 → ℝ) x,
      cov.curvatureAt x X Y Z + cov.curvatureAt x Y Z X + cov.curvatureAt x Z X Y = 0) ∧
    (∀ X Y Z W : TangentSpace 𝓘(ℝ, Fin 1 → ℝ) x,
      cov.riemannLowerAt twoOriginsMetric x X Y Z W = cov.riemannLowerAt twoOriginsMetric x Z W X Y) ∧
    (∀ Y Z : TangentSpace 𝓘(ℝ, Fin 1 → ℝ) x, cov.ricciAt x Y Z = cov.ricciAt x Z Y) ∧
    (∀ X Y Z W : TangentSpace 𝓘(ℝ, Fin 1 → ℝ) x,
      cov.covDerivCurvatureAt x X Y Z W + cov.covDerivCurvatureAt x Y Z X W +
        cov.covDerivCurvatureAt x Z X Y W = 0) ∧
    (∀ w : TangentSpace 𝓘(ℝ, Fin 1 → ℝ) x,
      cov.divBilinAt twoOriginsMetric (cov.einsteinField twoOriginsMetric) x w = 0) :=
  ⟨fun X Y Z => bianchi_first_provedW cov h.1 x X Y Z,
    fun X Y Z W => riemannLowerAt_pair_symmW cov twoOriginsMetric h.1 h.2 x X Y Z W,
    fun Y Z => ricciAt_symm_provedW cov twoOriginsMetric h.1 h.2 x Y Z,
    fun X Y Z W => bianchi_second_provedW cov h.1 x X Y Z W,
    fun w => einstein_divergence_free_provedW twoOriginsMetric cov x h w⟩

end Identities

/-- **Non-vacuity**: the Levi-Civita connection of `twoOriginsMetric` is locally smooth and Levi-Civita, so the identities
apply to it on the non-Hausdorff manifold. -/
theorem twoOrigins_exists_leviCivita :
    ∃ cov : Connection 𝓘(ℝ, Fin 1 → ℝ) TwoOrigins,
      LocallySmoothConnectionW cov ∧ cov.IsLeviCivita twoOriginsMetric :=
  ⟨leviCivita twoOriginsMetric, inferInstance, ⟨leviCivita_torsion _, leviCivita_compat _⟩⟩

end Lightlike
