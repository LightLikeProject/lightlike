import Mathlib.Analysis.Calculus.FDeriv.Symmetric
import Mathlib.Analysis.Normed.Operator.NormedSpace

/-!
# The generator of a one-parameter family of isometries is a Killing field (G3-004)

Carroll (gr-qc/9712019, eqs. (5.39)-(5.41)): "If a one-parameter family of isometries is generated by a vector field `V`,
then `V` is known as a Killing vector field", `£_V g = 0`. In coordinates on a real Banach space `E`, with the metric a
field of bilinear forms `G : E → E →L E →L ℝ`: for a `C²` map `Φ(s, y)` with `Φ(0, ·) = id` whose maps `Φ(s, ·)` preserve
`G` at `p` (`G(Φ(s, p))(D_yΦ u, D_yΦ w) = G(p)(u, w)` for `s` near `0`), the generator `X(y) = ∂_sΦ(0, y)` satisfies
Killing's equation at `p`: `DG(p)(X p)(u, w) + G(p)(DX(p) u, w) + G(p)(u, DX(p) w) = 0` (`killing_of_isometry_family`),
and on every set where the maps preserve `G` (`killing_of_isometry_family_on`).
The proof differentiates the isometry condition at `s = 0`; the derivative of `D_yΦ(s, p)` in `s` is `DX(p)` by the symmetry
of the second derivative of `Φ`.
-/

open Set Filter Topology

namespace Lightlike

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- `D_yΦ(0, y) = id` when `Φ(0, ·) = id`. -/
theorem fderiv_apply_inr_of_id {Φ : ℝ × E → E} (h0 : ∀ y, Φ (0, y) = y) {y : E}
    (hΦ : DifferentiableAt ℝ Φ (0, y)) (u : E) : fderiv ℝ Φ (0, y) (0, u) = u := by
  have h1 : HasFDerivAt (fun z : E => Φ (0, z)) ((fderiv ℝ Φ (0, y)).comp (ContinuousLinearMap.inr ℝ ℝ E)) y :=
    hΦ.hasFDerivAt.comp y (hasFDerivAt_prodMk_right (0 : ℝ) y)
  have h2 : (fun z : E => Φ (0, z)) = id := funext h0
  rw [h2] at h1
  have := (hasFDerivAt_id y).unique h1
  have := congrArg (fun L => L u) this
  simpa using this.symm

set_option maxSynthPendingDepth 3 in
/-- **The generator of a one-parameter family of isometries is Killing.** -/
theorem killing_of_isometry_family (G : E → E →L[ℝ] E →L[ℝ] ℝ) {Φ : ℝ × E → E} {p : E}
    (hΦ : ContDiffAt ℝ 2 Φ (0, p)) (h0 : ∀ y, Φ (0, y) = y)
    (hiso : ∀ᶠ s in 𝓝 (0 : ℝ), ∀ u w : E,
      G (Φ (s, p)) (fderiv ℝ Φ (s, p) (0, u)) (fderiv ℝ Φ (s, p) (0, w)) = G p u w)
    (hG : DifferentiableAt ℝ G p) (u w : E) :
    fderiv ℝ G p (fderiv ℝ Φ (0, p) (1, 0)) u w +
        G p (fderiv ℝ (fun y => fderiv ℝ Φ (0, y) (1, 0)) p u) w +
        G p u (fderiv ℝ (fun y => fderiv ℝ Φ (0, y) (1, 0)) p w) = 0 := by
  have hΦd : DifferentiableAt ℝ Φ (0, p) := hΦ.differentiableAt (by norm_num)
  have hDΦ : DifferentiableAt ℝ (fderiv ℝ Φ) (0, p) :=
    (hΦ.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  set D2 := fderiv ℝ (fderiv ℝ Φ) (0, p)
  have hsymm : ∀ v v', D2 v v' = D2 v' v := fun v v' => hΦ.isSymmSndFDerivAt (by simp) v v'
  have hp : Φ (0, p) = p := h0 p
  -- the path `s ↦ (s, p)`
  have hγ : ∀ s, HasDerivAt (fun s : ℝ => ((s, p) : ℝ × E)) ((1 : ℝ), (0 : E)) s := fun s =>
    (hasDerivAt_id s).prodMk (hasDerivAt_const s p)
  -- derivative at `0` of `s ↦ G(Φ(s, p))`
  have hA : HasDerivAt (fun s => G (Φ (s, p))) (fderiv ℝ G p (fderiv ℝ Φ (0, p) (1, 0))) 0 := by
    have h1 : HasDerivAt (fun s => Φ (s, p)) (fderiv ℝ Φ (0, p) (1, 0)) 0 :=
      HasFDerivAt.comp_hasDerivAt (l := Φ) (f := fun s : ℝ => ((s, p) : ℝ × E)) 0 hΦd.hasFDerivAt (hγ 0)
    rw [← hp] at hG
    have := HasFDerivAt.comp_hasDerivAt (l := G) (f := fun s => Φ (s, p)) 0 hG.hasFDerivAt h1
    rw [hp] at this
    exact this
  -- derivative at `0` of `s ↦ D_yΦ(s, p)`
  have hB : HasDerivAt (fun s => fderiv ℝ Φ (s, p)) (D2 (1, 0)) 0 :=
    HasFDerivAt.comp_hasDerivAt (l := fderiv ℝ Φ) (f := fun s : ℝ => ((s, p) : ℝ × E)) 0 hDΦ.hasFDerivAt (hγ 0)
  have hBu := hB.clm_apply (hasDerivAt_const 0 ((0 : ℝ), u))
  have hBw := hB.clm_apply (hasDerivAt_const 0 ((0 : ℝ), w))
  have hf := (hA.clm_apply hBu).clm_apply hBw
  -- the function is constant near `0`
  have hc : HasDerivAt (fun s => G (Φ (s, p)) (fderiv ℝ Φ (s, p) (0, u)) (fderiv ℝ Φ (s, p) (0, w))) 0 0 := by
    have : (fun s => G (Φ (s, p)) (fderiv ℝ Φ (s, p) (0, u)) (fderiv ℝ Φ (s, p) (0, w))) =ᶠ[𝓝 0]
        fun _ => G p u w := hiso.mono fun s hs => hs u w
    exact (hasDerivAt_const 0 (G p u w)).congr_of_eventuallyEq this
  have heq := hf.unique hc
  -- the derivative of the generator
  have hX : ∀ v, fderiv ℝ (fun y => fderiv ℝ Φ (0, y) (1, 0)) p v = D2 (0, v) (1, 0) := by
    intro v
    have h1 : HasFDerivAt (fun y : E => fderiv ℝ Φ (0, y)) (D2.comp (ContinuousLinearMap.inr ℝ ℝ E)) p :=
      hDΦ.hasFDerivAt.comp p (hasFDerivAt_prodMk_right (0 : ℝ) p)
    have h2 := h1.clm_apply (hasFDerivAt_const ((1 : ℝ), (0 : E)) p)
    rw [h2.fderiv]
    simp
  rw [hX u, hX w]
  have hu := fderiv_apply_inr_of_id h0 hΦd u
  have hw := fderiv_apply_inr_of_id h0 hΦd w
  simp only [hu, hw, map_zero, add_zero, add_apply] at heq
  rw [hp, hsymm (1, 0) (0, u), hsymm (1, 0) (0, w)] at heq
  linarith

set_option maxSynthPendingDepth 3 in
/-- **On an open set**: if the maps `Φ(s, ·)` preserve `G` at every point of a set `U` for `s` near `0`, the generator satisfies
Killing's equation on `U` (Carroll's (5.41), `£_V g = 0`, in coordinates). -/
theorem killing_of_isometry_family_on (G : E → E →L[ℝ] E →L[ℝ] ℝ) {Φ : ℝ × E → E} {U : Set E}
    (hΦ : ∀ p ∈ U, ContDiffAt ℝ 2 Φ (0, p)) (h0 : ∀ y, Φ (0, y) = y)
    (hiso : ∀ p ∈ U, ∀ᶠ s in 𝓝 (0 : ℝ), ∀ u w : E,
      G (Φ (s, p)) (fderiv ℝ Φ (s, p) (0, u)) (fderiv ℝ Φ (s, p) (0, w)) = G p u w)
    (hG : ∀ p ∈ U, DifferentiableAt ℝ G p) :
    ∀ p ∈ U, ∀ u w : E, fderiv ℝ G p (fderiv ℝ Φ (0, p) (1, 0)) u w +
        G p (fderiv ℝ (fun y => fderiv ℝ Φ (0, y) (1, 0)) p u) w +
        G p u (fderiv ℝ (fun y => fderiv ℝ Φ (0, y) (1, 0)) p w) = 0 := fun p hp u w =>
  killing_of_isometry_family G (hΦ p hp) h0 (hiso p hp) (hG p hp) u w

end Lightlike
