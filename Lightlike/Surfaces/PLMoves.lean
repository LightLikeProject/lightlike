import Lightlike.Surfaces.PLBridge
import Lightlike.PL.PachnerMoves

/-!
# Bistellar moves on the triangles of a surface

A bistellar move on the complex generated by a family of triangles that is a closed combinatorial
2-manifold is one of the 2D moves of `Lightlike/PonzanoRegge/` (a triangle subdivided by a new
vertex, an edge flipped, and the inverse of a subdivision). This is the two-dimensional case of
`exists_move3`, and gives the converse of `stellarEquiv_of_eqvGen_move2`.

## Main results

* `exists_move2`: a bistellar move on the closure of a family of triangles is a 2D move.
-/

open Finset Lightlike.PR Lightlike.PL Lightlike.PL.SComplex

namespace Lightlike.Surfaces

variable {V : Type*} [DecidableEq V]

/-- The triangles around a bistellar move `κ(σ, τ)` with `#σ + #τ = 4` on the complex generated by
triangles. -/
lemma move2_data {L : Finset (Finset V)} (hT : IsTri2 L) {σ τ : Finset V}
    (h : (closure L).IsBistellar σ τ) (hc : #σ + #τ = 4) :
    (∀ v ∈ τ, (σ ∪ τ).erase v ∈ L) ∧
      (∀ t ∈ L, σ ⊆ t → ∃ v ∈ τ, t = (σ ∪ τ).erase v) ∧ (∀ t ∈ L, ¬ τ ⊆ t) := by
  refine ⟨fun v hv => ?_, fun s hs hσs => ?_, fun s hs hτs => h.notMem (mem_closure.2 ⟨s, hs, hτs⟩)⟩
  · have hl : τ.erase v ∈ (closure L).link σ := by
      rw [h.link_eq, mem_boundary]
      exact erase_ssubset hv
    obtain ⟨-, -, hK⟩ := mem_link.1 hl
    obtain ⟨s, hs, hsub⟩ := mem_closure.1 hK
    have hvσ : v ∉ σ := disjoint_right.1 h.disjoint hv
    rw [Lightlike.PL.union_erase_of_notMem hvσ]
    have hcard : #(σ ∪ τ.erase v) = 3 := by
      rw [card_union_of_disjoint (disjoint_of_subset_right (erase_subset v τ) h.disjoint),
        card_erase_of_mem hv]
      have := card_pos.2 h.nonempty_right
      omega
    rw [eq_of_subset_of_card_le hsub (by rw [hT s hs, hcard])]
    exact hs
  · have hsK : σ ∪ s \ σ ∈ closure L := by
      rw [union_sdiff_of_subset hσs]
      exact mem_closure.2 ⟨s, hs, subset_rfl⟩
    have hsl : s \ σ ∈ (closure L).link σ := mem_link'.2 ⟨disjoint_sdiff, hsK⟩
    rw [h.link_eq, mem_boundary] at hsl
    have hc' : #(s \ σ) + 1 = #τ := by
      rw [card_sdiff_of_subset hσs, hT s hs]
      have := card_le_card hσs
      rw [hT s hs] at this
      omega
    obtain ⟨v, hv, hvs⟩ := not_subset.1 hsl.not_subset
    refine ⟨v, hv, ?_⟩
    have he : s \ σ = τ.erase v := eq_of_subset_of_card_le
      (fun x hx => mem_erase.2 ⟨fun e => hvs (e ▸ hx), hsl.subset hx⟩)
      (by rw [card_erase_of_mem hv]; omega)
    rw [Lightlike.PL.union_erase_of_notMem (disjoint_right.1 h.disjoint hv), ← he, union_sdiff_of_subset hσs]

/-- The result of a bistellar move `κ(σ, τ)` on the triangles of `L`, as generating triangles. -/
def bnew (L : Finset (Finset V)) (σ τ : Finset V) : Finset (Finset V) :=
  L.filter (fun t => ¬ σ ⊆ t) ∪ σ.image (fun y => σ.erase y ∪ τ)

/-- The facts about a bistellar move on triangles used to read it as a 2D move. -/
structure MoveData (L : Finset (Finset V)) (σ τ : Finset V) : Prop where
  tri : IsTri2 L
  disj : Disjoint σ τ
  mem : ∀ x ∈ τ, σ ∪ τ.erase x ∈ L
  star : ∀ t ∈ L, σ ⊆ t → ∃ x ∈ τ, t ⊆ σ ∪ τ.erase x
  fresh : ∀ t ∈ L, ¬ τ ⊆ t

/-- **An edge flip**: `κ({b, c}, {d, e})` on triangles is a move `flip22`. -/
lemma eqvGen_bnew_flip {L : Finset (Finset V)} {b c d e : V} (hD : MoveData L {b, c} {d, e})
    (hbc : b ≠ c) (hde : d ≠ e) : Relation.EqvGen Move2 L (bnew L {b, c} {d, e}) := by
  have hdis := hD.disj
  have hne : ∀ x ∈ ({b, c} : Finset V), ∀ y ∈ ({d, e} : Finset V), x ≠ y :=
    fun x hx y hy e' => disjoint_left.1 hdis hx (e' ▸ hy)
  have hbd : b ≠ d := hne b (by simp) d (by simp)
  have hbe : b ≠ e := hne b (by simp) e (by simp)
  have hcd : c ≠ d := hne c (by simp) d (by simp)
  have hce : c ≠ e := hne c (by simp) e (by simp)
  have eD : ({b, c} : Finset V) ∪ ({d, e} : Finset V).erase d = {b, c, e} := by
    clear * - hbc hbd hbe hcd hce hde
    vset_eq
  have eE : ({b, c} : Finset V) ∪ ({d, e} : Finset V).erase e = {b, c, d} := by
    clear * - hbc hbd hbe hcd hce hde
    vset_eq
  have h₁ : ({b, c, d} : Finset V) ∈ L := by
    have := hD.mem e (by simp)
    rwa [eE] at this
  have h₂ : ({b, c, e} : Finset V) ∈ L := by
    have := hD.mem d (by simp)
    rwa [eD] at this
  have hstar'' : ∀ t ∈ L, {b, c} ⊆ t → t = {b, c, d} ∨ t = {b, c, e} := by
    intro t ht hsub
    obtain ⟨v, hv, hsub'⟩ := hD.star t ht hsub
    have htv : t = {b, c} ∪ ({d, e} : Finset V).erase v := eq_of_subset_of_card_le hsub'
      (by rw [hD.tri t ht, card_union_of_disjoint (disjoint_of_subset_right (erase_subset v _) hdis),
        card_erase_of_mem hv, card_pair hbc, card_pair hde])
    rcases mem_insert.1 hv with hvd | hve
    · exact Or.inr (by rw [htv, hvd, eD])
    · exact Or.inl (by rw [htv, mem_singleton.1 hve, eE])
  have hm := Move2.flip22 (L := L) hbc hbd hbe hcd hce hde h₁ h₂ hstar'' hD.fresh
  have hf : L.filter (fun t => ¬ ({b, c} : Finset V) ⊆ t) =
      (L.erase {b, c, d}).erase {b, c, e} := by
    ext t
    simp only [mem_filter, mem_erase]
    constructor
    · rintro ⟨ht, hn⟩
      refine ⟨?_, ?_, ht⟩ <;> rintro rfl <;>
        exact hn (by intro z; simp only [mem_insert, mem_singleton]; tauto)
    · rintro ⟨h₁', h₂', ht⟩
      exact ⟨ht, fun hs => (hstar'' t ht hs).elim h₂' h₁'⟩
  have e₁ : ({b, c} : Finset V).erase b ∪ {d, e} = {c, d, e} := by
    clear * - hbc hbd hbe hcd hce hde
    vset_eq
  have e₂ : ({b, c} : Finset V).erase c ∪ {d, e} = {b, d, e} := by
    clear * - hbc hbd hbe hcd hce hde
    vset_eq
  have hL'eq : bnew L {b, c} {d, e} =
      insert {b, d, e} (insert {c, d, e} ((L.erase {b, c, d}).erase {b, c, e})) := by
    rw [bnew, hf, image_insert, image_singleton, e₁, e₂]
    ext t
    simp only [mem_union, mem_insert, mem_singleton]
    tauto
  rw [hL'eq]
  exact Relation.EqvGen.rel _ _ hm

/-- **A triangle is subdivided**: `κ({b, c, d}, {x})` on triangles is a move `sub13`. -/
lemma eqvGen_bnew_sub {L : Finset (Finset V)} {b c d x : V} (hD : MoveData L {b, c, d} {x})
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    Relation.EqvGen Move2 L (bnew L {b, c, d} {x}) := by
  have hdis := hD.disj
  have hne : ∀ y ∈ ({b, c, d} : Finset V), y ≠ x := fun y hy e' =>
    disjoint_left.1 hdis hy (e' ▸ mem_singleton_self y)
  have hxb : b ≠ x := hne b (by simp)
  have hxc : c ≠ x := hne c (by simp)
  have hxd : d ≠ x := hne d (by simp)
  have hσL : ({b, c, d} : Finset V) ∈ L := by
    have := hD.mem x (mem_singleton_self x)
    rwa [erase_singleton, union_empty] at this
  have hx : x ∉ verts2 L := fun hxv => by
    obtain ⟨t, ht, hxt⟩ := mem_verts2.1 hxv
    exact hD.fresh t ht (singleton_subset_iff.2 hxt)
  have hm := Move2.sub13 (L := L) hbc hbd hcd hσL hx
  have e₁ : ({b, c, d} : Finset V).erase b ∪ {x} = {c, d, x} := by
    clear * - hbc hbd hcd hxb hxc hxd
    vset_eq
  have e₂ : ({b, c, d} : Finset V).erase c ∪ {x} = {b, d, x} := by
    clear * - hbc hbd hcd hxb hxc hxd
    vset_eq
  have e₃ : ({b, c, d} : Finset V).erase d ∪ {x} = {b, c, x} := by
    clear * - hbc hbd hcd hxb hxc hxd
    vset_eq
  have hf : L.filter (fun t => ¬ ({b, c, d} : Finset V) ⊆ t) = L.erase {b, c, d} := by
    ext t
    simp only [mem_filter, mem_erase]
    constructor
    · rintro ⟨ht, hn⟩
      exact ⟨by rintro rfl; exact hn subset_rfl, ht⟩
    · rintro ⟨h₁', ht⟩
      exact ⟨ht, fun hs => h₁' (eq_of_subset_of_card_le hs
        (by rw [hD.tri t ht, card_three hbc hbd hcd])).symm⟩
  have hL'eq : bnew L {b, c, d} {x} =
      insert {b, c, x} (insert {c, d, x} (insert {b, d, x} (L.erase {b, c, d}))) := by
    rw [bnew, hf, image_insert, image_insert, image_singleton, e₁, e₂, e₃]
    ext t
    simp only [mem_union, mem_insert, mem_singleton]
    tauto
  rw [hL'eq]
  exact Relation.EqvGen.rel _ _ hm

/-- **A triangle subdivision is undone**: `κ({a}, {b, c, d})` on triangles is the inverse of a move
`sub13`. -/
lemma eqvGen_bnew_unsub {L : Finset (Finset V)} {a b c d : V} (hD : MoveData L {a} {b, c, d})
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    Relation.EqvGen Move2 L (bnew L {a} {b, c, d}) := by
  have hdis := hD.disj
  have hne : ∀ y ∈ ({b, c, d} : Finset V), a ≠ y := fun y hy e' =>
    disjoint_left.1 hdis (mem_singleton_self a) (e' ▸ hy)
  have hab : a ≠ b := hne b (by simp)
  have hac : a ≠ c := hne c (by simp)
  have had : a ≠ d := hne d (by simp)
  set L' : Finset (Finset V) := bnew L {a} {b, c, d} with hL'
  have hL'eq : L' = insert {b, c, d} (L.filter (fun t => ¬ ({a} : Finset V) ⊆ t)) := by
    rw [hL', bnew, image_singleton, erase_singleton, empty_union, union_comm]
    rfl
  have hτL : ({b, c, d} : Finset V) ∉ L := fun h => hD.fresh _ h subset_rfl
  have hτ : ({b, c, d} : Finset V) ∈ L' := by rw [hL'eq]; exact mem_insert_self _ _
  have hx : a ∉ verts2 L' := by
    intro hxv
    obtain ⟨t, ht, hat⟩ := mem_verts2.1 hxv
    rw [hL'eq, mem_insert, mem_filter] at ht
    rcases ht with rfl | ⟨-, hn⟩
    · simp only [mem_insert, mem_singleton] at hat
      rcases hat with h | h | h
      · exact hab h
      · exact hac h
      · exact had h
    · exact hn (singleton_subset_iff.2 hat)
  have hm := Move2.sub13 (L := L') hbc hbd hcd hτ hx
  have hLeq : insert ({b, c, a} : Finset V) (insert {c, d, a} (insert {b, d, a}
      (L'.erase {b, c, d}))) = L := by
    have hera : L'.erase {b, c, d} = L.filter (fun t => ¬ ({a} : Finset V) ⊆ t) := by
      rw [hL'eq, erase_insert (fun h => hτL (mem_of_mem_filter _ h))]
    have fb : ({a} : Finset V) ∪ ({b, c, d} : Finset V).erase b = {c, d, a} := by
      clear * - hab hac had hbc hbd hcd
      vset_eq
    have fc : ({a} : Finset V) ∪ ({b, c, d} : Finset V).erase c = {b, d, a} := by
      clear * - hab hac had hbc hbd hcd
      vset_eq
    have fd : ({a} : Finset V) ∪ ({b, c, d} : Finset V).erase d = {b, c, a} := by
      clear * - hab hac had hbc hbd hcd
      vset_eq
    have mb : ({c, d, a} : Finset V) ∈ L := by
      have := hD.mem b (by simp); rwa [fb] at this
    have mc : ({b, d, a} : Finset V) ∈ L := by
      have := hD.mem c (by simp); rwa [fc] at this
    have md : ({b, c, a} : Finset V) ∈ L := by
      have := hD.mem d (by simp); rwa [fd] at this
    rw [hera]
    ext t
    simp only [mem_insert, mem_filter]
    constructor
    · rintro (rfl | rfl | rfl | ⟨ht, -⟩)
      · exact md
      · exact mb
      · exact mc
      · exact ht
    · intro ht
      by_cases hat : a ∈ t
      · obtain ⟨v, hv, hsub⟩ := hD.star t ht (singleton_subset_iff.2 hat)
        have htv : t = {a} ∪ ({b, c, d} : Finset V).erase v := eq_of_subset_of_card_le hsub
          (by rw [hD.tri t ht, card_union_of_disjoint (disjoint_of_subset_right (erase_subset v _) hdis),
            card_erase_of_mem hv, card_singleton, card_three hbc hbd hcd])
        simp only [mem_insert, mem_singleton] at hv
        rcases hv with rfl | rfl | rfl
        · exact Or.inr (Or.inl (by rw [htv, fb]))
        · exact Or.inr (Or.inr (Or.inl (by rw [htv, fc])))
        · exact Or.inl (by rw [htv, fd])
      · exact Or.inr (Or.inr (Or.inr ⟨ht, fun hs => hat (singleton_subset_iff.1 hs)⟩))
  exact Relation.EqvGen.symm _ _ (hLeq ▸ Relation.EqvGen.rel _ _ hm)

/-- **A bistellar move on the closure of triangles is a chain of 2D moves.** -/
theorem exists_move2 {L : Finset (Finset V)} (hT : IsTri2 L) {σ τ : Finset V}
    (h : (closure L).IsBistellar σ τ) (hc : #σ + #τ = 4) :
    IsTri2 (bnew L σ τ) ∧ Relation.EqvGen Move2 L (bnew L σ τ) ∧
      closure (bnew L σ τ) = (closure L).bistellar σ τ h := by
  obtain ⟨hmem, hstar, hfresh⟩ := move2_data hT h hc
  have hσ := card_pos.2 h.nonempty_left
  have hτ := card_pos.2 h.nonempty_right
  have hdis := h.disjoint
  have hmem' : ∀ x ∈ τ, σ ∪ τ.erase x ∈ L := fun x hx => by
    have := hmem x hx
    rwa [Lightlike.PL.union_erase_of_notMem (disjoint_right.1 hdis hx)] at this
  have hstar' : ∀ t ∈ L, σ ⊆ t → ∃ x ∈ τ, t ⊆ σ ∪ τ.erase x := fun t ht hst => by
    obtain ⟨v, hv, rfl⟩ := hstar t ht hst
    exact ⟨v, hv, (Lightlike.PL.union_erase_of_notMem (disjoint_right.1 hdis hv)).le⟩
  have hD : MoveData L σ τ := ⟨hT, hdis, hmem', hstar', hfresh⟩
  refine ⟨?_, ?_, (bistellar_closure h.nonempty_left h.nonempty_right hdis hmem' hstar' hfresh).symm⟩
  · intro t ht
    rw [bnew, mem_union, mem_image, mem_filter] at ht
    rcases ht with ⟨ht, -⟩ | ⟨y, hy, rfl⟩
    · exact hT t ht
    · rw [card_union_of_disjoint (disjoint_of_subset_left (erase_subset y σ) hdis),
        card_erase_of_mem hy]
      omega
  · rcases (show #σ = 1 ∨ #σ = 2 ∨ #σ = 3 by omega) with h1 | h1 | h1
    · obtain ⟨a, rfl⟩ := card_eq_one.1 h1
      obtain ⟨b, c, d, hbc, hbd, hcd, rfl⟩ := card_eq_three.1 (by omega : #τ = 3)
      exact eqvGen_bnew_unsub hD hbc hbd hcd
    · obtain ⟨b, c, hbc, rfl⟩ := card_eq_two.1 h1
      obtain ⟨d, e, hde, rfl⟩ := card_eq_two.1 (by omega : #τ = 2)
      exact eqvGen_bnew_flip hD hbc hde
    · obtain ⟨b, c, d, hbc, hbd, hcd, rfl⟩ := card_eq_three.1 h1
      obtain ⟨x, rfl⟩ := card_eq_one.1 (by omega : #τ = 1)
      exact eqvGen_bnew_sub hD hbc hbd hcd

end Lightlike.Surfaces
