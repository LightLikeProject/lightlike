import Lightlike.PL.Cycle
import Lightlike.PL.Surface
import Lightlike.Surfaces.Classify

/-!
# Closed surfaces are closed combinatorial 2-manifolds

The triangles of a closed combinatorial surface (`IsSurface`) generate a closed combinatorial
2-manifold of `Lightlike/PL/`: the link of every vertex is a cycle, which is a PL 1-sphere.

## Main results

* `isCycleGraph_lk2`: the link of a vertex of a closed surface is a cycle graph.
* `IsSurface.isClosedCombManifold`: the complex generated by a closed surface is a closed
  combinatorial 2-manifold.
-/

open Finset Lightlike.PR Lightlike.PL

namespace Lightlike.Surfaces

variable {V : Type*} [DecidableEq V]

/-- **The link of a vertex of a closed surface is a cycle graph.** -/
theorem isCycleGraph_lk2 {L : Finset (Finset V)} (hS : IsSurface L) {v : V}
    (hv : v ∈ verts2 L) : CycleGraph (lk2 L v) := by
  have htri : ∀ e ∈ lk2 L v, #e = 2 := fun e he => by
    obtain ⟨hve, hL⟩ := mem_lk2.1 he
    have := hS.card _ hL
    rw [card_insert_of_notMem hve] at this
    omega
  refine ⟨?_, htri, ?_, hS.link v hv⟩
  · obtain ⟨τ, hτ, hvτ⟩ := mem_verts2.1 hv
    exact ⟨τ.erase v, mem_lk2.2 ⟨notMem_erase v τ, by rwa [insert_erase hvτ]⟩⟩
  · intro x hx
    obtain ⟨e, he, hxe⟩ := mem_verts2.1 hx
    obtain ⟨hve, hL⟩ := mem_lk2.1 he
    have hxv : v ≠ x := fun h => hve (h ▸ hxe)
    have hf : ({v, x} : Finset V) ∈ edges2 L :=
      pair_mem_edges2 hL (mem_insert_self v e) (mem_insert_of_mem hxe) hxv
    have h2 := hS.closed _ hf
    rw [← h2]
    have hset : L.filter (({v, x} : Finset V) ⊆ ·) = ((lk2 L v).filter (x ∈ ·)).image (insert v) := by
      ext τ
      simp only [mem_filter, mem_image, mem_lk2]
      constructor
      · rintro ⟨hτ, hsub⟩
        have hvτ : v ∈ τ := hsub (by simp)
        have hxτ : x ∈ τ := hsub (by simp)
        refine ⟨τ.erase v, ⟨⟨notMem_erase v τ, by rwa [insert_erase hvτ]⟩, ?_⟩, insert_erase hvτ⟩
        exact mem_erase.2 ⟨hxv.symm, hxτ⟩
      · rintro ⟨e', ⟨⟨hve', hL'⟩, hxe'⟩, rfl⟩
        refine ⟨hL', fun z hz => ?_⟩
        simp only [mem_insert, mem_singleton] at hz
        rcases hz with rfl | rfl
        · exact mem_insert_self _ _
        · exact mem_insert_of_mem hxe'
    rw [hset, card_image_of_injOn]
    intro a ha b hb hab
    have ha' := (mem_lk2.1 (mem_filter.1 ha).1).1
    have hb' := (mem_lk2.1 (mem_filter.1 hb).1).1
    have := congrArg (·.erase v) hab
    simpa [erase_insert ha', erase_insert hb'] using this

/-- **A closed combinatorial surface generates a closed combinatorial 2-manifold.** -/
theorem IsSurface.isClosedCombManifold {L : Finset (Finset V)} (hS : IsSurface L) :
    SComplex.IsClosedCombManifold 2 (SComplex.closure L) := by
  refine SComplex.isClosedCombManifold_succ_iff.2 fun v hv => ?_
  rw [verts_closure] at hv
  rw [SComplex.link_closure]
  exact (isCycleGraph_lk2 hS hv).isPLSphere

end Lightlike.Surfaces
