import Lightlike.GR.AdSPoincare
import Lightlike.Spacetime.ChartChange
import Lightlike.Spacetime.RiemannSymmetry

/-!
# The inversion isometry of the Poincaré patch of anti-de Sitter space

`x ↦ x/x²` (with `x² = -t² + x₁² + x₂² + z²`) is an isometry of the Poincaré patch `ds² = (L²/z²)(-dt² + dx² + dz²)`
(`adsInversion_isometry`): the Jacobian is `(1/q) (1 - 2 y (ηy)ᵀ/q)`, a `q⁻¹` multiple of an `η`-reflection, and
`z ↦ z/q` compensates the factor `q²` (`q = x²`). On the boundary `z = 0` it is the inversion `x ↦ x/x²` of Minkowski
space `ℝ^{1,2}`, which multiplies the Minkowski metric by `1/(x²)²` (`inversion_conformal_boundary`): a conformal
transformation of the boundary. Translations in `(t, x)` are isometries too (`adsTranslation_isometry`). The special conformal transformations are the conjugates of translations by the inversion (the source's (2.2)):
`specialConformal b = inversion ∘ (· + b) ∘ inversion` is an isometry of the Poincaré patch (`adsSpecialConformal_isometry`) and acts conformally on the
boundary `ℝ^{1,2}` with the factor `1/((x²)² (x'²)²)`, `x' = x/x² + b` (`specialConformal3_conformal`). The explicit form `(x + b x²)/(1 + 2 b·x + b² x²)` of (2.2) is proved
(`specialConformal_eq`, `specialConformal3_eq`).

Gap row GE7 (the conformal action of the isometry group on the boundary, beyond dilations). Source read (pdftotext):
Aharony-Gubser-Maldacena-Ooguri-Oz, arXiv:hep-th/9905111, section 2 (printed p. 31, eqs. (2.1)-(2.2)): conformal transformations are those
changing the metric by a scale factor `g_{μν}(x) → Ω²(x) g_{μν}(x)`, \"the minimal group that includes the Poincaré group as well as the
inversion symmetry `x^μ → x^μ/x²`\"; the conformal group is generated by the Poincaré transformations, the scale transformation (2.1) and the
special conformal transformations (2.2). Here: `inversion_conformal_boundary` is the statement that the inversion multiplies the Minkowski metric by
the scale factor `Ω² = 1/(x²)²`. That the inversion is an isometry of the Poincaré metric (`adsInversion_isometry`) is not stated in the passage read
(the source states the Poincaré metric (2.27) and the dilatation (2.28)).
-/

open Matrix Real

noncomputable section

namespace Lightlike

/-- The Minkowski quadratic form `q(y) = -y₀² + y₁² + y₂² + y₃²` on `ℝ⁴`. -/
def qf (y : Fin 4 → ℝ) : ℝ := -(y 0) ^ 2 + y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2

/-- The inversion `y ↦ y / q(y)`. -/
def inversion (y : Fin 4 → ℝ) : Fin 4 → ℝ := ![y 0 / qf y, y 1 / qf y, y 2 / qf y, y 3 / qf y]

/-- The sign of the metric `η = diag(-1, 1, 1, 1)`. -/
def sg (a : Fin 4) : ℝ := if a = 0 then -1 else 1

lemma pd_qf (y : Fin 4 → ℝ) (a : Fin 4) : pd a qf y = 2 * sg a * y a := by
  have p : ∀ i : Fin 4, pd a (fun z => z i ^ 2) y = if a = i then 2 * y i else 0 := fun i => by
    have h : HasDerivAt (fun t : ℝ => t ^ 2) (2 * y i) (y i) := by simpa using hasDerivAt_pow 2 (y i)
    exact pd_coord (n := 4) i a h
  have d : ∀ i : Fin 4, DifferentiableAt ℝ (fun z : Fin 4 → ℝ => z i ^ 2) y := fun i => by fun_prop
  have e : qf = fun z => ∑ i : Fin 4, sg i * z i ^ 2 := by
    funext z; simp [qf, Fin.sum_univ_four, sg]
  rw [e, pd_sum Finset.univ (f := fun i z => sg i * z i ^ 2) (fun i _ => (d i).const_mul _) a]
  simp only [pd_const_mul _ (d _), p]
  fin_cases a <;> simp [sg, Fin.sum_univ_four]

/-- `∂_a (1/q)`. -/
lemma pd_inv_qf {y : Fin 4 → ℝ} (hq : qf y ≠ 0) (a : Fin 4) :
    pd a (fun z => (qf z)⁻¹) y = -(2 * sg a * y a) / qf y ^ 2 := by
  have dq : DifferentiableAt ℝ qf y := by unfold qf; fun_prop
  have hi : DifferentiableAt ℝ (fun z => (qf z)⁻¹) y := dq.inv hq
  have h1 := pd_mul dq hi a
  have e : (fun z => qf z * (qf z)⁻¹) =ᶠ[nhds y] fun _ => (1 : ℝ) := by
    have : ∀ᶠ z in nhds y, qf z ≠ 0 := dq.continuousAt.eventually_ne hq
    filter_upwards [this] with z hz using mul_inv_cancel₀ hz
  have h2 : pd a (fun z => qf z * (qf z)⁻¹) y = 0 := by rw [pd_congr e, pd_const]
  have h3 : pd a (fun z => qf z * (qf z)⁻¹) y = pd a qf y * (qf y)⁻¹ + qf y * pd a (fun z => (qf z)⁻¹) y := h1
  rw [h2, pd_qf] at h3
  field_simp at h3 ⊢
  linarith

/-- One component of the inversion, differentiated. -/
lemma pd_inversion_comp {y : Fin 4 → ℝ} (hq : qf y ≠ 0) (μ a : Fin 4) :
    pd a (fun z => z μ / qf z) y =
      (if a = μ then (qf y)⁻¹ else 0) + y μ * (-(2 * sg a * y a) / qf y ^ 2) := by
  have dq : DifferentiableAt ℝ qf y := by unfold qf; fun_prop
  have hi : DifferentiableAt ℝ (fun z => (qf z)⁻¹) y := dq.inv hq
  have dc : DifferentiableAt ℝ (fun z : Fin 4 → ℝ => z μ) y := by fun_prop
  have e : (fun z : Fin 4 → ℝ => z μ / qf z) = fun z => z μ * (qf z)⁻¹ := by
    funext z; rw [div_eq_mul_inv]
  rw [e, pd_mul dc hi a, pd_inv_qf hq a, pd_coord (n := 4) μ a (hasDerivAt_id' (y μ))]
  simp

lemma inversion_apply (z : Fin 4 → ℝ) (μ : Fin 4) : inversion z μ = z μ / qf z := by
  fin_cases μ <;> rfl

/-- The Jacobian of the inversion. -/
lemma jac_inversion {y : Fin 4 → ℝ} (hq : qf y ≠ 0) (μ a : Fin 4) :
    jac inversion y μ a = (if a = μ then (qf y)⁻¹ else 0) + y μ * (-(2 * sg a * y a) / qf y ^ 2) := by
  unfold jac
  simp only [inversion_apply]
  exact pd_inversion_comp hq μ a

/-- **The inversion is an isometry of the Poincaré patch.** -/
theorem adsInversion_isometry (L : ℝ) {y : Fin 4 → ℝ} (hq : qf y ≠ 0) (hz : y 3 ≠ 0) :
    pullback (adsMetric L) inversion y = adsMetric L y := by
  have hqe : qf y = -(y 0) ^ 2 + y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2 := rfl
  unfold pullback
  simp only [jac_inversion hq]
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [Fin.sum_univ_four, adsMetric, adsD, inversion, sg, Matrix.diagonal_apply] <;>
    field_simp <;> (try rw [hqe]) <;> ring

/-! ## The boundary: inversion of `ℝ^{1,2}` -/

/-- The Minkowski quadratic form `q(y) = -y₀² + y₁² + y₂²` on `ℝ³`. -/
def qf3 (y : Fin 3 → ℝ) : ℝ := -(y 0) ^ 2 + y 1 ^ 2 + y 2 ^ 2

/-- The inversion3 `y ↦ y / q(y)`. -/
def inversion3 (y : Fin 3 → ℝ) : Fin 3 → ℝ := ![y 0 / qf3 y, y 1 / qf3 y, y 2 / qf3 y]

/-- The sign of the metric `η = diag(-1, 1, 1)`. -/
def sg3 (a : Fin 3) : ℝ := if a = 0 then -1 else 1

lemma pd_qf3 (y : Fin 3 → ℝ) (a : Fin 3) : pd a qf3 y = 2 * sg3 a * y a := by
  have p : ∀ i : Fin 3, pd a (fun z => z i ^ 2) y = if a = i then 2 * y i else 0 := fun i => by
    have h : HasDerivAt (fun t : ℝ => t ^ 2) (2 * y i) (y i) := by simpa using hasDerivAt_pow 2 (y i)
    exact pd_coord (n := 3) i a h
  have d : ∀ i : Fin 3, DifferentiableAt ℝ (fun z : Fin 3 → ℝ => z i ^ 2) y := fun i => by fun_prop
  have e : qf3 = fun z => ∑ i : Fin 3, sg3 i * z i ^ 2 := by
    funext z; simp [qf3, Fin.sum_univ_three, sg3]
  rw [e, pd_sum Finset.univ (f := fun i z => sg3 i * z i ^ 2) (fun i _ => (d i).const_mul _) a]
  simp only [pd_const_mul _ (d _), p]
  fin_cases a <;> simp [sg3, Fin.sum_univ_three]

/-- `∂_a (1/q)`. -/
lemma pd_inv_qf3 {y : Fin 3 → ℝ} (hq : qf3 y ≠ 0) (a : Fin 3) :
    pd a (fun z => (qf3 z)⁻¹) y = -(2 * sg3 a * y a) / qf3 y ^ 2 := by
  have dq : DifferentiableAt ℝ qf3 y := by unfold qf3; fun_prop
  have hi : DifferentiableAt ℝ (fun z => (qf3 z)⁻¹) y := dq.inv hq
  have h1 := pd_mul dq hi a
  have e : (fun z => qf3 z * (qf3 z)⁻¹) =ᶠ[nhds y] fun _ => (1 : ℝ) := by
    have : ∀ᶠ z in nhds y, qf3 z ≠ 0 := dq.continuousAt.eventually_ne hq
    filter_upwards [this] with z hz using mul_inv_cancel₀ hz
  have h2 : pd a (fun z => qf3 z * (qf3 z)⁻¹) y = 0 := by rw [pd_congr e, pd_const]
  have h3 : pd a (fun z => qf3 z * (qf3 z)⁻¹) y = pd a qf3 y * (qf3 y)⁻¹ + qf3 y * pd a (fun z => (qf3 z)⁻¹) y := h1
  rw [h2, pd_qf3] at h3
  field_simp at h3 ⊢
  linarith

/-- One component of the inversion3, differentiated. -/
lemma pd_inversion3_comp {y : Fin 3 → ℝ} (hq : qf3 y ≠ 0) (μ a : Fin 3) :
    pd a (fun z => z μ / qf3 z) y =
      (if a = μ then (qf3 y)⁻¹ else 0) + y μ * (-(2 * sg3 a * y a) / qf3 y ^ 2) := by
  have dq : DifferentiableAt ℝ qf3 y := by unfold qf3; fun_prop
  have hi : DifferentiableAt ℝ (fun z => (qf3 z)⁻¹) y := dq.inv hq
  have dc : DifferentiableAt ℝ (fun z : Fin 3 → ℝ => z μ) y := by fun_prop
  have e : (fun z : Fin 3 → ℝ => z μ / qf3 z) = fun z => z μ * (qf3 z)⁻¹ := by
    funext z; rw [div_eq_mul_inv]
  rw [e, pd_mul dc hi a, pd_inv_qf3 hq a, pd_coord (n := 3) μ a (hasDerivAt_id' (y μ))]
  simp

lemma inversion3_apply (z : Fin 3 → ℝ) (μ : Fin 3) : inversion3 z μ = z μ / qf3 z := by
  fin_cases μ <;> rfl

/-- The Jacobian of the inversion3. -/
lemma jac_inversion3 {y : Fin 3 → ℝ} (hq : qf3 y ≠ 0) (μ a : Fin 3) :
    jac inversion3 y μ a = (if a = μ then (qf3 y)⁻¹ else 0) + y μ * (-(2 * sg3 a * y a) / qf3 y ^ 2) := by
  unfold jac
  simp only [inversion3_apply]
  exact pd_inversion3_comp hq μ a

/-- The Minkowski metric `diag(-1, 1, 1)` of the boundary. -/
def minkBoundary (_ : Fin 3 → ℝ) : Matrix (Fin 3) (Fin 3) ℝ := diagonal ![-1, 1, 1]

/-- **On the boundary the inversion is conformal**: it multiplies the Minkowski metric by `1/(x²)²`. -/
theorem inversion_conformal_boundary {y : Fin 3 → ℝ} (hq : qf3 y ≠ 0) :
    pullback minkBoundary inversion3 y = (qf3 y ^ 2)⁻¹ • minkBoundary y := by
  have hqe : qf3 y = -(y 0) ^ 2 + y 1 ^ 2 + y 2 ^ 2 := rfl
  unfold pullback
  simp only [jac_inversion3 hq]
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [Fin.sum_univ_three, minkBoundary, sg3, Matrix.diagonal_apply] <;>
    field_simp <;> (try rw [hqe]) <;> ring

/-! ## Translations -/

lemma jac_translation {n : ℕ} (b : Fin n → ℝ) (y : Fin n → ℝ) : jac (fun z => z + b) y = 1 := by
  ext μ a
  have := pd_coord (n := n) μ a (f := fun t => t + b μ) (f' := 1) ((hasDerivAt_id' (y μ)).add_const (b μ))
  simp only [jac, Pi.add_apply, Matrix.one_apply]
  rw [this]
  by_cases h : a = μ
  · simp [h]
  · simp [h, Ne.symm h]

/-- **Translations in `(t, x)` are isometries of the Poincaré patch** (the metric depends only on `z`). -/
theorem adsTranslation_isometry (L : ℝ) (b : Fin 4 → ℝ) (hb : b 3 = 0) (y : Fin 4 → ℝ) :
    pullback (adsMetric L) (fun z => z + b) y = adsMetric L y := by
  rw [pullback_eq_mul, jac_translation]
  simp [adsMetric, adsD, hb]

/-! ## Composition and the special conformal transformations -/

lemma jac_comp {n : ℕ} {φ ψ : (Fin n → ℝ) → Fin n → ℝ} {y : Fin n → ℝ}
    (hφ : ∀ μ, DifferentiableAt ℝ (fun w => φ w μ) (ψ y)) (hψ : ∀ μ, DifferentiableAt ℝ (fun z => ψ z μ) y) :
    jac (fun z => φ (ψ z)) y = jac φ (ψ y) * jac ψ y := by
  ext μ a
  simp only [jac, Matrix.mul_apply]
  exact pd_comp (f := fun w => φ w μ) (hφ μ) hψ a

/-- **Pullback along a composition.** -/
lemma pullback_comp {n : ℕ} (g : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ) {φ ψ : (Fin n → ℝ) → Fin n → ℝ}
    {y : Fin n → ℝ} (hφ : ∀ μ, DifferentiableAt ℝ (fun w => φ w μ) (ψ y))
    (hψ : ∀ μ, DifferentiableAt ℝ (fun z => ψ z μ) y) :
    pullback g (fun z => φ (ψ z)) y = pullback (pullback g φ) ψ y := by
  rw [pullback_eq_mul, pullback_eq_mul, pullback_eq_mul, jac_comp hφ hψ, Matrix.transpose_mul]
  simp only [Matrix.mul_assoc]

/-- The pullback depends on the metric only at the image point. -/
lemma pullback_congr_at {n : ℕ} {G g : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ} {ψ : (Fin n → ℝ) → Fin n → ℝ}
    {y : Fin n → ℝ} (h : G (ψ y) = g (ψ y)) : pullback G ψ y = pullback g ψ y := by
  unfold pullback; rw [h]

/-- A conformal factor passes through the pullback. -/
lemma pullback_smul_field {n : ℕ} (c : (Fin n → ℝ) → ℝ) (G : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ)
    (ψ : (Fin n → ℝ) → Fin n → ℝ) (y : Fin n → ℝ) :
    pullback (fun w => c w • G w) ψ y = c (ψ y) • pullback G ψ y := by
  ext a b
  simp only [pullback, Matrix.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => by ring

lemma diff_inversion {y : Fin 4 → ℝ} (hq : qf y ≠ 0) (μ : Fin 4) :
    DifferentiableAt ℝ (fun z => inversion z μ) y := by
  have dq : DifferentiableAt ℝ qf y := by unfold qf; fun_prop
  simp only [inversion_apply]
  exact (by fun_prop : DifferentiableAt ℝ (fun z : Fin 4 → ℝ => z μ) y).mul (dq.inv hq) |>.congr_of_eventuallyEq
    (Filter.Eventually.of_forall fun z => by simp [div_eq_mul_inv])

lemma diff_translation {n : ℕ} (b : Fin n → ℝ) (y : Fin n → ℝ) (μ : Fin n) :
    DifferentiableAt ℝ (fun z => (fun z => z + b) z μ) y := by
  simp only [Pi.add_apply]; fun_prop

/-- The special conformal transformation with parameter `b`: inversion, translation by `b`, inversion. -/
def specialConformal (b : Fin 4 → ℝ) (y : Fin 4 → ℝ) : Fin 4 → ℝ := inversion (inversion y + b)

/-- **Special conformal transformations are isometries of the Poincaré patch** (`b` a translation in
`(t, x)`, so `b 3 = 0`): where `q(y) ≠ 0` and `q(y/q + b) ≠ 0`, `z ≠ 0`. -/
theorem adsSpecialConformal_isometry (L : ℝ) (b : Fin 4 → ℝ) (hb : b 3 = 0) {y : Fin 4 → ℝ}
    (hq : qf y ≠ 0) (hz : y 3 ≠ 0) (hq' : qf (inversion y + b) ≠ 0) :
    pullback (adsMetric L) (specialConformal b) y = adsMetric L y := by
  have hz' : (inversion y + b) 3 ≠ 0 := by
    simp [inversion, hb, hz, hq]
  have hdi : ∀ μ, DifferentiableAt ℝ (fun w => inversion w μ) ((fun z => z + b) (inversion y)) :=
    fun μ => diff_inversion hq' μ
  have e : specialConformal b = fun z => inversion ((fun z => (fun z => z + b) (inversion z)) z) := rfl
  rw [e, pullback_comp (adsMetric L) (ψ := fun z => (fun z => z + b) (inversion z)) hdi
    (fun μ => by simpa [Pi.add_apply] using (diff_inversion hq μ).add_const (b μ))]
  rw [pullback_congr_at (g := adsMetric L) (ψ := fun z => (fun z => z + b) (inversion z)) (y := y)
    (adsInversion_isometry L hq' hz')]
  rw [pullback_comp (adsMetric L) (φ := fun z => z + b) (ψ := inversion) (diff_translation b _) (diff_inversion hq)]
  rw [pullback_congr_at (g := adsMetric L) (ψ := inversion) (y := y) (adsTranslation_isometry L b hb (inversion y))]
  exact adsInversion_isometry L hq hz

lemma diff_inversion3 {y : Fin 3 → ℝ} (hq : qf3 y ≠ 0) (μ : Fin 3) :
    DifferentiableAt ℝ (fun z => inversion3 z μ) y := by
  have dq : DifferentiableAt ℝ qf3 y := by unfold qf3; fun_prop
  simp only [inversion3_apply]
  exact (by fun_prop : DifferentiableAt ℝ (fun z : Fin 3 → ℝ => z μ) y).mul (dq.inv hq) |>.congr_of_eventuallyEq
    (Filter.Eventually.of_forall fun z => by simp [div_eq_mul_inv])

/-- The special conformal transformation of `ℝ^{1,2}`: inversion, translation by `b`, inversion. -/
def specialConformal3 (b : Fin 3 → ℝ) (y : Fin 3 → ℝ) : Fin 3 → ℝ := inversion3 (inversion3 y + b)

/-- **Special conformal transformations act conformally on the boundary**: the pullback of the
Minkowski metric is `1/((x²)² (x'²)²)` times the metric, with `x' = x/x² + b`. -/
theorem specialConformal3_conformal (b : Fin 3 → ℝ) {y : Fin 3 → ℝ} (hq : qf3 y ≠ 0)
    (hq' : qf3 (inversion3 y + b) ≠ 0) :
    pullback minkBoundary (specialConformal3 b) y =
      ((qf3 (inversion3 y + b) ^ 2)⁻¹ * (qf3 y ^ 2)⁻¹) • minkBoundary y := by
  have hdi : ∀ μ, DifferentiableAt ℝ (fun w => inversion3 w μ) ((fun z => z + b) (inversion3 y)) :=
    fun μ => diff_inversion3 hq' μ
  have e : specialConformal3 b = fun z => inversion3 ((fun z => (fun z => z + b) (inversion3 z)) z) := rfl
  have hψ : ∀ μ, DifferentiableAt ℝ (fun z => ((fun z => z + b) (inversion3 z)) μ) y :=
    fun μ => by simpa [Pi.add_apply] using (diff_inversion3 hq μ).add_const (b μ)
  rw [e, pullback_comp minkBoundary (ψ := fun z => (fun z => z + b) (inversion3 z)) hdi hψ]
  rw [pullback_congr_at (g := fun w => (qf3 w ^ 2)⁻¹ • minkBoundary w)
    (ψ := fun z => (fun z => z + b) (inversion3 z)) (y := y) (inversion_conformal_boundary hq')]
  rw [pullback_smul_field (fun w => (qf3 w ^ 2)⁻¹) minkBoundary]
  have hT : ∀ w : Fin 3 → ℝ, pullback minkBoundary (fun z => z + b) w = minkBoundary w := fun w => by
    rw [pullback_eq_mul, jac_translation]; simp [minkBoundary]
  rw [pullback_comp minkBoundary (φ := fun z => z + b) (ψ := inversion3) (diff_translation b _) (diff_inversion3 hq)]
  rw [pullback_congr_at (g := minkBoundary) (ψ := inversion3) (y := y) (hT (inversion3 y))]
  rw [inversion_conformal_boundary hq]
  simp [smul_smul]

/-- **The explicit form of the special conformal transformation** (AGMOO (2.2)):
`x ↦ (x + b x²)/(1 + 2 b·x + b² x²)` wherever `x² ≠ 0` and the denominator is nonzero; here
`b·x = -b₀x₀ + b₁x₁ + b₂x₂ + b₃x₃` and `x² = qf x`. -/
theorem specialConformal_eq (b y : Fin 4 → ℝ) (hq : qf y ≠ 0)
    (hd : 1 + 2 * (-(b 0 * y 0) + b 1 * y 1 + b 2 * y 2 + b 3 * y 3) + qf b * qf y ≠ 0) (μ : Fin 4) :
    specialConformal b y μ =
      (y μ + b μ * qf y) / (1 + 2 * (-(b 0 * y 0) + b 1 * y 1 + b 2 * y 2 + b 3 * y 3) + qf b * qf y) := by
  have hqw : qf (inversion y + b) =
      (1 + 2 * (-(b 0 * y 0) + b 1 * y 1 + b 2 * y 2 + b 3 * y 3) + qf b * qf y) / qf y := by
    simp only [qf, inversion_apply, Pi.add_apply] at hq ⊢
    field_simp
    ring
  unfold specialConformal
  rw [inversion_apply, hqw]
  simp only [Pi.add_apply, inversion_apply]
  field_simp

/-- **The explicit form on the boundary `ℝ^{1,2}`.** -/
theorem specialConformal3_eq (b y : Fin 3 → ℝ) (hq : qf3 y ≠ 0)
    (hd : 1 + 2 * (-(b 0 * y 0) + b 1 * y 1 + b 2 * y 2) + qf3 b * qf3 y ≠ 0) (μ : Fin 3) :
    specialConformal3 b y μ =
      (y μ + b μ * qf3 y) / (1 + 2 * (-(b 0 * y 0) + b 1 * y 1 + b 2 * y 2) + qf3 b * qf3 y) := by
  have hqw : qf3 (inversion3 y + b) =
      (1 + 2 * (-(b 0 * y 0) + b 1 * y 1 + b 2 * y 2) + qf3 b * qf3 y) / qf3 y := by
    simp only [qf3, inversion3_apply, Pi.add_apply] at hq ⊢
    field_simp
    ring
  unfold specialConformal3
  rw [inversion3_apply, hqw]
  simp only [Pi.add_apply, inversion3_apply]
  field_simp

end Lightlike
