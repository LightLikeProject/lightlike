  funext a a' b b' c c' d d'
  fin_cases a <;> fin_cases a' <;> fin_cases b <;> fin_cases b' <;> fin_cases c <;> fin_cases c' <;>
    fin_cases d <;> fin_cases d' <;> simp only [weylOf, weylASD, weylSD, Fin.sum_univ_two, Fin.zero_eta, Fin.mk_one, Fin.isValue, eps_00, eps_01, eps_10, eps_11, zero_mul, mul_zero, zero_add, add_zero]
