/-- The ASD Weyl spinor of a Weyl tensor is totally symmetric. -/
theorem weylASD_symm {C : Bispinor4} (hC : IsWeyl C) : IsTotallySymm (weylASD C) := by
  have h1 := hC.antisymm₁
  have h2 := hC.antisymm₂
  have h3 := hC.pair
  have h4 := hC.cyclic
  have h5 := hC.traceless
  simp only [Fin.sum_univ_two, eps_00, eps_01, eps_10, eps_11] at h5
  intro a b c d
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> refine ⟨?_, ?_, ?_⟩
