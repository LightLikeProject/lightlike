lemma eps_swap (a b : Fin 2) : eps b a = -eps a b := by fin_cases a <;> fin_cases b <;> simp

/-- The Schouten identity `ε_{αβ} ε_{γδ} + ε_{αγ} ε_{δβ} + ε_{αδ} ε_{βγ} = 0`. -/
lemma eps_schouten (a b c d : Fin 2) :
    eps a b * eps c d + eps a c * eps d b + eps a d * eps b c = 0 := by
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> simp

namespace IsTotallySymm

variable {Ψ : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℂ} (hΨ : IsTotallySymm Ψ)
include hΨ

lemma swap02 (a b c d : Fin 2) : Ψ c b a d = Ψ a b c d :=
  ((hΨ b c a d).1).trans (((hΨ b a c d).2.1).trans (hΨ a b c d).1)

lemma pairSwap (a b c d : Fin 2) : Ψ c d a b = Ψ a b c d :=
  ((hΨ c a d b).2.1).trans (((hΨ a c d b).1).trans (((hΨ a c b d).2.2).trans (hΨ a b c d).2.1))

lemma cyc₁ (a b c d : Fin 2) : Ψ a c d b = Ψ a b c d :=
  ((hΨ a c b d).2.2).trans (hΨ a b c d).2.1

lemma cyc₂ (a b c d : Fin 2) : Ψ a d b c = Ψ a b c d :=
  ((hΨ a b d c).2.1).trans (hΨ a b c d).2.2

/-- `ε^{αγ} Ψ_{αβγδ} = 0`. -/
lemma contract (b d : Fin 2) : ∑ a, ∑ c, eps a c * Ψ a b c d = 0 := by
  simp only [Fin.sum_univ_two, eps_00, eps_01, eps_10, eps_11]
  rw [hΨ.swap02 0 b 1 d]
  ring

end IsTotallySymm

/-- **`ε ε Ψ̃ + ε̄ ε̄ Ψ` has the symmetries of a Weyl tensor** for totally symmetric `Ψ`, `Ψ̃`. -/
theorem weylOf_isWeyl {Ψ Ψt : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℂ} (hΨ : IsTotallySymm Ψ)
    (hΨt : IsTotallySymm Ψt) : IsWeyl (weylOf Ψ Ψt) where
  antisymm₁ a a' b b' c c' d d' := by
    simp only [weylOf]
    rw [eps_swap a b, eps_swap a' b', (hΨ a b c d).1, (hΨt a' b' c' d').1]
    ring
  antisymm₂ a a' b b' c c' d d' := by
    simp only [weylOf]
    rw [eps_swap c d, eps_swap c' d', (hΨ a b c d).2.2, (hΨt a' b' c' d').2.2]
    ring
  pair a a' b b' c c' d d' := by
    simp only [weylOf]
    rw [hΨ.pairSwap a b c d, hΨt.pairSwap a' b' c' d']
    ring
  cyclic a a' b b' c c' d d' := by
    simp only [weylOf]
    rw [hΨ.cyc₁ a b c d, hΨ.cyc₂ a b c d, hΨt.cyc₁ a' b' c' d', hΨt.cyc₂ a' b' c' d']
    linear_combination Ψt a' b' c' d' * eps_schouten a b c d + Ψ a b c d * eps_schouten a' b' c' d'
  traceless b b' d d' := by
    have e1 := hΨ.contract b d
    have e2 := hΨt.contract b' d'
    simp only [weylOf, Fin.sum_univ_two] at e1 e2 ⊢
    linear_combination (norm := skip) eps b d * e2 + eps b' d' * e1
    fin_cases b <;> fin_cases b' <;> fin_cases d <;> fin_cases d' <;>
      simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, eps_00, eps_01, eps_10, eps_11] <;> ring

/-- **The Weyl spinors of `ε ε Ψ̃ + ε̄ ε̄ Ψ` are `Ψ` and `Ψ̃`.** -/
theorem weylParts_weylOf {Ψ Ψt : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℂ} (hΨ : IsTotallySymm Ψ)
    (hΨt : IsTotallySymm Ψt) : weylASD (weylOf Ψ Ψt) = Ψ ∧ weylSD (weylOf Ψ Ψt) = Ψt := by
  have k : ∀ c d, Ψ 1 0 c d = Ψ 0 1 c d := fun c d => (hΨ 0 1 c d).1
  have kt : ∀ c d, Ψt 1 0 c d = Ψt 0 1 c d := fun c d => (hΨt 0 1 c d).1
  constructor
  · funext a b c d
    simp only [weylASD, weylOf, Fin.sum_univ_two, eps_00, eps_01, eps_10, eps_11, kt]
    ring
  · funext a b c d
    simp only [weylSD, weylOf, Fin.sum_univ_two, eps_00, eps_01, eps_10, eps_11, k]
    ring

/-- **Weyl tensors are pairs of totally symmetric 4-spinors** (the Weyl term of Adamo (3.12)). -/
def weylEquiv : {C : Bispinor4 // IsWeyl C} ≃
    {Ψ : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℂ // IsTotallySymm Ψ} ×
      {Ψt : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℂ // IsTotallySymm Ψt} where
  toFun C := (⟨weylASD C.1, weylASD_symm C.2⟩, ⟨weylSD C.1, weylSD_symm C.2⟩)
  invFun p := ⟨weylOf p.1.1 p.2.1, weylOf_isWeyl p.1.2 p.2.2⟩
  left_inv C := Subtype.ext (weyl_eq_weylOf C.2).symm
  right_inv p := by
    obtain ⟨h1, h2⟩ := weylParts_weylOf p.1.2 p.2.2
    exact Prod.ext (Subtype.ext h1) (Subtype.ext h2)

end Lightlike.Spinor

