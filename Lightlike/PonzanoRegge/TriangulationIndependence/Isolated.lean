module

public import Lightlike.PonzanoRegge.TriangulationIndependence.TreeConnected

/-!
# Isolated maximal trees: a criterion for `¬ TreeConnected`

A maximal tree `T` of `K` is **isolated** when no triangle of `K` has two of its edges in `T`
(then no triangle exchange starts at `T`, and, since the result of an exchange contains two edges of
a triangle, none ends at `T`). An isolated tree is alone in its exchange class, so if `K` has
another maximal tree, `K` is not `TreeConnected`
(`not_treeConnected_of_isolated`). This is the criterion used for the combinatorial 3-sphere with
seven vertices in `Lightlike/PonzanoRegge/TriangulationIndependence/Tests/SphereCounterexample.lean`, where it refutes the hope that every
simply connected closed 3-manifold is tree-connected (programme item L9b/L13, closed-manifold gauge
tree, Freidel–Louapre 2004, Section III).

`IsSpanningTree.of_parent` is a decidable way to check that an explicit edge set is a spanning tree:
every vertex other than the root has a parent joined to it by a tree edge, with decreasing rank.
-/

@[expose] public section

namespace Lightlike.PR

open Finset

variable {V : Type*} [DecidableEq V]

/-- An isolated tree is alone in its class for the equivalence generated by exchanges: exchanges
neither start nor end at it. -/
theorem eq_of_eqvGen_exchange_isolated {K : Complex3 V} {T : Finset (Finset V)}
    (hiso : ∀ u v w : V, ({u, v} : Finset V) ∈ T → ({v, w} : Finset V) ∈ T → u ≠ w →
      ({u, v, w} : Finset V) ∈ K.tris → False)
    {a b : Finset (Finset V)} (h : Relation.EqvGen (TreeExchange K) a b) : a = T ↔ b = T := by
  induction h with
  | rel a b hs =>
    obtain ⟨hT0, huv, hvw, huw, hτ, he, hg, hf⟩ := hs
    rename_i u v w
    constructor
    · rintro rfl
      exact (hiso u v w he hg huw hτ).elim
    · intro hb
      have hge : ({v, w} : Finset V) ≠ {u, v} := fun h => huw (by
        have : w ∈ ({u, v} : Finset V) := h ▸ (by simp)
        simp only [mem_insert, mem_singleton] at this
        rcases this with h' | h'
        · exact h'.symm
        · exact absurd h'.symm hvw)
      have h1' : ({u, w} : Finset V) ∈ T := hb ▸ mem_insert_self _ _
      have h2 : ({v, w} : Finset V) ∈ T := hb ▸ mem_insert_of_mem (mem_erase.mpr ⟨hge, hg⟩)
      have htri : ({u, w, v} : Finset V) ∈ K.tris := by
        rwa [show ({u, w, v} : Finset V) = {u, v, w} by ext; simp; tauto]
      have h2' : ({w, v} : Finset V) ∈ T := by rw [pair_comm]; exact h2
      exact (hiso u w v h1' h2' huv htri).elim
  | refl => exact Iff.rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- **A complex with an isolated maximal tree and another maximal tree is not tree-connected.** -/
theorem not_treeConnected_of_isolated {K : Complex3 V} {T T' : Finset (Finset V)}
    (hT : IsMaxTree K T) (hT' : IsMaxTree K T') (hne : T' ≠ T)
    (hiso : ∀ u v w : V, ({u, v} : Finset V) ∈ T → ({v, w} : Finset V) ∈ T → u ≠ w →
      ({u, v, w} : Finset V) ∈ K.tris → False) :
    ¬ TreeConnected K := fun h =>
  hne ((eq_of_eqvGen_exchange_isolated hiso (h hT' hT)).mpr rfl)

/-- **Spanning trees from parent pointers**: if the edges of `T` lie in `W`, every vertex of `W`
other than the root `r` is joined by a tree edge to a parent of smaller rank, and `#T + 1 = #W`,
then `T` is a spanning tree of `W`. -/
theorem IsSpanningTree.of_parent {W : Finset V} {T : Finset (Finset V)} {r : V} (hr : r ∈ W)
    (par : V → V) (rank : V → ℕ) (hedge : ∀ e ∈ T, e ⊆ W ∧ #e = 2)
    (hpar : ∀ w ∈ W, w ≠ r → ({w, par w} : Finset V) ∈ T ∧ rank (par w) < rank w)
    (hcard : #T + 1 = #W) : IsSpanningTree W T := by
  refine ⟨hedge, ?_, hcard⟩
  have toRoot : ∀ n, ∀ w ∈ W, rank w = n →
      Relation.ReflTransGen (fun x y => ({x, y} : Finset V) ∈ T) w r ∧
      Relation.ReflTransGen (fun x y => ({x, y} : Finset V) ∈ T) r w := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro w hw hn
      by_cases hwr : w = r
      · subst hwr; exact ⟨.refl, .refl⟩
      · obtain ⟨he, hlt⟩ := hpar w hw hwr
        have hpW : par w ∈ W := (hedge _ he).1 (by simp)
        obtain ⟨i1, i2⟩ := ih _ (hn ▸ hlt) _ hpW rfl
        refine ⟨.head he i1, .tail i2 ?_⟩
        rwa [pair_comm]
  intro u hu v hv
  exact (toRoot _ u hu rfl).1.trans (toRoot _ v hv rfl).2

end Lightlike.PR
