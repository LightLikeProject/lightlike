import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Topology.ContinuousMap.Star
import Mathlib.Topology.Algebra.Group.Basic
import Mathlib.Analysis.Normed.Operator.LinearIsometry

/-!
# The holonomy–flux (Weyl) algebra of one graph and its representations (G2-011)

Loop quantum gravity quantises the holonomies of a connection and the fluxes of the conjugate
triad (Lewandowski–Okołów–Sahlmann–Thiemann, `lost-2006`; Fleischhack, `fleischhack-2009`).
On a single graph with edge set `E` and structure group `G`, the configuration space of the holonomies
is the compact group `K = G^E`. The *holonomy–flux algebra of the graph* is the algebra generated by

* the holonomy functions, the continuous functions `f ∈ C(K, ℂ)` (a `*`-algebra under pointwise
  operations and complex conjugation), and
* the exponentiated fluxes, one element `U_k` for each `k ∈ K`: the flux through a surface acts on the
  holonomies of the edges it crosses by group translation, so the exponentiated fluxes form the
  group `K` acting on `C(K, ℂ)` by translation,

with the relations `U_k U_l = U_{kl}`, `U_k* = U_{k⁻¹}` and `U_k f U_k⁻¹ = f ∘ (k⁻¹ · )`. This is the
Weyl form of the holonomy–flux algebra, the crossed product `C(K) ⋊ K`; no derivatives of
functions on `K` are needed.

A representation of it on a Hilbert space `H` is a `*`-homomorphism `hol : C(K, ℂ) → B(H)` and a
unitary representation `flux : K → U(H)` satisfying the covariance relation. This file defines

* `translate`: the translation action on `C(K, ℂ)`;
* `HFRep K H`: a representation of the holonomy–flux algebra of a graph on `H`;
* `HFRep.state`: the vector state `f ↦ ⟨Ω, hol f Ω⟩` of a vector `Ω`; it is linear, positive
  (`HFRep.state_star_mul_self`) and, if `Ω` is flux invariant (`FluxInvariant`), translation invariant
  (`HFRep.state_translate`).

The graph-level uniqueness theorem (a cyclic flux-invariant vector gives the Ashtekar–Lewandowski
representation) is in the next files of this folder. Only the single-graph statement is formalised
here; the diffeomorphism group, the projective limit over graphs and the statement of
`lost-2006` on a manifold are not.

Supporting definitions; no catalogue entry.
-/

noncomputable section

namespace Lightlike.Rows.G2_011

variable (K : Type*) [Group K] [TopologicalSpace K] [IsTopologicalGroup K]

/-- The translation `(translate k f)(x) = f (k⁻¹ x)` of a holonomy function by `k ∈ K`: the action
of the exponentiated flux `k` on the holonomies. -/
def translate (k : K) (f : C(K, ℂ)) : C(K, ℂ) :=
  f.comp ⟨fun x => k⁻¹ * x, by fun_prop⟩

variable {K}

@[simp] lemma translate_apply (k : K) (f : C(K, ℂ)) (x : K) : translate K k f x = f (k⁻¹ * x) := rfl

lemma translate_mul (k l : K) (f : C(K, ℂ)) :
    translate K (k * l) f = translate K k (translate K l f) := by
  ext x; simp [mul_assoc]

@[simp] lemma translate_one (f : C(K, ℂ)) : translate K 1 f = f := by
  ext x; simp

lemma translate_star_mul (k : K) (f g : C(K, ℂ)) :
    translate K k (star f * g) = star (translate K k f) * translate K k g := by
  ext x; simp

variable (K)

/-- **A representation of the holonomy–flux algebra of one graph** with holonomy group `K` on the
Hilbert space `H`: a `*`-homomorphism `hol` of the algebra of holonomy functions `C(K, ℂ)` into the
bounded operators, a unitary representation `flux` of the group of exponentiated fluxes `K`, and the
covariance `U_k (f ξ) = (f ∘ (k⁻¹ · )) (U_k ξ)`, the Weyl relation between holonomies and fluxes. -/
structure HFRep (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  /-- the holonomy functions act as bounded operators. -/
  hol : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)
  /-- the exponentiated fluxes act as unitaries. -/
  flux : K →* (H ≃ₗᵢ[ℂ] H)
  /-- the Weyl relation `U_k f U_k⁻¹ = f ∘ (k⁻¹ · )`. -/
  covariant : ∀ (k : K) (f : C(K, ℂ)) (ξ : H), flux k (hol f ξ) = hol (translate K k f) (flux k ξ)

variable {K} {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A vector is **flux invariant** if every exponentiated flux fixes it. -/
def FluxInvariant (ρ : HFRep K H) (Ω : H) : Prop := ∀ k : K, ρ.flux k Ω = Ω

/-- The **vector state** `f ↦ ⟨Ω, hol f Ω⟩` of a vector `Ω` on the holonomy functions. -/
def HFRep.state (ρ : HFRep K H) (Ω : H) (f : C(K, ℂ)) : ℂ := inner ℂ Ω (ρ.hol f Ω)

/-- The vector state is positive: `⟨Ω, hol (f̄ f) Ω⟩ = ‖hol f Ω‖²`. -/
theorem HFRep.state_star_mul_self (ρ : HFRep K H) (Ω : H) (f : C(K, ℂ)) :
    ρ.state Ω (star f * f) = ((‖ρ.hol f Ω‖ ^ 2 : ℝ) : ℂ) := by
  unfold HFRep.state
  rw [map_mul, map_star, mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint,
    ContinuousLinearMap.adjoint_inner_right, inner_self_eq_norm_sq_to_K]
  simp

/-- The vector state of a flux-invariant vector is translation invariant. -/
theorem HFRep.state_translate (ρ : HFRep K H) {Ω : H} (hΩ : FluxInvariant ρ Ω) (k : K)
    (f : C(K, ℂ)) : ρ.state Ω (translate K k f) = ρ.state Ω f := by
  unfold HFRep.state
  have h := ρ.covariant k f Ω
  rw [hΩ k] at h
  rw [← h]
  nth_rewrite 1 [← hΩ k]
  exact LinearIsometryEquiv.inner_map_map _ _ _

end Lightlike.Rows.G2_011
