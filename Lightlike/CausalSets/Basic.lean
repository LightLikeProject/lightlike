import Mathlib

/-!
# Causal sets: locally finite partial orders

A *causal set* is a locally finite partially ordered set: the order is the causal relation of a
discretised spacetime, and local finiteness says that a causal interval contains finitely many
elements, which is the discreteness hypothesis of the causal-set programme.

This file is the order-theoretic side of a bridge between Lorentzian geometry
(`Lightlike/Spacetime/Causal/`) and causal sets: `Lightlike/CausalSets/Sprinkling.lean` takes the
causal order of Minkowski space and restricts it to finite point sets.

Contents: the class `CausalSet`, links (`CovBy`), the interval, chains and antichains, the
fact that every strict relation is a finite chain of links, that the order is generated by the
links, and a 4-element diamond with a non-transitive relation rejected.

## References

* L. Bombelli, J. Lee, D. Meyer, R. D. Sorkin, *Space-time as a causal set*, Phys. Rev. Lett. 59
  (1987) 521.
* S. Surya, *The causal set approach to the problem of quantum gravity*, Living Reviews in
  Relativity 22 (2019), section 2.
-/

open Set

namespace Lightlike.CausalSets

/-- A **causal set**: a partial order in which every closed interval is finite. -/
class CausalSet (α : Type*) [PartialOrder α] : Prop where
  /-- Every causal interval is finite. -/
  finite_Icc : ∀ a b : α, (Icc a b).Finite

variable {α : Type*} [PartialOrder α]

/-- A **link** of a causal set: a relation `a ≺ b` with no element strictly between. -/
abbrev IsLink (a b : α) : Prop := a ⋖ b

/-- The causal interval between two elements: all elements `c` with `a ≼ c ≼ b`. -/
abbrev interval (a b : α) : Set α := Icc a b

/-- A **chain** of a causal set: a totally ordered subset. -/
abbrev IsCausalChain (s : Set α) : Prop := IsChain (· ≤ ·) s

/-- An **antichain** of a causal set: a subset of pairwise unrelated elements. -/
abbrev IsCausalAntichain (s : Set α) : Prop := IsAntichain (· ≤ ·) s

/-- Every finite partial order is a causal set. -/
instance (priority := 100) [Finite α] : CausalSet α := ⟨fun _ _ => Set.toFinite _⟩

namespace CausalSet

variable [CausalSet α]

/-- Below any strict relation `a < b` there is a link `a ⋖ c` with `c ≼ b`. -/
lemma exists_link_of_lt {a b : α} (h : a < b) : ∃ c, a ⋖ c ∧ c ≤ b := by
  have hfin : (Ioc a b).Finite := (finite_Icc a b).subset Ioc_subset_Icc_self
  have hne : (Ioc a b).Nonempty := ⟨b, h, le_rfl⟩
  obtain ⟨c, hc, hmin⟩ := hfin.exists_minimalFor id _ hne
  refine ⟨c, ⟨hc.1, fun d had hdc => ?_⟩, hc.2⟩
  have : d ∈ Ioc a b := ⟨had, hdc.le.trans hc.2⟩
  exact absurd (hmin this hdc.le) (not_le_of_gt hdc)

/-- The order is generated by the links: `a ≼ b` iff there is a finite chain of links from `a` to
`b`. -/
lemma le_iff_reflTransGen_link {a b : α} :
    a ≤ b ↔ Relation.ReflTransGen (fun x y : α => x ⋖ y) a b := by
  constructor
  · intro hab
    -- induction on the finite interval
    have hfin : (Icc a b).Finite := finite_Icc a b
    induction' hn : hfin.toFinset.card using Nat.strong_induction_on with n ih generalizing a
    rcases hab.eq_or_lt with rfl | h
    · exact Relation.ReflTransGen.refl
    · obtain ⟨c, hac, hcb⟩ := exists_link_of_lt h
      have hsub : (Icc c b).Finite := finite_Icc c b
      have hlt : hsub.toFinset.card < n := by
        rw [← hn]
        apply Finset.card_lt_card
        refine ⟨fun x hx => ?_, fun hsup => ?_⟩
        · simp only [Set.Finite.mem_toFinset, mem_Icc] at hx ⊢
          exact ⟨hac.lt.le.trans hx.1, hx.2⟩
        · have := hsup (show a ∈ hfin.toFinset by simp [hab])
          simp only [Set.Finite.mem_toFinset, mem_Icc] at this
          exact absurd hac.lt (not_lt_of_ge this.1)
      exact Relation.ReflTransGen.head hac (ih _ hlt hcb hsub rfl)
  · intro h
    induction h with
    | refl => exact le_rfl
    | tail _ hl ih => exact ih.trans hl.le

/-- Distinct comparable elements of a causal set are joined by a nonempty chain of links. -/
lemma lt_iff_transGen_link {a b : α} :
    a < b ↔ Relation.TransGen (fun x y : α => x ⋖ y) a b := by
  constructor
  · intro h
    obtain ⟨c, hac, hcb⟩ := exists_link_of_lt h
    exact Relation.TransGen.head' hac (le_iff_reflTransGen_link.1 hcb)
  · intro h
    induction h with
    | single hl => exact hl.lt
    | tail _ hl ih => exact ih.trans hl.lt

end CausalSet

/-- The 4-element diamond: `0 ≺ 1, 2 ≺ 3`, with `1` and `2` unrelated. -/
def Diamond : Type := Fin 4

namespace Diamond

/-- The relation of the diamond: `a ≼ b` iff `a = b`, or `a` is the bottom, or `b` is the top. -/
def rel (a b : Fin 4) : Prop := a = b ∨ a = 0 ∨ b = 3

instance (a b : Fin 4) : Decidable (rel a b) := by unfold rel; infer_instance

lemma rel_trans : ∀ a b c : Fin 4, rel a b → rel b c → rel a c := by decide

lemma rel_antisymm : ∀ a b : Fin 4, rel a b → rel b a → a = b := by decide

/-- The diamond order. -/
instance : PartialOrder Diamond where
  le a b := rel a b
  le_refl a := Or.inl rfl
  le_trans a b c := rel_trans a b c
  le_antisymm a b := rel_antisymm a b

/-- The diamond is finite, hence a causal set. -/
instance : Finite Diamond := inferInstanceAs (Finite (Fin 4))

/-- Trust check: the interval from the bottom `0` to the top `3` has the four elements; the
interval `[0, 1]` has two, so `0 ≺ 1` is a link, while `0 ≺ 3` is a relation that is not a link;
and `1`, `2` are unrelated. -/
example : (Finset.univ.filter fun c : Fin 4 => rel 0 c ∧ rel c 3).card = 4 ∧
    (Finset.univ.filter fun c : Fin 4 => rel 0 c ∧ rel c 1).card = 2 ∧
    ¬ rel 1 2 ∧ ¬ rel 2 1 := by decide

end Diamond

/-- Trust check (a non-transitive relation is rejected): the relation with `0 ≺ 1`, `1 ≺ 2` but
not `0 ≺ 2` on `Fin 3` is not transitive, so it is not the order of any causal set. -/
example : ¬ (∀ a b c : Fin 3, (a = b ∨ (a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 2)) →
    (b = c ∨ (b = 0 ∧ c = 1) ∨ (b = 1 ∧ c = 2)) → (a = c ∨ (a = 0 ∧ c = 1) ∨ (a = 1 ∧ c = 2))) := by
  decide

end Lightlike.CausalSets
