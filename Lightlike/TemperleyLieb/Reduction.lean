import Mathlib
import Lightlike.TemperleyLieb.Natural
import Lightlike.TemperleyLieb.Jones

/-!
# Closing up a diagram: `cap z cup` stays in the Temperley–Lieb subalgebra

Let `C n = tlSub (modelE q) n` be the subalgebra generated by `e_0, …, e_{n-1}` in `End(ModelSpace)`.
* `cap_cup_mem`: for `m, m' ≤ n`, `cap_m cup_{m'} ∈ C (n-1)` (it is `δ`, `1`, or a product of `e`'s);
* `cap_mem_cup`: for `z ∈ C (n+1)` and `m, m' ≤ n`, `cap_m z cup_{m'} ∈ C (n-1)`.

The second statement is the reduction of closed diagrams used for the vertex–vertex products: it is proved by
induction on the words of `z`, pulling one generator at a time through `cap` by `e_j = cup_j cap_j`.
-/

namespace Lightlike.TemperleyLieb

open Finsupp

variable {k : Type*} [Field k]

/-- The Temperley–Lieb subalgebra of the model generated by `e_0, …, e_{n-1}`. -/
noncomputable abbrev CSub (q : kˣ) (n : ℕ) : Subalgebra k (Module.End k (ModelSpace k)) :=
  tlSub (k := k) (modelE q) n

/-- `cup_b cap_a ∈ C (b+1)` for `a ≤ b`. -/
lemma cup_cap_mem_of_le (q : kˣ) {a b : ℕ} (h : a ≤ b) :
    cupOp q b * capOp q a ∈ CSub q (b + 1) := by
  induction b, h using Nat.le_induction with
  | base => rw [cup_cap]; exact e_mem_tlSub (Nat.lt_succ_self _)
  | succ b hab ih =>
    have : cupOp q (b + 1) * capOp q a = modelE q (b + 1) * (cupOp q b * capOp q a) := by
      rw [← mul_assoc, e_mul_cup_succ]
    rw [this]
    exact Subalgebra.mul_mem _ (e_mem_tlSub (Nat.lt_succ_self _))
      (tlSub_mono (Nat.le_succ _) ih)

/-- `cap_m cup_{m+2+t} ∈ C (m+1+t)`. -/
lemma cap_cup_far_right (q : kˣ) (m t : ℕ) : capOp q m * cupOp q (m + 2 + t) ∈ CSub q (m + 1 + t) := by
  induction t with
  | zero =>
    have : capOp q m * cupOp q (m + 2 + 0) = modelE q m := by
      have h1 : cupOp q (m + 2 + 0) = modelE q (m + 2) * cupOp q (m + 1) := (e_mul_cup_succ q (m + 1)).symm
      rw [h1, ← mul_assoc, cap_mul_e_far q (le_refl m), mul_assoc, cap_cup_succ, mul_one]
    rw [this]; exact e_mem_tlSub (by omega)
  | succ t ih =>
    have h1 : cupOp q (m + 2 + (t + 1)) = modelE q (m + 2 + t + 1) * cupOp q (m + 2 + t) :=
      (e_mul_cup_succ q (m + 2 + t)).symm
    have h2 : capOp q m * modelE q (m + t + 1 + 2) = modelE q (m + t + 1) * capOp q m :=
      cap_mul_e_far q (by omega)
    have : capOp q m * cupOp q (m + 2 + (t + 1)) = modelE q (m + t + 1) * (capOp q m * cupOp q (m + 2 + t)) := by
      rw [h1, ← mul_assoc, show m + 2 + t + 1 = m + t + 1 + 2 by ring, h2, mul_assoc]
    rw [this]
    exact Subalgebra.mul_mem _ (e_mem_tlSub (by omega)) (tlSub_mono (by omega) ih)

/-- `cap_{m+2+t} cup_m ∈ C (m+1+t)`. -/
lemma cap_cup_far_left (q : kˣ) (m t : ℕ) : capOp q (m + 2 + t) * cupOp q m ∈ CSub q (m + 1 + t) := by
  induction t with
  | zero =>
    have h1 : capOp q (m + 2 + 0) = capOp q (m + 1) * modelE q (m + 2) := (cap_mul_e_succ q (m + 1)).symm
    have h2 : modelE q (m + 2) * cupOp q m = cupOp q m * modelE q m := e_mul_cup_far q (le_refl m)
    have : capOp q (m + 2 + 0) * cupOp q m = modelE q m := by
      rw [h1, mul_assoc, h2, ← mul_assoc, cap_succ_cup, one_mul]
    rw [this]; exact e_mem_tlSub (by omega)
  | succ t ih =>
    have h1 : capOp q (m + 2 + (t + 1)) = capOp q (m + 2 + t) * modelE q (m + 2 + t + 1) :=
      (cap_mul_e_succ q (m + 2 + t)).symm
    have h2 : modelE q (m + t + 1 + 2) * cupOp q m = cupOp q m * modelE q (m + t + 1) :=
      e_mul_cup_far q (by omega)
    have : capOp q (m + 2 + (t + 1)) * cupOp q m = (capOp q (m + 2 + t) * cupOp q m) * modelE q (m + t + 1) := by
      rw [h1, mul_assoc, show m + 2 + t + 1 = m + t + 1 + 2 by ring, h2, ← mul_assoc]
    rw [this]
    exact Subalgebra.mul_mem _ (tlSub_mono (by omega) ih) (e_mem_tlSub (by omega))

/-- `cap_m cup_{m'} ∈ C (n-1)` for `m, m' ≤ n`. -/
lemma cap_cup_mem (q : kˣ) {n m m' : ℕ} (hm : m ≤ n) (hm' : m' ≤ n) :
    capOp q m * cupOp q m' ∈ CSub q (n - 1) := by
  rcases lt_trichotomy m m' with h | h | h
  · by_cases h1 : m + 2 ≤ m'
    · obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le h1
      exact tlSub_mono (by omega) (cap_cup_far_right q m t)
    · have : m' = m + 1 := by omega
      subst this
      rw [cap_cup_succ]; exact Subalgebra.one_mem _
  · subst h
    rw [cap_cup]; exact Subalgebra.algebraMap_mem _ _
  · by_cases h1 : m' + 2 ≤ m
    · obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le h1
      exact tlSub_mono (by omega) (cap_cup_far_left q m' t)
    · have : m = m' + 1 := by omega
      subst this
      rw [cap_succ_cup]; exact Subalgebra.one_mem _

/-- **Reduction of closed diagrams.** For `z ∈ C (n+1)` and `m, m' ≤ n`, `cap_m z cup_{m'} ∈ C (n-1)`. -/
theorem cap_mul_cup_mem (q : kˣ) {n : ℕ} {z : Module.End k (ModelSpace k)} (hz : z ∈ CSub q (n + 1)) :
    ∀ m m', m ≤ n → m' ≤ n → capOp q m * z * cupOp q m' ∈ CSub q (n - 1) := by
  unfold CSub tlSub at hz
  have hz' : z ∈ Submodule.span k (Submonoid.closure {x | ∃ j < n + 1, x = modelE q j}) := by
    rw [← Algebra.adjoin_eq_span]; exact hz
  clear hz
  induction hz' using Submodule.span_induction with
  | mem x hx =>
    induction hx using Submonoid.closure_induction_left with
    | one => intro m m' hm hm'; simpa using cap_cup_mem q hm hm'
    | mul_left j hj y _ ih =>
      obtain ⟨j', hj', rfl⟩ := hj
      intro m m' hm hm'
      have hjn : j' ≤ n := by omega
      have : capOp q m * (modelE q j' * y) * cupOp q m' =
          (capOp q m * cupOp q j') * (capOp q j' * y * cupOp q m') := by
        rw [← cup_cap]; simp only [mul_assoc]
      rw [this]
      exact Subalgebra.mul_mem _ (cap_cup_mem q hm hjn) (ih j' m' hjn hm')
  | zero => intro m m' _ _; simp
  | add x y _ _ hx hy =>
    intro m m' hm hm'
    rw [mul_add, add_mul]
    exact Subalgebra.add_mem _ (hx m m' hm hm') (hy m m' hm hm')
  | smul r x _ hx =>
    intro m m' hm hm'
    rw [mul_smul_comm, smul_mul_assoc]
    exact Subalgebra.smul_mem _ (hx m m' hm hm') r

end Lightlike.TemperleyLieb
