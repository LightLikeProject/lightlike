import Mathlib
import Lightlike.TemperleyLieb.JonesWenzl

/-!
# Jones' conditional expectation in the Temperley–Lieb algebra

Let `C m` be the subalgebra generated by `e 0, …, e (m - 1)` of an algebra with a Temperley–Lieb family.
* `dec_succ`: every element of `C (m+1)` is `u + v e_m w` with `u, v, w ∈ C m`;
* `expectation`: for `z ∈ C m`, `e_m z e_m = z' e_m` for some `z' ∈ C m` (Jones' basic construction);
* `absorb`: if `p` is killed on both sides by `e_j` for all `j < m`, then every `x ∈ C m` acts on `p` by a scalar,
  `p x = c p = x p`.

## References

* V. F. R. Jones, Index for subfactors, Invent. Math. 72 (1983), Section 3 (the basic construction), and
  L. H. Kauffman, S. L. Lins, *Temperley–Lieb recoupling theory and invariants of 3-manifolds*, Chapter 2.
-/

namespace Lightlike.TemperleyLieb

variable {k : Type*} [Field k] {A : Type*} [Ring A] [Algebra k A]

/-- The subalgebra generated by `e 0, …, e (m - 1)`. -/
def tlSub (e : ℕ → A) (m : ℕ) : Subalgebra k A := Algebra.adjoin k {x | ∃ j < m, x = e j}

variable {δ : k} {e : ℕ → A}

/-- The generator `e j` lies in `tlSub e m` for `j < m`. -/
lemma e_mem_tlSub {j m : ℕ} (h : j < m) : e j ∈ (tlSub (k := k) e m) :=
  Algebra.subset_adjoin ⟨j, h, rfl⟩

/-- The subalgebras are increasing. -/
lemma tlSub_mono {m n : ℕ} (h : m ≤ n) : (tlSub (k := k) e m) ≤ tlSub e n := by
  apply Algebra.adjoin_mono
  rintro x ⟨j, hj, rfl⟩
  exact ⟨j, by omega, rfl⟩

/-- `e_n` commutes with every element of `tlSub e m` if `m + 1 ≤ n`. -/
lemma comm_tlSub (he : IsTL δ e) {m n : ℕ} (h : m + 1 ≤ n) {x : A} (hx : x ∈ tlSub (k := k) e m) :
    e n * x = x * e n := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    exact (he.comm j n (by omega)).symm
  | algebraMap r => exact (Algebra.commutes r (e n)).symm
  | add x y _ _ hx hy => rw [mul_add, add_mul, hx, hy]
  | mul x y _ _ hx hy => rw [← mul_assoc, hx, mul_assoc, hy, mul_assoc]

/-- The span of the products `v e_m w` with `v, w ∈ tlSub e m`. -/
def midSpan (e : ℕ → A) (m : ℕ) : Submodule k A :=
  Submodule.span k {x | ∃ v ∈ tlSub (k := k) e m, ∃ w ∈ tlSub (k := k) e m, x = v * e m * w}

/-- Left multiplication by `tlSub e m` preserves the middle span. -/
lemma midSpan_mul_left {m : ℕ} {a b : A} (ha : a ∈ tlSub (k := k) e m) (hb : b ∈ midSpan (k := k) e m) :
    a * b ∈ midSpan (k := k) e m := by
  induction hb using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨v, hv, w, hw, rfl⟩ := hx
    exact Submodule.subset_span ⟨a * v, Subalgebra.mul_mem _ ha hv, w, hw, by simp only [mul_assoc]⟩
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact Submodule.add_mem _ hx hy
  | smul r x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ r hx

/-- Right multiplication by `tlSub e m` preserves the middle span. -/
lemma midSpan_mul_right {m : ℕ} {a b : A} (ha : a ∈ tlSub (k := k) e m) (hb : b ∈ midSpan (k := k) e m) :
    b * a ∈ midSpan (k := k) e m := by
  induction hb using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨v, hv, w, hw, rfl⟩ := hx
    exact Submodule.subset_span ⟨v, hv, w * a, Subalgebra.mul_mem _ hw ha, by simp only [mul_assoc]⟩
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul]; exact Submodule.add_mem _ hx hy
  | smul r x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r hx

/-- Product of two middle terms, given the expectation property at level `m`. -/
lemma midSpan_mul_mid {m : ℕ}
    (hCE : ∀ z ∈ tlSub (k := k) e m, ∃ z' ∈ tlSub (k := k) e m, e m * z * e m = z' * e m)
    {b b' : A} (hb : b ∈ midSpan (k := k) e m) (hb' : b' ∈ midSpan (k := k) e m) :
    b * b' ∈ midSpan (k := k) e m := by
  induction hb using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨v, hv, w, hw, rfl⟩ := hx
    induction hb' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨v', hv', w', hw', rfl⟩ := hy
      obtain ⟨z, hz, hzz⟩ := hCE (w * v') (Subalgebra.mul_mem _ hw hv')
      refine Submodule.subset_span ⟨v * z, Subalgebra.mul_mem _ hv hz, w', hw', ?_⟩
      calc v * e m * w * (v' * e m * w') = v * (e m * (w * v') * e m) * w' := by simp only [mul_assoc]
        _ = v * (z * e m) * w' := by rw [hzz]
        _ = _ := by simp only [mul_assoc]
    | zero => simp
    | add y y' _ _ hy hy' => rw [mul_add]; exact Submodule.add_mem _ hy hy'
    | smul r y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ r hy
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul]; exact Submodule.add_mem _ hx hy
  | smul r x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r hx

/-- The subalgebra `tlSub e m + midSpan e m`, given the expectation property at level `m`. -/
def decSub (e : ℕ → A) (m : ℕ)
    (hCE : ∀ z ∈ tlSub (k := k) e m, ∃ z' ∈ tlSub (k := k) e m, e m * z * e m = z' * e m) :
    Subalgebra k A where
  carrier := {x | ∃ a ∈ tlSub (k := k) e m, ∃ b ∈ midSpan (k := k) e m, x = a + b}
  mul_mem' := by
    rintro x y ⟨a, ha, b, hb, rfl⟩ ⟨a', ha', b', hb', rfl⟩
    refine ⟨a * a', Subalgebra.mul_mem _ ha ha', a * b' + b * a' + b * b', ?_, by noncomm_ring⟩
    exact Submodule.add_mem _ (Submodule.add_mem _ (midSpan_mul_left ha hb') (midSpan_mul_right ha' hb))
      (midSpan_mul_mid hCE hb hb')
  add_mem' := by
    rintro x y ⟨a, ha, b, hb, rfl⟩ ⟨a', ha', b', hb', rfl⟩
    exact ⟨a + a', Subalgebra.add_mem _ ha ha', b + b', Submodule.add_mem _ hb hb', by abel⟩
  algebraMap_mem' r := ⟨algebraMap k A r, Subalgebra.algebraMap_mem _ r, 0, Submodule.zero_mem _, by simp⟩

/-- **Decomposition**: given the expectation property at level `m`, every element of `tlSub e (m+1)`
is `a + b` with `a ∈ tlSub e m` and `b` in the span of the `v e_m w`. -/
lemma dec_succ {m : ℕ}
    (hCE : ∀ z ∈ tlSub (k := k) e m, ∃ z' ∈ tlSub (k := k) e m, e m * z * e m = z' * e m) {z : A}
    (hz : z ∈ tlSub (k := k) e (m + 1)) :
    ∃ a ∈ tlSub (k := k) e m, ∃ b ∈ midSpan (k := k) e m, z = a + b := by
  have hle : tlSub (k := k) e (m + 1) ≤ decSub e m hCE := by
    apply Algebra.adjoin_le
    rintro x ⟨j, hj, rfl⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h | h
    · exact ⟨e j, e_mem_tlSub h, 0, Submodule.zero_mem _, by simp⟩
    · subst h
      refine ⟨0, Subalgebra.zero_mem _, e j, Submodule.subset_span ⟨1, Subalgebra.one_mem _, 1,
        Subalgebra.one_mem _, by simp⟩, by simp⟩
  exact hle hz

/-- **Jones' conditional expectation**: `e_m z e_m = z' e_m` with `z' ∈ tlSub e m`, for `z ∈ tlSub e m`. -/
theorem expectation (he : IsTL δ e) :
    ∀ m : ℕ, ∀ z ∈ tlSub (k := k) e m, ∃ z' ∈ tlSub (k := k) e m, e m * z * e m = z' * e m := by
  intro m
  induction m with
  | zero =>
    intro z hz
    have hbot : tlSub (k := k) e 0 = ⊥ := by
      unfold tlSub
      have : {x | ∃ j < 0, x = e j} = (∅ : Set A) := by
        ext x; simp
      rw [this, Algebra.adjoin_empty]
    rw [hbot] at hz
    obtain ⟨r, rfl⟩ := Algebra.mem_bot.mp hz
    refine ⟨algebraMap k A (r * δ), Subalgebra.algebraMap_mem _ _, ?_⟩
    calc e 0 * algebraMap k A r * e 0 = algebraMap k A r * (e 0 * e 0) := by
          rw [← Algebra.commutes r (e 0), mul_assoc]
      _ = algebraMap k A (r * δ) * e 0 := by rw [he.sq, ← mul_assoc, ← map_mul]
  | succ m ih =>
    intro z hz
    obtain ⟨a, ha, b, hb, rfl⟩ := dec_succ ih hz
    have hmono : tlSub (k := k) e m ≤ tlSub e (m + 1) := tlSub_mono (Nat.le_succ m)
    have hQa : ∀ a ∈ tlSub (k := k) e m, ∃ z' ∈ tlSub (k := k) e (m + 1),
        e (m + 1) * a * e (m + 1) = z' * e (m + 1) := by
      intro a ha
      refine ⟨algebraMap k A δ * a, Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (hmono ha), ?_⟩
      calc e (m + 1) * a * e (m + 1) = a * (e (m + 1) * e (m + 1)) := by
            rw [comm_tlSub he (le_refl _) ha, mul_assoc]
        _ = algebraMap k A δ * a * e (m + 1) := by
            rw [he.sq, ← mul_assoc, ← Algebra.commutes δ a]
    have hQb : ∀ b ∈ midSpan (k := k) e m, ∃ z' ∈ tlSub (k := k) e (m + 1),
        e (m + 1) * b * e (m + 1) = z' * e (m + 1) := by
      intro b hb
      induction hb using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨v, hv, w, hw, rfl⟩ := hx
        refine ⟨v * w, Subalgebra.mul_mem _ (hmono hv) (hmono hw), ?_⟩
        have c1 := comm_tlSub he (le_refl _) hv
        have c2 := comm_tlSub he (le_refl _) hw
        calc e (m + 1) * (v * e m * w) * e (m + 1)
            = (e (m + 1) * v) * e m * (w * e (m + 1)) := by simp only [mul_assoc]
          _ = v * (e (m + 1) * e m * e (m + 1)) * w := by rw [c1, ← c2]; simp only [mul_assoc]
          _ = v * e (m + 1) * w := by rw [he.braid_r]
          _ = v * (w * e (m + 1)) := by rw [mul_assoc, c2]
          _ = v * w * e (m + 1) := by rw [mul_assoc]
      | zero => exact ⟨0, Subalgebra.zero_mem _, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨z1, h1, e1⟩ := hx
        obtain ⟨z2, h2, e2⟩ := hy
        exact ⟨z1 + z2, Subalgebra.add_mem _ h1 h2, by rw [mul_add, add_mul, e1, e2, add_mul]⟩
      | smul r x _ hx =>
        obtain ⟨z1, h1, e1⟩ := hx
        exact ⟨r • z1, Subalgebra.smul_mem _ h1 r, by rw [mul_smul_comm, smul_mul_assoc, e1, smul_mul_assoc]⟩
    obtain ⟨za, hza, ea⟩ := hQa a ha
    obtain ⟨zb, hzb, eb⟩ := hQb b hb
    exact ⟨za + zb, Subalgebra.add_mem _ hza hzb, by rw [mul_add, add_mul, ea, eb, add_mul]⟩

/-- **Absorption.** If `p` is annihilated on both sides by `e_j` for `j < m`, then every `x ∈ tlSub e m` acts
on `p` by a scalar: `p x = c p = x p`. -/
theorem absorb {m : ℕ} {p : A} (hL : ∀ j < m, e j * p = 0) (hR : ∀ j < m, p * e j = 0) :
    ∀ x ∈ tlSub (k := k) e m, ∃ c : k, p * x = c • p ∧ x * p = c • p := by
  intro x hx
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    exact ⟨0, by simpa using hR j hj, by simpa using hL j hj⟩
  | algebraMap r =>
    exact ⟨r, by rw [← Algebra.commutes, Algebra.smul_def], by rw [Algebra.smul_def]⟩
  | add x y _ _ hx hy =>
    obtain ⟨c, h1, h2⟩ := hx
    obtain ⟨d, h3, h4⟩ := hy
    exact ⟨c + d, by rw [mul_add, h1, h3, add_smul], by rw [add_mul, h2, h4, add_smul]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨c, h1, h2⟩ := hx
    obtain ⟨d, h3, h4⟩ := hy
    refine ⟨c * d, ?_, ?_⟩
    · rw [← mul_assoc, h1, smul_mul_assoc, h3, smul_smul]
    · rw [mul_assoc, h4, mul_smul_comm, h2, smul_smul, mul_comm]

end Lightlike.TemperleyLieb
