import Mathlib
import Lightlike.TemperleyLieb.Reduction

/-!
# The trivalent vertex and its norm (Schur's lemma for the model)

Shifted Jones–Wenzl projectors `jwAt q s n` (on the strands `s, …, s+n-1`) and the sandwich
`V' V = p_c · nestCap · (p_a p_b') · nestCup · p_c` of the vertex `V(a,b;c)` with its dual (`i` arcs at the junction
`l = a - i`, `c = a + b - 2 i`).  `vertex_norm` shows that `V' V` is a scalar multiple of `p_c`: the sandwich of
the closed-up diagram lies in `C (c-1)` (`nestCap_mul_nestCup_mem`), and `p_c` absorbs `C (c-1)`.
-/

namespace Lightlike.TemperleyLieb

open Finsupp

variable {k : Type*} [Field k]

/-- The loop value of the model. -/
noncomputable def loopVal (q : kˣ) : k := -(q : k) - ((q⁻¹ : kˣ) : k)

/-- The Jones–Wenzl projector on the strands `s, …, s + n - 1` of the model. -/
noncomputable def jwAt (q : kˣ) (s n : ℕ) : Module.End k (ModelSpace k) :=
  jw (loopVal q) (fun j => modelE q (j + s)) n

/-- The shifted generators satisfy the Temperley–Lieb relations. -/
theorem isTL_shift (q : kˣ) (s : ℕ) : IsTL (loopVal q) (fun j => (modelE q (j + s) : Module.End k (ModelSpace k))) where
  sq i := (modelE_isTL q).sq (i + s)
  braid_l i := by simpa [add_assoc, add_comm, add_left_comm] using (modelE_isTL q).braid_l (i + s)
  braid_r i := by simpa [add_assoc, add_comm, add_left_comm] using (modelE_isTL q).braid_r (i + s)
  comm i j h := (modelE_isTL q).comm (i + s) (j + s) (by omega)

/-- The shifted projector lies in the subalgebra generated by the generators below `s + n - 1`. -/
theorem jwAt_mem (q : kˣ) (s : ℕ) : ∀ n, jwAt q s n ∈ CSub q (s + n - 1) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases n with _ | _ | n
    · unfold jwAt; rw [jw_zero]; exact Subalgebra.one_mem _
    · unfold jwAt; rw [jw_one]; exact Subalgebra.one_mem _
    · have h1 : jwAt q s (n + 1) ∈ CSub q (s + (n + 1) - 1) := ih (n + 1) (by omega)
      have h2 : jwAt q s (n + 2) = jwAt q s (n + 1) -
          (chebD (loopVal q) n / chebD (loopVal q) (n + 1)) •
            (jwAt q s (n + 1) * modelE q (n + s) * jwAt q s (n + 1)) := jw_succ_succ n
      rw [h2]
      have h3 : jwAt q s (n + 1) ∈ CSub q (s + (n + 2) - 1) :=
        tlSub_mono (m := s + (n + 1) - 1) (n := s + (n + 2) - 1) (by omega) h1
      have h4 : (chebD (loopVal q) n / chebD (loopVal q) (n + 1)) •
          (jwAt q s (n + 1) * modelE q (n + s) * jwAt q s (n + 1)) ∈ CSub q (s + (n + 2) - 1) :=
        Subalgebra.smul_mem _ (Subalgebra.mul_mem _
          (Subalgebra.mul_mem _ h3 (e_mem_tlSub (e := modelE q) (j := n + s) (m := s + (n + 2) - 1) (by omega)))
          h3) _
      have h5 := Subalgebra.add_mem _ h3 (Subalgebra.smul_mem (CSub q (s + (n + 2) - 1)) h4 (-1 : k))
      convert h5 using 1
      module

/-- **The norm of the vertex** (Schur's lemma): for `i ≤ a, b`, `c = a + b - 2i` and `d_j ≠ 0` for `j < c`,
`p_c · (nestCap · p_a p_b' · nestCup) · p_c` is a scalar multiple of `p_c`. -/
theorem vertex_norm (q : kˣ) (a b i : ℕ) (hia : i ≤ a) (hib : i ≤ b)
    (hd : ∀ j, j < a + b - 2 * i → chebD (loopVal q) j ≠ 0) :
    ∃ κ : k, jwAt q 0 (a + b - 2 * i) *
        (nestCap q (a - i) i * (jwAt q 0 a * jwAt q a b) * nestCup q (a - i) i) *
        jwAt q 0 (a + b - 2 * i) = κ • jwAt q 0 (a + b - 2 * i) := by
  set c := a + b - 2 * i with hc
  have hQ : jwAt q 0 a * jwAt q a b ∈ CSub q (a + b - 1) := by
    have h1 : jwAt q 0 a ∈ CSub q (a + b - 1) :=
      tlSub_mono (m := 0 + a - 1) (n := a + b - 1) (by omega) (jwAt_mem q 0 a)
    have h2 : jwAt q a b ∈ CSub q (a + b - 1) := by
      have := jwAt_mem q a b
      rwa [show a + b - 1 = a + b - 1 from rfl] at this
    exact Subalgebra.mul_mem _ h1 h2
  have hZ := nestCap_mul_nestCup_mem q (a - i) i (a + b - 1) hQ (by omega)
  have hprops := jwProps_of_le (isTL_shift q 0) c hd c le_rfl
  have hjw : jwAt q 0 c = jw (loopVal q) (modelE q) c := rfl
  have hZ' : a + b - 1 - 2 * i = c - 1 := by omega
  rw [hZ'] at hZ
  have hL : ∀ j < c - 1, modelE q j * jwAt q 0 c = 0 := fun j hj => by
    rw [hjw]; exact hprops.killL j (by omega)
  have hR : ∀ j < c - 1, jwAt q 0 c * modelE q j = 0 := fun j hj => by
    rw [hjw]; exact hprops.killR j (by omega)
  obtain ⟨κ, h1, -⟩ := absorb (k := k) (e := modelE q) (p := jwAt q 0 c) hL hR _ hZ
  refine ⟨κ, ?_⟩
  have hidem : jwAt q 0 c * jwAt q 0 c = jwAt q 0 c := by rw [hjw]; exact hprops.idem
  rw [h1, smul_mul_assoc, hidem]

end Lightlike.TemperleyLieb
