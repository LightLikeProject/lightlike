/-!
# The CCR algebra of a symplectic vector space

C. Bär, N. Ginoux and F. Pfäffle, *Wave equations on Lorentzian manifolds and quantization*, arXiv:0806.1036 (read),
Section 4.2 (Definition 4.2.1, Example 4.2.2, Proposition 4.2.3): a *Weyl system* of a symplectic vector space `(V, ω)` is a unital C*-algebra `A` with a map `W : V → A`
(here `A` is any unital star algebra over `ℂ`),
`W(0) = 1`, `W(-φ) = W(φ)*`, `W(φ) W(ψ) = e^{-iω(φ,ψ)/2} W(φ + ψ)` (Definition 4.2.1); its elements `W(φ)` are unitary and
linearly independent (Proposition 4.2.3 (1), (4)); the CCR algebra `CCR(V, ω)` is the C*-algebra generated by the operators
`(W(φ)F)(ψ) = e^{iω(φ,ψ)/2} F(φ + ψ)` on `ℓ²(V)` (Example 4.2.2, "From now on we will call CCR(V, ω) as defined in
Example 4.2.2 the CCR-algebra", p. 122).

* `IsSymplecticForm ω`, `IsWeylSystem ω W` (Definition 4.2.1);
* `IsWeylSystem.mem_unitary`, `IsWeylSystem.linearIndependent` (Proposition 4.2.3 (1), (4));
* `IsWeylSystem.mem_spectrum`, `IsWeylSystem.norm_sub`, `IsWeylSystem.not_separableSpace`, `ccrAlgebra_not_separableSpace`:
  in a C*-algebra the spectrum of `W(χ)`, `χ ≠ 0`, is the unit circle, `‖W(φ) - W(ψ)‖ = 2` for `φ ≠ ψ`, and the algebra is
  not separable unless `V = 0` (Proposition 4.2.3 (2), (3));
* `weylOp ω B φ`: Example 4.2.2 on a Hilbert space with a Hilbert basis `B` indexed by `V` (for instance `ℓ²(V)`);
  `ccrAlgebra ω B`, the closed star subalgebra they generate, a C*-algebra, and `ccrW`, its Weyl system;
* `CCRRep.isWeylSystem`: the Weyl unitaries of a representation of the CCR over a complex inner product space `h` form a
  Weyl system of `(h, σ)`, `σ = Im⟪·,·⟫` (`symplecticForm`).
-/

open scoped InnerProductSpace

namespace Lightlike.OperatorAlgebras

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- **A symplectic form** on a real vector space (Bär-Ginoux-Pfäffle, Section 4.2): antisymmetric and nondegenerate. -/
structure IsSymplecticForm (ω : LinearMap.BilinForm ℝ V) : Prop where
  /-- `ω` is antisymmetric. -/
  antisymm : ∀ φ ψ, ω φ ψ = -ω ψ φ
  /-- `ω` is nondegenerate. -/
  nondeg : ∀ φ, (∀ ψ, ω φ ψ = 0) → φ = 0

lemma IsSymplecticForm.self_eq_zero {ω : LinearMap.BilinForm ℝ V} (hω : IsSymplecticForm ω) (φ : V) : ω φ φ = 0 := by
  have := hω.antisymm φ φ; linarith

/-- **A Weyl system** of `(V, ω)` in a unital star algebra `A` (Bär-Ginoux-Pfäffle, Definition 4.2.1). -/
structure IsWeylSystem {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A] (ω : LinearMap.BilinForm ℝ V) (W : V → A) :
    Prop where
  /-- `W(0) = 1`. -/
  map_zero : W 0 = 1
  /-- `W(-φ) = W(φ)*`. -/
  map_neg : ∀ φ, W (-φ) = star (W φ)
  /-- The Weyl relation. -/
  mul : ∀ φ ψ, W φ * W ψ = Complex.exp (-(Complex.I * ((ω φ ψ / 2 : ℝ) : ℂ))) • W (φ + ψ)

section WeylSystem

variable {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A] {ω : LinearMap.BilinForm ℝ V} {W : V → A}

/-- **The Weyl elements are unitary** (Bär-Ginoux-Pfäffle, Proposition 4.2.3 (1)). -/
theorem IsWeylSystem.mem_unitary (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) (φ : V) : W φ ∈ unitary A := by
  refine Unitary.mem_iff.mpr ⟨?_, ?_⟩
  · rw [← hW.map_neg, hW.mul, neg_add_cancel, hW.map_zero, _root_.map_neg ω φ, LinearMap.neg_apply, hω.self_eq_zero]
    simp
  · rw [← hW.map_neg, hW.mul, add_neg_cancel, hW.map_zero, _root_.map_neg (ω φ) φ, hω.self_eq_zero]
    simp

/-- Conjugation by a Weyl element: `W(ψ) W(χ) W(-ψ) = e^{-iω(ψ,χ)} W(χ)`. -/
lemma IsWeylSystem.conj (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) (ψ χ : V) :
    W ψ * W χ * W (-ψ) = Complex.exp (-(Complex.I * ((ω ψ χ : ℝ) : ℂ))) • W χ := by
  rw [hW.mul, smul_mul_assoc, hW.mul, smul_smul, ← Complex.exp_add, show ψ + χ + -ψ = χ by abel]
  congr 2
  have h1 : ω (ψ + χ) (-ψ) = ω ψ χ := by
    rw [map_add ω ψ χ, LinearMap.add_apply, _root_.map_neg (ω ψ) ψ, _root_.map_neg (ω χ) ψ, hω.self_eq_zero, hω.antisymm χ ψ]; ring
  rw [h1]
  push_cast
  ring

/-- **The Weyl elements are linearly independent** (Bär-Ginoux-Pfäffle, Proposition 4.2.3 (4)). -/
theorem IsWeylSystem.linearIndependent [Nontrivial A] (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) :
    LinearIndependent ℂ W := by
  classical
  rw [linearIndependent_iff']
  suffices key : ∀ n : ℕ, ∀ s : Finset V, s.card = n → ∀ g : V → ℂ, ∑ i ∈ s, g i • W i = 0 → ∀ i ∈ s, g i = 0 from
    fun s g h i hi => key _ s rfl g h i hi
  have hone : ∀ ψ, W ψ * W (-ψ) = 1 := fun ψ => by
    rw [hW.map_neg]; exact (Unitary.mem_iff.mp (hW.mem_unitary hω ψ)).2
  intro n
  induction n with
  | zero =>
    intro s hs g _ i hi
    rw [Finset.card_eq_zero] at hs; subst hs; simp at hi
  | succ n ih =>
    intro s hs g hsum
    obtain ⟨φn, t, hφn, rfl, htc⟩ := Finset.card_eq_succ.mp hs
    rw [Finset.sum_insert hφn] at hsum
    -- multiply by `W(-φn)`: `g φn • 1 + ∑ β φ • W(φ - φn) = 0`, with `β φ = 0` iff `g φ = 0`
    obtain ⟨β, hβg, h1⟩ : ∃ β : V → ℂ, (∀ φ, β φ = 0 → g φ = 0) ∧
        g φn • (1 : A) + ∑ φ ∈ t, β φ • W (φ - φn) = 0 := by
      refine ⟨fun φ => g φ * Complex.exp (-(Complex.I * ((ω (-φn) φ / 2 : ℝ) : ℂ))), fun φ h => ?_, ?_⟩
      · exact (mul_eq_zero.mp h).resolve_right (Complex.exp_ne_zero _)
      · have h0 : ω (-φn) φn = 0 := by rw [_root_.map_neg ω φn, LinearMap.neg_apply, hω.self_eq_zero, neg_zero]
        have := congrArg (W (-φn) * ·) hsum
        simp only [mul_add, Finset.mul_sum, mul_smul_comm, mul_zero] at this
        rw [hW.mul, neg_add_cancel, hW.map_zero, h0] at this
        simp only [hW.mul, smul_smul, ← sub_eq_neg_add] at this
        simpa using this
    -- conjugating by `W(ψ)` multiplies the coefficient of `W(χ)` by `e^{-iω(ψ, χ)}`
    have hconj : ∀ ψ, g φn • (1 : A) +
        ∑ φ ∈ t, (β φ * Complex.exp (-(Complex.I * ((ω ψ (φ - φn) : ℝ) : ℂ)))) • W (φ - φn) = 0 := by
      intro ψ
      have := congrArg (fun a => W ψ * a * W (-ψ)) h1
      simp only [mul_add, add_mul, Finset.mul_sum, Finset.sum_mul, mul_smul_comm, smul_mul_assoc, mul_one,
        mul_zero, zero_mul, hone, hW.conj hω, smul_smul] at this
      exact this
    have h2 : ∀ ψ, ∑ φ ∈ t, (β φ * (1 - Complex.exp (-(Complex.I * ((ω ψ (φ - φn) : ℝ) : ℂ))))) •
        W (φ - φn) = 0 := by
      intro ψ
      have := congrArg₂ (· - ·) h1 (hconj ψ)
      simp only [add_sub_add_left_eq_sub, sub_self, ← Finset.sum_sub_distrib, ← sub_smul] at this
      rw [← this]
      refine Finset.sum_congr rfl fun φ _ => ?_
      congr 1; ring
    have hinj : Set.InjOn (fun φ => φ - φn) t := fun a _ b _ h => sub_left_injective h
    have hβ : ∀ φ ∈ t, β φ = 0 := by
      intro φ hφ
      have hne : φ - φn ≠ 0 := sub_ne_zero.mpr fun h => hφn (h ▸ hφ)
      obtain ⟨ψ0, hψ0⟩ : ∃ ψ0, ω (φ - φn) ψ0 ≠ 0 := by
        by_contra hcon; push_neg at hcon; exact hne (hω.nondeg _ hcon)
      have hω0 : ω ψ0 (φ - φn) ≠ 0 := by rw [hω.antisymm]; exact neg_ne_zero.mpr hψ0
      have hωψ : ω ((Real.pi / ω ψ0 (φ - φn)) • ψ0) (φ - φn) = Real.pi := by
        rw [map_smul, LinearMap.smul_apply, smul_eq_mul]; field_simp
      have h3 : ∑ χ ∈ t.image (fun φ => φ - φn),
          (β (χ + φn) * (1 - Complex.exp (-(Complex.I *
            ((ω ((Real.pi / ω ψ0 (φ - φn)) • ψ0) χ : ℝ) : ℂ))))) • W χ = 0 := by
        rw [Finset.sum_image (fun a ha b hb h => hinj ha hb h)]
        simpa only [sub_add_cancel] using h2 ((Real.pi / ω ψ0 (φ - φn)) • ψ0)
      have h4 := ih (t.image fun φ => φ - φn) (by rw [Finset.card_image_of_injOn hinj, htc]) _ h3 (φ - φn)
        (Finset.mem_image_of_mem _ hφ)
      simp only [sub_add_cancel, hωψ] at h4
      have he : Complex.exp (-(Complex.I * (Real.pi : ℂ))) = -1 := by
        rw [show -(Complex.I * (Real.pi : ℂ)) = -(↑Real.pi * Complex.I) by ring, Complex.exp_neg, Complex.exp_pi_mul_I]
        norm_num
      rw [he] at h4
      exact (mul_eq_zero.mp h4).resolve_right (by norm_num)
    have hg : ∀ φ ∈ t, g φ = 0 := fun φ hφ => hβg φ (hβ φ hφ)
    have hsum' : g φn • W φn = 0 := by
      rw [Finset.sum_eq_zero (fun φ hφ => by rw [hg φ hφ, zero_smul]), add_zero] at hsum
      exact hsum
    have hWne : W φn ≠ 0 := fun h0 => by
      have := (Unitary.mem_iff.mp (hW.mem_unitary hω φn)).1
      rw [h0, mul_zero] at this
      exact zero_ne_one this
    have hgn : g φn = 0 := (smul_eq_zero.mp hsum').resolve_right hWne
    intro i hi
    rcases Finset.mem_insert.mp hi with rfl | hi
    · exact hgn
    · exact hg i hi

end WeylSystem

section WeylNorm

variable {A : Type*} [CStarAlgebra A] [Nontrivial A] {ω : LinearMap.BilinForm ℝ V} {W : V → A}

/-- **The spectrum of `W(χ)`, `χ ≠ 0`, is the whole unit circle** (Bär-Ginoux-Pfäffle, proof of Proposition 4.2.3 (2)):
conjugation by `W(ξ)` multiplies it by `e^{-iω(ξ,χ)}`, and `ω(ξ, χ)` takes every real value. -/
theorem IsWeylSystem.mem_spectrum (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) {χ : V} (hχ : χ ≠ 0) {μ : ℂ}
    (hμ : ‖μ‖ = 1) : μ ∈ spectrum ℂ (W χ) := by
  obtain ⟨lam, hlam⟩ := spectrum.nonempty (W χ)
  have hlam1 : ‖lam‖ = 1 := by
    have := spectrum.subset_circle_of_unitary (𝕜 := ℂ) (hW.mem_unitary hω χ) hlam
    simpa using this
  have hrot : ∀ r : ℝ, ∀ ν ∈ spectrum ℂ (W χ), Complex.exp (-(Complex.I * (r : ℂ))) * ν ∈ spectrum ℂ (W χ) := by
    obtain ⟨ξ₀, hξ₀⟩ : ∃ ξ₀, ω ξ₀ χ ≠ 0 := by
      by_contra h
      push_neg at h
      exact hχ (hω.nondeg χ fun ψ => by rw [hω.antisymm, h ψ, neg_zero])
    intro r ν hν
    have hωξ : ω ((r / ω ξ₀ χ) • ξ₀) χ = r := by
      rw [map_smul, LinearMap.smul_apply, smul_eq_mul, div_mul_cancel₀ _ hξ₀]
    set u : Aˣ := Unitary.toUnits ⟨W ((r / ω ξ₀ χ) • ξ₀), hW.mem_unitary hω _⟩ with hu
    have hinv : ((u⁻¹ : Aˣ) : A) = W (-((r / ω ξ₀ χ) • ξ₀)) := by
      rw [hW.map_neg]
      rfl
    have hconj : (u : A) * W χ * ((u⁻¹ : Aˣ) : A) = Complex.exp (-(Complex.I * (r : ℂ))) • W χ := by
      rw [hinv, show (u : A) = W ((r / ω ξ₀ χ) • ξ₀) from rfl, hW.conj hω, hωξ]
    have hs := spectrum.units_conjugate (R := ℂ) (a := W χ) (u := u)
    rw [hconj, spectrum.smul_eq_smul _ _ ⟨ν, hν⟩] at hs
    rw [← hs]
    exact Set.smul_mem_smul_set hν
  have hlam0 : lam ≠ 0 := fun h => by rw [h, norm_zero] at hlam1; exact zero_ne_one hlam1
  have hz1 : ‖μ / lam‖ = 1 := by rw [norm_div, hμ, hlam1, div_one]
  have key := hrot (-Complex.arg (μ / lam)) lam hlam
  have hexp : Complex.exp (-(Complex.I * ((-Complex.arg (μ / lam) : ℝ) : ℂ))) = μ / lam := by
    have h1 : Complex.exp (↑(Complex.arg (μ / lam)) * Complex.I) = μ / lam := by
      have := Complex.norm_mul_exp_arg_mul_I (μ / lam)
      rwa [hz1, Complex.ofReal_one, one_mul] at this
    refine Eq.trans ?_ h1
    congr 1
    push_cast
    ring
  rwa [hexp, div_mul_cancel₀ _ hlam0] at key

/-- **`‖W(φ) - W(ψ)‖ = 2` for `φ ≠ ψ`** (Bär-Ginoux-Pfäffle, Proposition 4.2.3 (2)). -/
theorem IsWeylSystem.norm_sub (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) {φ ψ : V} (h : φ ≠ ψ) :
    ‖W φ - W ψ‖ = 2 := by
  have hχ0 : φ - ψ ≠ 0 := sub_ne_zero.mpr h
  set c : ℂ := Complex.exp (Complex.I * ((ω ψ (φ - ψ) / 2 : ℝ) : ℂ)) with hc
  have hc1 : ‖c‖ = 1 := by rw [hc, mul_comm]; exact Complex.norm_exp_ofReal_mul_I _
  have hdecomp : W φ - W ψ = W ψ * (c • W (φ - ψ) - 1) := by
    have h1 := hW.mul ψ (φ - ψ)
    rw [show ψ + (φ - ψ) = φ by abel] at h1
    rw [mul_sub, mul_one, mul_smul_comm, h1, smul_smul, hc, ← Complex.exp_add, add_neg_cancel, Complex.exp_zero,
      one_smul]
  rw [hdecomp, show W ψ = ((⟨W ψ, hW.mem_unitary hω ψ⟩ : unitary A) : A) from rfl, CStarRing.norm_coe_unitary_mul]
  apply le_antisymm
  · calc ‖c • W (φ - ψ) - 1‖ ≤ ‖c • W (φ - ψ)‖ + ‖(1 : A)‖ := norm_sub_le _ _
      _ = 2 := by
        rw [norm_smul, hc1, CStarRing.norm_of_mem_unitary (hW.mem_unitary hω _), norm_one]
        norm_num
  · have hc0 : c ≠ 0 := fun h0 => by rw [h0, norm_zero] at hc1; exact zero_ne_one hc1
    have hm : -c⁻¹ ∈ spectrum ℂ (W (φ - ψ)) :=
      hW.mem_spectrum hω hχ0 (by rw [norm_neg, norm_inv, hc1, inv_one])
    have h1 : (-1 : ℂ) ∈ spectrum ℂ (c • W (φ - ψ)) := by
      rw [spectrum.smul_eq_smul _ _ ⟨_, hm⟩]
      convert Set.smul_mem_smul_set (a := c) hm using 1
      rw [smul_eq_mul, mul_neg, mul_inv_cancel₀ hc0]
    have h2 : (-2 : ℂ) ∈ spectrum ℂ (c • W (φ - ψ) - 1) := by
      rw [show (1 : A) = algebraMap ℂ A 1 from (map_one _).symm, ← spectrum.sub_singleton_eq]
      exact ⟨-1, h1, 1, Set.mem_singleton 1, by norm_num⟩
    have := spectrum.norm_le_norm_of_mem h2
    simpa using this

/-- **A C*-algebra with a Weyl system of a nonzero symplectic space is not separable** (Bär-Ginoux-Pfäffle,
Proposition 4.2.3 (3)): the balls of radius `1` around the `W(φ)` are disjoint, and there are uncountably many. -/
theorem IsWeylSystem.not_separableSpace [Nontrivial V] (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) :
    ¬ TopologicalSpace.SeparableSpace A := by
  intro hsep
  have hdisj : (Set.univ : Set V).PairwiseDisjoint fun φ => Metric.ball (W φ) 1 := by
    intro φ _ ψ _ hφψ
    refine Set.disjoint_left.mpr fun x hx hx' => ?_
    have h2 := hW.norm_sub hω hφψ
    have hlt : dist (W φ) (W ψ) < 2 := by
      calc dist (W φ) (W ψ) ≤ dist (W φ) x + dist x (W ψ) := dist_triangle _ _ _
        _ < 1 + 1 := add_lt_add (by rw [dist_comm]; exact hx) hx'
        _ = 2 := by norm_num
    rw [dist_eq_norm, h2] at hlt
    exact lt_irrefl _ hlt
  have hc := hdisj.countable_of_isOpen (fun φ _ => Metric.isOpen_ball)
    (fun φ _ => ⟨W φ, Metric.mem_ball_self one_pos⟩)
  obtain ⟨v, hv⟩ := exists_ne (0 : V)
  have hinj : Function.Injective fun t : ℝ => t • v := smul_left_injective ℝ hv
  have : Countable V := Set.countable_univ_iff.mp hc
  exact Cardinal.not_countable_real (Set.countable_univ_iff.mpr hinj.countable)

/-- Conjugation of a finite combination of Weyl elements: `W(ξ) (∑ c_ψ W(ψ)) W(-ξ) = ∑ e^{-iω(ξ,ψ)} c_ψ W(ψ)`. -/
lemma IsWeylSystem.conj_sum (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) (ξ : V) (s : Finset V) (c : V → ℂ) :
    W ξ * (∑ ψ ∈ s, c ψ • W ψ) * W (-ξ) =
      ∑ ψ ∈ s, (Complex.exp (-(Complex.I * ((ω ξ ψ : ℝ) : ℂ))) * c ψ) • W ψ := by
  rw [Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun ψ _ => ?_
  rw [mul_smul_comm, smul_mul_assoc, hW.conj hω, smul_smul, mul_comm]

/-- **The coefficient of `W(0)` is bounded by the norm** (Bär-Ginoux-Pfäffle, proof of Lemma 4.2.7, here in any
C*-algebra): `|c₀| ≤ ‖∑_{ψ ∈ s} c_ψ W(ψ)‖`. Averaging `a` with `W(ξ) a W(ξ)*` for `ω(ξ, φ) = π` removes the term of
`φ ≠ 0` and keeps the term of `0`, without increasing the norm. -/
theorem IsWeylSystem.norm_coeff_zero_le (hω : IsSymplecticForm ω) (hW : IsWeylSystem ω W) (s : Finset V)
    (c : V → ℂ) (h0 : (0 : V) ∈ s) : ‖c 0‖ ≤ ‖∑ ψ ∈ s, c ψ • W ψ‖ := by
  classical
  suffices key : ∀ n, ∀ c : V → ℂ, (s.filter fun ψ => ψ ≠ 0 ∧ c ψ ≠ 0).card ≤ n →
      ‖c 0‖ ≤ ‖∑ ψ ∈ s, c ψ • W ψ‖ from key _ c le_rfl
  intro n
  induction n with
  | zero =>
    intro c hc
    have hempty := Finset.card_eq_zero.mp (Nat.le_zero.mp hc)
    have hsum : ∑ ψ ∈ s, c ψ • W ψ = c 0 • W 0 := by
      refine Finset.sum_eq_single_of_mem 0 h0 fun ψ hψ hψ0 => ?_
      by_contra hne
      have hmem : ψ ∈ s.filter fun ψ => ψ ≠ 0 ∧ c ψ ≠ 0 :=
        Finset.mem_filter.mpr ⟨hψ, hψ0, fun h => hne (by rw [h, zero_smul])⟩
      rw [hempty] at hmem
      exact Finset.notMem_empty _ hmem
    rw [hsum, hW.map_zero, norm_smul, norm_one, mul_one]
  | succ n ih =>
    intro c hc
    by_cases hex : ∃ φ ∈ s, φ ≠ 0 ∧ c φ ≠ 0
    · obtain ⟨φ, hφs, hφ0, hcφ⟩ := hex
      obtain ⟨ξ₀, hξ₀⟩ : ∃ ξ₀, ω ξ₀ φ ≠ 0 := by
        by_contra h
        push_neg at h
        exact hφ0 (hω.nondeg φ fun ψ => by rw [hω.antisymm, h ψ, neg_zero])
      set ξ := (Real.pi / ω ξ₀ φ) • ξ₀ with hξ
      have hωξ : ω ξ φ = Real.pi := by
        rw [hξ, map_smul, LinearMap.smul_apply, smul_eq_mul, div_mul_cancel₀ _ hξ₀]
      set c' : V → ℂ := fun ψ => ((1 + Complex.exp (-(Complex.I * ((ω ξ ψ : ℝ) : ℂ)))) / 2) * c ψ with hc'
      have hc'0 : c' 0 = c 0 := by
        have hz : ω ξ 0 = 0 := _root_.map_zero (ω ξ)
        simp only [hc', hz, Complex.ofReal_zero, mul_zero, neg_zero, Complex.exp_zero]
        ring
      have hc'φ : c' φ = 0 := by
        simp only [hc', hωξ]
        rw [mul_comm Complex.I, Complex.exp_neg, Complex.exp_pi_mul_I]
        ring
      have hsub : (s.filter fun ψ => ψ ≠ 0 ∧ c' ψ ≠ 0) ⊆ (s.filter fun ψ => ψ ≠ 0 ∧ c ψ ≠ 0).erase φ := by
        intro ψ hψ
        simp only [Finset.mem_filter, Finset.mem_erase] at hψ ⊢
        refine ⟨fun h => hψ.2.2 (by rw [h]; exact hc'φ), hψ.1, hψ.2.1, fun h => hψ.2.2 ?_⟩
        simp only [hc', h, mul_zero]
      have hcard : (s.filter fun ψ => ψ ≠ 0 ∧ c' ψ ≠ 0).card ≤ n := by
        have h1 := Finset.card_le_card hsub
        have h2 := Finset.card_erase_of_mem (s := s.filter fun ψ => ψ ≠ 0 ∧ c ψ ≠ 0) (a := φ)
          (Finset.mem_filter.mpr ⟨hφs, hφ0, hcφ⟩)
        omega
      have hsum' : ∑ ψ ∈ s, c' ψ • W ψ = (1 / 2 : ℂ) • ((∑ ψ ∈ s, c ψ • W ψ) +
          W ξ * (∑ ψ ∈ s, c ψ • W ψ) * W (-ξ)) := by
        rw [hW.conj_sum hω, ← Finset.sum_add_distrib, Finset.smul_sum]
        refine Finset.sum_congr rfl fun ψ _ => ?_
        rw [← add_smul, smul_smul]
        congr 1
        simp only [hc']
        ring
      have hnorm : ‖(1 / 2 : ℂ) • ((∑ ψ ∈ s, c ψ • W ψ) + W ξ * (∑ ψ ∈ s, c ψ • W ψ) * W (-ξ))‖ ≤
          ‖∑ ψ ∈ s, c ψ • W ψ‖ := by
        have hu : ‖W ξ * (∑ ψ ∈ s, c ψ • W ψ) * W (-ξ)‖ = ‖∑ ψ ∈ s, c ψ • W ψ‖ := by
          rw [show W ξ = ((⟨W ξ, hW.mem_unitary hω ξ⟩ : unitary A) : A) from rfl,
            show W (-ξ) = ((⟨W (-ξ), hW.mem_unitary hω (-ξ)⟩ : unitary A) : A) from rfl, mul_assoc,
            CStarRing.norm_coe_unitary_mul, CStarRing.norm_mul_coe_unitary]
        rw [norm_smul]
        calc ‖(1 / 2 : ℂ)‖ * ‖(∑ ψ ∈ s, c ψ • W ψ) + W ξ * (∑ ψ ∈ s, c ψ • W ψ) * W (-ξ)‖
            ≤ ‖(1 / 2 : ℂ)‖ * (‖∑ ψ ∈ s, c ψ • W ψ‖ + ‖W ξ * (∑ ψ ∈ s, c ψ • W ψ) * W (-ξ)‖) :=
              mul_le_mul_of_nonneg_left (norm_add_le _ _) (norm_nonneg _)
          _ = ‖∑ ψ ∈ s, c ψ • W ψ‖ := by
              rw [hu, norm_div, norm_one, Complex.norm_two]
              ring
      calc ‖c 0‖ = ‖c' 0‖ := by rw [hc'0]
        _ ≤ ‖∑ ψ ∈ s, c' ψ • W ψ‖ := ih c' hcard
        _ ≤ ‖∑ ψ ∈ s, c ψ • W ψ‖ := by rw [hsum']; exact hnorm
    · push_neg at hex
      refine ih c (le_of_eq ?_ |>.trans (Nat.zero_le n))
      refine Finset.card_eq_zero.mpr (Finset.filter_eq_empty_iff.mpr fun ψ hψ h => ?_)
      exact h.2 (hex ψ hψ h.1)

end WeylNorm

/-! ### The CCR algebra (Bär-Ginoux-Pfäffle, Example 4.2.2) -/

section CCR

variable (ω : LinearMap.BilinForm ℝ V)

/-- The phase `e^{iω(φ,ψ)/2}`. -/
noncomputable def weylPhase' (φ ψ : V) : ℂ := Complex.exp (Complex.I * ((ω φ ψ / 2 : ℝ) : ℂ))

lemma norm_weylPhase' (φ ψ : V) : ‖weylPhase' ω φ ψ‖ = 1 := by
  rw [weylPhase', Complex.norm_exp]; simp

lemma memℓp_translate (φ : V) (F : lp (fun _ : V => ℂ) 2) :
    Memℓp (fun ψ => weylPhase' ω φ ψ * F (φ + ψ)) 2 := by
  have h2 : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
  have hF : Memℓp (fun ψ => F (φ + ψ)) 2 := by
    have := (lp.memℓp F)
    rw [memℓp_gen_iff h2] at this ⊢
    exact (Equiv.addLeft φ).summable_iff.mpr this
  refine hF.mono' fun ψ => ?_
  rw [norm_mul, norm_weylPhase', one_mul]

/-- **The Weyl operators of Example 4.2.2** on the coefficients: `(W(φ)F)(ψ) = e^{iω(φ,ψ)/2} F(φ + ψ)`. -/
noncomputable def weylCoeff (φ : V) : lp (fun _ : V => ℂ) 2 →ₗ[ℂ] lp (fun _ : V => ℂ) 2 where
  toFun F := ⟨fun ψ => weylPhase' ω φ ψ * F (φ + ψ), memℓp_translate ω φ F⟩
  map_add' F G := by
    ext ψ
    show weylPhase' ω φ ψ * (F + G) (φ + ψ) = weylPhase' ω φ ψ * F (φ + ψ) + weylPhase' ω φ ψ * G (φ + ψ)
    rw [lp.coeFn_add, Pi.add_apply]; ring
  map_smul' c F := by
    ext ψ
    show weylPhase' ω φ ψ * (c • F) (φ + ψ) = c * (weylPhase' ω φ ψ * F (φ + ψ))
    rw [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul]; ring

lemma weylCoeff_apply (φ : V) (F : lp (fun _ : V => ℂ) 2) (ψ : V) :
    weylCoeff ω φ F ψ = weylPhase' ω φ ψ * F (φ + ψ) := rfl

lemma norm_weylCoeff (φ : V) (F : lp (fun _ : V => ℂ) 2) : ‖weylCoeff ω φ F‖ = ‖F‖ := by
  have h2 : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
  have h : ‖weylCoeff ω φ F‖ ^ (2 : ENNReal).toReal = ‖F‖ ^ (2 : ENNReal).toReal := by
    rw [lp.norm_rpow_eq_tsum h2, lp.norm_rpow_eq_tsum h2]
    simp only [weylCoeff_apply, norm_mul, norm_weylPhase', one_mul]
    exact (Equiv.addLeft φ).tsum_eq (fun ψ => ‖F ψ‖ ^ (2 : ENNReal).toReal)
  exact Real.rpow_left_injOn h2.ne' (norm_nonneg _) (norm_nonneg _) h

variable {ω}

lemma weylCoeff_weylCoeff (hω : IsSymplecticForm ω) (φ ψ : V) (F : lp (fun _ : V => ℂ) 2) :
    weylCoeff ω φ (weylCoeff ω ψ F) =
      Complex.exp (-(Complex.I * ((ω φ ψ / 2 : ℝ) : ℂ))) • weylCoeff ω (φ + ψ) F := by
  ext χ
  simp only [weylCoeff_apply, lp.coeFn_smul, Pi.smul_apply, smul_eq_mul, weylPhase']
  rw [show ψ + (φ + χ) = φ + ψ + χ by abel, ← mul_assoc, ← mul_assoc, ← Complex.exp_add, ← Complex.exp_add]
  congr 2
  simp only [map_add, LinearMap.add_apply, hω.antisymm ψ φ]
  push_cast; ring

lemma weylCoeff_zero (F : lp (fun _ : V => ℂ) 2) : weylCoeff ω 0 F = F := by
  ext ψ; simp [weylCoeff_apply, weylPhase']

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (B : HilbertBasis V ℂ H)

variable (ω) in
/-- **The Weyl operator** `W(φ)` of Example 4.2.2 on a Hilbert space with a Hilbert basis `B` indexed by `V`, acting on the
coefficients in `B` by `(W(φ)F)(ψ) = e^{iω(φ,ψ)/2} F(φ + ψ)`. -/
noncomputable def weylOp (φ : V) : H →L[ℂ] H :=
  LinearMap.mkContinuous ((B.repr.symm.toLinearEquiv.toLinearMap ∘ₗ weylCoeff ω φ) ∘ₗ B.repr.toLinearEquiv.toLinearMap)
    1 (fun x => by
      show ‖B.repr.symm (weylCoeff ω φ (B.repr x))‖ ≤ 1 * ‖x‖
      rw [LinearIsometryEquiv.norm_map, norm_weylCoeff, LinearIsometryEquiv.norm_map, one_mul])

lemma repr_weylOp (φ : V) (x : H) : B.repr (weylOp ω B φ x) = weylCoeff ω φ (B.repr x) := by
  show B.repr (B.repr.symm _) = _; exact B.repr.apply_symm_apply _

lemma weylOp_ext {A A' : H →L[ℂ] H} (h : ∀ x, B.repr (A x) = B.repr (A' x)) : A = A' :=
  ContinuousLinearMap.ext fun x => B.repr.injective (h x)

lemma weylOp_mul (hω : IsSymplecticForm ω) (φ ψ : V) :
    weylOp ω B φ * weylOp ω B ψ = Complex.exp (-(Complex.I * ((ω φ ψ / 2 : ℝ) : ℂ))) • weylOp ω B (φ + ψ) :=
  weylOp_ext B fun x => by
    rw [ContinuousLinearMap.mul_apply, repr_weylOp, repr_weylOp, weylCoeff_weylCoeff hω, ContinuousLinearMap.smul_apply,
      map_smul, repr_weylOp]

lemma weylOp_zero : weylOp ω B 0 = 1 :=
  weylOp_ext B fun x => by rw [repr_weylOp, weylCoeff_zero, ContinuousLinearMap.one_apply]

lemma weylOp_neg (hω : IsSymplecticForm ω) (φ : V) : weylOp ω B (-φ) = ContinuousLinearMap.adjoint (weylOp ω B φ) := by
  have hinv : weylOp ω B φ * weylOp ω B (-φ) = 1 := by
    rw [weylOp_mul B hω, add_neg_cancel, weylOp_zero, map_neg (ω φ) φ, hω.self_eq_zero]; simp
  have hiso : ∀ x, ‖weylOp ω B φ x‖ = ‖x‖ := fun x => by
    rw [← LinearIsometryEquiv.norm_map B.repr, repr_weylOp, norm_weylCoeff, LinearIsometryEquiv.norm_map]
  have hstar : ContinuousLinearMap.adjoint (weylOp ω B φ) * weylOp ω B φ = 1 :=
    (ContinuousLinearMap.norm_map_iff_adjoint_comp_self _).mp hiso
  calc weylOp ω B (-φ) = (ContinuousLinearMap.adjoint (weylOp ω B φ) * weylOp ω B φ) * weylOp ω B (-φ) := by
        rw [hstar, one_mul]
    _ = ContinuousLinearMap.adjoint (weylOp ω B φ) := by rw [mul_assoc, hinv, mul_one]

/-- **Example 4.2.2 is a Weyl system** in `L(H)`. -/
theorem isWeylSystem_weylOp (hω : IsSymplecticForm ω) : IsWeylSystem ω (weylOp ω B) where
  map_zero := weylOp_zero B
  map_neg φ := by rw [weylOp_neg B hω, ContinuousLinearMap.star_eq_adjoint]
  mul := weylOp_mul B hω

variable (ω) in
/-- **The CCR algebra** `CCR(V, ω)` (Bär-Ginoux-Pfäffle, Example 4.2.2): the C*-subalgebra of `L(H)` generated by the
Weyl operators. -/
noncomputable def ccrAlgebra : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range (weylOp ω B))).topologicalClosure

/-- The CCR algebra is a C*-algebra (a closed star subalgebra of `L(H)`). -/
noncomputable instance cstarAlgebra_ccrAlgebra : CStarAlgebra (ccrAlgebra ω B) :=
  StarSubalgebra.cstarAlgebra _
    (h_closed := StarSubalgebra.isClosed_topologicalClosure (StarAlgebra.adjoin ℂ (Set.range (weylOp ω B))))

variable (ω) in
/-- The Weyl system of the CCR algebra. -/
noncomputable def ccrW (φ : V) : ccrAlgebra ω B :=
  ⟨weylOp ω B φ, StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨φ, rfl⟩)⟩

/-- **`CCR(V, ω)` with `W` is a CCR-representation** of `(V, ω)` (a Weyl system generating the algebra). -/
theorem isWeylSystem_ccrW (hω : IsSymplecticForm ω) : IsWeylSystem ω (ccrW ω B) where
  map_zero := Subtype.ext (weylOp_zero B)
  map_neg φ := Subtype.ext ((isWeylSystem_weylOp B hω).map_neg φ)
  mul φ ψ := Subtype.ext (weylOp_mul B hω φ ψ)

/-- **`CCR(V, ω)` is not separable** for a nonzero symplectic space (Bär-Ginoux-Pfäffle, Proposition 4.2.3 (3)), and
`‖W(φ) - W(ψ)‖ = 2` there for `φ ≠ ψ` (Proposition 4.2.3 (2)). -/
theorem ccrAlgebra_not_separableSpace [Nontrivial V] (hω : IsSymplecticForm ω) :
    ¬ TopologicalSpace.SeparableSpace (ccrAlgebra ω B) := by
  obtain ⟨v⟩ := (inferInstance : Nonempty V)
  have hB : B v ≠ 0 := B.orthonormal.ne_zero v
  haveI : Nontrivial (ccrAlgebra ω B) := ⟨⟨1, 0, fun h => hB (by
    have := congrArg (fun T : ccrAlgebra ω B => (T : H →L[ℂ] H) (B v)) h
    simpa using this)⟩⟩
  exact (isWeylSystem_ccrW B hω).not_separableSpace hω

end CCR

/-! ### The Fock representation as a Weyl system -/

section Fock

variable (h : Type*) [NormedAddCommGroup h] [InnerProductSpace ℂ h]

/-- The symplectic form `σ(f, g) = Im⟪f, g⟫` of a complex inner product space, as a real bilinear form. -/
noncomputable def symplecticForm : LinearMap.BilinForm ℝ h :=
  LinearMap.mk₂ ℝ (symp h)
    (fun f f' g => by simp [symp, inner_add_left])
    (fun c f g => by
      show symp h (c • f) g = c * symp h f g
      rw [← Complex.coe_smul]; unfold symp; rw [inner_smul_left]; simp [Complex.mul_im])
    (fun f g g' => by simp [symp, inner_add_right])
    (fun c f g => by
      show symp h f (c • g) = c * symp h f g
      rw [← Complex.coe_smul]; unfold symp; rw [inner_smul_right]; simp [Complex.mul_im])

lemma symplecticForm_apply (f g : h) : symplecticForm h f g = symp h f g := rfl

/-- `σ` is a symplectic form. -/
theorem isSymplecticForm_symplecticForm : IsSymplecticForm (symplecticForm h) where
  antisymm f g := by
    simp only [symplecticForm_apply, symp]
    rw [← inner_conj_symm, Complex.conj_im]
  nondeg f hf := by
    have := hf (Complex.I • f)
    rw [symplecticForm_apply, symp, inner_smul_right, Complex.I_mul_im] at this
    have h2 : ‖f‖ ^ 2 = 0 := by rw [← inner_self_eq_norm_sq (𝕜 := ℂ)]; simpa using this
    exact norm_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp h2)

variable {h} {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-- **The Weyl unitaries of a representation of the CCR are a Weyl system** of `(h, σ)` in `L(K)` (Bär-Ginoux-Pfäffle,
Definition 4.2.1, with `W(-f) = W(f)*` and the Weyl relation). -/
theorem CCRRep.isWeylSystem (R : CCRRep h K) :
    IsWeylSystem (symplecticForm h) (fun f => (R.W f : K →L[ℂ] K)) where
  map_zero := by
    ext ψ; exact R.W_zero_apply ψ
  map_neg f := by
    rw [LinearIsometryEquiv.star_eq_symm]
    ext ψ
    apply (R.W f).injective
    show R.W f (R.W (-f) ψ) = R.W f ((R.W f).symm ψ)
    rw [R.W_W_neg, LinearIsometryEquiv.apply_symm_apply]
  mul f g := by
    ext ψ
    show R.W f (R.W g ψ) = _
    rw [R.weyl, symplecticForm_apply]
    rfl

end Fock

end Lightlike.OperatorAlgebras
