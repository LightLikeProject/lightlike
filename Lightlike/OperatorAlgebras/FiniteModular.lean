import Lightlike.OperatorAlgebras.FiniteKMS
import Mathlib.Analysis.Matrix.Spectrum
import Mathlib.Analysis.Matrix.PosDef
import Mathlib.Analysis.SpecialFunctions.Exponential

/-!
# Modular theory of a faithful state on a matrix algebra

Jakšić, Ogata, Pautrat and Pillet, arXiv:1106.3786, Section 2.12.1, pp. 62-63 (read): for a faithful state `ρ` the modular dynamics is
`ς_ρ^t(A) = e^{it log ρ} A e^{-it log ρ}`, and `ρ` is a `(β = -1)`-KMS state for it, `ρ(AB) = ρ(ς_ρ^i(B) A)`; on the standard Hilbert
space (matrices with `⟨ξ|η⟩ = tr(ξ* η)`) the modular operator is `Δ_ρ ξ = ρ ξ ρ^{-1}`, more generally `Δ_ρ^z ξ = ρ^z ξ ρ^{-z}`, the
modular conjugation is `J ξ = ξ*`, and `J Δ_ρ^{1/2} A ξ_ρ = A* ξ_ρ` for `ξ_ρ = ρ^{1/2}` (eq. (2.34)), which characterizes `J` and
`Δ_ρ^{1/2}` as the factors of the polar decomposition of `A ξ_ρ ↦ A* ξ_ρ` (Tomita's operator `S`).

Here `log ρ` and `ρ^{±1/2}` are built from the spectral decomposition (`logPosDef`, `sqrtPosDef`, `invSqrtPosDef`), `e^{log ρ} = ρ`
(`exp_logPosDef`), and the statements are `isKMS_modular` (the `β = -1` KMS condition for the modular dynamics, generated by `log ρ`) and
`modConj_modOp_sqrt` (eq. (2.34), with `Δ_ρ^{1/2} ξ = ρ^{1/2} ξ ρ^{-1/2}` (`modOpSqrt`) and `J ξ = ξ*` (`modConj`)),
`modOpSqrt_modOpSqrt` (`Δ_ρ ξ = ρ ξ ρ^{-1}` is the square of `Δ_ρ^{1/2}`), `modConj_modOpSqrt_modConj` (`J Δ_ρ^{1/2} J = Δ_ρ^{-1/2}`) and
`modOpPow_mul_modOpPow_neg` (`Δ_ρ^{it}` implements the modular dynamics `modGroup`).
-/

open Matrix NormedSpace
open scoped ComplexOrder

namespace Lightlike.OperatorAlgebras

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- **The modular Hamiltonian** `log ρ` of a positive definite `ρ`, through the spectral decomposition `ρ = U diag(λ) U*`. -/
noncomputable def logPosDef {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : Matrix n n ℂ :=
  (hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ) *
    diagonal (fun i => ((Real.log (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) *
    (star hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)

/-- `e^{log ρ} = ρ`. -/
lemma exp_logPosDef {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : exp (logPosDef hρ) = ρ := by
  set U := hρ.isHermitian.eigenvectorUnitary
  set u : (Matrix n n ℂ)ˣ := Unitary.toUnits U
  have hu : (u : Matrix n n ℂ) = U := rfl
  have hu' : ((u⁻¹ : (Matrix n n ℂ)ˣ) : Matrix n n ℂ) = (star U : Matrix n n ℂ) := rfl
  have hD : exp (diagonal (fun i => ((Real.log (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ))) =
      diagonal (RCLike.ofReal ∘ hρ.isHermitian.eigenvalues) := by
    rw [exp_diagonal, Pi.exp_def]
    congr 1
    funext i
    simp only [Function.comp_apply]
    rw [← Complex.exp_eq_exp_ℂ, ← Complex.ofReal_exp, Real.exp_log (hρ.eigenvalues_pos i)]
    rfl
  rw [logPosDef, ← hu', ← hu, Matrix.exp_units_conj, hD, hu, hu']
  conv_rhs => rw [hρ.isHermitian.spectral_theorem, Unitary.conjStarAlgAut_apply]
  try rfl

/-- **A faithful state is `(β = -1)`-KMS for its modular dynamics** (Jakšić-Ogata-Pautrat-Pillet, Section 2.12.1, p. 63):
`ρ(AB) = ρ(ς_ρ^i(B) A)`, the KMS condition for the dynamics generated by `log ρ` at `β = -1`. -/
theorem isKMS_modular {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (htr : ρ.trace = 1) : IsKMS (logPosDef hρ) ρ (-1) := by
  have hE : exp (-(((-1 : ℝ) : ℂ) • logPosDef hρ)) = ρ := by
    rw [Complex.ofReal_neg, Complex.ofReal_one, neg_one_smul, neg_neg, exp_logPosDef]
  have hZ : (exp (-(((-1 : ℝ) : ℂ) • logPosDef hρ))).trace ≠ 0 := by rw [hE, htr]; exact one_ne_zero
  refine (isKMS_iff_eq_gibbs _ ρ (-1) hZ htr).mpr ?_
  rw [gibbs, hE, htr, inv_one, one_smul]

/-- The square root `ρ^{1/2}` of a positive definite `ρ`, through the spectral decomposition. -/
noncomputable def sqrtPosDef {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : Matrix n n ℂ :=
  (hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ) *
    diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) *
    (star hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)

/-- The inverse square root `ρ^{-1/2}`. -/
noncomputable def invSqrtPosDef {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : Matrix n n ℂ :=
  (hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ) *
    diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i))⁻¹ : ℂ)) *
    (star hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)

lemma unitary_star_mul {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) :
    (star hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ) * (hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ) = 1 :=
  Unitary.coe_star_mul_self _

lemma sqrt_mul_invSqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : sqrtPosDef hρ * invSqrtPosDef hρ = 1 := by
  set U : Matrix n n ℂ := (hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)
  set V : Matrix n n ℂ := (star hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)
  have hU : V * U = 1 := unitary_star_mul hρ
  have hU' : U * V = 1 := Unitary.coe_mul_star_self _
  have hd : diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) *
      diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i))⁻¹ : ℂ)) = 1 := by
    rw [diagonal_mul_diagonal, ← diagonal_one]
    congr 1
    funext i
    have h0 : (Real.sqrt (hρ.isHermitian.eigenvalues i) : ℂ) ≠ 0 := by
      exact_mod_cast (Real.sqrt_pos.mpr (hρ.eigenvalues_pos i)).ne'
    exact mul_inv_cancel₀ h0
  calc sqrtPosDef hρ * invSqrtPosDef hρ =
      U * (diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) * (V * U) *
        diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i))⁻¹ : ℂ))) * V := by
        simp only [sqrtPosDef, invSqrtPosDef, U, V, Matrix.mul_assoc]
    _ = 1 := by rw [hU, Matrix.mul_one, hd, Matrix.mul_one, hU']

lemma sqrtPosDef_isHermitian {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : (sqrtPosDef hρ)ᴴ = sqrtPosDef hρ := by
  have hd : (diagonal fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ))ᴴ =
      diagonal fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ) := by
    rw [diagonal_conjTranspose]
    congr 1
    funext i
    simp
  rw [sqrtPosDef, conjTranspose_mul, conjTranspose_mul, hd, star_eq_conjTranspose, conjTranspose_conjTranspose,
    Matrix.mul_assoc]

/-- **The modular operator** `Δ_ρ^{1/2} ξ = ρ^{1/2} ξ ρ^{-1/2}` on the Hilbert-Schmidt space. -/
noncomputable def modOpSqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (ξ : Matrix n n ℂ) : Matrix n n ℂ :=
  sqrtPosDef hρ * ξ * invSqrtPosDef hρ

/-- **The modular conjugation** `J ξ = ξ*`. -/
def modConj (ξ : Matrix n n ℂ) : Matrix n n ℂ := ξᴴ

/-- **Tomita's relation** (Jakšić-Ogata-Pautrat-Pillet, eq. (2.34), p. 63): `J Δ_ρ^{1/2} (A ξ_ρ) = A* ξ_ρ` with `ξ_ρ = ρ^{1/2}`. -/
theorem modConj_modOp_sqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (A : Matrix n n ℂ) :
    modConj (modOpSqrt hρ (A * sqrtPosDef hρ)) = Aᴴ * sqrtPosDef hρ := by
  rw [modOpSqrt, modConj, Matrix.mul_assoc, Matrix.mul_assoc, sqrt_mul_invSqrt, Matrix.mul_one, conjTranspose_mul,
    sqrtPosDef_isHermitian]

variable {n : Type*} [Fintype n] [DecidableEq n]

lemma sqrt_mul_sqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : sqrtPosDef hρ * sqrtPosDef hρ = ρ := by
  set U : Matrix n n ℂ := (hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)
  set V : Matrix n n ℂ := (star hρ.isHermitian.eigenvectorUnitary : Matrix n n ℂ)
  have hU : V * U = 1 := unitary_star_mul hρ
  have hd : diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) *
      diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) =
      diagonal (RCLike.ofReal ∘ hρ.isHermitian.eigenvalues) := by
    rw [diagonal_mul_diagonal]
    congr 1
    funext i
    simp only [Function.comp_apply]
    rw [← Complex.ofReal_mul, Real.mul_self_sqrt (hρ.eigenvalues_pos i).le]
    rfl
  calc sqrtPosDef hρ * sqrtPosDef hρ =
      U * (diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ)) * (V * U) *
        diagonal (fun i => ((Real.sqrt (hρ.isHermitian.eigenvalues i) : ℝ) : ℂ))) * V := by
        simp only [sqrtPosDef, U, V, Matrix.mul_assoc]
    _ = ρ := by
      rw [hU, Matrix.mul_one, hd]
      conv_rhs => rw [hρ.isHermitian.spectral_theorem, Unitary.conjStarAlgAut_apply]
      try rfl
  try rfl

lemma invSqrt_mul_sqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : invSqrtPosDef hρ * sqrtPosDef hρ = 1 :=
  mul_eq_one_comm.mp (sqrt_mul_invSqrt hρ)

lemma invSqrt_mul_invSqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) : invSqrtPosDef hρ * invSqrtPosDef hρ = ρ⁻¹ := by
  refine (Matrix.inv_eq_left_inv ?_).symm
  calc invSqrtPosDef hρ * invSqrtPosDef hρ * ρ = invSqrtPosDef hρ * invSqrtPosDef hρ * (sqrtPosDef hρ * sqrtPosDef hρ) := by
        rw [sqrt_mul_sqrt hρ]
    _ = invSqrtPosDef hρ * (invSqrtPosDef hρ * sqrtPosDef hρ) * sqrtPosDef hρ := by simp only [Matrix.mul_assoc]
    _ = 1 := by rw [invSqrt_mul_sqrt, Matrix.mul_one, invSqrt_mul_sqrt]

/-- **The modular operator** `Δ_ρ ξ = ρ ξ ρ^{-1}` (Jakšić-Ogata-Pautrat-Pillet, Section 2.12.1, p. 63) is the square of `Δ_ρ^{1/2}`. -/
theorem modOpSqrt_modOpSqrt {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (ξ : Matrix n n ℂ) :
    modOpSqrt hρ (modOpSqrt hρ ξ) = ρ * ξ * ρ⁻¹ := by
  calc modOpSqrt hρ (modOpSqrt hρ ξ) = (sqrtPosDef hρ * sqrtPosDef hρ) * ξ * (invSqrtPosDef hρ * invSqrtPosDef hρ) := by
        simp only [modOpSqrt, Matrix.mul_assoc]
    _ = ρ * ξ * ρ⁻¹ := by rw [sqrt_mul_sqrt, invSqrt_mul_invSqrt]

/-- `J Δ_ρ^{1/2} J = Δ_ρ^{-1/2}`: `(ρ^{1/2} ξ* ρ^{-1/2})* = ρ^{-1/2} ξ ρ^{1/2}`. -/
theorem modConj_modOpSqrt_modConj {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (ξ : Matrix n n ℂ) :
    modConj (modOpSqrt hρ (modConj ξ)) = invSqrtPosDef hρ * ξ * sqrtPosDef hρ := by
  have hS := sqrtPosDef_isHermitian hρ
  have hSi : (invSqrtPosDef hρ)ᴴ = invSqrtPosDef hρ := by
    have h1 : (invSqrtPosDef hρ)ᴴ * sqrtPosDef hρ = 1 := by
      rw [← hS, ← conjTranspose_mul, sqrt_mul_invSqrt, conjTranspose_one]
    calc (invSqrtPosDef hρ)ᴴ = (invSqrtPosDef hρ)ᴴ * (sqrtPosDef hρ * invSqrtPosDef hρ) := by
          rw [sqrt_mul_invSqrt, Matrix.mul_one]
      _ = invSqrtPosDef hρ := by rw [← Matrix.mul_assoc, h1, Matrix.one_mul]
  rw [modOpSqrt, modConj, modConj, conjTranspose_mul, conjTranspose_mul, conjTranspose_conjTranspose, hS, hSi,
    Matrix.mul_assoc]

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- **The modular dynamics** `ς_ρ^t(A) = e^{it log ρ} A e^{-it log ρ}` (Jakšić-Ogata-Pautrat-Pillet, Section 2.12.1, p. 62). -/
noncomputable def modGroup {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (t : ℝ) (A : Matrix n n ℂ) : Matrix n n ℂ :=
  exp (((t : ℂ) * Complex.I) • logPosDef hρ) * A * exp (-(((t : ℂ) * Complex.I) • logPosDef hρ))

/-- `Δ_ρ^{it} ξ = ρ^{it} ξ ρ^{-it}` on the Hilbert-Schmidt space (p. 63, `Δ_ρ^z ξ = ρ^z ξ ρ^{-z}`). -/
noncomputable def modOpPow {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (t : ℝ) (ξ : Matrix n n ℂ) : Matrix n n ℂ :=
  exp (((t : ℂ) * Complex.I) • logPosDef hρ) * ξ * exp (-(((t : ℂ) * Complex.I) • logPosDef hρ))

/-- **`Δ^{it}` implements the modular dynamics** (Jakšić-Ogata-Pautrat-Pillet, p. 63, `L(ς_ρ^t(A)) = Δ_ρ^{it} L(A) Δ_ρ^{-it}`):
`Δ^{it} (A (Δ^{-it} ξ)) = ς^t(A) ξ`. -/
theorem modOpPow_mul_modOpPow_neg {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (t : ℝ) (A ξ : Matrix n n ℂ) :
    modOpPow hρ t (A * modOpPow hρ (-t) ξ) = modGroup hρ t A * ξ := by
  set X := ((t : ℂ) * Complex.I) • logPosDef hρ with hX
  have hneg : ((((-t : ℝ) : ℂ) * Complex.I) • logPosDef hρ) = -X := by
    rw [hX, Complex.ofReal_neg, neg_mul, neg_smul]
  simp only [modOpPow, modGroup, hneg, neg_neg]
  rw [← hX]
  calc exp X * (A * (exp (-X) * ξ * exp X)) * exp (-X)
      = exp X * A * exp (-X) * ξ * (exp X * exp (-X)) := by simp only [Matrix.mul_assoc]
    _ = exp X * A * exp (-X) * ξ := by rw [exp_mul_exp_neg, Matrix.mul_one]

/-- The modular dynamics is a group: `ς^0 = id`. -/
lemma modGroup_zero {ρ : Matrix n n ℂ} (hρ : ρ.PosDef) (A : Matrix n n ℂ) : modGroup hρ 0 A = A := by
  simp [modGroup]

end Lightlike.OperatorAlgebras
