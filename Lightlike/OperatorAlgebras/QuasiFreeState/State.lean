import Lightlike.OperatorAlgebras.QuasiFreeState.GNS
import Lightlike.OperatorAlgebras.QuasiFreeState.Functional
import Lightlike.OperatorAlgebras.WeylAlgebra

/-!
# The quasi-free state as a state of a C*-algebra

For a covariance `η` of `(V, ω)` let `A_η` be the C*-algebra generated by the Weyl unitaries `qfW φ` of the GNS space
`QFSpace ω η` (`qfAlgebra`). The vector state `a ↦ ⟨Ω, a Ω⟩` is the **quasi-free state** `ρ_η` (`qfState`): it is
normalized (`qfState_one`), positive (`qfState_star_mul_self_nonneg`), bounded (`norm_qfState_le`), and
`ρ_η(W(φ)) = exp(-¼ η(φ, φ))` (`qfState_W`), so on a Weyl polynomial it equals the algebraic quasi-free functional
`qfFunctional η` (`qfState_linearCombination`).

(Bratteli-Robinson 2, Chapter 5; Dereziński, arXiv:math-ph/0511030, Section 9.1.)

Left to a later row: that `ρ_η` lives on the *universal* CCR algebra `ccrAlgebra`; that would need the uniqueness of the
C*-norm on the Weyl algebra of a discrete group (amenability), which is not in the library.
-/

open scoped InnerProductSpace ComplexOrder ComplexConjugate

universe u

namespace Lightlike.OperatorAlgebras.QuasiFreeState

open Lightlike.OperatorAlgebras

section Generic

variable {V : Type u} [AddCommGroup V] [Module ℝ V] {ω : LinearMap.BilinForm ℝ V}
  {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A] [StarModule ℂ A] {W : V → A}

omit [StarModule ℂ A] in
/-- The span of a Weyl system is closed under products. -/
lemma weylSpan_mul_mem (hW : IsWeylSystem ω W) {x y : A} (hx : x ∈ Submodule.span ℂ (Set.range W))
    (hy : y ∈ Submodule.span ℂ (Set.range W)) : x * y ∈ Submodule.span ℂ (Set.range W) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨φ, rfl⟩ := hx
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨ψ, rfl⟩ := hy
      rw [hW.mul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)
    | zero => simp
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
    | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hy
  | zero => simp
  | add x z _ _ hx hz => rw [add_mul]; exact add_mem hx hz
  | smul c x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ hx

/-- The span of a Weyl system is closed under the star. -/
lemma weylSpan_star_mem (hW : IsWeylSystem ω W) {x : A} (hx : x ∈ Submodule.span ℂ (Set.range W)) :
    star x ∈ Submodule.span ℂ (Set.range W) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨φ, rfl⟩ := hx
    rw [← hW.map_neg]
    exact Submodule.subset_span ⟨_, rfl⟩
  | zero => simp
  | add x z _ _ hx hz => rw [star_add]; exact add_mem hx hz
  | smul c x _ hx => rw [star_smul]; exact Submodule.smul_mem _ _ hx

/-- **The `*`-algebra generated by a Weyl system is its linear span** (the Weyl polynomials). -/
lemma mem_weylSpan_of_mem_adjoin (hW : IsWeylSystem ω W) {x : A}
    (hx : x ∈ StarAlgebra.adjoin ℂ (Set.range W)) : x ∈ Submodule.span ℂ (Set.range W) := by
  induction hx using StarAlgebra.adjoin_induction with
  | mem x h => exact Submodule.subset_span h
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, ← hW.map_zero]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact weylSpan_mul_mem hW hx hy
  | star x _ hx => exact weylSpan_star_mem hW hx

end Generic

variable {V : Type u} [AddCommGroup V] [Module ℝ V] (ω η : LinearMap.BilinForm ℝ V)
  [Fact (qfKerM ω η).PosSemidef]

/-- **A state** of a unital star algebra over `ℂ`: a normalized linear functional that is nonnegative on `a* a`. -/
structure IsState {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A] (ρ : A →ₗ[ℂ] ℂ) : Prop where
  map_one : ρ 1 = 1
  nonneg : ∀ a : A, 0 ≤ ρ (star a * a)

/-- The Weyl operator `W(φ)` of the GNS space as a bounded operator. -/
noncomputable def qfOp (hω : ∀ a b, ω a b = -ω b a) (φ : V) : QFSpace ω η →L[ℂ] QFSpace ω η :=
  ((qfW ω η hω φ : QFSpace ω η ≃ₗᵢ[ℂ] QFSpace ω η) : QFSpace ω η →L[ℂ] QFSpace ω η)

/-- **The C*-algebra generated by the Weyl unitaries of the GNS representation.** -/
noncomputable def qfAlgebra (hω : ∀ a b, ω a b = -ω b a) : StarSubalgebra ℂ (QFSpace ω η →L[ℂ] QFSpace ω η) :=
  (StarAlgebra.adjoin ℂ (Set.range (qfOp ω η hω))).topologicalClosure

noncomputable instance (hω : ∀ a b, ω a b = -ω b a) : CStarAlgebra (qfAlgebra ω η hω) :=
  StarSubalgebra.cstarAlgebra _
    (h_closed := StarSubalgebra.isClosed_topologicalClosure (StarAlgebra.adjoin ℂ (Set.range (qfOp ω η hω))))

/-- The Weyl system of `qfAlgebra`. -/
noncomputable def qfWA (hω : ∀ a b, ω a b = -ω b a) (φ : V) : qfAlgebra ω η hω :=
  ⟨qfOp ω η hω φ, StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨φ, rfl⟩)⟩

/-- `qfWA` is a Weyl system of `(V, ω)` in the C*-algebra `qfAlgebra`. -/
theorem isWeylSystem_qfWA (hω : ∀ a b, ω a b = -ω b a) : IsWeylSystem ω (qfWA ω η hω) where
  map_zero := Subtype.ext ((qfWeylSystem ω η hω).map_zero)
  map_neg φ := Subtype.ext ((qfWeylSystem ω η hω).map_neg φ)
  mul φ ψ := Subtype.ext ((qfWeylSystem ω η hω).mul φ ψ)

/-- **The quasi-free state** `a ↦ ⟨Ω, a Ω⟩` on `qfAlgebra ω η`. -/
noncomputable def qfState (hω : ∀ a b, ω a b = -ω b a) : qfAlgebra ω η hω →ₗ[ℂ] ℂ where
  toFun a := ⟪qfVac ω η, (a : QFSpace ω η →L[ℂ] QFSpace ω η) (qfVac ω η)⟫_ℂ
  map_add' a b := by simp [inner_add_right]
  map_smul' c a := by simp [inner_smul_right]

lemma qfState_apply (hω : ∀ a b, ω a b = -ω b a) (a : qfAlgebra ω η hω) :
    qfState ω η hω a = ⟪qfVac ω η, (a : QFSpace ω η →L[ℂ] QFSpace ω η) (qfVac ω η)⟫_ℂ := rfl

/-- `ρ_η(1) = 1`. -/
theorem qfState_one (hω : ∀ a b, ω a b = -ω b a) : qfState ω η hω 1 = 1 := by
  have h := inner_vac_qfW ω η hω 0
  rw [qfW_zero] at h
  simpa [qfState_apply, gaussVal] using h

/-- **`ρ_η(W(φ)) = exp(-¼ η(φ, φ))`.** -/
theorem qfState_W (hω : ∀ a b, ω a b = -ω b a) (φ : V) :
    qfState ω η hω (qfWA ω η hω φ) = ((gaussVal η φ : ℝ) : ℂ) :=
  inner_vac_qfW ω η hω φ

/-- **Positivity**: `ρ_η(a* a) = ‖a Ω‖² ≥ 0` for every `a` in the algebra. -/
theorem qfState_star_mul_self_nonneg (hω : ∀ a b, ω a b = -ω b a) (a : qfAlgebra ω η hω) :
    0 ≤ qfState ω η hω (star a * a) := by
  have h : qfState ω η hω (star a * a) =
      ⟪(a : QFSpace ω η →L[ℂ] QFSpace ω η) (qfVac ω η), (a : QFSpace ω η →L[ℂ] QFSpace ω η) (qfVac ω η)⟫_ℂ := by
    rw [qfState_apply]
    show ⟪qfVac ω η, (star (a : QFSpace ω η →L[ℂ] QFSpace ω η) * (a : QFSpace ω η →L[ℂ] QFSpace ω η))
      (qfVac ω η)⟫_ℂ = _
    rw [mul_apply_eq_comp, ← ContinuousLinearMap.adjoint_inner_right]
    rfl
  rw [h, inner_self_eq_norm_sq_to_K]
  rw [← RCLike.ofReal_pow]
  exact Complex.zero_le_real.2 (sq_nonneg _)

/-- **The quasi-free state is a state** of the C*-algebra `qfAlgebra`. -/
theorem isState_qfState (hω : ∀ a b, ω a b = -ω b a) : IsState (qfState ω η hω) :=
  ⟨qfState_one ω η hω, qfState_star_mul_self_nonneg ω η hω⟩

lemma norm_qfVac (hω : ∀ a b, ω a b = -ω b a) : ‖qfVac ω η‖ = 1 := by
  have h := inner_vac_qfW ω η hω 0
  rw [qfW_zero] at h
  have h2 : ‖qfVac ω η‖ ^ 2 = 1 := by
    have h' : ⟪qfVac ω η, qfVac ω η⟫_ℂ = 1 := by simpa [gaussVal] using h
    rw [inner_self_eq_norm_sq_to_K] at h'
    rw [← RCLike.ofReal_pow] at h'
    exact Complex.ofReal_eq_one.1 h'
  nlinarith [norm_nonneg (qfVac ω η)]

/-- **The quasi-free state is bounded**: `|ρ_η(a)| ≤ ‖a‖`. -/
theorem norm_qfState_le (hω : ∀ a b, ω a b = -ω b a) (a : qfAlgebra ω η hω) :
    ‖qfState ω η hω a‖ ≤ ‖a‖ := by
  rw [qfState_apply]
  refine (norm_inner_le_norm _ _).trans ?_
  have h1 := (a : QFSpace ω η →L[ℂ] QFSpace ω η).le_opNorm (qfVac ω η)
  rw [norm_qfVac ω η hω] at h1 ⊢
  simpa using h1

/-- **The quasi-free state on a Weyl polynomial** is the algebraic quasi-free functional:
`ρ_η(∑ fᵩ W(φ)) = ∑ fᵩ exp(-¼ η(φ, φ))`. -/
theorem qfState_linearCombination (hω : ∀ a b, ω a b = -ω b a) (f : V →₀ ℂ) :
    qfState ω η hω (Finsupp.linearCombination ℂ (qfWA ω η hω) f) = qfFunctional η f := by
  have : (qfState ω η hω).comp (Finsupp.linearCombination ℂ (qfWA ω η hω)) = qfFunctional η := by
    apply Finsupp.lhom_ext
    intro φ c
    simp [qfFunctional, qfState_W]
  exact LinearMap.congr_fun this f

/-- **The Weyl polynomials `∑ fᵩ W(φ)` are dense in `qfAlgebra`.** -/
theorem dense_span_qfWA (hω : ∀ a b, ω a b = -ω b a) :
    Dense ((Submodule.span ℂ (Set.range (qfWA ω η hω)) : Submodule ℂ (qfAlgebra ω η hω)) :
      Set (qfAlgebra ω η hω)) := by
  intro a
  rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
  have hsub : (StarAlgebra.adjoin ℂ (Set.range (qfOp ω η hω)) : Set (QFSpace ω η →L[ℂ] QFSpace ω η)) ⊆
      Subtype.val '' ((Submodule.span ℂ (Set.range (qfWA ω η hω)) : Submodule ℂ (qfAlgebra ω η hω)) :
        Set (qfAlgebra ω η hω)) := by
    intro x hx
    have hx' := mem_weylSpan_of_mem_adjoin (qfWeylSystem ω η hω) hx
    change x ∈ Submodule.span ℂ (Set.range (qfOp ω η hω)) at hx'
    clear hx
    induction hx' using Submodule.span_induction with
    | mem x hx => obtain ⟨φ, rfl⟩ := hx; exact ⟨qfWA ω η hω φ, Submodule.subset_span ⟨_, rfl⟩, rfl⟩
    | zero => exact ⟨0, zero_mem _, rfl⟩
    | add x y _ _ hx hy =>
      obtain ⟨x', hx', rfl⟩ := hx
      obtain ⟨y', hy', rfl⟩ := hy
      exact ⟨x' + y', add_mem hx' hy', rfl⟩
    | smul c x _ hx =>
      obtain ⟨x', hx', rfl⟩ := hx
      exact ⟨c • x', Submodule.smul_mem _ _ hx', rfl⟩
  have ha : (a : QFSpace ω η →L[ℂ] QFSpace ω η) ∈
      closure (StarAlgebra.adjoin ℂ (Set.range (qfOp ω η hω)) : Set (QFSpace ω η →L[ℂ] QFSpace ω η)) := by
    have h2 : (a : QFSpace ω η →L[ℂ] QFSpace ω η) ∈
        ((StarAlgebra.adjoin ℂ (Set.range (qfOp ω η hω))).topologicalClosure :
          Set (QFSpace ω η →L[ℂ] QFSpace ω η)) := a.2
    rwa [StarSubalgebra.topologicalClosure_coe] at h2
  exact closure_mono hsub ha

lemma continuous_qfState (hω : ∀ a b, ω a b = -ω b a) : Continuous (qfState ω η hω) :=
  (LinearMap.mkContinuous (qfState ω η hω) 1 fun a => by simpa using norm_qfState_le ω η hω a).continuous

/-- **Uniqueness of the quasi-free state**: a continuous linear functional on `qfAlgebra` with
`ρ(W(φ)) = exp(-¼ η(φ, φ))` for all `φ` is `ρ_η`. -/
theorem qfState_unique (hω : ∀ a b, ω a b = -ω b a) (ρ : qfAlgebra ω η hω →L[ℂ] ℂ)
    (hρ : ∀ φ, ρ (qfWA ω η hω φ) = ((gaussVal η φ : ℝ) : ℂ)) (a : qfAlgebra ω η hω) :
    ρ a = qfState ω η hω a := by
  have hclosed : IsClosed {x : qfAlgebra ω η hω | ρ x = qfState ω η hω x} :=
    isClosed_eq ρ.continuous (continuous_qfState ω η hω)
  have hspan : ((Submodule.span ℂ (Set.range (qfWA ω η hω)) : Submodule ℂ (qfAlgebra ω η hω)) :
      Set (qfAlgebra ω η hω)) ⊆ {x | ρ x = qfState ω η hω x} := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx => obtain ⟨φ, rfl⟩ := hx; simp [hρ, qfState_W]
    | zero => simp
    | add x y _ _ hx hy =>
      change ρ (x + y) = qfState ω η hω (x + y)
      rw [map_add, map_add]
      exact congrArg₂ (· + ·) hx hy
    | smul c x _ hx =>
      change ρ (c • x) = qfState ω η hω (c • x)
      rw [map_smul, map_smul]
      exact congrArg (c • ·) hx
  have := hclosed.closure_subset_iff.2 hspan
  exact this ((dense_span_qfWA ω η hω).closure_eq ▸ Set.mem_univ a)

end Lightlike.OperatorAlgebras.QuasiFreeState
