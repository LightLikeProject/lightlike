import Lightlike.Poincare.SnagCommute
import Lightlike.OperatorAlgebras.Spectral.Unbounded.AbstractCalculus
import Mathlib.Analysis.CStarAlgebra.GelfandDuality

/-!
# The joint spectrum of finitely many commuting unitaries

For finitely many pairwise commuting unitaries `C_1, …, C_n` on a Hilbert space, the C*-algebra they generate
(`jointAlg`) is commutative, and Gelfand duality identifies it with the continuous functions on its character space
(`jointGelfand`). The characters are determined by their values on the generators, so the character space is
homeomorphic to the joint spectrum, a compact subset of `ℂⁿ` (`jointSpectrum`, `jointHomeo`).

Supporting results for the joint spectral measure of the translations; no catalogue entry.
-/

open scoped InnerProductSpace IsMulCommutative
open Filter Topology Lightlike.OperatorAlgebras.Spectral Lightlike.OperatorAlgebras.Spectral.Unbounded

namespace Lightlike.Poincare

noncomputable section

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] {n : ℕ}

/-- Finitely many pairwise commuting unitaries. -/
structure CommutingUnitaries (C : Fin n → H →L[ℂ] H) : Prop where
  mem_unitary : ∀ k, C k ∈ unitary (H →L[ℂ] H)
  comm : ∀ j k, C j * C k = C k * C j

variable (C : Fin n → H →L[ℂ] H)

/-- The C*-algebra generated by the `C_k`. -/
def jointAlg : StarSubalgebra ℂ (H →L[ℂ] H) := (StarAlgebra.adjoin ℂ (Set.range C)).topologicalClosure

instance : CStarAlgebra (jointAlg C) :=
  StarSubalgebra.cstarAlgebra _ (h_closed := (StarAlgebra.adjoin ℂ (Set.range C)).isClosed_topologicalClosure)

variable {C}

lemma CommutingUnitaries.star_comm (hC : CommutingUnitaries C) (j k : Fin n) :
    C j * star (C k) = star (C k) * C j := by
  have hu := hC.mem_unitary k
  have h1 : star (C k) * C k = 1 := Unitary.star_mul_self_of_mem hu
  have h2 : C k * star (C k) = 1 := Unitary.mul_star_self_of_mem hu
  calc C j * star (C k) = star (C k) * C k * (C j * star (C k)) := by rw [h1, one_mul]
    _ = star (C k) * (C k * C j) * star (C k) := by noncomm_ring
    _ = star (C k) * (C j * C k) * star (C k) := by rw [hC.comm j k]
    _ = star (C k) * C j * (C k * star (C k)) := by noncomm_ring
    _ = star (C k) * C j := by rw [h2, mul_one]

lemma CommutingUnitaries.isMulCommutative (hC : CommutingUnitaries C) : IsMulCommutative (jointAlg C) := by
  have hnormal : ∀ x ∈ Set.range C, IsStarNormal x := by
    rintro _ ⟨k, rfl⟩
    exact ⟨by
      have h1 : star (C k) * C k = 1 := Unitary.star_mul_self_of_mem (hC.mem_unitary k)
      have h2 : C k * star (C k) = 1 := Unitary.mul_star_self_of_mem (hC.mem_unitary k)
      rw [Commute, SemiconjBy, h1, h2]⟩
  have hcomm : (Set.range C).Pairwise Commute := by
    rintro _ ⟨j, rfl⟩ _ ⟨k, rfl⟩ _
    exact hC.comm j k
  have hcomm_star : (Set.range C).Pairwise (Commute · <| star ·) := by
    rintro _ ⟨j, rfl⟩ _ ⟨k, rfl⟩ _
    exact hC.star_comm j k
  have := StarAlgebra.isMulCommutative_adjoin ℂ hnormal hcomm hcomm_star
  exact StarSubalgebra.isMulCommutative_topologicalClosure _

variable (hC : CommutingUnitaries C)
include hC

/-- The commutative C*-algebra structure. -/
@[instance_reducible] def jointCommAlg : CommCStarAlgebra (jointAlg C) := by
  haveI := hC.isMulCommutative
  infer_instance

/-- **Gelfand duality** for the C*-algebra generated by the `C_k`. -/
def jointGelfand : letI := jointCommAlg hC
    jointAlg C ≃⋆ₐ[ℂ] C(WeakDual.characterSpace ℂ (jointAlg C), ℂ) :=
  letI := jointCommAlg hC
  gelfandStarTransform (jointAlg C)

/-- The generator `C_k` as an element of `jointAlg C`. -/
def jointGen (k : Fin n) : jointAlg C :=
  ⟨C k, StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨k, rfl⟩)⟩

omit hC in
@[simp] lemma coe_jointGen (k : Fin n) : (jointGen (C := C) k : H →L[ℂ] H) = C k := rfl

/-- The values of a character on the generators. -/
def jointEval : letI := jointCommAlg hC
    WeakDual.characterSpace ℂ (jointAlg C) → (Fin n → ℂ) :=
  letI := jointCommAlg hC
  fun χ k => χ (jointGen k)

lemma continuous_jointEval : letI := jointCommAlg hC; Continuous (jointEval hC) := by
  letI := jointCommAlg hC
  refine continuous_pi fun k => ?_
  exact (WeakDual.eval_continuous (jointGen (C := C) k)).comp continuous_subtype_val

/-- **A character is determined by its values on the generators.** -/
lemma injective_jointEval : letI := jointCommAlg hC; Function.Injective (jointEval hC) := by
  letI := jointCommAlg hC
  intro χ ψ h
  let S := StarAlgebra.adjoin ℂ (Set.range C)
  let φχ : jointAlg C →⋆ₐ[ℂ] ℂ := StarAlgHomClass.toStarAlgHom χ
  let φψ : jointAlg C →⋆ₐ[ℂ] ℂ := StarAlgHomClass.toStarAlgHom ψ
  have hcomp : φχ.comp (StarSubalgebra.inclusion (StarSubalgebra.le_topologicalClosure S)) =
      φψ.comp (StarSubalgebra.inclusion (StarSubalgebra.le_topologicalClosure S)) := by
    refine StarAlgHom.ext_adjoin fun x hx => ?_
    obtain ⟨k, hk⟩ := hx
    have hxk : (StarSubalgebra.inclusion (StarSubalgebra.le_topologicalClosure S) x : jointAlg C) = jointGen k :=
      Subtype.ext hk.symm
    simp only [StarAlgHom.comp_apply]
    calc φχ _ = φχ (jointGen k) := congrArg φχ hxk
      _ = φψ (jointGen k) := congrFun h k
      _ = φψ _ := (congrArg φψ hxk).symm
  have heq : φχ = φψ := StarAlgHom.ext_topologicalClosure (map_continuous χ) (map_continuous ψ) hcomp
  ext a
  exact congrArg (fun φ : jointAlg C →⋆ₐ[ℂ] ℂ => φ a) heq

lemma isEmbedding_jointEval : letI := jointCommAlg hC; Topology.IsEmbedding (jointEval hC) := by
  letI := jointCommAlg hC
  exact ((continuous_jointEval hC).isClosedEmbedding (injective_jointEval hC)).isEmbedding

/-- The joint spectrum: the values of the characters on the generators, a compact subset of `ℂⁿ`. -/
def jointSpectrum : Set (Fin n → ℂ) := letI := jointCommAlg hC; Set.range (jointEval hC)

/-- The character space is homeomorphic to the joint spectrum. -/
def jointHomeo : letI := jointCommAlg hC
    WeakDual.characterSpace ℂ (jointAlg C) ≃ₜ jointSpectrum hC :=
  letI := jointCommAlg hC
  (isEmbedding_jointEval hC).toHomeomorph

instance : CompactSpace (jointSpectrum hC) := by
  letI := jointCommAlg hC
  exact (jointHomeo hC).compactSpace

/-! ## The calculus on the joint spectrum -/

/-- `f ↦ f(C_1, …, C_n)`: the inverse Gelfand transform, on the joint spectrum. -/
def jointCalc (f : C(jointSpectrum hC, ℂ)) : H →L[ℂ] H :=
  letI := jointCommAlg hC
  ((jointGelfand hC).symm (f.comp (jointHomeo hC)) : H →L[ℂ] H)

lemma isAbstractCalculus_jointCalc : IsAbstractCalculus (jointCalc hC) := by
  letI := jointCommAlg hC
  refine ⟨fun α β f g => ?_, fun f g => ?_, fun f => ?_, fun f => ?_, ?_⟩
  · simp only [jointCalc, ContinuousMap.add_comp, ContinuousMap.smul_comp, map_add, map_smul]
    rfl
  · simp only [jointCalc, ContinuousMap.mul_comp, map_mul]
    rfl
  · have e : (star f).comp (jointHomeo hC : C(WeakDual.characterSpace ℂ (jointAlg C), jointSpectrum hC)) =
        star (f.comp (jointHomeo hC : C(WeakDual.characterSpace ℂ (jointAlg C), jointSpectrum hC))) :=
      ContinuousMap.ext fun _ => rfl
    simp only [jointCalc]
    rw [e, map_star, ← ContinuousLinearMap.star_eq_adjoint]
    rfl
  · simp only [jointCalc]
    rw [show ‖(((jointGelfand hC).symm (f.comp (jointHomeo hC)) : jointAlg C) : H →L[ℂ] H)‖ =
        ‖(jointGelfand hC).symm (f.comp (jointHomeo hC))‖ from rfl, StarAlgEquiv.norm_map]
    rw [ContinuousMap.norm_eq_iSup_norm, ContinuousMap.norm_eq_iSup_norm]
    exact (jointHomeo hC).toEquiv.iSup_comp (g := fun x => ‖f x‖)
  · simp only [jointCalc, ContinuousMap.one_comp, map_one]
    rfl

/-- **The joint projection-valued measure** on the joint spectrum. -/
def jointPVM : ProjectionValuedMeasure (jointSpectrum hC) H := abstractPVM (isAbstractCalculus_jointCalc hC)

/-- The coordinate functions integrate to the generators: `∫ z_k dE(z) = C_k`. -/
theorem jointPVM_integral_coord (k : Fin n) :
    (jointPVM hC).integral (fun z => (z : Fin n → ℂ) k) = C k := by
  letI := jointCommAlg hC
  have h := abstractPVM_integral_continuous (isAbstractCalculus_jointCalc hC)
    ⟨fun z : jointSpectrum hC => (z : Fin n → ℂ) k, (continuous_apply k).comp continuous_subtype_val⟩
  refine h.trans ?_
  have e : (⟨fun z : jointSpectrum hC => (z : Fin n → ℂ) k, (continuous_apply k).comp continuous_subtype_val⟩ :
      C(jointSpectrum hC, ℂ)).comp (jointHomeo hC) = jointGelfand hC (jointGen k) := by
    ext χ
    rfl
  simp only [jointCalc, e, StarAlgEquiv.symm_apply_apply, coe_jointGen]

end

end Lightlike.Poincare
