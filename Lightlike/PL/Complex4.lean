import Lightlike.PL.Euler
import Lightlike.FourD.Pachner

/-!
# The 4-dimensional Pachner moves of `FourD/` as bistellar moves

`Lightlike.FourD.Complex4` is a pure 4-dimensional complex given by its 4-simplices, with the
five 4D Pachner moves `Complex4.move` (`Lightlike/FourD/Pachner.lean`). Here they are compared with
the general notions of `PL/`.

* `ofComplex4 K`: the simplicial complex generated by the 4-simplices of `K`.
* `ofComplex4_move`: every 4D move is the bistellar move `κ(σ, τ)` on the generated complex;
  `isMove_of_isBistellar`: conversely, every bistellar move `κ(σ, τ)` with `#σ + #τ = 6` comes
  from a 4D move. So Pachner's theorem for simplicial complexes applies to `Complex4`.
* `IsCombManifold4 K`: `K` is a closed combinatorial 4-manifold (every vertex link is a PL
  3-sphere); `isCombManifold4_move_iff`: the 4D moves preserve and reflect it;
  `IsCombManifold4.isClosed4`: such a `K` is a closed pseudo-manifold in the sense of `FourD/`
  (every tetrahedron lies in exactly two 4-simplices).
-/

open Finset Lightlike.FourD

namespace Lightlike.PL

open SComplex

variable {V : Type*} [DecidableEq V]

/-! ## Combinatorial manifolds are invariant under stellar equivalence -/

/-- **Stellar equivalence preserves closed combinatorial manifolds.** -/
theorem SComplex.StellarEquiv.isClosedCombManifold_iff {n : ℕ} {K L : SComplex V}
    (h : StellarEquiv K L) : IsClosedCombManifold n K ↔ IsClosedCombManifold n L := by
  rw [IsClosedCombManifold, IsClosedCombManifold, ← isMfdIn_false_iff, ← isMfdIn_false_iff]
  exact isMfdIn_iff_of_stellarEquivIn (isMfdIn_main false n).1 h

/-- **Stellar equivalence preserves combinatorial manifolds.** -/
theorem SComplex.StellarEquiv.isCombManifold_iff {n : ℕ} {K L : SComplex V}
    (h : StellarEquiv K L) : IsCombManifold n K ↔ IsCombManifold n L := by
  rw [IsCombManifold, IsCombManifold, ← isMfdIn_true_iff, ← isMfdIn_true_iff]
  exact isMfdIn_iff_of_stellarEquivIn (isMfdIn_main true n).1 h

/-! ## The bridge -/

/-- The simplicial complex generated by the 4-simplices of a `Complex4`. -/
def ofComplex4 (K : Complex4 V) : SComplex V := SComplex.closure K.simps

lemma verts_ofComplex4 (K : Complex4 V) : (ofComplex4 K).verts = K.verts := by
  ext v
  rw [mem_verts, ofComplex4, mem_closure, Complex4.mem_verts]
  simp

/-- `(σ ∪ τ) ∖ {v} = σ ∪ (τ ∖ {v})` for `v ∉ σ`. -/
lemma union_erase_of_notMem {σ τ : Finset V} {v : V} (hv : v ∉ σ) :
    (σ ∪ τ).erase v = σ ∪ τ.erase v := by
  ext x
  simp only [mem_erase, mem_union]
  constructor
  · rintro ⟨hxv, hx | hx⟩
    · exact .inl hx
    · exact .inr ⟨hxv, hx⟩
  · rintro (hx | ⟨hxv, hx⟩)
    · exact ⟨fun e => hv (e ▸ hx), .inl hx⟩
    · exact ⟨hxv, .inr hx⟩

/-- `(σ ∪ τ) ∖ {u} = (σ ∖ {u}) ∪ τ` for `u ∉ τ`. -/
lemma union_erase_of_notMem' {σ τ : Finset V} {u : V} (hu : u ∉ τ) :
    (σ ∪ τ).erase u = σ.erase u ∪ τ := by
  rw [union_comm, union_erase_of_notMem hu, union_comm]

lemma move4_mem {K : Complex4 V} {σ τ : Finset V} (h : K.IsMove σ τ) :
    ∀ x ∈ τ, σ ∪ τ.erase x ∈ K.simps := fun x hx => by
  rw [← union_erase_of_notMem (disjoint_right.1 h.disj hx)]
  exact h.mem x hx

lemma move4_star {K : Complex4 V} {σ τ : Finset V} (h : K.IsMove σ τ) :
    ∀ t ∈ K.simps, σ ⊆ t → ∃ x ∈ τ, t ⊆ σ ∪ τ.erase x := fun t ht hσt => by
  obtain ⟨v, hv, rfl⟩ := h.star t ht hσt
  exact ⟨v, hv, (union_erase_of_notMem (disjoint_right.1 h.disj hv)).le⟩

/-- **A 4D move is a bistellar move**: its preconditions are those of `κ(σ, τ)`. -/
theorem isBistellar_move4 {K : Complex4 V} {σ τ : Finset V} (h : K.IsMove σ τ) :
    (ofComplex4 K).IsBistellar σ τ :=
  isBistellar_closure h.nonempty_left h.nonempty_right h.disj (move4_mem h) (move4_star h) h.fresh

/-- **The 4D Pachner move of `FourD/` is the bistellar move `κ(σ, τ)`** on the generated
complex. -/
theorem ofComplex4_move {K : Complex4 V} {σ τ : Finset V} (h : K.IsMove σ τ) :
    ofComplex4 (K.move h) = (ofComplex4 K).bistellar σ τ (isBistellar_move4 h) := by
  change SComplex.closure _ = (SComplex.closure K.simps).bistellar _ _ _
  rw [bistellar_closure h.nonempty_left h.nonempty_right h.disj (move4_mem h) (move4_star h) h.fresh]
  congr 1
  change K.simps.filter (fun s => ¬ σ ⊆ s) ∪ σ.image (fun u => (σ ∪ τ).erase u) = _
  congr 1
  refine image_congr fun u hu => ?_
  exact union_erase_of_notMem' (disjoint_left.1 h.disj hu)

/-- **Conversely, a bistellar move `κ(σ, τ)` with `#σ + #τ = 6` on the generated complex is a 4D
move.** -/
theorem isMove_of_isBistellar {K : Complex4 V} {σ τ : Finset V}
    (h : (ofComplex4 K).IsBistellar σ τ) (hc : #σ + #τ = 6) : K.IsMove σ τ where
  disj := h.disjoint
  card := hc
  nonempty_left := h.nonempty_left
  nonempty_right := h.nonempty_right
  mem := by
    intro v hv
    have hl : τ.erase v ∈ (ofComplex4 K).link σ := by
      rw [h.link_eq, mem_boundary]
      exact erase_ssubset hv
    obtain ⟨-, -, hK⟩ := mem_link.1 hl
    obtain ⟨s, hs, hsub⟩ := mem_closure.1 hK
    have hvσ : v ∉ σ := disjoint_right.1 h.disjoint hv
    rw [union_erase_of_notMem hvσ]
    have hcard : #(σ ∪ τ.erase v) = 5 := by
      rw [card_union_of_disjoint (disjoint_of_subset_right (erase_subset v τ) h.disjoint),
        card_erase_of_mem hv]
      have := card_pos.2 h.nonempty_right
      omega
    have : σ ∪ τ.erase v = s :=
      eq_of_subset_of_card_le hsub (by rw [K.card_eq s hs, hcard])
    rw [this]
    exact hs
  star := by
    intro s hs hσs
    have hsK : σ ∪ s \ σ ∈ ofComplex4 K := by
      rw [union_sdiff_of_subset hσs]
      exact mem_closure.2 ⟨s, hs, subset_rfl⟩
    have hsl : s \ σ ∈ (ofComplex4 K).link σ := mem_link'.2 ⟨disjoint_sdiff, hsK⟩
    rw [h.link_eq, mem_boundary] at hsl
    have hc' : #(s \ σ) + 1 = #τ := by
      rw [card_sdiff_of_subset hσs, K.card_eq s hs]
      have := card_le_card hσs
      rw [K.card_eq s hs] at this
      omega
    obtain ⟨v, hv, hvs⟩ := not_subset.1 hsl.not_subset
    refine ⟨v, hv, ?_⟩
    have he : s \ σ = τ.erase v := eq_of_subset_of_card_le
      (fun x hx => mem_erase.2 ⟨fun e => hvs (e ▸ hx), hsl.subset hx⟩)
      (by rw [card_erase_of_mem hv]; omega)
    rw [union_erase_of_notMem (disjoint_right.1 h.disjoint hv), ← he,
      union_sdiff_of_subset hσs]
  fresh := fun s hs hτs => h.notMem (mem_closure.2 ⟨s, hs, hτs⟩)

/-! ## Combinatorial 4-manifolds -/

/-- `K` is a **closed combinatorial 4-manifold**: every vertex link of the generated complex is a
PL 3-sphere. -/
def IsCombManifold4 (K : Complex4 V) : Prop := IsClosedCombManifold 4 (ofComplex4 K)

/-- The vertex links, in terms of the 4-simplices: the tetrahedra opposite `v` in the 4-simplices
through `v` generate a PL 3-sphere. -/
theorem isCombManifold4_iff {K : Complex4 V} :
    IsCombManifold4 K ↔ ∀ v ∈ K.verts,
      IsPLSphere 3 (SComplex.closure ((K.simps.filter (v ∈ ·)).image (·.erase v))) := by
  rw [IsCombManifold4, isClosedCombManifold_succ_iff, verts_ofComplex4]
  refine forall₂_congr fun v _ => ?_
  rw [ofComplex4, link_closure]

/-- **The 4D Pachner moves preserve and reflect closed combinatorial 4-manifolds.** -/
theorem isCombManifold4_move_iff {K : Complex4 V} {σ τ : Finset V} (h : K.IsMove σ τ) :
    IsCombManifold4 (K.move h) ↔ IsCombManifold4 K := by
  rw [IsCombManifold4, IsCombManifold4, ofComplex4_move]
  exact (StellarEquiv.bistellar _).isClosedCombManifold_iff.symm

/-- **A closed combinatorial 4-manifold is a closed pseudo-manifold**: every tetrahedron lies in
exactly two 4-simplices (its link is a PL 0-sphere, which has two vertices). -/
theorem IsCombManifold4.isClosed4 {K : Complex4 V} (h : IsCombManifold4 K) : K.IsClosed4 := by
  intro t ht
  obtain ⟨s₀, hs₀, hts₀, ht4⟩ := Complex4.mem_faces.1 ht
  have htK : t ∈ ofComplex4 K := mem_closure.2 ⟨s₀, hs₀, hts₀⟩
  have hlk := IsClosedCombManifold.isPLSphere_link h htK (card_pos.1 (by omega)) (by omega)
  rw [ht4] at hlk
  have hlk0 : IsPLSphere 0 ((ofComplex4 K).link t) := hlk
  have h2 := hlk0.card_verts_zero
  rw [← h2]
  have he : K.star t = ((ofComplex4 K).link t).verts.image (insert · t) := by
    ext s
    rw [Complex4.mem_star, mem_image]
    constructor
    · rintro ⟨hs, hts⟩
      have hc : #(s \ t) = 1 := by rw [card_sdiff_of_subset hts, K.card_eq s hs, ht4]
      obtain ⟨w, hw⟩ := card_eq_one.1 hc
      have hws : w ∈ s \ t := hw ▸ mem_singleton_self w
      rw [mem_sdiff] at hws
      refine ⟨w, mem_verts.2 (mem_link'.2 ⟨disjoint_singleton_right.2 hws.2, ?_⟩), ?_⟩
      · exact mem_closure.2 ⟨s, hs, union_subset hts (singleton_subset_iff.2 hws.1)⟩
      · rw [← sdiff_union_of_subset hts, hw, insert_eq]
    · rintro ⟨w, hw, rfl⟩
      obtain ⟨hwt, hwK⟩ := mem_link'.1 (mem_verts.1 hw)
      obtain ⟨s, hs, hsub⟩ := mem_closure.1 hwK
      have hwt' : w ∉ t := disjoint_singleton_right.1 hwt
      have : insert w t = s := by
        refine eq_of_subset_of_card_le (by rwa [insert_eq, union_comm]) ?_
        rw [K.card_eq s hs, card_insert_of_notMem hwt', ht4]
      exact ⟨this ▸ hs, subset_insert w t⟩
  rw [he, card_image_of_injOn]
  intro w hw w' hw' hww'
  have hwt : w ∉ t := disjoint_singleton_right.1 (mem_link'.1 (mem_verts.1 hw)).1
  have hwt' : w' ∉ t := disjoint_singleton_right.1 (mem_link'.1 (mem_verts.1 hw')).1
  have := congrArg (· \ t) hww'
  simp only [insert_sdiff_of_notMem _ hwt, insert_sdiff_of_notMem _ hwt', sdiff_self,
    bot_eq_empty, insert_empty, singleton_inj] at this
  exact this

/-- The boundary of a 5-simplex, `Complex4.sphere S`, generates the boundary of the simplex on `S`. -/
theorem ofComplex4_sphere {S : Finset V} (hS : #S = 6) :
    ofComplex4 (Complex4.sphere S) = boundary S := by
  refine ext_mem fun f => ?_
  rw [ofComplex4, mem_closure, mem_boundary]
  constructor
  · rintro ⟨s, hs, hfs⟩
    rw [Complex4.sphere, mem_powersetCard] at hs
    refine hfs.trans_ssubset (Finset.ssubset_iff_subset_ne.2 ⟨hs.1, fun e => ?_⟩)
    rw [e, hS] at hs
    omega
  · intro hf
    obtain ⟨x, hxS, hxf⟩ := not_subset.1 hf.not_subset
    refine ⟨S.erase x, ?_, fun y hy => mem_erase.2 ⟨fun e => hxf (e ▸ hy), hf.subset hy⟩⟩
    rw [Complex4.sphere, mem_powersetCard, card_erase_of_mem hxS, hS]
    exact ⟨erase_subset x S, rfl⟩

/-- **The boundary of a 5-simplex is a closed combinatorial 4-manifold.** -/
theorem isCombManifold4_sphere {S : Finset V} (hS : #S = 6) :
    IsCombManifold4 (Complex4.sphere S) := by
  rw [IsCombManifold4, ofComplex4_sphere hS]
  exact isClosedCombManifold_boundary hS

end Lightlike.PL
