import Mathlib.AlgebraicTopology.SimplicialComplex.Basic
import Mathlib.Data.Finset.Powerset
import Mathlib.Data.Finset.Prod
import Mathlib.Data.Finset.Preimage

/-!
# Finite abstract simplicial complexes

A **finite abstract simplicial complex** on a vertex type `V` is a finite family of finite vertex
sets (its *faces*) that is closed under taking subsets. We follow the convention of combinatorial
topology (Lickorish, *Simplicial moves on complexes and manifolds*, Geom. Topol. Monogr. 2 (1999)
299–320) in which the **empty set is a face** of every non-void complex. This makes the join and
link formulas uniform and gives the `(−1)`-sphere `{∅}`, the boundary of a 0-simplex, which is the
link of a top-dimensional simplex in a closed manifold.

Mathlib has `PreAbstractSimplicialComplex` and `AbstractSimplicialComplex`
(`Mathlib/AlgebraicTopology/SimplicialComplex/Basic.lean`): families of *nonempty* sets, given
as a `Set`, without finiteness. Here we need finite complexes (cardinalities, kernel `decide` on
examples) and the empty face, so we use our own structure `SComplex V` and map it to Mathlib's
notion by `SComplex.toPreAbstract` (forget the empty face).

## Definitions

* `SComplex V`: a finite downward closed family of finite subsets of `V`; `s ∈ K` for faces.
* `verts K`: the vertices (the elements of faces).
* `simplex A`: all subsets of `A`; `boundary A`: all proper subsets of `A`.
  For `A` with `n + 1` elements these are the `n`-simplex `Δⁿ` and the `(n−1)`-sphere `∂Δⁿ`;
  `boundary {x} = {∅}`.
* `closure T`: the complex generated by a finite family `T` (all subsets of members of `T`).
* `map K f`: the image under an injective map `f : V ↪ W` of the vertices (for a permutation, an
  isomorphic complex); `lift K = map K inl`, the same complex on `V ⊕ ℕ`, where there is an
  unlimited supply of new vertices.
* `join K L`: unions of a face of `K` and a face of `L`; `cone a K = join (simplex {a}) K`.
  No disjointness is assumed in the definition, and for overlapping vertex sets `join` is not
  Lickorish's join. Every result that uses the join in its usual sense (the exchanges of
  `Lightlike/PL/Exchange.lean`, `IsSB.boundary_join`, Pachner's theorem) assumes disjoint vertex
  sets.
* `link K σ`: the faces `u` disjoint from `σ` with `σ ∪ u ∈ K`; `star K σ`: the faces `u` with
  `σ ∪ u ∈ K` (the closed star).

## Main results

* `star_eq_join`: the closed star of a face is the join of the face with its link.
* `link_cone_apex`: the link of the apex of a cone `a * K` is `K`.
* `link_link`: the link of `τ` in the link of `σ` is the link of `σ ∪ τ`.
* `link_simplex`, `link_boundary`: links in a simplex and in its boundary are again a simplex and a
  boundary, `lk(σ, Δ_A) = Δ_{A∖σ}` and `lk(σ, ∂Δ_A) = ∂Δ_{A∖σ}`.
* `link_closure`: the link of a vertex in a complex given by generating faces.
* `toPreAbstract_injective`: the bridge to Mathlib forgets nothing on non-void complexes.
-/

open Finset

namespace Lightlike.PL

/-- A **finite abstract simplicial complex** on the vertex type `V`: a finite family of finite
vertex sets closed under subsets. The empty set is a face of every non-void complex.

Finiteness is needed: the quadrant `[0, ∞)²` cut into unit squares, every square split along its `/` diagonal,
versus every square split along its `\` diagonal, are PL homeomorphic, but no finite sequence of bistellar moves
and isomorphisms joins them. The boundary is essential: on the whole plane the two grids are mirror images, hence
isomorphic. -/
@[ext]
structure SComplex (V : Type*) where
  /-- The faces, as finite vertex sets. -/
  faces : Finset (Finset V)
  /-- Every subset of a face is a face. -/
  down : ∀ s ∈ faces, ∀ t ⊆ s, t ∈ faces

namespace SComplex

variable {V : Type*}

instance : Membership (Finset V) (SComplex V) := ⟨fun K s => s ∈ K.faces⟩

@[simp] lemma mem_faces {K : SComplex V} {s : Finset V} : s ∈ K.faces ↔ s ∈ K := Iff.rfl

instance [DecidableEq V] (K : SComplex V) (s : Finset V) : Decidable (s ∈ K) :=
  inferInstanceAs (Decidable (s ∈ K.faces))

/-- Two complexes are equal when they have the same faces. -/
lemma ext_mem {K L : SComplex V} (h : ∀ s, s ∈ K ↔ s ∈ L) : K = L :=
  SComplex.ext (Finset.ext h)

/-- A subset of a face is a face. -/
lemma down_mem {K : SComplex V} {s t : Finset V} (hs : s ∈ K) (ht : t ⊆ s) : t ∈ K :=
  K.down s hs t ht

/-- The empty set is a face of every complex with at least one face. -/
lemma empty_mem {K : SComplex V} {s : Finset V} (hs : s ∈ K) : ∅ ∈ K :=
  down_mem hs (empty_subset s)

variable [DecidableEq V]

/-! ## Vertices -/

/-- The **vertices** of `K`: the elements of its faces. -/
def verts (K : SComplex V) : Finset V := K.faces.biUnion id

lemma mem_verts {K : SComplex V} {x : V} : x ∈ K.verts ↔ {x} ∈ K := by
  simp only [verts, mem_biUnion, id, mem_faces]
  exact ⟨fun ⟨s, hs, hx⟩ => down_mem hs (singleton_subset_iff.2 hx),
    fun h => ⟨{x}, h, mem_singleton_self x⟩⟩

lemma subset_verts {K : SComplex V} {s : Finset V} (hs : s ∈ K) : s ⊆ K.verts := fun _ hx =>
  mem_verts.2 (down_mem hs (singleton_subset_iff.2 hx))

lemma notMem_of_notMem_verts {K : SComplex V} {s : Finset V} {a : V} (ha : a ∉ K.verts)
    (hs : s ∈ K) : a ∉ s := fun h => ha (subset_verts hs h)

/-! ## Simplices, boundaries, closures -/

/-- The **simplex** on the vertex set `A`: all subsets of `A`. For `#A = n + 1` this is the
`n`-simplex. -/
def simplex (A : Finset V) : SComplex V where
  faces := A.powerset
  down _ hs _ ht := mem_powerset.2 (ht.trans (mem_powerset.1 hs))

omit [DecidableEq V] in
@[simp] lemma mem_simplex {A s : Finset V} : s ∈ simplex A ↔ s ⊆ A := mem_powerset

/-- The **boundary** of the simplex on `A`: all proper subsets of `A`. For `#A = n + 1` this is
the `(n−1)`-sphere `∂Δⁿ`; the boundary of a 0-simplex is `{∅}`, the `(−1)`-sphere. -/
def boundary (A : Finset V) : SComplex V where
  faces := A.powerset.erase A
  down s hs t ht := by
    rw [mem_erase, mem_powerset] at hs ⊢
    exact ⟨fun h => hs.1 (subset_antisymm hs.2 (h ▸ ht)), ht.trans hs.2⟩

@[simp] lemma mem_boundary {A s : Finset V} : s ∈ boundary A ↔ s ⊂ A := by
  change s ∈ A.powerset.erase A ↔ _
  rw [mem_erase, mem_powerset, Finset.ssubset_iff_subset_ne, and_comm]

lemma verts_boundary_subset (A : Finset V) : (boundary A).verts ⊆ A := fun x hx =>
  (mem_boundary.1 (mem_verts.1 hx)).subset (mem_singleton_self x)

/-- The complex **generated** by a finite family `T` of vertex sets: all subsets of members. -/
def closure (T : Finset (Finset V)) : SComplex V where
  faces := T.biUnion powerset
  down s hs t ht := by
    simp only [mem_biUnion, mem_powerset] at hs ⊢
    obtain ⟨u, hu, hsu⟩ := hs
    exact ⟨u, hu, ht.trans hsu⟩

@[simp] lemma mem_closure {T : Finset (Finset V)} {s : Finset V} :
    s ∈ closure T ↔ ∃ t ∈ T, s ⊆ t := by
  change s ∈ T.biUnion powerset ↔ _
  simp

lemma closure_singleton (A : Finset V) : closure {A} = simplex A := ext_mem fun s => by simp

lemma verts_simplex (A : Finset V) : (simplex A).verts = A := by
  ext x; simp [mem_verts]

lemma verts_boundary {A : Finset V} (hA : 2 ≤ #A) : (boundary A).verts = A := by
  ext x
  rw [mem_verts, mem_boundary]
  constructor
  · exact fun h => singleton_subset_iff.1 h.subset
  · intro hx
    refine Finset.ssubset_iff_subset_ne.2 ⟨singleton_subset_iff.2 hx, fun h => ?_⟩
    rw [← h, card_singleton] at hA
    omega

lemma boundary_singleton (x : V) : boundary {x} = simplex ∅ := ext_mem fun s => by
  rw [mem_boundary, mem_simplex, subset_empty, ssubset_singleton_iff]

/-! ## Joins and cones -/

/-- The **join** `K * L`: unions of a face of `K` and a face of `L`. When the vertex sets are
disjoint this is the usual join of simplicial complexes. -/
def join (K L : SComplex V) : SComplex V where
  faces := (K.faces ×ˢ L.faces).image fun p => p.1 ∪ p.2
  down s hs r hr := by
    simp only [mem_image, mem_product, Prod.exists] at hs ⊢
    obtain ⟨t, u, ⟨ht, hu⟩, rfl⟩ := hs
    refine ⟨r ∩ t, r ∩ u, ⟨down_mem ht inter_subset_right, down_mem hu inter_subset_right⟩, ?_⟩
    rw [← inter_union_distrib_left, inter_eq_left.2 hr]

lemma mem_join {K L : SComplex V} {s : Finset V} :
    s ∈ K.join L ↔ ∃ t ∈ K, ∃ u ∈ L, t ∪ u = s := by
  change s ∈ (K.faces ×ˢ L.faces).image _ ↔ _
  simp only [mem_image, mem_product, Prod.exists, mem_faces]
  constructor
  · rintro ⟨t, u, ⟨ht, hu⟩, rfl⟩; exact ⟨t, ht, u, hu, rfl⟩
  · rintro ⟨t, ht, u, hu, rfl⟩; exact ⟨t, u, ⟨ht, hu⟩, rfl⟩

/-- The **cone** on `K` with apex `a`: the join of the vertex `a` with `K`. -/
def cone (a : V) (K : SComplex V) : SComplex V := (simplex {a}).join K

lemma mem_cone {a : V} {K : SComplex V} {s : Finset V} :
    s ∈ cone a K ↔ ∃ t ∈ K, s = t ∨ s = insert a t := by
  rw [cone, mem_join]
  constructor
  · rintro ⟨r, hr, t, ht, rfl⟩
    rw [mem_simplex, subset_singleton_iff] at hr
    rcases hr with rfl | rfl
    · exact ⟨t, ht, .inl (empty_union t)⟩
    · exact ⟨t, ht, .inr (insert_eq a t).symm⟩
  · rintro ⟨t, ht, h | h⟩
    · exact ⟨∅, mem_simplex.2 (empty_subset _), t, ht, by rw [h, empty_union]⟩
    · exact ⟨{a}, mem_simplex.2 subset_rfl, t, ht, by rw [h, insert_eq]⟩

/-! ## Links and stars -/

/-- The **link** of `σ` in `K`: the faces `u` disjoint from `σ` such that `σ ∪ u` is a face.
It is the void complex when `σ` is not a face. -/
def link (K : SComplex V) (σ : Finset V) : SComplex V where
  faces := K.faces.filter fun u => Disjoint σ u ∧ σ ∪ u ∈ K.faces
  down s hs t ht := by
    simp only [mem_filter, mem_faces] at hs ⊢
    exact ⟨down_mem hs.1 ht, hs.2.1.mono_right ht, down_mem hs.2.2 (union_subset_union_right ht)⟩

@[simp] lemma mem_link {K : SComplex V} {σ u : Finset V} :
    u ∈ K.link σ ↔ u ∈ K ∧ Disjoint σ u ∧ σ ∪ u ∈ K := by
  change u ∈ K.faces.filter _ ↔ _
  simp

/-- `u` lies in the link of `σ` exactly when it is disjoint from `σ` and `σ ∪ u` is a face. -/
lemma mem_link' {K : SComplex V} {σ u : Finset V} :
    u ∈ K.link σ ↔ Disjoint σ u ∧ σ ∪ u ∈ K := by
  rw [mem_link]
  exact ⟨fun h => h.2, fun h => ⟨down_mem h.2 subset_union_right, h⟩⟩

/-- The **closed star** of `σ` in `K`: the faces `u` such that `σ ∪ u` is a face. -/
def star (K : SComplex V) (σ : Finset V) : SComplex V where
  faces := K.faces.filter fun u => σ ∪ u ∈ K.faces
  down s hs t ht := by
    simp only [mem_filter, mem_faces] at hs ⊢
    exact ⟨down_mem hs.1 ht, down_mem hs.2 (union_subset_union_right ht)⟩

@[simp] lemma mem_star {K : SComplex V} {σ u : Finset V} :
    u ∈ K.star σ ↔ σ ∪ u ∈ K := by
  change u ∈ K.faces.filter _ ↔ _
  simp only [mem_filter, mem_faces, and_iff_right_iff_imp]
  exact fun h => down_mem h subset_union_right

/-- The link of the empty face is the whole complex. -/
@[simp] lemma link_empty (K : SComplex V) : K.link ∅ = K := ext_mem fun u => by simp

/-- **The link of the apex of a cone** on `K` is `K`, when the apex is not a vertex of `K`. -/
theorem link_cone_apex {a : V} {K : SComplex V} (ha : a ∉ K.verts) : (cone a K).link {a} = K := by
  refine ext_mem fun u => ?_
  rw [mem_link', disjoint_singleton_left, mem_cone, ← insert_eq]
  constructor
  · rintro ⟨hau, t, ht, he | he⟩
    · exact absurd (he ▸ mem_insert_self a u) (fun h => ha (subset_verts ht h))
    · have hat : a ∉ t := fun h => ha (subset_verts ht h)
      rw [← erase_insert hau, he, erase_insert hat]
      exact ht
  · intro hu
    exact ⟨fun h => ha (subset_verts hu h), u, hu, .inr rfl⟩

/-- **The closed star of a face is the join of the face with its link**: `st(σ) = σ * lk(σ)`. -/
theorem star_eq_join (K : SComplex V) (σ : Finset V) :
    K.star σ = (simplex σ).join (K.link σ) := by
  refine ext_mem fun u => ?_
  rw [mem_star, mem_join]
  constructor
  · intro h
    refine ⟨u ∩ σ, mem_simplex.2 inter_subset_right, u \ σ, mem_link'.2 ⟨disjoint_sdiff, ?_⟩, ?_⟩
    · rwa [union_sdiff_self_eq_union]
    · rw [union_comm, sdiff_union_inter]
  · rintro ⟨t, ht, w, hw, rfl⟩
    rw [mem_simplex] at ht
    rw [mem_link'] at hw
    rw [← union_assoc, union_eq_left.2 ht]
    exact hw.2

/-- **Links of links**: for disjoint `σ`, `τ`, `lk(τ, lk(σ, K)) = lk(σ ∪ τ, K)`. -/
theorem link_link (K : SComplex V) {σ τ : Finset V} (h : Disjoint σ τ) :
    (K.link σ).link τ = K.link (σ ∪ τ) := by
  refine ext_mem fun u => ?_
  simp only [mem_link', disjoint_union_left, disjoint_union_right]
  constructor
  · rintro ⟨hτu, hστ, hστu⟩
    exact ⟨⟨hστ.2, hτu⟩, by rwa [union_assoc]⟩
  · rintro ⟨⟨hσu, hτu⟩, hu⟩
    exact ⟨hτu, ⟨h, hσu⟩, by rwa [← union_assoc]⟩

/-- The link of a face `σ ⊆ A` in the simplex on `A` is the simplex on `A ∖ σ`. -/
theorem link_simplex {A σ : Finset V} (hσ : σ ⊆ A) : (simplex A).link σ = simplex (A \ σ) := by
  refine ext_mem fun u => ?_
  rw [mem_link', mem_simplex, mem_simplex, union_subset_iff, subset_sdiff, disjoint_comm]
  exact ⟨fun h => ⟨h.2.2, h.1⟩, fun h => ⟨h.2, hσ, h.1⟩⟩

/-- The link of a proper face `σ ⊂ A` in the boundary of the simplex on `A` is the boundary of the
simplex on `A ∖ σ`. -/
theorem link_boundary {A σ : Finset V} (hσ : σ ⊂ A) :
    (boundary A).link σ = boundary (A \ σ) := by
  refine ext_mem fun u => ?_
  rw [mem_link', mem_boundary, mem_boundary]
  constructor
  · rintro ⟨hd, hu⟩
    refine Finset.ssubset_iff_subset_ne.2 ⟨subset_sdiff.2 ⟨subset_union_right.trans hu.subset,
      disjoint_comm.1 hd⟩, fun he => ?_⟩
    rw [he, union_sdiff_of_subset hσ.subset] at hu
    exact hu.ne rfl
  · intro hu
    have hsub : u ⊆ A \ σ := hu.subset
    refine ⟨disjoint_comm.1 (subset_sdiff.1 hsub).2, Finset.ssubset_iff_subset_ne.2
      ⟨union_subset hσ.subset (hsub.trans sdiff_subset), fun he => hu.ne ?_⟩⟩
    refine subset_antisymm hsub fun x hx => ?_
    rw [mem_sdiff] at hx
    have : x ∈ σ ∪ u := he ▸ hx.1
    rcases mem_union.1 this with h | h
    · exact absurd h hx.2
    · exact h

/-- The link of a vertex `v` of the boundary of the simplex on `A` is the boundary of the simplex
on `A ∖ {v}`. -/
lemma link_boundary_vertex {A : Finset V} {v : V} (hv : v ∈ (boundary A).verts) :
    (boundary A).link {v} = boundary (A.erase v) := by
  rw [mem_verts, mem_boundary] at hv
  rw [link_boundary hv, sdiff_singleton_eq_erase]

/-- The link of a vertex in the complex generated by `T` is generated by the faces of `T`
through the vertex, with the vertex removed. -/
theorem link_closure (T : Finset (Finset V)) (v : V) :
    (closure T).link {v} = closure ((T.filter (v ∈ ·)).image (·.erase v)) := by
  refine ext_mem fun u => ?_
  simp only [mem_link', mem_closure, mem_image, mem_filter, disjoint_singleton_left]
  constructor
  · rintro ⟨hv, t, ht, hut⟩
    have hvt : v ∈ t := hut (mem_union_left _ (mem_singleton_self v))
    refine ⟨t.erase v, ⟨t, ⟨ht, hvt⟩, rfl⟩, fun x hx => mem_erase.2 ⟨?_, ?_⟩⟩
    · rintro rfl; exact hv hx
    · exact hut (mem_union_right _ hx)
  · rintro ⟨_, ⟨t, ⟨ht, hvt⟩, rfl⟩, hut⟩
    refine ⟨fun h => (mem_erase.1 (hut h)).1 rfl, t, ht, union_subset ?_ ?_⟩
    · exact singleton_subset_iff.2 hvt
    · exact hut.trans (erase_subset v t)

/-! ## Injective maps of the vertices, and the lift -/

section Map

variable {W : Type*} [DecidableEq W]

/-- The image of `K` under an injective map `f` of the vertices. For a permutation of `V` this is
an *isomorphic* complex. -/
def map (K : SComplex V) (f : V ↪ W) : SComplex W where
  faces := K.faces.image (Finset.map f)
  down s hs t ht := by
    simp only [mem_image, mem_faces] at hs ⊢
    obtain ⟨u, hu, rfl⟩ := hs
    obtain ⟨v, hv, rfl⟩ := Finset.subset_map_iff.1 ht
    exact ⟨v, down_mem hu hv, rfl⟩

omit [DecidableEq V] in
lemma mem_map {K : SComplex V} {f : V ↪ W} {s : Finset W} :
    s ∈ K.map f ↔ ∃ t ∈ K, t.map f = s := by
  change s ∈ K.faces.image _ ↔ _
  simp

omit [DecidableEq V] in
@[simp] lemma map_mem_map {K : SComplex V} {f : V ↪ W} {t : Finset V} :
    t.map f ∈ K.map f ↔ t ∈ K := by
  rw [mem_map]
  exact ⟨fun ⟨u, hu, he⟩ => Finset.map_inj.1 he ▸ hu, fun h => ⟨t, h, rfl⟩⟩

omit [DecidableEq V] in
lemma exists_eq_map_of_mem_map {K : SComplex V} {f : V ↪ W} {s : Finset W} (hs : s ∈ K.map f) :
    ∃ t : Finset V, t.map f = s :=
  let ⟨t, _, h⟩ := mem_map.1 hs
  ⟨t, h⟩

omit [DecidableEq V] in
/-- A complex whose faces are images under `f`, with preimages exactly the faces of `K`, is the
image of `K`. -/
lemma eq_map_of {M : SComplex W} {K : SComplex V} {f : V ↪ W}
    (hM : ∀ s ∈ M, ∃ t : Finset V, t.map f = s) (h : ∀ t : Finset V, t.map f ∈ M ↔ t ∈ K) : M = K.map f := ext_mem fun s => by
  constructor
  · intro hs
    obtain ⟨t, rfl⟩ := hM s hs
    exact map_mem_map.2 ((h t).1 hs)
  · intro hs
    obtain ⟨t, ht, rfl⟩ := mem_map.1 hs
    exact (h t).2 ht

lemma verts_map (K : SComplex V) (f : V ↪ W) : (K.map f).verts = K.verts.map f := by
  ext x
  rw [mem_verts, Finset.mem_map]
  constructor
  · intro h
    obtain ⟨t, ht, he⟩ := mem_map.1 h
    have : #t = 1 := by rw [← card_map f, he, card_singleton]
    obtain ⟨y, rfl⟩ := card_eq_one.1 this
    rw [map_singleton, singleton_inj] at he
    exact ⟨y, mem_verts.2 ht, he⟩
  · rintro ⟨y, hy, rfl⟩
    rw [← map_singleton]
    exact map_mem_map.2 (mem_verts.1 hy)

omit [DecidableEq V] in
lemma map_map {U : Type*} [DecidableEq U] (K : SComplex V) (f : V ↪ W) (g : W ↪ U) :
    (K.map f).map g = K.map (f.trans g) := ext_mem fun s => by
  simp only [mem_map]
  constructor
  · rintro ⟨t, ⟨u, hu, rfl⟩, rfl⟩
    exact ⟨u, hu, by rw [Finset.map_map]⟩
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u.map f, ⟨u, hu, rfl⟩, by rw [Finset.map_map]⟩

/-- The image depends only on the values of `f` on the vertices. -/
lemma map_congr {K : SComplex V} {f g : V ↪ W} (h : ∀ x ∈ K.verts, f x = g x) :
    K.map f = K.map g := by
  have key : ∀ t ∈ K, t.map f = t.map g := fun t ht => by
    ext y
    simp only [Finset.mem_map]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨x, hx, (h x (subset_verts ht hx)).symm⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨x, hx, h x (subset_verts ht hx)⟩
  refine ext_mem fun s => ?_
  simp only [mem_map]
  constructor
  · rintro ⟨t, ht, rfl⟩
    exact ⟨t, ht, (key t ht).symm⟩
  · rintro ⟨t, ht, rfl⟩
    exact ⟨t, ht, key t ht⟩

lemma map_refl (K : SComplex V) : K.map (Function.Embedding.refl V) = K :=
  ext_mem fun s => by simp [mem_map]

omit [DecidableEq V] in
lemma map_simplex (A : Finset V) (f : V ↪ W) : (simplex A).map f = simplex (A.map f) :=
  ext_mem fun s => by
    rw [mem_map, mem_simplex]
    constructor
    · rintro ⟨t, ht, rfl⟩
      exact Finset.map_subset_map.2 (mem_simplex.1 ht)
    · intro hs
      obtain ⟨u, hu, rfl⟩ := Finset.subset_map_iff.1 hs
      exact ⟨u, mem_simplex.2 hu, rfl⟩

lemma map_boundary (A : Finset V) (f : V ↪ W) : (boundary A).map f = boundary (A.map f) :=
  ext_mem fun s => by
    rw [mem_map, mem_boundary]
    constructor
    · rintro ⟨t, ht, rfl⟩
      exact Finset.map_ssubset_map.2 (mem_boundary.1 ht)
    · intro hs
      obtain ⟨u, -, rfl⟩ := Finset.subset_map_iff.1 hs.subset
      exact ⟨u, mem_boundary.2 (Finset.map_ssubset_map.1 hs), rfl⟩

lemma map_closure (T : Finset (Finset V)) (f : V ↪ W) :
    (closure T).map f = closure (T.image (Finset.map f)) :=
  ext_mem fun s => by
    rw [mem_map, mem_closure]
    constructor
    · rintro ⟨t, ht, rfl⟩
      obtain ⟨u, hu, htu⟩ := mem_closure.1 ht
      exact ⟨u.map f, mem_image_of_mem _ hu, Finset.map_subset_map.2 htu⟩
    · rintro ⟨u, hu, hsu⟩
      obtain ⟨u', hu', rfl⟩ := mem_image.1 hu
      obtain ⟨t, ht, rfl⟩ := Finset.subset_map_iff.1 hsu
      exact ⟨t, mem_closure.2 ⟨u', hu', ht⟩, rfl⟩

/-- Links commute with injective maps of the vertices. -/
lemma map_link (K : SComplex V) (σ : Finset V) (f : V ↪ W) :
    (K.link σ).map f = (K.map f).link (σ.map f) := by
  refine (eq_map_of (fun s hs => exists_eq_map_of_mem_map (mem_link.1 hs).1) fun t => ?_).symm
  rw [mem_link, mem_link, map_mem_map, Finset.disjoint_map, ← Finset.map_union, map_mem_map]

/-- The **lift** of `K` to the vertex type `V ⊕ ℕ`, which has an unlimited supply of new vertices.
Stellar equivalence of complexes on `V` is measured after lifting (`StellarEquiv`), so that it does
not depend on how many vertices `V` has to spare. -/
def lift (K : SComplex V) : SComplex (V ⊕ ℕ) := K.map Function.Embedding.inl

lemma verts_lift (K : SComplex V) : K.lift.verts = K.verts.map Function.Embedding.inl :=
  verts_map K _

lemma link_lift (K : SComplex V) (σ : Finset V) :
    K.lift.link (σ.map Function.Embedding.inl) = (K.link σ).lift :=
  (map_link K σ _).symm

lemma lift_boundary (A : Finset V) : (boundary A).lift = boundary (A.map Function.Embedding.inl) :=
  map_boundary A _

lemma lift_simplex (A : Finset V) : (simplex A).lift = simplex (A.map Function.Embedding.inl) :=
  map_simplex A _

end Map

/-! ## Bridge to Mathlib -/

/-- The faces other than `∅`, as a Mathlib `PreAbstractSimplicialComplex`. -/
def toPreAbstract (K : SComplex V) : PreAbstractSimplicialComplex V where
  faces := {s | s ∈ K ∧ s.Nonempty}
  isRelLowerSet_faces :=
    IsLowerSet.isRelLowerSet_sep (s := {s | s ∈ K}) (P := Finset.Nonempty)
      (fun _ _ h hs => down_mem hs h)

omit [DecidableEq V] in
lemma mem_toPreAbstract {K : SComplex V} {s : Finset V} :
    s ∈ K.toPreAbstract ↔ s ∈ K ∧ s.Nonempty := Iff.rfl

omit [DecidableEq V] in
/-- The bridge to Mathlib loses nothing on complexes that have at least one face: such a complex
is determined by its nonempty faces. -/
theorem toPreAbstract_injective {K L : SComplex V} (hK : ∅ ∈ K) (hL : ∅ ∈ L)
    (h : K.toPreAbstract = L.toPreAbstract) : K = L := by
  refine ext_mem fun s => ?_
  rcases s.eq_empty_or_nonempty with rfl | hs
  · exact ⟨fun _ => hL, fun _ => hK⟩
  · have := SetLike.ext_iff.1 h s
    simp only [mem_toPreAbstract, hs, and_true] at this
    exact this

end SComplex

