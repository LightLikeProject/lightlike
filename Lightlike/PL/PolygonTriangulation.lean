import Lightlike.PL.PolygonSplit
import Lightlike.PL.PolygonTriangle
import Lightlike.PL.SubdivSphere

/-!
# Triangulating a simple polygon

A **triangulation** of a simple polygon `q` is a finite family `T` of triangles, each spanned by
three vertices of `q`, whose faces form a geometric complex with underlying set the closed region
bounded by `q` (the inside together with the carrier), and in which every edge of `q` is a face.

The proof is by induction on the number of vertices: a triangle is its own triangulation, and a
polygon with at least four vertices splits along an interior diagonal into two smaller polygons
whose triangulations fit together along the diagonal.

## Main definitions

* `Lightlike.PL.Polygon.IsTriangulation`
-/

open Set Finset

namespace Lightlike.PL
namespace SComplex

variable {E : Type*} [AddCommGroup E] [Module ℝ E] [DecidableEq E]

lemma space_closure (T : Finset (Finset E)) :
    (SComplex.closure T).space = ⋃ t ∈ T, convexHull ℝ (t : Set E) := by
  ext x
  simp only [mem_space, SComplex.mem_closure, Set.mem_iUnion, exists_prop]
  constructor
  · rintro ⟨s, ⟨t, ht, hst⟩, hx⟩
    exact ⟨t, ht, convexHull_mono (Finset.coe_subset.2 hst) hx⟩
  · rintro ⟨t, ht, hx⟩
    exact ⟨t, ⟨t, ht, subset_rfl⟩, hx⟩

/-- **Two geometric complexes that meet only along a common simplex fit together.** If `E` is a
face of both, and the underlying sets of the two complexes meet inside the hull of `E`, then the
complex generated by the union of the generating families is geometric. -/
lemma isGeom_closure_union {T₁ T₂ : Finset (Finset E)} (h₁ : IsGeom (SComplex.closure T₁))
    (h₂ : IsGeom (SComplex.closure T₂)) {F : Finset E} (hF₁ : F ∈ SComplex.closure T₁)
    (hF₂ : F ∈ SComplex.closure T₂)
    (hsp : (SComplex.closure T₁).space ∩ (SComplex.closure T₂).space ⊆ convexHull ℝ (F : Set E)) :
    IsGeom (SComplex.closure (T₁ ∪ T₂)) := by
  have hmem : ∀ s, s ∈ SComplex.closure (T₁ ∪ T₂) ↔
      s ∈ SComplex.closure T₁ ∨ s ∈ SComplex.closure T₂ := by
    intro s
    simp only [SComplex.mem_closure, Finset.mem_union]
    constructor
    · rintro ⟨t, ht | ht, hst⟩
      · exact Or.inl ⟨t, ht, hst⟩
      · exact Or.inr ⟨t, ht, hst⟩
    · rintro (⟨t, ht, hst⟩ | ⟨t, ht, hst⟩)
      · exact ⟨t, Or.inl ht, hst⟩
      · exact ⟨t, Or.inr ht, hst⟩
  -- the mixed case
  have mixed : ∀ s ∈ SComplex.closure T₁, ∀ t ∈ SComplex.closure T₂,
      convexHull ℝ (s : Set E) ∩ convexHull ℝ (t : Set E) ⊆ convexHull ℝ ((s : Set E) ∩ (t : Set E)) := by
    intro s hs t ht x ⟨hxs, hxt⟩
    have hxF : x ∈ convexHull ℝ (F : Set E) :=
      hsp ⟨convexHull_subset_space hs hxs, convexHull_subset_space ht hxt⟩
    have h1 := h₁.inter s hs F hF₁ ⟨hxs, hxF⟩
    have h2 := h₂.inter t ht F hF₂ ⟨hxt, hxF⟩
    have hind := h₁.indep F hF₁
    have h1' : x ∈ convexHull ℝ ((s ∩ F : Finset E) : Set E) := by
      rw [Finset.coe_inter]; exact h1
    have h2' : x ∈ convexHull ℝ ((t ∩ F : Finset E) : Set E) := by
      rw [Finset.coe_inter]; exact h2
    have := (hind.convexHull_inter (t₁ := s ∩ F) (t₂ := t ∩ F)
      Finset.inter_subset_right Finset.inter_subset_right).symm.subset ⟨h1', h2'⟩
    refine convexHull_mono ?_ this
    intro y hy
    simp only [Finset.coe_inter, Set.mem_inter_iff, Finset.mem_coe] at hy
    exact ⟨hy.1.1, hy.2.1⟩
  refine ⟨fun s hs => ?_, fun s hs t ht => ?_⟩
  · rcases (hmem s).1 hs with h | h
    · exact h₁.indep s h
    · exact h₂.indep s h
  · rcases (hmem s).1 hs with h | h <;> rcases (hmem t).1 ht with h' | h'
    · exact h₁.inter s h t h'
    · exact mixed s h t h'
    · intro x hx
      have := mixed t h' s h ⟨hx.2, hx.1⟩
      rwa [Set.inter_comm (t : Set E) (s : Set E)] at this
    · exact h₂.inter s h t h'

end SComplex

namespace Polygon

variable {n : ℕ}

/-- `T` is a **triangulation** of the polygon `q`: its triangles have three vertices among those
of `q`, their faces form a geometric complex whose underlying set is the closed region bounded by
`q`, and every edge of `q` is a face. -/
def IsTriangulation (q : Polygon n) (T : Finset (Finset (ℝ × ℝ))) : Prop :=
  (∀ t ∈ T, t.card = 3 ∧ (t : Set (ℝ × ℝ)) ⊆ Set.range q) ∧
    SComplex.IsGeom (SComplex.closure T) ∧
    (SComplex.closure T).space = q.inside ∪ q.carrier ∧
    ∀ i, ({q i, q (finRotate n i)} : Finset (ℝ × ℝ)) ∈ SComplex.closure T

/-- **A triangle is its own triangulation.** -/
theorem isTriangulation_triangle {q : Polygon 3} (hs : q.IsSimple) :
    ∃ T, IsTriangulation q T := by
  classical
  have hind := affineIndependent_of_isSimple hs
  have hinj : Function.Injective q := hind.injective
  set S : Finset (ℝ × ℝ) := Finset.univ.image q with hS
  have hSset : (S : Set (ℝ × ℝ)) = Set.range q := by simp [hS]
  refine ⟨{S}, ⟨fun t ht => ?_, ?_, ?_, fun i => ?_⟩⟩
  · rw [Finset.mem_singleton] at ht
    subst ht
    refine ⟨?_, hSset.le⟩
    rw [hS, Finset.card_image_of_injective _ hinj]; simp
  · rw [SComplex.closure_singleton]
    refine SComplex.isGeom_simplex ?_
    have := hind.range
    rwa [← hSset] at this
  · rw [SComplex.space_closure]
    simp only [Finset.mem_singleton, Set.iUnion_iUnion_eq_left]
    rw [hSset, inside_eq_interior_hull hs, carrier_eq_frontier_hull hs,
      ← closure_eq_interior_union_frontier]
    exact ((Set.finite_range q).isClosed_convexHull (𝕜 := ℝ)).closure_eq.symm
  · rw [SComplex.mem_closure]
    refine ⟨S, Finset.mem_singleton_self _, ?_⟩
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl <;> simp [hS]

variable {q : Polygon n} [NeZero n]

lemma cyc_mem_range (k : ℕ) : q.cyc k ∈ Set.range q := ⟨⟨k % n, Nat.mod_lt _ (NeZero.pos n)⟩, rfl⟩

lemma left_range_subset (b : ℕ) : Set.range (q.left b) ⊆ Set.range q := by
  rintro _ ⟨i, rfl⟩; exact cyc_mem_range _

lemma right_range_subset (b : ℕ) : Set.range (q.right b) ⊆ Set.range q := by
  rintro _ ⟨i, rfl⟩; exact cyc_mem_range _

lemma fin_eq_cyc (i : Fin n) : q i = q.cyc i := (q.cyc_of_lt i.2).symm

lemma finRotate_eq_cyc (hn : 2 ≤ n) (i : Fin n) : q (finRotate n i) = q.cyc (i + 1) := by
  simp only [cyc]; congr 1; ext; exact finRotate_val hn i

/-- **Two triangulated parts of a split polygon give a triangulation of the polygon.** -/
theorem isTriangulation_union (hs : q.IsSimple) {b : ℕ} (hb : 2 ≤ b) (hbn : b + 2 ≤ n)
    (hdis : Disjoint (q.left b).inside (q.right b).inside)
    (hspl : q.inside = (q.left b).inside ∪ (q.right b).inside ∪
      openSegment ℝ (q.cyc 0) (q.cyc b))
    {T₁ T₂ : Finset (Finset (ℝ × ℝ))} (h₁ : IsTriangulation (q.left b) T₁)
    (h₂ : IsTriangulation (q.right b) T₂) : IsTriangulation q (T₁ ∪ T₂) := by
  have hn : 2 ≤ n := by omega
  have hopen : ∀ x ∈ openSegment ℝ (q.cyc 0) (q.cyc b), x ∉ q.carrier := fun x hx hxc =>
    (show x ∈ q.inside by rw [hspl]; exact Or.inr hx).1 hxc
  have hsL := isSimple_left hs hb hbn hopen
  have hsR := isSimple_right hs hb hbn hopen
  obtain ⟨hA₁, hG₁, hS₁, hE₁⟩ := h₁
  obtain ⟨hA₂, hG₂, hS₂, hE₂⟩ := h₂
  -- the closed diagonal
  set F : Finset (ℝ × ℝ) := {q.cyc 0, q.cyc b} with hF
  have hFseg : convexHull ℝ (F : Set (ℝ × ℝ)) = segment ℝ (q.cyc 0) (q.cyc b) := by
    rw [hF]; simp [convexHull_pair]
  have hF₁ : F ∈ SComplex.closure T₁ := by
    have := hE₁ ⟨b, by omega⟩
    have e1 : (q.left b) ⟨b, by omega⟩ = q.cyc b := rfl
    have e2 : (q.left b) (finRotate (b + 1) ⟨b, by omega⟩) = q.cyc 0 := by
      show q.cyc ((finRotate (b + 1) ⟨b, by omega⟩ : Fin (b + 1)) : ℕ) = _
      rw [finRotate_val (by omega)]
      simp
    rw [e1, e2] at this
    rwa [Finset.pair_comm] at this
  have hF₂ : F ∈ SComplex.closure T₂ := by
    have := hE₂ ⟨n - b, by omega⟩
    have e1 : (q.right b) ⟨n - b, by omega⟩ = q.cyc 0 := by
      show q.cyc (b + (n - b)) = _
      have : b + (n - b) = n + 0 := by omega
      rw [this, q.cyc_self_add 0]
    have e2 : (q.right b) (finRotate (n - b + 1) ⟨n - b, by omega⟩) = q.cyc b := by
      show q.cyc (b + ((finRotate (n - b + 1) ⟨n - b, by omega⟩ : Fin (n - b + 1)) : ℕ)) = _
      rw [finRotate_val (by omega)]
      simp
    rw [e1, e2] at this
    exact this
  -- the underlying sets meet only along the diagonal
  have hsp : (SComplex.closure T₁).space ∩ (SComplex.closure T₂).space ⊆
      convexHull ℝ (F : Set (ℝ × ℝ)) := by
    rintro x ⟨hx1, hx2⟩
    rw [hS₁] at hx1
    rw [hS₂] at hx2
    rw [hFseg]
    rcases hx1 with h1 | h1 <;> rcases hx2 with h2 | h2
    · exact absurd h2 (Set.disjoint_left.1 hdis h1 |> fun h => h)
    · exact absurd h2 (not_mem_carrier_of_disjoint_inside hsR hdis h1)
    · exact absurd h1 (not_mem_carrier_of_disjoint_inside hsL hdis.symm h2)
    · exact carrier_left_inter_right hs hb hbn h1 h2
  have hcarLR : ∀ x, x ∈ (q.left b).carrier ∨ x ∈ (q.right b).carrier ↔
      x ∈ q.carrier ∨ x ∈ segment ℝ (q.cyc 0) (q.cyc b) := fun x =>
    mem_carrier_left_or_right (p := q) hn (b := b) (by omega) (by omega)
  have hseg_L : ∀ x ∈ segment ℝ (q.cyc 0) (q.cyc b), x ∈ (q.left b).carrier := fun x hx =>
    (mem_carrier_left_iff (p := q) (by omega)).2 (Or.inr (by rwa [segment_symm]))
  have hspace : (SComplex.closure (T₁ ∪ T₂)).space = q.inside ∪ q.carrier := by
    have hu : (SComplex.closure (T₁ ∪ T₂)).space =
        (SComplex.closure T₁).space ∪ (SComplex.closure T₂).space := by
      simp only [SComplex.space_closure]
      ext x
      simp only [Finset.mem_union, Set.mem_iUnion, Set.mem_union, exists_prop]
      constructor
      · rintro ⟨t, ht | ht, hx⟩
        · exact Or.inl ⟨t, ht, hx⟩
        · exact Or.inr ⟨t, ht, hx⟩
      · rintro (⟨t, ht, hx⟩ | ⟨t, ht, hx⟩)
        · exact ⟨t, Or.inl ht, hx⟩
        · exact ⟨t, Or.inr ht, hx⟩
    rw [hu, hS₁, hS₂]
    ext x
    constructor
    · rintro ((h | h) | (h | h))
      · exact Or.inl (by rw [hspl]; exact Or.inl (Or.inl h))
      · rcases (hcarLR x).1 (Or.inl h) with h' | h'
        · exact Or.inr h'
        · rw [← insert_endpoints_openSegment] at h'
          rcases h' with rfl | rfl | h'
          · exact Or.inr (cyc_mem_carrier hn (by omega))
          · exact Or.inr (cyc_mem_carrier hn (by omega))
          · exact Or.inl (by rw [hspl]; exact Or.inr h')
      · exact Or.inl (by rw [hspl]; exact Or.inl (Or.inr h))
      · rcases (hcarLR x).1 (Or.inr h) with h' | h'
        · exact Or.inr h'
        · rw [← insert_endpoints_openSegment] at h'
          rcases h' with rfl | rfl | h'
          · exact Or.inr (cyc_mem_carrier hn (by omega))
          · exact Or.inr (cyc_mem_carrier hn (by omega))
          · exact Or.inl (by rw [hspl]; exact Or.inr h')
    · rintro (h | h)
      · rw [hspl] at h
        rcases h with (h | h) | h
        · exact Or.inl (Or.inl h)
        · exact Or.inr (Or.inl h)
        · exact Or.inl (Or.inr (hseg_L x (openSegment_subset_segment ℝ _ _ h)))
      · rcases (hcarLR x).2 (Or.inl h) with h' | h'
        · exact Or.inl (Or.inr h')
        · exact Or.inr (Or.inr h')
  refine ⟨fun t ht => ?_, ?_, hspace, fun i => ?_⟩
  · rcases Finset.mem_union.1 ht with ht | ht
    · exact ⟨(hA₁ t ht).1, (hA₁ t ht).2.trans (left_range_subset b)⟩
    · exact ⟨(hA₂ t ht).1, (hA₂ t ht).2.trans (right_range_subset b)⟩
  · exact SComplex.isGeom_closure_union hG₁ hG₂ hF₁ hF₂ hsp
  · rw [fin_eq_cyc (q := q) i, finRotate_eq_cyc (q := q) hn i, SComplex.mem_closure]
    rcases Nat.lt_or_ge (i : ℕ) b with hib | hib
    · have h := hE₁ ⟨i, by omega⟩
      have e1 : (q.left b) ⟨i, by omega⟩ = q.cyc i := rfl
      have e2 : (q.left b) (finRotate (b + 1) ⟨i, by omega⟩) = q.cyc (i + 1) := by
        show q.cyc ((finRotate (b + 1) ⟨i, by omega⟩ : Fin (b + 1)) : ℕ) = _
        rw [finRotate_val (by omega)]
        simp only
        rw [Nat.mod_eq_of_lt (by omega : (i : ℕ) + 1 < b + 1)]
      rw [e1, e2, SComplex.mem_closure] at h
      obtain ⟨t, ht, hst⟩ := h
      exact ⟨t, Finset.mem_union_left _ ht, hst⟩
    · have h := hE₂ ⟨i - b, by omega⟩
      have e1 : (q.right b) ⟨i - b, by omega⟩ = q.cyc i := by
        show q.cyc (b + (i - b)) = _
        rw [Nat.add_sub_cancel' hib]
      have e2 : (q.right b) (finRotate (n - b + 1) ⟨i - b, by omega⟩) = q.cyc (i + 1) := by
        show q.cyc (b + ((finRotate (n - b + 1) ⟨i - b, by omega⟩ : Fin (n - b + 1)) : ℕ)) = _
        rw [finRotate_val (by omega)]
        simp only
        rw [Nat.mod_eq_of_lt (by omega : (i : ℕ) - b + 1 < n - b + 1)]
        congr 1; omega
      rw [e1, e2, SComplex.mem_closure] at h
      obtain ⟨t, ht, hst⟩ := h
      exact ⟨t, Finset.mem_union_right _ ht, hst⟩

lemma range_rot (β : Fin n) : Set.range (q.rot β) = Set.range q := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩; exact ⟨i + β, rfl⟩
  · rintro ⟨j, rfl⟩; exact ⟨j - β, by simp [rot]⟩

/-- A triangulation of a cyclic shift of a polygon is a triangulation of the polygon. -/
lemma isTriangulation_of_rot (a : Fin n) {T : Finset (Finset (ℝ × ℝ))}
    (h : IsTriangulation (q.rot a) T) : IsTriangulation q T := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  refine ⟨fun t ht => ⟨(h1 t ht).1, by rw [← range_rot a]; exact (h1 t ht).2⟩, h2, ?_, fun i => ?_⟩
  · rw [h3, inside_rot, carrier_rot]
  · have := h4 (i - a)
    have e1 : (q.rot a) (i - a) = q i := by simp [rot]
    have e2 : (q.rot a) (finRotate n (i - a)) = q (finRotate n i) := by
      simp only [rot]
      congr 1
      rw [← finRotate_add]; simp
    rwa [e1, e2] at this

/-- **Every simple polygon has a triangulation.** -/
theorem exists_triangulation : ∀ (n : ℕ) (p : Polygon n), 3 ≤ n → p.IsSimple →
    ∃ T, IsTriangulation p T := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro p hn hs
    have : NeZero n := ⟨by omega⟩
    rcases (by omega : n = 3 ∨ 4 ≤ n) with rfl | h4
    · exact isTriangulation_triangle hs
    · obtain ⟨a, b, hb2, hb3, hL, hR, hdis, hspl⟩ := exists_split hs h4
      obtain ⟨T₁, h₁⟩ := ih (b + 1) (by omega) ((p.rot a).left b) (by omega) hL
      obtain ⟨T₂, h₂⟩ := ih (n - b + 1) (by omega) ((p.rot a).right b) (by omega) hR
      exact ⟨T₁ ∪ T₂, isTriangulation_of_rot a
        (isTriangulation_union (isSimple_rot hs a) hb2 hb3 hdis hspl h₁ h₂)⟩

end Polygon

end Lightlike.PL
