import Lightlike.PL.Stellar

/-!
# Stellar subdivision of a complex given by generators

The stellar subdivision of the complex generated by a family `T` is generated by a family computed
from `T`: the members that do not contain the subdivided face, and, for each member `t` containing
it, the sets obtained by replacing one vertex of the face by the apex. Comparing generators needs
no quantification over all sets of vertices, which is what makes it cheap in the kernel.

## Main results

* `starAt_closure`: the generators of `(closure T).starAt A a`.
* `boundary_eq_closure`: the boundary of a simplex is generated by its facets.
-/

open Finset

namespace Lightlike.PL
namespace SComplex

variable {V : Type*} [DecidableEq V]

/-- **The stellar subdivision of a complex given by generators, in terms of generators.** -/
theorem starAt_closure (T : Finset (Finset V)) (A : Finset V) (a : V) :
    (closure T).starAt A a = closure (T.filter (fun t => ¬ A ⊆ t) ∪
      (T.filter (fun t => A ⊆ t)).biUnion (fun t => A.image (fun y => insert a (t.erase y)))) := by
  refine ext_mem fun s => ?_
  rw [mem_starAt, mem_closure]
  simp only [mem_closure, mem_union, mem_filter, mem_biUnion, mem_image]
  constructor
  · rintro (⟨⟨t, ht, hst⟩, hA⟩ | ⟨u, ⟨t, ht, hut⟩, hAu, ⟨t', ht', hAut'⟩, rfl⟩)
    · by_cases hAt : A ⊆ t
      · obtain ⟨y, hyA, hys⟩ := not_subset.1 hA
        exact ⟨insert a (t.erase y), Or.inr ⟨t, ⟨ht, hAt⟩, y, hyA, rfl⟩,
          fun x hx => mem_insert_of_mem (mem_erase.2 ⟨fun e => hys (e ▸ hx), hst hx⟩)⟩
      · exact ⟨t, Or.inl ⟨ht, hAt⟩, hst⟩
    · obtain ⟨y, hyA, hyu⟩ := not_subset.1 hAu
      have hAt' : A ⊆ t' := fun x hx => hAut' (mem_union_left _ hx)
      exact ⟨insert a (t'.erase y), Or.inr ⟨t', ⟨ht', hAt'⟩, y, hyA, rfl⟩,
        insert_subset_insert a fun x hx =>
          mem_erase.2 ⟨fun e => hyu (e ▸ hx), hAut' (mem_union_right _ hx)⟩⟩
  · rintro ⟨g, hg, hsg⟩
    rcases hg with ⟨hgT, hAg⟩ | ⟨t, ⟨ht, hAt⟩, y, hyA, rfl⟩
    · exact Or.inl ⟨⟨g, hgT, hsg⟩, fun h => hAg (h.trans hsg)⟩
    · by_cases has : a ∈ s
      · refine Or.inr ⟨s.erase a, ⟨t, ht, fun x hx => ?_⟩, fun h => ?_, ⟨t, ht, ?_⟩, insert_erase has⟩
        · have := hsg (mem_of_mem_erase hx)
          rcases mem_insert.1 this with h | h
          · exact absurd h (ne_of_mem_erase hx)
          · exact mem_of_mem_erase h
        · have := h hyA
          have h2 := hsg (mem_of_mem_erase this)
          rcases mem_insert.1 h2 with h' | h'
          · exact ne_of_mem_erase this h'
          · exact notMem_erase y t h'
        · refine union_subset hAt fun x hx => ?_
          have := hsg (mem_of_mem_erase hx)
          rcases mem_insert.1 this with h | h
          · exact absurd h (ne_of_mem_erase hx)
          · exact mem_of_mem_erase h
      · refine Or.inl ⟨⟨t, ht, fun x hx => ?_⟩, fun h => ?_⟩
        · have := hsg hx
          rcases mem_insert.1 this with h | h
          · exact absurd (h ▸ hx) has
          · exact mem_of_mem_erase h
        · have := hsg (h hyA)
          rcases mem_insert.1 this with h' | h'
          · exact has (h' ▸ h hyA)
          · exact notMem_erase y t h'

/-- The boundary of a simplex is generated by its facets. -/
theorem boundary_eq_closure (A : Finset V) :
    boundary A = closure (A.image (A.erase ·)) := by
  refine ext_mem fun s => ?_
  rw [mem_boundary, mem_closure]
  simp only [mem_image]
  constructor
  · intro hs
    obtain ⟨y, hyA, hys⟩ := not_subset.1 hs.not_subset
    exact ⟨A.erase y, ⟨y, hyA, rfl⟩, fun x hx => mem_erase.2 ⟨fun e => hys (e ▸ hx), hs.subset hx⟩⟩
  · rintro ⟨_, ⟨y, hyA, rfl⟩, hsub⟩
    exact hsub.trans_ssubset (erase_ssubset hyA)

end SComplex
end Lightlike.PL
