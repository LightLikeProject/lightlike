import Lightlike.PL.Manifold
import Lightlike.PonzanoRegge.SphereConverse

/-!
# The 3-dimensional moves of `PonzanoRegge/` as bistellar moves

The Ponzano–Regge and Turaev–Viro state sums are defined on `Lightlike.PR.Complex3`, pure
3-dimensional complexes given by their tetrahedra, and their invariance is proven under the moves
`Lightlike.PR.move23`, `move14`, `move32`, `move41`. Here we check these against the general definitions.

* `ofComplex3 K`: the simplicial complex generated by the tetrahedra of `K`.
* `ofComplex3_move23`, `ofComplex3_move14`, `ofComplex3_move32`, `ofComplex3_move41`: each move
  is the bistellar move `κ(A, B)` with `(#A, #B) = (3, 2), (4, 1), (2, 3), (1, 4)`.
* `isPLSphere_closure_of_isSphere2`: a combinatorial 2-sphere in the sense of
  `Lightlike/PonzanoRegge/Manifold.lean` (reached from the boundary of a tetrahedron by
  2-dimensional bistellar moves) is a PL 2-sphere.
* `isClosedCombManifold_ofComplex3`: a closed combinatorial 3-manifold in the sense of
  `Lightlike/PonzanoRegge/Manifold.lean` is a closed combinatorial 3-manifold in the general sense.
-/

open Finset Lightlike.PR

namespace Lightlike.PL

open SComplex

variable {V : Type*} [DecidableEq V]

/-- Equality of small explicit vertex sets, given the distinctness hypotheses in context. -/
macro "vset_eq" : tactic =>
  `(tactic| (ext x; simp only [mem_insert, mem_singleton, mem_erase, mem_union, ne_eq]; aesop))

/-- Disjointness of small explicit vertex sets, given the distinctness hypotheses in context. -/
macro "vdisj" : tactic => `(tactic| (
  rw [Finset.disjoint_left]
  intro x hx hx'
  simp only [mem_insert, mem_singleton] at hx hx'
  aesop))

/-- The simplicial complex generated by the tetrahedra of a `Complex3`. -/
def ofComplex3 (K : Complex3 V) : SComplex V := closure K.tets

lemma verts_ofComplex3 (K : Complex3 V) : (ofComplex3 K).verts = K.verts := by
  ext v
  rw [mem_verts, ofComplex3, mem_closure, Complex3.verts, mem_biUnion]
  simp

/-- The link of a vertex in `ofComplex3 K` is generated by the link of `K` at that vertex. -/
lemma link_ofComplex3 (K : Complex3 V) (v : V) :
    (ofComplex3 K).link {v} = closure (K.link v) := by
  rw [ofComplex3, link_closure]; rfl

/-! ## The 2-3 and 3-2 moves -/

/-- The 2-3 move is a bistellar move `κ(ABC, DE)`. -/
theorem isBistellar_move23 {K : Complex3 V} {A B C D E : V} (h : IsMove23 K A B C D E) :
    (ofComplex3 K).IsBistellar {A, B, C} {D, E} := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have eD : ({A, B, C} : Finset V) ∪ ({D, E} : Finset V).erase D = {A, B, C, E} := by vset_eq
  have eE : ({A, B, C} : Finset V) ∪ ({D, E} : Finset V).erase E = {A, B, C, D} := by vset_eq
  refine isBistellar_closure (by simp) (by simp) (by vdisj) ?_ ?_ h.fresh
  · intro x hx
    rcases mem_insert.1 hx with rfl | hx
    · rw [eD]; exact h.mem₂
    · rw [mem_singleton.1 hx, eE]; exact h.mem₁
  · intro t ht hsub
    rcases h.face t ht hsub with rfl | rfl
    · exact ⟨E, by simp, eE.ge⟩
    · exact ⟨D, by simp, eD.ge⟩

/-- **The 2-3 move of `PonzanoRegge/` is the bistellar move `κ(ABC, DE)`**: it replaces the
triangle `ABC` (with link `{D, E}`) by the edge `DE`. -/
theorem ofComplex3_move23 {K : Complex3 V} {A B C D E : V} (h : IsMove23 K A B C D E) :
    ofComplex3 (move23 K h) = (ofComplex3 K).bistellar {A, B, C} {D, E} (isBistellar_move23 h) := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have eD : ({A, B, C} : Finset V) ∪ ({D, E} : Finset V).erase D = {A, B, C, E} := by vset_eq
  have eE : ({A, B, C} : Finset V) ∪ ({D, E} : Finset V).erase E = {A, B, C, D} := by vset_eq
  have hmem : ∀ x ∈ ({D, E} : Finset V), {A, B, C} ∪ ({D, E} : Finset V).erase x ∈ K.tets := by
    intro x hx
    rcases mem_insert.1 hx with rfl | hx
    · rw [eD]; exact h.mem₂
    · rw [mem_singleton.1 hx, eE]; exact h.mem₁
  have hstar : ∀ t ∈ K.tets, {A, B, C} ⊆ t →
      ∃ x ∈ ({D, E} : Finset V), t ⊆ {A, B, C} ∪ ({D, E} : Finset V).erase x := by
    intro t ht hsub
    rcases h.face t ht hsub with rfl | rfl
    · exact ⟨E, by simp, eE.ge⟩
    · exact ⟨D, by simp, eD.ge⟩
  have key := bistellar_closure (T := K.tets) (A := {A, B, C}) (B := {D, E}) (by simp) (by simp)
    (by vdisj) hmem hstar h.fresh
  change SComplex.closure _ = (SComplex.closure K.tets).bistellar _ _ _
  rw [key]
  congr 1
  have hf : K.tets.filter (fun t => ¬ ({A, B, C} : Finset V) ⊆ t) =
      (K.tets.erase {A, B, C, D}).erase {A, B, C, E} := by
    ext t
    simp only [mem_filter, mem_erase]
    constructor
    · rintro ⟨ht, hn⟩
      refine ⟨?_, ?_, ht⟩ <;> rintro rfl <;> exact hn (by intro z; simp only [mem_insert, mem_singleton]; tauto)
    · rintro ⟨h₁, h₂, ht⟩
      exact ⟨ht, fun hs => (h.face t ht hs).elim h₂ h₁⟩
  have e₁ : ({A, B, C} : Finset V).erase A ∪ {D, E} = {B, C, D, E} := by vset_eq
  have e₂ : ({A, B, C} : Finset V).erase B ∪ {D, E} = {C, A, D, E} := by vset_eq
  have e₃ : ({A, B, C} : Finset V).erase C ∪ {D, E} = {A, B, D, E} := by vset_eq
  rw [hf, image_insert, image_insert, image_singleton, e₁, e₂, e₃]
  ext t
  simp only [move23, mem_union, mem_insert, mem_singleton]
  tauto

/-- The 3-2 move is a bistellar move `κ(DE, ABC)`. -/
theorem isBistellar_move32 {K : Complex3 V} {A B C D E : V} (h : IsMove32 K A B C D E) :
    (ofComplex3 K).IsBistellar {D, E} {A, B, C} := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have eA : ({D, E} : Finset V) ∪ ({A, B, C} : Finset V).erase A = {B, C, D, E} := by vset_eq
  have eB : ({D, E} : Finset V) ∪ ({A, B, C} : Finset V).erase B = {C, A, D, E} := by vset_eq
  have eC : ({D, E} : Finset V) ∪ ({A, B, C} : Finset V).erase C = {A, B, D, E} := by vset_eq
  refine isBistellar_closure (by simp) (by simp) (by vdisj) ?_ ?_ h.fresh
  · intro x hx
    simp only [mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl | rfl
    · rw [eA]; exact h.mem₂
    · rw [eB]; exact h.mem₃
    · rw [eC]; exact h.mem₁
  · intro t ht hsub
    rcases h.star t ht hsub with rfl | rfl | rfl
    · exact ⟨C, by simp, eC.ge⟩
    · exact ⟨A, by simp, eA.ge⟩
    · exact ⟨B, by simp, eB.ge⟩

/-- **The 3-2 move of `PonzanoRegge/` is the bistellar move `κ(DE, ABC)`.** -/
theorem ofComplex3_move32 {K : Complex3 V} {A B C D E : V} (h : IsMove32 K A B C D E) :
    ofComplex3 (move32 K h) = (ofComplex3 K).bistellar {D, E} {A, B, C} (isBistellar_move32 h) := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have eA : ({D, E} : Finset V) ∪ ({A, B, C} : Finset V).erase A = {B, C, D, E} := by vset_eq
  have eB : ({D, E} : Finset V) ∪ ({A, B, C} : Finset V).erase B = {C, A, D, E} := by vset_eq
  have eC : ({D, E} : Finset V) ∪ ({A, B, C} : Finset V).erase C = {A, B, D, E} := by vset_eq
  have hmem : ∀ x ∈ ({A, B, C} : Finset V), {D, E} ∪ ({A, B, C} : Finset V).erase x ∈ K.tets := by
    intro x hx
    simp only [mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl | rfl
    · rw [eA]; exact h.mem₂
    · rw [eB]; exact h.mem₃
    · rw [eC]; exact h.mem₁
  have hstar : ∀ t ∈ K.tets, {D, E} ⊆ t →
      ∃ x ∈ ({A, B, C} : Finset V), t ⊆ {D, E} ∪ ({A, B, C} : Finset V).erase x := by
    intro t ht hsub
    rcases h.star t ht hsub with rfl | rfl | rfl
    · exact ⟨C, by simp, eC.ge⟩
    · exact ⟨A, by simp, eA.ge⟩
    · exact ⟨B, by simp, eB.ge⟩
  have key := bistellar_closure (T := K.tets) (A := {D, E}) (B := {A, B, C}) (by simp) (by simp)
    (by vdisj) hmem hstar h.fresh
  change SComplex.closure _ = (SComplex.closure K.tets).bistellar _ _ _
  rw [key]
  congr 1
  have hf : K.tets.filter (fun t => ¬ ({D, E} : Finset V) ⊆ t) =
      ((K.tets.erase {A, B, D, E}).erase {B, C, D, E}).erase {C, A, D, E} := by
    ext t
    simp only [mem_filter, mem_erase]
    constructor
    · rintro ⟨ht, hn⟩
      refine ⟨?_, ?_, ?_, ht⟩ <;> rintro rfl <;> exact hn (by intro z; simp only [mem_insert, mem_singleton]; tauto)
    · rintro ⟨h₁, h₂, h₃, ht⟩
      exact ⟨ht, fun hs => (h.star t ht hs).elim h₃ (fun h' => h'.elim h₂ h₁)⟩
  have e₁ : ({D, E} : Finset V).erase D ∪ {A, B, C} = {A, B, C, E} := by vset_eq
  have e₂ : ({D, E} : Finset V).erase E ∪ {A, B, C} = {A, B, C, D} := by vset_eq
  rw [hf, image_insert, image_singleton, e₁, e₂]
  ext t
  simp only [move32, mem_union, mem_insert, mem_singleton]
  tauto

/-! ## The 1-4 and 4-1 moves -/

/-- A tetrahedron of `K` containing the four vertices of a tetrahedron is that tetrahedron. -/
lemma eq_of_four_subset {K : Complex3 V} {s t : Finset V} (ht : t ∈ K.tets) (hs : #s = 4)
    (hst : s ⊆ t) : t = s :=
  (eq_of_subset_of_card_le hst (by rw [K.card_eq t ht, hs])).symm

/-- The 1-4 move is a bistellar move `κ(ABCD, E)`. -/
theorem isBistellar_move14 {K : Complex3 V} {A B C D E : V} (h : IsMove14 K A B C D E) :
    (ofComplex3 K).IsBistellar {A, B, C, D} {E} := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  refine isBistellar_closure (by simp) (by simp) (by vdisj) ?_ ?_ ?_
  · intro x hx
    rw [mem_singleton.1 hx, erase_singleton, union_empty]; exact h.mem
  · intro t ht hsub
    refine ⟨E, mem_singleton_self E, ?_⟩
    rw [erase_singleton, union_empty, eq_of_four_subset ht (card_four h.hAB h.hAC h.hAD h.hBC
      h.hBD h.hCD) hsub]
  · intro t ht hE
    exact h.fresh t ht (singleton_subset_iff.1 hE)

/-- **The 1-4 move of `PonzanoRegge/` is the bistellar move `κ(ABCD, E)`**: it replaces the
tetrahedron `ABCD` (with link `{∅} = ∂E`) by the cone from the new vertex `E` on its boundary. -/
theorem ofComplex3_move14 {K : Complex3 V} {A B C D E : V} (h : IsMove14 K A B C D E) :
    ofComplex3 (move14 K h) = (ofComplex3 K).bistellar {A, B, C, D} {E} (isBistellar_move14 h) := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have e₁ : ({A, B, C, D} : Finset V).erase A ∪ {E} = {B, C, D, E} := by vset_eq
  have e₂ : ({A, B, C, D} : Finset V).erase B ∪ {E} = {A, C, D, E} := by vset_eq
  have e₃ : ({A, B, C, D} : Finset V).erase C ∪ {E} = {A, B, D, E} := by vset_eq
  have e₄ : ({A, B, C, D} : Finset V).erase D ∪ {E} = {A, B, C, E} := by vset_eq
  have h4 := card_four h.hAB h.hAC h.hAD h.hBC h.hBD h.hCD
  have hmem : ∀ x ∈ ({E} : Finset V), {A, B, C, D} ∪ ({E} : Finset V).erase x ∈ K.tets := by
    intro x hx
    rw [mem_singleton.1 hx, erase_singleton, union_empty]; exact h.mem
  have hstar : ∀ t ∈ K.tets, {A, B, C, D} ⊆ t →
      ∃ x ∈ ({E} : Finset V), t ⊆ {A, B, C, D} ∪ ({E} : Finset V).erase x := by
    intro t ht hsub
    refine ⟨E, mem_singleton_self E, ?_⟩
    rw [erase_singleton, union_empty, eq_of_four_subset ht h4 hsub]
  have hnew : ∀ t ∈ K.tets, ¬ ({E} : Finset V) ⊆ t := fun t ht hE =>
    h.fresh t ht (singleton_subset_iff.1 hE)
  have key := bistellar_closure (T := K.tets) (A := {A, B, C, D}) (B := {E}) (by simp) (by simp)
    (by vdisj) hmem hstar hnew
  change SComplex.closure _ = (SComplex.closure K.tets).bistellar _ _ _
  rw [key]
  congr 1
  have hf : K.tets.filter (fun t => ¬ ({A, B, C, D} : Finset V) ⊆ t) = K.tets.erase {A, B, C, D} := by
    ext t
    simp only [mem_filter, mem_erase]
    constructor
    · rintro ⟨ht, hn⟩
      exact ⟨by rintro rfl; exact hn subset_rfl, ht⟩
    · rintro ⟨h₁, ht⟩
      exact ⟨ht, fun hs => h₁ (eq_of_four_subset ht h4 hs)⟩
  rw [hf, image_insert, image_insert, image_insert, image_singleton, e₁, e₂, e₃, e₄]
  ext t
  simp only [move14, mem_union, mem_insert, mem_singleton]
  tauto

/-- The 4-1 move is a bistellar move `κ(E, ABCD)`. -/
theorem isBistellar_move41 {K : Complex3 V} {A B C D E : V} (h : IsMove41 K A B C D E) :
    (ofComplex3 K).IsBistellar {E} {A, B, C, D} := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have h4 := card_four h.hAB h.hAC h.hAD h.hBC h.hBD h.hCD
  have eA : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase A = {B, C, D, E} := by vset_eq
  have eB : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase B = {A, C, D, E} := by vset_eq
  have eC : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase C = {A, B, D, E} := by vset_eq
  have eD : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase D = {A, B, C, E} := by vset_eq
  refine isBistellar_closure (by simp) (by simp) (by vdisj) ?_ ?_ ?_
  · intro x hx
    simp only [mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · rw [eA]; exact h.mem₄
    · rw [eB]; exact h.mem₃
    · rw [eC]; exact h.mem₂
    · rw [eD]; exact h.mem₁
  · intro t ht hsub
    rcases h.star t ht (singleton_subset_iff.1 hsub) with rfl | rfl | rfl | rfl
    · exact ⟨D, by simp, eD.ge⟩
    · exact ⟨C, by simp, eC.ge⟩
    · exact ⟨B, by simp, eB.ge⟩
    · exact ⟨A, by simp, eA.ge⟩
  · intro t ht hsub
    exact h.fresh (eq_of_four_subset ht h4 hsub ▸ ht)

/-- **The 4-1 move of `PonzanoRegge/` is the bistellar move `κ(E, ABCD)`.** -/
theorem ofComplex3_move41 {K : Complex3 V} {A B C D E : V} (h : IsMove41 K A B C D E) :
    ofComplex3 (move41 K h) = (ofComplex3 K).bistellar {E} {A, B, C, D} (isBistellar_move41 h) := by
  have := h.hAB; have := h.hAC; have := h.hAD; have := h.hAE; have := h.hBC
  have := h.hBD; have := h.hBE; have := h.hCD; have := h.hCE; have := h.hDE
  have h4 := card_four h.hAB h.hAC h.hAD h.hBC h.hBD h.hCD
  have eA : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase A = {B, C, D, E} := by vset_eq
  have eB : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase B = {A, C, D, E} := by vset_eq
  have eC : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase C = {A, B, D, E} := by vset_eq
  have eD : ({E} : Finset V) ∪ ({A, B, C, D} : Finset V).erase D = {A, B, C, E} := by vset_eq
  have hmem : ∀ x ∈ ({A, B, C, D} : Finset V),
      {E} ∪ ({A, B, C, D} : Finset V).erase x ∈ K.tets := by
    intro x hx
    simp only [mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · rw [eA]; exact h.mem₄
    · rw [eB]; exact h.mem₃
    · rw [eC]; exact h.mem₂
    · rw [eD]; exact h.mem₁
  have hstar : ∀ t ∈ K.tets, ({E} : Finset V) ⊆ t →
      ∃ x ∈ ({A, B, C, D} : Finset V), t ⊆ {E} ∪ ({A, B, C, D} : Finset V).erase x := by
    intro t ht hsub
    rcases h.star t ht (singleton_subset_iff.1 hsub) with rfl | rfl | rfl | rfl
    · exact ⟨D, by simp, eD.ge⟩
    · exact ⟨C, by simp, eC.ge⟩
    · exact ⟨B, by simp, eB.ge⟩
    · exact ⟨A, by simp, eA.ge⟩
  have hnew : ∀ t ∈ K.tets, ¬ ({A, B, C, D} : Finset V) ⊆ t := fun t ht hsub =>
    h.fresh (eq_of_four_subset ht h4 hsub ▸ ht)
  have key := bistellar_closure (T := K.tets) (A := {E}) (B := {A, B, C, D}) (by simp) (by simp)
    (by vdisj) hmem hstar hnew
  change SComplex.closure _ = (SComplex.closure K.tets).bistellar _ _ _
  rw [key]
  congr 1
  have hf : K.tets.filter (fun t => ¬ ({E} : Finset V) ⊆ t) =
      (((K.tets.erase {A, B, C, E}).erase {A, B, D, E}).erase {A, C, D, E}).erase {B, C, D, E} := by
    ext t
    simp only [mem_filter, mem_erase, singleton_subset_iff]
    constructor
    · rintro ⟨ht, hn⟩
      refine ⟨?_, ?_, ?_, ?_, ht⟩ <;> rintro rfl <;> exact hn (by simp)
    · rintro ⟨h₁, h₂, h₃, h₄, ht⟩
      exact ⟨ht, fun hs => by rcases h.star t ht hs with h' | h' | h' | h' <;> contradiction⟩
  rw [hf, image_singleton, erase_singleton, empty_union]
  ext t
  simp only [move41, mem_union, mem_insert, mem_singleton]
  tauto

/-! ## Combinatorial 2-spheres and 3-manifolds of `PonzanoRegge/` -/

/-- The boundary of the tetrahedron `abcd` (its four triangles) generates the boundary of the
simplex on `{a, b, c, d}`. -/
lemma closure_bdry {a b c d : V} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c)
    (hbd : b ≠ d) (hcd : c ≠ d) : closure (bdry a b c d) = boundary {a, b, c, d} := by
  refine ext_mem fun s => ?_
  rw [mem_closure, mem_boundary]
  constructor
  · rintro ⟨t, ht, hst⟩
    refine hst.trans_ssubset (Finset.ssubset_iff_subset_ne.2 ⟨?_, ?_⟩)
    · simp only [bdry, mem_insert, mem_singleton] at ht
      rcases ht with rfl | rfl | rfl | rfl <;> intro x <;> simp only [mem_insert, mem_singleton] <;>
        tauto
    · intro he
      have h4 := card_four hab hac had hbc hbd hcd
      simp only [bdry, mem_insert, mem_singleton] at ht
      rcases ht with rfl | rfl | rfl | rfl <;> rw [← he] at h4
      · rw [card_three hab hac hbc] at h4; omega
      · rw [card_three hab had hbd] at h4; omega
      · rw [card_three hac had hcd] at h4; omega
      · rw [card_three hbc hbd hcd] at h4; omega
  · intro hs
    obtain ⟨y, hy, hys⟩ := not_subset.1 hs.not_subset
    simp only [mem_insert, mem_singleton] at hy
    have hsub : ∀ z ∈ s, z ∈ ({a, b, c, d} : Finset V) := fun z hz => hs.subset hz
    simp only [mem_insert, mem_singleton] at hsub
    rcases hy with rfl | rfl | rfl | rfl
    · refine ⟨{b, c, d}, by simp [bdry], fun z hz => ?_⟩
      rcases hsub z hz with rfl | rfl | rfl | rfl <;> simp_all
    · refine ⟨{a, c, d}, by simp [bdry], fun z hz => ?_⟩
      rcases hsub z hz with rfl | rfl | rfl | rfl <;> simp_all
    · refine ⟨{a, b, d}, by simp [bdry], fun z hz => ?_⟩
      rcases hsub z hz with rfl | rfl | rfl | rfl <;> simp_all
    · refine ⟨{a, b, c}, by simp [bdry], fun z hz => ?_⟩
      rcases hsub z hz with rfl | rfl | rfl | rfl <;> simp_all

/-- **A 2-dimensional move of `PonzanoRegge/` is a bistellar move**, so the generated complexes are
stellar equivalent. -/
theorem stellarEquiv_of_move2 {L L' : Finset (Finset V)} (h : Move2 L L')
    (hL : IsTri2 L) : StellarEquiv (closure L) (closure L') := by
  cases h with
  | @sub13 b c d x hbc hbd hcd hτ hx =>
    have hxb : x ≠ b := fun e => hx (mem_verts2.2 ⟨_, hτ, by simp [e]⟩)
    have hxc : x ≠ c := fun e => hx (mem_verts2.2 ⟨_, hτ, by simp [e]⟩)
    have hxd : x ≠ d := fun e => hx (mem_verts2.2 ⟨_, hτ, by simp [e]⟩)
    have h3 := card_three hbc hbd hcd
    have hmem : ∀ y ∈ ({x} : Finset V), {b, c, d} ∪ ({x} : Finset V).erase y ∈ L := by
      intro y hy
      rw [mem_singleton.1 hy, erase_singleton, union_empty]; exact hτ
    have hstar : ∀ t ∈ L, {b, c, d} ⊆ t →
        ∃ y ∈ ({x} : Finset V), t ⊆ {b, c, d} ∪ ({x} : Finset V).erase y := by
      intro t ht hsub
      refine ⟨x, mem_singleton_self x, ?_⟩
      rw [erase_singleton, union_empty]
      exact (eq_of_subset_of_card_le hsub (by rw [hL t ht, h3])).ge
    have hnew : ∀ t ∈ L, ¬ ({x} : Finset V) ⊆ t := fun t ht hsub =>
      hx (mem_verts2.2 ⟨t, ht, singleton_subset_iff.1 hsub⟩)
    have hdis : Disjoint ({b, c, d} : Finset V) {x} := by vdisj
    have hb := isBistellar_closure (by simp) (by simp) hdis hmem hstar hnew
    have key := bistellar_closure (by simp) (by simp) hdis hmem hstar hnew
    have hres : closure (insert {b, c, x} (insert {c, d, x} (insert {b, d, x} (L.erase {b, c, d}))))
        = (closure L).bistellar _ _ hb := by
      rw [key]
      congr 1
      have hf : L.filter (fun t => ¬ ({b, c, d} : Finset V) ⊆ t) = L.erase {b, c, d} := by
        ext t
        simp only [mem_filter, mem_erase]
        constructor
        · rintro ⟨ht, hn⟩
          exact ⟨by rintro rfl; exact hn subset_rfl, ht⟩
        · rintro ⟨h₁, ht⟩
          exact ⟨ht, fun hs => h₁ (eq_of_subset_of_card_le hs (by rw [hL t ht, h3])).symm⟩
      have e₁ : ({b, c, d} : Finset V).erase b ∪ {x} = {c, d, x} := by vset_eq
      have e₂ : ({b, c, d} : Finset V).erase c ∪ {x} = {b, d, x} := by vset_eq
      have e₃ : ({b, c, d} : Finset V).erase d ∪ {x} = {b, c, x} := by vset_eq
      rw [hf, image_insert, image_insert, image_singleton, e₁, e₂, e₃]
      ext t
      simp only [mem_union, mem_insert, mem_singleton]
      tauto
    rw [hres]
    exact StellarEquiv.bistellar hb
  | @flip22 b c d e hbc hbd hbe hcd hce hde h₁ h₂ hstar' hfresh =>
    have hmem : ∀ y ∈ ({d, e} : Finset V), {b, c} ∪ ({d, e} : Finset V).erase y ∈ L := by
      intro y hy
      rcases mem_insert.1 hy with rfl | hy
      · have : ({b, c} : Finset V) ∪ ({y, e} : Finset V).erase y = {b, c, e} := by vset_eq
        rw [this]; exact h₂
      · rw [mem_singleton.1 hy]
        have : ({b, c} : Finset V) ∪ ({d, e} : Finset V).erase e = {b, c, d} := by vset_eq
        rw [this]; exact h₁
    have eD : ({b, c} : Finset V) ∪ ({d, e} : Finset V).erase d = {b, c, e} := by vset_eq
    have eE : ({b, c} : Finset V) ∪ ({d, e} : Finset V).erase e = {b, c, d} := by vset_eq
    have hstar : ∀ t ∈ L, {b, c} ⊆ t →
        ∃ y ∈ ({d, e} : Finset V), t ⊆ {b, c} ∪ ({d, e} : Finset V).erase y := by
      intro t ht hsub
      rcases hstar' t ht hsub with rfl | rfl
      · exact ⟨e, by simp, eE.ge⟩
      · exact ⟨d, by simp, eD.ge⟩
    have hdis : Disjoint ({b, c} : Finset V) {d, e} := by vdisj
    have hb := isBistellar_closure (by simp) (by simp) hdis hmem hstar hfresh
    have key := bistellar_closure (by simp) (by simp) hdis hmem hstar hfresh
    have hres : closure (insert {b, d, e} (insert {c, d, e} ((L.erase {b, c, d}).erase {b, c, e})))
        = (closure L).bistellar _ _ hb := by
      rw [key]
      congr 1
      have hf : L.filter (fun t => ¬ ({b, c} : Finset V) ⊆ t) =
          (L.erase {b, c, d}).erase {b, c, e} := by
        ext t
        simp only [mem_filter, mem_erase]
        constructor
        · rintro ⟨ht, hn⟩
          refine ⟨?_, ?_, ht⟩ <;> rintro rfl <;> exact hn (by intro z; simp only [mem_insert, mem_singleton]; tauto)
        · rintro ⟨h₁', h₂', ht⟩
          exact ⟨ht, fun hs => (hstar' t ht hs).elim h₂' h₁'⟩
      have e₁ : ({b, c} : Finset V).erase b ∪ {d, e} = {c, d, e} := by vset_eq
      have e₂ : ({b, c} : Finset V).erase c ∪ {d, e} = {b, d, e} := by vset_eq
      rw [hf, image_insert, image_singleton, e₁, e₂]
      ext t
      simp only [mem_union, mem_insert, mem_singleton]
      tauto
    rw [hres]
    exact StellarEquiv.bistellar hb

/-- Chains of 2-dimensional moves and their inverses keep families of triangles and give stellar
equivalent complexes. -/
lemma stellarEquiv_of_eqvGen_move2 {L L' : Finset (Finset V)}
    (h : Relation.EqvGen Move2 L L') :
    (IsTri2 L ↔ IsTri2 L') ∧ (IsTri2 L → StellarEquiv (closure L) (closure L')) := by
  induction h with
  | rel L L' h => exact ⟨h.tri_iff, fun hL => stellarEquiv_of_move2 h hL⟩
  | refl L => exact ⟨Iff.rfl, fun _ => .refl _⟩
  | symm L L' _ ih =>
    exact ⟨ih.1.symm, fun hL => (ih.2 (ih.1.2 hL)).symm⟩
  | trans L L' L'' _ _ ih₁ ih₂ =>
    exact ⟨ih₁.1.trans ih₂.1, fun hL => (ih₁.2 hL).trans (ih₂.2 (ih₁.1.1 hL))⟩

/-- **A combinatorial 2-sphere of `PonzanoRegge/` is a PL 2-sphere.** (`IsSphere2` asks for a
chain of 2-dimensional bistellar moves from the boundary of a tetrahedron; these are stellar
equivalences.) -/
theorem isPLSphere_closure_of_isSphere2 {L : Finset (Finset V)} (h : IsSphere2 L) :
    IsPLSphere 2 (closure L) := by
  obtain ⟨a, b, c, d, hab, hac, had, hbc, hbd, hcd, hL⟩ := h
  have hT : IsTri2 (bdry a b c d) := by
    intro τ hτ
    simp only [bdry, mem_insert, mem_singleton] at hτ
    rcases hτ with rfl | rfl | rfl | rfl
    · exact card_three hab hac hbc
    · exact card_three hab had hbd
    · exact card_three hac had hcd
    · exact card_three hbc hbd hcd
  have h₀ := isPLSphere_boundary (n := 2) (card_four hab hac had hbc hbd hcd)
  rw [← closure_bdry hab hac had hbc hbd hcd] at h₀
  exact h₀.of_stellarEquiv ((stellarEquiv_of_eqvGen_move2 hL).2 hT)

/-- **A closed combinatorial 3-manifold of `PonzanoRegge/` is a closed combinatorial 3-manifold**
in the general sense: the link of every vertex of `ofComplex3 K` is a PL 2-sphere. -/
theorem isClosedCombManifold_ofComplex3 {K : Complex3 V} (h : IsCombManifold K) :
    IsClosedCombManifold 3 (ofComplex3 K) := by
  refine isClosedCombManifold_succ_iff.2 fun v hv => ?_
  rw [verts_ofComplex3] at hv
  rw [link_ofComplex3]
  exact isPLSphere_closure_of_isSphere2 (h v hv)

end Lightlike.PL
