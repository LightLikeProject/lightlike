import Lightlike.PL.PolygonBall

/-!
# The boundary of the triangulated region is the polygon

In the triangulation of a simple polygon `q` built by `exists_ball_triangulation`, the boundary of
the complex generated by the triangles, in the sense of `SComplex.bd` (the faces inside a nonempty
face whose link is a PL ball), consists exactly of the faces inside an edge of the polygon.

Besides `EdgeUnique` (every edge of the polygon lies in exactly one triangle), the induction
carries `NonBdry`: every edge of the complex that is not an edge of the polygon lies in two
different triangles.

## Main results

* `Lightlike.PL.Polygon.NonBdry`
* `Lightlike.PL.Polygon.mem_bd_closure_iff`: the boundary faces are the faces inside a polygon edge
-/

open Set Finset

namespace Lightlike.PL
namespace Polygon

variable {n : ℕ}

/-- The link of a face with at least two vertices in the complex generated by triangles: the empty
face and the vertices opposite to it in the triangles that contain it. -/
lemma link_mem_iff {T : Finset (Finset (ℝ × ℝ))} (hT3 : ∀ t ∈ T, t.card = 3)
    {τ : Finset (ℝ × ℝ)} (hτK : τ ∈ SComplex.closure T) (h2 : 2 ≤ τ.card)
    {s : Finset (ℝ × ℝ)} :
    s ∈ (SComplex.closure T).link τ ↔
      s = ∅ ∨ ∃ x, x ∉ τ ∧ s = {x} ∧ ∃ t' ∈ T, insert x τ ⊆ t' := by
  rw [SComplex.mem_link]
  constructor
  · rintro ⟨-, hd, hu⟩
    obtain ⟨t', ht', hst⟩ := SComplex.mem_closure.1 hu
    have hcard : (τ ∪ s).card = τ.card + s.card := Finset.card_union_of_disjoint hd
    have hle : (τ ∪ s).card ≤ 3 := (Finset.card_le_card hst).trans (hT3 t' ht').le
    have hs1 : s.card ≤ 1 := by omega
    rcases Nat.lt_or_ge s.card 1 with h | h
    · left; exact Finset.card_eq_zero.1 (by omega)
    · right
      obtain ⟨x, rfl⟩ := Finset.card_eq_one.1 (by omega : s.card = 1)
      refine ⟨x, ?_, rfl, t', ht', ?_⟩
      · exact fun hx => Finset.disjoint_left.1 hd hx (Finset.mem_singleton_self x)
      · intro y hy
        rcases Finset.mem_insert.1 hy with rfl | hy
        · exact hst (Finset.mem_union_right _ (Finset.mem_singleton_self _))
        · exact hst (Finset.mem_union_left _ hy)
  · rintro (rfl | ⟨x, hx, rfl, t', ht', hxt⟩)
    · refine ⟨?_, Finset.disjoint_empty_right _, by simpa using hτK⟩
      obtain ⟨t', ht', hτt⟩ := SComplex.mem_closure.1 hτK
      exact SComplex.mem_closure.2 ⟨t', ht', Finset.empty_subset _⟩
    · refine ⟨SComplex.mem_closure.2 ⟨t', ht', fun y hy => ?_⟩, ?_, ?_⟩
      · rw [Finset.mem_singleton] at hy
        exact hxt (hy ▸ Finset.mem_insert_self _ _)
      · rw [Finset.disjoint_singleton_right]; exact hx
      · refine SComplex.mem_closure.2 ⟨t', ht', fun y hy => ?_⟩
        rcases Finset.mem_union.1 hy with h | h
        · exact hxt (Finset.mem_insert_of_mem h)
        · rw [Finset.mem_singleton] at h
          exact hxt (h ▸ Finset.mem_insert_self _ _)

/-- The signed count of the link is `1` minus the number of its vertices. -/
lemma signedCount_link {T : Finset (Finset (ℝ × ℝ))} (hT3 : ∀ t ∈ T, t.card = 3)
    {τ : Finset (ℝ × ℝ)} (hτK : τ ∈ SComplex.closure T) (h2 : 2 ≤ τ.card) :
    ((SComplex.closure T).link τ).signedCount = 1 - ((SComplex.closure T).link τ).verts.card := by
  set L := (SComplex.closure T).link τ with hL
  have hfaces : L.faces = insert ∅ (L.verts.image fun x => ({x} : Finset (ℝ × ℝ))) := by
    ext s
    simp only [SComplex.mem_faces, Finset.mem_insert, Finset.mem_image, SComplex.mem_verts]
    constructor
    · intro hs
      rcases (link_mem_iff hT3 hτK h2).1 hs with rfl | ⟨x, -, rfl, -⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨x, hs, rfl⟩
    · rintro (rfl | ⟨x, hx, rfl⟩)
      · exact (link_mem_iff hT3 hτK h2).2 (Or.inl rfl)
      · exact hx
  unfold SComplex.signedCount
  rw [hfaces, Finset.sum_insert (by simp), Finset.sum_image (fun x _ y _ h => Finset.singleton_injective h)]
  simp only [Finset.card_singleton, Finset.sum_const]
  simp
  ring

/-- **A face whose link is a PL ball lies in at most one triangle.** If `τ` has at least two
vertices and its link is a ball, then all triangles containing `τ` are equal, and `τ` has exactly
two vertices. -/
lemma unique_triangle_of_ball {T : Finset (Finset (ℝ × ℝ))} (hT3 : ∀ t ∈ T, t.card = 3)
    {τ : Finset (ℝ × ℝ)} (hτK : τ ∈ SComplex.closure T) (h2 : 2 ≤ τ.card)
    (hb : SComplex.IsBallIn ((SComplex.closure T).link τ)) :
    τ.card = 2 ∧ ∀ t₁ ∈ T, ∀ t₂ ∈ T, τ ⊆ t₁ → τ ⊆ t₂ → t₁ = t₂ := by
  have hsc := hb.signedCount_eq_zero
  rw [signedCount_link hT3 hτK h2] at hsc
  have hv : ((SComplex.closure T).link τ).verts.card = 1 := by omega
  obtain ⟨x, hx⟩ := Finset.card_eq_one.1 hv
  have hxL : ({x} : Finset (ℝ × ℝ)) ∈ (SComplex.closure T).link τ := by
    rw [← SComplex.mem_verts, hx]; exact Finset.mem_singleton_self x
  rcases (link_mem_iff hT3 hτK h2).1 hxL with h | ⟨y, hy, hyx, t', ht', hyt⟩
  · exact absurd h (by simp)
  · have hyx' : y = x := by simpa using hyx.symm
    subst hyx'
    have hc : (insert y τ).card = τ.card + 1 := Finset.card_insert_of_notMem hy
    have hle := Finset.card_le_card hyt
    have := hT3 t' ht'
    have hτ2 : τ.card = 2 := by omega
    refine ⟨hτ2, ?_⟩
    -- every triangle containing τ is τ plus the unique vertex
    have key : ∀ t ∈ T, τ ⊆ t → t = insert y τ := by
      intro t ht hτt
      have hcard : (t \ τ).card = 1 := by
        rw [Finset.card_sdiff_of_subset hτt, hT3 t ht, hτ2]
      obtain ⟨z, hz⟩ := Finset.card_eq_one.1 hcard
      have hzt : z ∈ t \ τ := by rw [hz]; exact Finset.mem_singleton_self z
      have hzL : ({z} : Finset (ℝ × ℝ)) ∈ (SComplex.closure T).link τ := by
        refine (link_mem_iff hT3 hτK h2).2 (Or.inr ⟨z, (Finset.mem_sdiff.1 hzt).2, rfl, t, ht, ?_⟩)
        intro w hw
        rcases Finset.mem_insert.1 hw with rfl | hw
        · exact (Finset.mem_sdiff.1 hzt).1
        · exact hτt hw
      have hzv : z ∈ ((SComplex.closure T).link τ).verts := SComplex.mem_verts.2 hzL
      rw [hx, Finset.mem_singleton] at hzv
      subst hzv
      ext w
      constructor
      · intro hw
        by_cases hwτ : w ∈ τ
        · exact Finset.mem_insert_of_mem hwτ
        · have : w ∈ t \ τ := Finset.mem_sdiff.2 ⟨hw, hwτ⟩
          rw [hz, Finset.mem_singleton] at this
          rw [this]; exact Finset.mem_insert_self _ _
      · intro hw
        rcases Finset.mem_insert.1 hw with rfl | hw
        · exact (Finset.mem_sdiff.1 hzt).1
        · exact hτt hw
    intro t₁ h₁ t₂ h₂ a b
    rw [key t₁ h₁ a, key t₂ h₂ b]

/-- **The boundary of the triangulated region is the polygon.** For a triangulation `T` of a simple
polygon `q` in which every edge of the polygon lies in exactly one triangle, every other edge lies
in two triangles, and the generated complex is a PL ball, a face is in the boundary of the complex
exactly when it lies in an edge of the polygon. -/
theorem mem_bd_closure_iff [NeZero n] {q : Polygon n} {T : Finset (Finset (ℝ × ℝ))}
    (hT : IsTriangulation q T) (hU : EdgeUnique q T) (hN : NonBdry q T) {σ : Finset (ℝ × ℝ)} :
    σ ∈ (SComplex.closure T).bd ↔ ∃ i, σ ⊆ {q i, q (finRotate n i)} := by
  have hT3 : ∀ t ∈ T, t.card = 3 := fun t ht => (hT.1 t ht).1
  constructor
  · intro h
    obtain ⟨hσK, hσ⟩ := SComplex.mem_bd.1 h
    rcases hσ with rfl | ⟨τ, hτK, hστ, hτne, hb⟩
    · exact ⟨⟨0, NeZero.pos n⟩, Finset.empty_subset _⟩
    · obtain ⟨t, ht, hτt⟩ := SComplex.mem_closure.1 hτK
      by_cases h1 : τ.card = 1
      · obtain ⟨a, rfl⟩ := Finset.card_eq_one.1 h1
        obtain ⟨j, hj⟩ := (hT.1 t ht).2 (hτt (Finset.mem_singleton_self a))
        refine ⟨j, hστ.trans ?_⟩
        intro y hy
        rw [Finset.mem_singleton] at hy
        rw [hy, ← hj]; exact Finset.mem_insert_self _ _
      · have h2 : 2 ≤ τ.card := by
          have := hτne.card_pos; omega
        obtain ⟨hc2, huniq⟩ := unique_triangle_of_ball hT3 hτK h2 hb
        rcases hN τ hτK hc2 with ⟨i, hi⟩ | ⟨t₁, h₁, t₂, h₂, hne, e₁, e₂⟩
        · exact ⟨i, hστ.trans (hi ▸ Finset.Subset.refl _)⟩
        · exact absurd (huniq t₁ h₁ t₂ h₂ e₁ e₂) hne
  · rintro ⟨i, hi⟩
    obtain ⟨x, hx, hu⟩ := hU i
    set τ : Finset (ℝ × ℝ) := {q i, q (finRotate n i)} with hτ
    have hτsub : τ ⊆ {q i, q (finRotate n i), x} := by
      intro y hy
      simp only [hτ, Finset.mem_insert, Finset.mem_singleton] at hy ⊢
      tauto
    have hτK : τ ∈ SComplex.closure T := SComplex.mem_closure.2 ⟨_, hx, hτsub⟩
    have hc3 := hT3 _ hx
    have hab : q i ≠ q (finRotate n i) := by
      intro h
      have e : ({q i, q (finRotate n i), x} : Finset (ℝ × ℝ)) = {q i, x} := by
        ext y; simp only [Finset.mem_insert, Finset.mem_singleton]; rw [← h]; tauto
      rw [e] at hc3
      have := Finset.card_le_two (a := q i) (b := x)
      omega
    have hxτ : x ∉ τ := by
      intro h
      have e : ({q i, q (finRotate n i), x} : Finset (ℝ × ℝ)) = {q i, q (finRotate n i)} := by
        ext y
        simp only [hτ, Finset.mem_insert, Finset.mem_singleton] at h ⊢
        rcases h with h | h <;> (rw [h]; tauto)
      rw [e] at hc3
      have := Finset.card_le_two (a := q i) (b := q (finRotate n i))
      omega
    have hτ2 : 2 ≤ τ.card := by rw [hτ, Finset.card_pair hab]
    have hlink : (SComplex.closure T).link τ = SComplex.simplex {x} := by
      refine SComplex.ext_mem fun s => ?_
      rw [link_mem_iff hT3 hτK hτ2, SComplex.mem_simplex]
      constructor
      · rintro (rfl | ⟨y, hy, rfl, t', ht', hyt⟩)
        · exact Finset.empty_subset _
        · have h1 : q i ∈ t' := hyt (Finset.mem_insert_of_mem (by simp [hτ]))
          have h2 : q (finRotate n i) ∈ t' := hyt (Finset.mem_insert_of_mem (by simp [hτ]))
          have := hu t' ht' h1 h2
          have hyt' : y ∈ t' := hyt (Finset.mem_insert_self _ _)
          rw [this] at hyt'
          simp only [Finset.mem_insert, Finset.mem_singleton] at hyt'
          rcases hyt' with rfl | rfl | rfl
          · exact absurd (by simp [hτ]) hy
          · exact absurd (by simp [hτ]) hy
          · exact Finset.Subset.refl _
      · intro hs
        rcases Finset.subset_singleton_iff.1 hs with rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr ⟨x, hxτ, rfl, _, hx, fun y hy => by
            simp only [hτ, Finset.mem_insert, Finset.mem_singleton] at hy ⊢; tauto⟩
    have hball : SComplex.IsBallIn ((SComplex.closure T).link τ) := by
      rw [hlink]; exact SComplex.isBallIn_simplex ⟨x, Finset.mem_singleton_self x⟩
    exact SComplex.mem_bd.2 ⟨SComplex.down_mem hτK hi, Or.inr ⟨τ, hτK, hi, ⟨q i, by simp [hτ]⟩, hball⟩⟩

/-- **The underlying set of the boundary is the polygon.** -/
theorem bd_space_eq_carrier [NeZero n] {q : Polygon n} {T : Finset (Finset (ℝ × ℝ))}
    (hT : IsTriangulation q T) (hU : EdgeUnique q T) (hN : NonBdry q T) :
    (SComplex.closure T).bd.space = q.carrier := by
  ext x
  rw [SComplex.mem_space]
  constructor
  · rintro ⟨σ, hσ, hx⟩
    obtain ⟨i, hi⟩ := (mem_bd_closure_iff hT hU hN).1 hσ
    refine Set.mem_iUnion.2 ⟨i, ?_⟩
    have := convexHull_mono (𝕜 := ℝ) (Finset.coe_subset.2 hi) hx
    rw [Finset.coe_insert, Finset.coe_singleton, convexHull_pair] at this
    exact this
  · intro hx
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hx
    refine ⟨{q i, q (finRotate n i)}, (mem_bd_closure_iff hT hU hN).2 ⟨i, subset_rfl⟩, ?_⟩
    rw [Finset.coe_insert, Finset.coe_singleton, convexHull_pair]
    exact hi

/-- **The polygonal Schoenflies theorem.** The closed region bounded by a simple closed polygon in
the plane is the underlying set of a geometric complex that is a PL ball, whose boundary is
exactly the polygon. -/
theorem polygon_schoenflies (p : Polygon n) (hn : 3 ≤ n) (hs : p.IsSimple) :
    ∃ K : SComplex (ℝ × ℝ), SComplex.IsGeom K ∧ K.space = p.inside ∪ p.carrier ∧
      SComplex.IsBallIn K ∧ K.bd.space = p.carrier := by
  have : NeZero n := ⟨by omega⟩
  obtain ⟨T, hT, hU, hN, hB⟩ := exists_ball_triangulation n p hn hs
  exact ⟨SComplex.closure T, hT.2.1, hT.2.2.1, hB, bd_space_eq_carrier hT hU hN⟩

end Polygon

end Lightlike.PL
