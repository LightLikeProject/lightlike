import Lightlike.PL.PachnerMain
import Lightlike.PL.Complex4
import Lightlike.PL.Surface

/-!
# Pachner's theorem for `Complex4` and `Complex3`

Pachner's theorem (`SComplex.pachner`) is stated for simplicial complexes. Here it is transferred
to the pure complexes given by their top simplices: `Lightlike.FourD.Complex4` with the five 4D moves of
`Lightlike/FourD/Pachner.lean`, and `Lightlike.PR.Complex3` with the 2-3, 3-2, 1-4 and 4-1 moves of
`PonzanoRegge/`. Since stellar moves need new vertices, the chains of moves run on the copies of
the complexes with vertices in `V ⊕ ℕ`.

## Main results

* `IsMfdIn.exists_facet`: in a closed combinatorial `n`-manifold with a face of `n + 1` vertices,
  every face lies in a face of `n + 1` vertices (purity).
* `IsMfdIn.card_add_card_of_isBistellar`: a bistellar move `κ(A, B)` on a closed combinatorial
  `n`-manifold has `#A + #B = n + 2`.
* `pachner4`: two closed combinatorial 4-manifolds `K`, `K'` given by 4-simplices are stellar
  equivalent exactly when (their copies on `V ⊕ ℕ`) are related by 4D moves.
* `exists_move3`: a bistellar move with `#σ + #τ = 5` on the complex generated by a `Complex3` is
  one of its 2-3, 3-2, 1-4 and 4-1 moves.
* `pachner3`: **stellar-equivalent closed combinatorial 3-manifolds are related by chains of 2-3,
  3-2, 1-4 and 4-1 moves on `Complex3`**, and conversely.
-/

open Finset Lightlike.FourD

namespace Lightlike.PL

namespace SComplex

variable {V : Type*} [DecidableEq V]

/-! ## Purity and the sizes of the moves -/

/-- In a closed combinatorial `n`-manifold, a nonempty face with at most `n` vertices lies in a
larger face. -/
lemma IsMfdIn.exists_insert [Infinite V] {n : ℕ} {M : SComplex V} (hM : IsMfdIn false n M)
    {σ : Finset V} (hσ : σ ∈ M) (hne : σ.Nonempty) (hle : #σ ≤ n) :
    ∃ w, w ∉ σ ∧ insert w σ ∈ M := by
  obtain ⟨m, hm, hSB⟩ := (isMfdIn_main false n).1 M hM σ hσ hne
  obtain ⟨D₁, hD₁, hsph⟩ : ∃ D₁ : Finset V, #D₁ = m + 1 ∧ StellarEquivIn (M.link σ) (boundary D₁) := by
    rcases hSB with h' | ⟨hb, -⟩
    · exact h'
    · exact absurd hb (by decide)
  have hmax : (M.link σ).maxCard = m := by
    rw [hsph.maxCard_eq, maxCard_boundary (card_pos.1 (by omega)), hD₁]
    rfl
  have h0 : ∅ ∈ M.link σ := mem_link'.2 ⟨disjoint_empty_right _, by rwa [union_empty]⟩
  obtain ⟨w', hw', hcard⟩ := exists_card_eq_maxCard h0
  obtain ⟨w, hw⟩ : w'.Nonempty := card_pos.1 (by omega)
  have hl := mem_link'.1 (down_mem hw' (singleton_subset_iff.2 hw))
  refine ⟨w, disjoint_singleton_right.1 hl.1, ?_⟩
  rw [insert_eq, union_comm]
  exact hl.2

/-- **Purity**: in a closed combinatorial `n`-manifold with a face of `n + 1` vertices, every face
lies in a face of `n + 1` vertices. -/
theorem IsMfdIn.exists_facet [Infinite V] {n : ℕ} {M : SComplex V} (hM : IsMfdIn false n M)
    (hmax : M.maxCard = n + 1) {σ : Finset V} (hσ : σ ∈ M) :
    ∃ τ ∈ M, σ ⊆ τ ∧ #τ = n + 1 := by
  have hle : ∀ s ∈ M, #s ≤ n + 1 := fun s hs => hmax ▸ card_le_maxCard hs
  -- first get a nonempty face containing `σ`
  have hne : ∃ σ' ∈ M, σ ⊆ σ' ∧ σ'.Nonempty := by
    rcases σ.eq_empty_or_nonempty with rfl | h'
    · obtain ⟨s, hs, hc⟩ := exists_card_eq_maxCard hσ
      exact ⟨s, hs, empty_subset _, card_pos.1 (by omega)⟩
    · exact ⟨σ, hσ, subset_rfl, h'⟩
  obtain ⟨σ', hσ', hσσ', hne'⟩ := hne
  -- then grow it, one vertex at a time
  suffices H : ∀ k, ∀ s ∈ M, σ ⊆ s → s.Nonempty → n + 1 - #s = k → ∃ τ ∈ M, σ ⊆ τ ∧ #τ = n + 1 from
    H _ σ' hσ' hσσ' hne' rfl
  intro k
  induction k with
  | zero =>
    intro s hs hσs _ hk
    exact ⟨s, hs, hσs, by have := hle s hs; omega⟩
  | succ k ih =>
    intro s hs hσs hsne hk
    obtain ⟨w, hws, hw⟩ := hM.exists_insert hs hsne (by omega)
    exact ih _ hw (hσs.trans (subset_insert w s)) (insert_nonempty w s)
      (by rw [card_insert_of_notMem hws]; omega)

/-- **The sizes of a bistellar move**: on a closed combinatorial `n`-manifold, `κ(A, B)` has
`#A + #B = n + 2`. -/
theorem IsMfdIn.card_add_card_of_isBistellar [Infinite V] {n : ℕ} {M : SComplex V}
    (hM : IsMfdIn false n M) {A B : Finset V} (h : IsBistellar M A B) : #A + #B = n + 2 := by
  obtain ⟨m, hm, hSB⟩ := (isMfdIn_main false n).1 M hM A h.mem h.nonempty_left
  obtain ⟨D₁, hD₁, hsph⟩ : ∃ D₁ : Finset V, #D₁ = m + 1 ∧ StellarEquivIn (M.link A) (boundary D₁) := by
    rcases hSB with h' | ⟨hb, -⟩
    · exact h'
    · exact absurd hb (by decide)
  have := hsph.maxCard_eq
  rw [h.link_eq, maxCard_boundary h.nonempty_right, maxCard_boundary (card_pos.1 (by omega)),
    hD₁] at this
  have := card_pos.2 h.nonempty_right
  omega

/-- Bistellar moves with equal data are equal. -/
lemma bistellar_congr {K K' : SComplex V} {A B : Finset V} (hK : K = K')
    (h : IsBistellar K A B) (h' : IsBistellar K' A B) : K.bistellar A B h = K'.bistellar A B h' := by
  subst hK
  rfl

/-- Bistellar equivalence preserves closed combinatorial manifolds (inside an infinite type). -/
lemma BistellarEquivIn.isMfdIn_iff [Infinite V] {n : ℕ} {M N : SComplex V}
    (h : BistellarEquivIn M N) : IsMfdIn false n M ↔ IsMfdIn false n N :=
  isMfdIn_iff_of_stellarEquivIn (isMfdIn_main false n).1 h.stellarEquivIn

end SComplex

open SComplex

variable {V : Type*} [DecidableEq V]

/-! ## Pachner's theorem for `Complex4` -/

/-- The image of a `Complex4` under an injective map of the vertices. -/
def mapComplex4 {W : Type*} [DecidableEq W] (K : Complex4 V) (f : V ↪ W) : Complex4 W where
  simps := K.simps.image (Finset.map f)
  card_eq s hs := by
    obtain ⟨t, ht, rfl⟩ := mem_image.1 hs
    rw [card_map, K.card_eq t ht]

lemma ofComplex4_mapComplex4 {W : Type*} [DecidableEq W] (K : Complex4 V) (f : V ↪ W) :
    ofComplex4 (mapComplex4 K f) = (ofComplex4 K).map f := by
  rw [ofComplex4, ofComplex4, map_closure]
  rfl

/-- The 4-simplices of a complex: its faces with five vertices. -/
def toComplex4 (M : SComplex V) : Complex4 V where
  simps := M.faces.filter (#· = 5)
  card_eq _ hs := (mem_filter.1 hs).2

lemma toComplex4_ofComplex4 (K : Complex4 V) : toComplex4 (ofComplex4 K) = K := by
  apply Complex4.ext
  ext s
  change s ∈ (ofComplex4 K).faces.filter (#· = 5) ↔ _
  rw [mem_filter, mem_faces, ofComplex4, mem_closure]
  constructor
  · rintro ⟨⟨t, ht, hst⟩, hs⟩
    rwa [eq_of_subset_of_card_le hst (by rw [K.card_eq t ht, hs])]
  · intro hs
    exact ⟨⟨s, hs, subset_rfl⟩, K.card_eq s hs⟩

/-- A closed combinatorial 4-manifold with a 4-simplex is generated by its 4-simplices. -/
lemma ofComplex4_toComplex4 [Infinite V] {M : SComplex V} (hM : IsMfdIn false 4 M)
    (hmax : M.maxCard = 5) : ofComplex4 (toComplex4 M) = M := by
  refine ext_mem fun s => ?_
  rw [ofComplex4, mem_closure]
  constructor
  · rintro ⟨t, ht, hst⟩
    exact down_mem (mem_filter.1 ht).1 hst
  · intro hs
    obtain ⟨τ, hτ, hsτ, hc⟩ := hM.exists_facet hmax hs
    exact ⟨τ, mem_filter.2 ⟨hτ, hc⟩, hsτ⟩

lemma toComplex4_map {W : Type*} [DecidableEq W] (M : SComplex V) (f : V ↪ W) :
    toComplex4 (M.map f) = mapComplex4 (toComplex4 M) f := by
  apply Complex4.ext
  ext s
  change s ∈ (M.map f).faces.filter (#· = 5) ↔ s ∈ (M.faces.filter (#· = 5)).image _
  rw [mem_filter, mem_faces, SComplex.mem_map, mem_image]
  constructor
  · rintro ⟨⟨t, ht, rfl⟩, hc⟩
    exact ⟨t, mem_filter.2 ⟨ht, by rwa [card_map] at hc⟩, rfl⟩
  · rintro ⟨t, ht, rfl⟩
    obtain ⟨ht, hc⟩ := mem_filter.1 ht
    exact ⟨⟨t, ht, rfl⟩, by rw [card_map, hc]⟩

/-- One **4D move** of `FourD/`. -/
inductive Move4Step : Complex4 V → Complex4 V → Prop
  /-- A 4D Pachner move. -/
  | move {K : Complex4 V} {σ τ : Finset V} (h : K.IsMove σ τ) : Move4Step K (K.move h)

/-- A chain of 4D moves gives bistellar equivalent complexes. -/
lemma bistellarEquivIn_of_move4 {K K' : Complex4 V} (h : Relation.EqvGen Move4Step K K') :
    BistellarEquivIn (ofComplex4 K) (ofComplex4 K') := by
  induction h with
  | rel K K' h =>
    cases h with
    | move h =>
      rw [ofComplex4_move h]
      exact BistellarEquivIn.bistellar _
  | refl => exact .refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A bistellar equivalence between closed combinatorial 4-manifolds with 4-simplices is a chain
of 4D moves of their 4-simplices. -/
lemma move4_of_bistellarEquivIn [Infinite V] {M N : SComplex V} (h : BistellarEquivIn M N)
    (hM : IsMfdIn false 4 M) (hmax : M.maxCard = 5) :
    Relation.EqvGen Move4Step (toComplex4 M) (toComplex4 N) := by
  induction h with
  | rel M N h =>
    cases h with
    | @bistellar A B hb =>
      have hc := hM.card_add_card_of_isBistellar hb
      have hpure := ofComplex4_toComplex4 hM hmax
      have hb' : (ofComplex4 (toComplex4 M)).IsBistellar A B := by rw [hpure]; exact hb
      have hmove := isMove_of_isBistellar hb' hc
      have heq : M.bistellar A B hb = ofComplex4 ((toComplex4 M).move hmove) := by
        rw [ofComplex4_move hmove]
        exact bistellar_congr hpure.symm hb _
      rw [heq, toComplex4_ofComplex4]
      exact .rel _ _ (.move hmove)
  | refl => exact .refl _
  | symm M N hMN ih =>
    have hM' := (SComplex.BistellarEquivIn.isMfdIn_iff hMN).2 hM
    have hmaxM : M.maxCard = 5 :=
      (SComplex.BistellarEquivIn.stellarEquivIn hMN).maxCard_eq.trans hmax
    exact (ih hM' hmaxM).symm
  | trans M N P hMN _ ih₁ ih₂ =>
    exact (ih₁ hM hmax).trans _ _ _ (ih₂ ((SComplex.BistellarEquivIn.isMfdIn_iff hMN).1 hM)
      (hmax ▸ (SComplex.BistellarEquivIn.stellarEquivIn hMN).maxCard_eq.symm))

/-- A `Complex4` with a 4-simplex generates a complex whose largest faces have five vertices. -/
lemma maxCard_ofComplex4 {K : Complex4 V} (hne : K.simps.Nonempty) :
    (ofComplex4 K).maxCard = 5 := by
  apply le_antisymm
  · refine maxCard_le fun s hs => ?_
    obtain ⟨t, ht, hst⟩ := mem_closure.1 hs
    exact (card_le_card hst).trans (K.card_eq t ht).le
  · obtain ⟨s, hs⟩ := hne
    rw [← K.card_eq s hs]
    exact card_le_maxCard (mem_closure.2 ⟨s, hs, subset_rfl⟩)

/-- **Pachner's theorem for `Complex4`** (stellar version, as `SComplex.pachner`): closed
combinatorial 4-manifolds given by their 4-simplices are stellar equivalent exactly when their
copies on `V ⊕ ℕ` are related by the 4D moves of `FourD/`. -/
theorem pachner4 {K K' : Complex4 V} (hK : IsCombManifold4 K) (hne : K.simps.Nonempty) :
    StellarEquiv (ofComplex4 K) (ofComplex4 K') ↔
      Relation.EqvGen Move4Step (mapComplex4 K (Function.Embedding.inl : V ↪ V ⊕ ℕ))
        (mapComplex4 K' (Function.Embedding.inl : V ↪ V ⊕ ℕ)) := by
  constructor
  · intro h
    have hb := (pachner hK).1 h
    have hM : IsMfdIn false 4 (ofComplex4 K).lift := isMfdIn_false_iff.2 hK
    have hmax : (ofComplex4 K).lift.maxCard = 5 := by
      rw [lift, maxCard_map, maxCard_ofComplex4 hne]
    have := move4_of_bistellarEquivIn hb hM hmax
    rwa [lift, lift, ← ofComplex4_mapComplex4, ← ofComplex4_mapComplex4, toComplex4_ofComplex4,
      toComplex4_ofComplex4] at this
  · intro h
    have := bistellarEquivIn_of_move4 h
    rw [ofComplex4_mapComplex4, ofComplex4_mapComplex4] at this
    exact BistellarEquiv.stellarEquiv this


/-! ## Pachner's theorem for `Complex3` -/

section Complex3

open Lightlike.PR

/-- The image of a `Complex3` under an injective map of the vertices. -/
def mapComplex3 {W : Type*} [DecidableEq W] (K : Complex3 V) (f : V ↪ W) : Complex3 W where
  tets := K.tets.image (Finset.map f)
  card_eq s hs := by
    obtain ⟨t, ht, rfl⟩ := mem_image.1 hs
    rw [card_map, K.card_eq t ht]

lemma ofComplex3_mapComplex3 {W : Type*} [DecidableEq W] (K : Complex3 V) (f : V ↪ W) :
    ofComplex3 (mapComplex3 K f) = (ofComplex3 K).map f := by
  rw [ofComplex3, ofComplex3, map_closure]
  rfl

/-- The tetrahedra of a complex: its faces with four vertices. -/
def toComplex3 (M : SComplex V) : Complex3 V where
  tets := M.faces.filter (#· = 4)
  card_eq _ hs := (mem_filter.1 hs).2

lemma toComplex3_ofComplex3 (K : Complex3 V) : toComplex3 (ofComplex3 K) = K := by
  cases K with
  | mk tets card_eq =>
  simp only [toComplex3, Complex3.mk.injEq]
  ext s
  rw [mem_filter, mem_faces, ofComplex3, mem_closure]
  constructor
  · rintro ⟨⟨t, ht, hst⟩, hs⟩
    rwa [eq_of_subset_of_card_le hst (by rw [card_eq t ht, hs])]
  · intro hs
    exact ⟨⟨s, hs, subset_rfl⟩, card_eq s hs⟩

lemma ofComplex3_toComplex3 [Infinite V] {M : SComplex V} (hM : IsMfdIn false 3 M)
    (hmax : M.maxCard = 4) : ofComplex3 (toComplex3 M) = M := by
  refine ext_mem fun s => ?_
  rw [ofComplex3, mem_closure]
  constructor
  · rintro ⟨t, ht, hst⟩
    exact down_mem (mem_filter.1 ht).1 hst
  · intro hs
    obtain ⟨τ, hτ, hsτ, hc⟩ := hM.exists_facet hmax hs
    exact ⟨τ, mem_filter.2 ⟨hτ, hc⟩, hsτ⟩

lemma toComplex3_map {W : Type*} [DecidableEq W] (M : SComplex V) (f : V ↪ W) :
    toComplex3 (M.map f) = mapComplex3 (toComplex3 M) f := by
  simp only [toComplex3, mapComplex3, Complex3.mk.injEq]
  ext s
  rw [mem_filter, mem_faces, SComplex.mem_map, mem_image]
  constructor
  · rintro ⟨⟨t, ht, rfl⟩, hc⟩
    exact ⟨t, mem_filter.2 ⟨ht, by rwa [card_map] at hc⟩, rfl⟩
  · rintro ⟨t, ht, rfl⟩
    obtain ⟨ht, hc⟩ := mem_filter.1 ht
    exact ⟨⟨t, ht, rfl⟩, by rw [card_map, hc]⟩

lemma maxCard_ofComplex3 {K : Complex3 V} (hne : K.tets.Nonempty) :
    (ofComplex3 K).maxCard = 4 := by
  apply le_antisymm
  · refine maxCard_le fun s hs => ?_
    obtain ⟨t, ht, hst⟩ := mem_closure.1 hs
    exact (card_le_card hst).trans (K.card_eq t ht).le
  · obtain ⟨s, hs⟩ := hne
    rw [← K.card_eq s hs]
    exact card_le_maxCard (mem_closure.2 ⟨s, hs, subset_rfl⟩)

/-- The tetrahedra around a bistellar move `κ(σ, τ)` with `#σ + #τ = 5` on the generated complex. -/
lemma move3_data {K : Complex3 V} {σ τ : Finset V} (h : (ofComplex3 K).IsBistellar σ τ)
    (hc : #σ + #τ = 5) :
    (∀ v ∈ τ, (σ ∪ τ).erase v ∈ K.tets) ∧
      (∀ t ∈ K.tets, σ ⊆ t → ∃ v ∈ τ, t = (σ ∪ τ).erase v) ∧ (∀ t ∈ K.tets, ¬ τ ⊆ t) := by
  refine ⟨fun v hv => ?_, fun s hs hσs => ?_, fun s hs hτs => h.notMem (mem_closure.2 ⟨s, hs, hτs⟩)⟩
  · have hl : τ.erase v ∈ (ofComplex3 K).link σ := by
      rw [h.link_eq, mem_boundary]
      exact erase_ssubset hv
    obtain ⟨-, -, hK⟩ := mem_link.1 hl
    obtain ⟨s, hs, hsub⟩ := mem_closure.1 hK
    have hvσ : v ∉ σ := disjoint_right.1 h.disjoint hv
    rw [union_erase_of_notMem hvσ]
    have hcard : #(σ ∪ τ.erase v) = 4 := by
      rw [card_union_of_disjoint (disjoint_of_subset_right (erase_subset v τ) h.disjoint),
        card_erase_of_mem hv]
      have := card_pos.2 h.nonempty_right
      omega
    rw [eq_of_subset_of_card_le hsub (by rw [K.card_eq s hs, hcard])]
    exact hs
  · have hsK : σ ∪ s \ σ ∈ ofComplex3 K := by
      rw [union_sdiff_of_subset hσs]
      exact mem_closure.2 ⟨s, hs, subset_rfl⟩
    have hsl : s \ σ ∈ (ofComplex3 K).link σ := mem_link'.2 ⟨disjoint_sdiff, hsK⟩
    rw [h.link_eq, mem_boundary] at hsl
    have hc' : #(s \ σ) + 1 = #τ := by
      rw [card_sdiff_of_subset hσs, K.card_eq s hs]
      have := card_le_card hσs
      rw [K.card_eq s hs] at this
      omega
    obtain ⟨v, hv, hvs⟩ := not_subset.1 hsl.not_subset
    refine ⟨v, hv, ?_⟩
    have he : s \ σ = τ.erase v := eq_of_subset_of_card_le
      (fun x hx => mem_erase.2 ⟨fun e => hvs (e ▸ hx), hsl.subset hx⟩)
      (by rw [card_erase_of_mem hv]; omega)
    rw [union_erase_of_notMem (disjoint_right.1 h.disjoint hv), ← he, union_sdiff_of_subset hσs]

/-- One **3D move** of `PonzanoRegge/` (2-3, 3-2, 1-4 or 4-1). -/
inductive Move3Step : Complex3 V → Complex3 V → Prop
  /-- A 2-3 move. -/
  | move23 {K : Complex3 V} {A B C D E : V} (h : IsMove23 K A B C D E) : Move3Step K (move23 K h)
  /-- A 3-2 move. -/
  | move32 {K : Complex3 V} {A B C D E : V} (h : IsMove32 K A B C D E) : Move3Step K (move32 K h)
  /-- A 1-4 move. -/
  | move14 {K : Complex3 V} {A B C D E : V} (h : IsMove14 K A B C D E) : Move3Step K (move14 K h)
  /-- A 4-1 move. -/
  | move41 {K : Complex3 V} {A B C D E : V} (h : IsMove41 K A B C D E) : Move3Step K (move41 K h)

/-- A chain of 3D moves gives bistellar equivalent complexes. -/
lemma bistellarEquivIn_of_move3 {K K' : Complex3 V} (h : Relation.EqvGen Move3Step K K') :
    BistellarEquivIn (ofComplex3 K) (ofComplex3 K') := by
  induction h with
  | rel K K' h =>
    cases h with
    | move23 h => rw [ofComplex3_move23 h]; exact BistellarEquivIn.bistellar _
    | move32 h => rw [ofComplex3_move32 h]; exact BistellarEquivIn.bistellar _
    | move14 h => rw [ofComplex3_move14 h]; exact BistellarEquivIn.bistellar _
    | move41 h => rw [ofComplex3_move41 h]; exact BistellarEquivIn.bistellar _
  | refl => exact .refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

end Complex3

section Complex3

open Lightlike.PR

-- The case analysis passes every distinctness fact to `vset_eq`; each use needs only some.
set_option linter.unusedVariables false in
/-- **A bistellar move with `#σ + #τ = 5` on the complex generated by a `Complex3` is one of the
2-3, 3-2, 1-4 and 4-1 moves of `PonzanoRegge/`.** -/
lemma exists_move3 {K : Complex3 V} {σ τ : Finset V} (h : (ofComplex3 K).IsBistellar σ τ)
    (hc : #σ + #τ = 5) : ∃ K', Move3Step K K' ∧ ofComplex3 K' = (ofComplex3 K).bistellar σ τ h := by
  obtain ⟨hmem, hstar, hfresh⟩ := move3_data h hc
  have hσ := card_pos.2 h.nonempty_left
  have hτ := card_pos.2 h.nonempty_right
  have hne : ∀ {x y : V}, x ∈ σ → y ∈ τ → x ≠ y := fun hx hy e =>
    disjoint_left.1 h.disjoint hx (e ▸ hy)
  rcases (show #σ = 1 ∨ #σ = 2 ∨ #σ = 3 ∨ #σ = 4 by omega) with h1 | h1 | h1 | h1
  · -- the 4-1 move: `σ = {e}`, `τ = {a, b, c, d}`
    obtain ⟨e, rfl⟩ := card_eq_one.1 h1
    obtain ⟨a, b, c, d, hab, hac, had, hbc, hbd, hcd, rfl⟩ := card_eq_four.1 (by omega : #τ = 4)
    have hae : a ≠ e := (hne (mem_singleton_self e) (by simp)).symm
    have hbe : b ≠ e := (hne (mem_singleton_self e) (by simp)).symm
    have hce : c ≠ e := (hne (mem_singleton_self e) (by simp)).symm
    have hde : d ≠ e := (hne (mem_singleton_self e) (by simp)).symm
    have ea : (({e} : Finset V) ∪ {a, b, c, d}).erase a = {b, c, d, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have eb : (({e} : Finset V) ∪ {a, b, c, d}).erase b = {a, c, d, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have ec : (({e} : Finset V) ∪ {a, b, c, d}).erase c = {a, b, d, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have ed : (({e} : Finset V) ∪ {a, b, c, d}).erase d = {a, b, c, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have hm : IsMove41 K a b c d e := {
      hAB := hab, hAC := hac, hAD := had, hAE := hae, hBC := hbc, hBD := hbd, hBE := hbe,
      hCD := hcd, hCE := hce, hDE := hde
      mem₁ := ed ▸ hmem d (by simp)
      mem₂ := ec ▸ hmem c (by simp)
      mem₃ := eb ▸ hmem b (by simp)
      mem₄ := ea ▸ hmem a (by simp)
      star := fun t ht het => by
        obtain ⟨v, hv, rfl⟩ := hstar t ht (singleton_subset_iff.2 het)
        simp only [mem_insert, mem_singleton] at hv
        rcases hv with rfl | rfl | rfl | rfl
        · exact .inr (.inr (.inr ea))
        · exact .inr (.inr (.inl eb))
        · exact .inr (.inl ec)
        · exact .inl ed
      fresh := fun h' => hfresh _ h' subset_rfl }
    exact ⟨move41 K hm, .move41 hm, ofComplex3_move41 hm⟩
  · -- the 3-2 move: `σ = {d, e}`, `τ = {a, b, c}`
    obtain ⟨d, e, hde, rfl⟩ := card_eq_two.1 h1
    obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ := card_eq_three.1 (by omega : #τ = 3)
    have had : a ≠ d := (hne (by simp) (by simp)).symm
    have hae : a ≠ e := (hne (by simp) (by simp)).symm
    have hbd : b ≠ d := (hne (by simp) (by simp)).symm
    have hbe : b ≠ e := (hne (by simp) (by simp)).symm
    have hcd : c ≠ d := (hne (by simp) (by simp)).symm
    have hce : c ≠ e := (hne (by simp) (by simp)).symm
    have ea : (({d, e} : Finset V) ∪ {a, b, c}).erase a = {b, c, d, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have eb : (({d, e} : Finset V) ∪ {a, b, c}).erase b = {c, a, d, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have ec : (({d, e} : Finset V) ∪ {a, b, c}).erase c = {a, b, d, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have hm : IsMove32 K a b c d e := {
      hAB := hab, hAC := hac, hAD := had, hAE := hae, hBC := hbc, hBD := hbd, hBE := hbe,
      hCD := hcd, hCE := hce, hDE := hde
      mem₁ := ec ▸ hmem c (by simp)
      mem₂ := ea ▸ hmem a (by simp)
      mem₃ := eb ▸ hmem b (by simp)
      star := fun t ht hDE => by
        obtain ⟨v, hv, rfl⟩ := hstar t ht hDE
        simp only [mem_insert, mem_singleton] at hv
        rcases hv with rfl | rfl | rfl
        · exact .inr (.inl ea)
        · exact .inr (.inr eb)
        · exact .inl ec
      fresh := fun t ht h' => hfresh t ht h' }
    exact ⟨move32 K hm, .move32 hm, ofComplex3_move32 hm⟩
  · -- the 2-3 move: `σ = {a, b, c}`, `τ = {d, e}`
    obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ := card_eq_three.1 h1
    obtain ⟨d, e, hde, rfl⟩ := card_eq_two.1 (by omega : #τ = 2)
    have had : a ≠ d := hne (by simp) (by simp)
    have hae : a ≠ e := hne (by simp) (by simp)
    have hbd : b ≠ d := hne (by simp) (by simp)
    have hbe : b ≠ e := hne (by simp) (by simp)
    have hcd : c ≠ d := hne (by simp) (by simp)
    have hce : c ≠ e := hne (by simp) (by simp)
    have ed : (({a, b, c} : Finset V) ∪ {d, e}).erase d = {a, b, c, e} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have ee : (({a, b, c} : Finset V) ∪ {d, e}).erase e = {a, b, c, d} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have hm : IsMove23 K a b c d e := {
      hAB := hab, hAC := hac, hAD := had, hAE := hae, hBC := hbc, hBD := hbd, hBE := hbe,
      hCD := hcd, hCE := hce, hDE := hde
      mem₁ := ee ▸ hmem e (by simp)
      mem₂ := ed ▸ hmem d (by simp)
      face := fun t ht hABC => by
        obtain ⟨v, hv, rfl⟩ := hstar t ht hABC
        simp only [mem_insert, mem_singleton] at hv
        rcases hv with rfl | rfl
        · exact .inr ed
        · exact .inl ee
      fresh := fun t ht h' => hfresh t ht h' }
    exact ⟨move23 K hm, .move23 hm, ofComplex3_move23 hm⟩
  · -- the 1-4 move: `σ = {a, b, c, d}`, `τ = {e}`
    obtain ⟨a, b, c, d, hab, hac, had, hbc, hbd, hcd, rfl⟩ := card_eq_four.1 h1
    obtain ⟨e, rfl⟩ := card_eq_one.1 (by omega : #τ = 1)
    have hae : a ≠ e := hne (by simp) (by simp)
    have hbe : b ≠ e := hne (by simp) (by simp)
    have hce : c ≠ e := hne (by simp) (by simp)
    have hde : d ≠ e := hne (by simp) (by simp)
    have ee : (({a, b, c, d} : Finset V) ∪ {e}).erase e = {a, b, c, d} := by
      clear * - hab hac had hae hbc hbd hbe hcd hce hde
      vset_eq
    have hm : IsMove14 K a b c d e := {
      hAB := hab, hAC := hac, hAD := had, hAE := hae, hBC := hbc, hBD := hbd, hBE := hbe,
      hCD := hcd, hCE := hce, hDE := hde
      mem := ee ▸ hmem e (by simp)
      fresh := fun t ht het => hfresh t ht (singleton_subset_iff.2 het) }
    exact ⟨move14 K hm, .move14 hm, ofComplex3_move14 hm⟩

end Complex3

section Complex3

open Lightlike.PR

/-- A bistellar equivalence between closed combinatorial 3-manifolds with tetrahedra is a chain of
3D moves of their tetrahedra. -/
lemma move3_of_bistellarEquivIn [Infinite V] {M N : SComplex V} (h : BistellarEquivIn M N)
    (hM : IsMfdIn false 3 M) (hmax : M.maxCard = 4) :
    Relation.EqvGen Move3Step (toComplex3 M) (toComplex3 N) := by
  induction h with
  | rel M N h =>
    cases h with
    | @bistellar A B hb =>
      have hc := hM.card_add_card_of_isBistellar hb
      have hpure := ofComplex3_toComplex3 hM hmax
      have hb' : (ofComplex3 (toComplex3 M)).IsBistellar A B := by rw [hpure]; exact hb
      obtain ⟨K', hK', hK'eq⟩ := exists_move3 hb' hc
      have heq : M.bistellar A B hb = ofComplex3 K' := by
        rw [hK'eq]
        exact bistellar_congr hpure.symm hb _
      rw [heq, toComplex3_ofComplex3]
      exact .rel _ _ hK'
  | refl => exact .refl _
  | symm M N hMN ih =>
    have hM' := (SComplex.BistellarEquivIn.isMfdIn_iff hMN).2 hM
    have hmaxM : M.maxCard = 4 :=
      (SComplex.BistellarEquivIn.stellarEquivIn hMN).maxCard_eq.trans hmax
    exact (ih hM' hmaxM).symm
  | trans M N P hMN _ ih₁ ih₂ =>
    exact (ih₁ hM hmax).trans _ _ _ (ih₂ ((SComplex.BistellarEquivIn.isMfdIn_iff hMN).1 hM)
      (hmax ▸ (SComplex.BistellarEquivIn.stellarEquivIn hMN).maxCard_eq.symm))

/-- **Pachner's theorem for `Complex3`** (the corollary of milestone PL2; stellar version, as
`SComplex.pachner`): closed combinatorial 3-manifolds of `PonzanoRegge/` are stellar equivalent
exactly when their copies on `V ⊕ ℕ` are related by chains of 2-3, 3-2, 1-4 and 4-1 moves. -/
theorem pachner3 {K K' : Complex3 V} (hK : IsCombManifold K) (hne : K.tets.Nonempty) :
    StellarEquiv (ofComplex3 K) (ofComplex3 K') ↔
      Relation.EqvGen Move3Step (mapComplex3 K (Function.Embedding.inl : V ↪ V ⊕ ℕ))
        (mapComplex3 K' (Function.Embedding.inl : V ↪ V ⊕ ℕ)) := by
  have hK3 := isCombManifold_iff_ofComplex3.1 hK
  constructor
  · intro h
    have hb := (pachner hK3).1 h
    have hM : IsMfdIn false 3 (ofComplex3 K).lift := isMfdIn_false_iff.2 hK3
    have hmax : (ofComplex3 K).lift.maxCard = 4 := by
      rw [lift, maxCard_map, maxCard_ofComplex3 hne]
    have := move3_of_bistellarEquivIn hb hM hmax
    rwa [lift, lift, ← ofComplex3_mapComplex3, ← ofComplex3_mapComplex3, toComplex3_ofComplex3,
      toComplex3_ofComplex3] at this
  · intro h
    have := bistellarEquivIn_of_move3 h
    rw [ofComplex3_mapComplex3, ofComplex3_mapComplex3] at this
    exact BistellarEquiv.stellarEquiv this

end Complex3

