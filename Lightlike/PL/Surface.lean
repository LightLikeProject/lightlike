import Lightlike.PL.Euler
import Lightlike.PL.Complex3
import Lightlike.PonzanoRegge.SphereRecognition

/-!
# PL 2-spheres are intrinsic triangulated 2-spheres

`Lightlike/PonzanoRegge/SphereConverse.lean` defines intrinsic triangulated 2-spheres
(`IsSurfaceSphere`): every edge lies in two triangles, every vertex link is connected, the
1-skeleton is connected and the Euler characteristic is 2. Here we show that a family of triangles
generating a PL 2-sphere has these properties.

Together with the theorem that every intrinsic triangulated 2-sphere is reached from the boundary
of a tetrahedron by 2-dimensional bistellar moves (Steinitz–Wagner, `IsSurfaceSphere.isSphere2` in
`Lightlike/PonzanoRegge/SphereRecognition.lean`), this gives the converse of
`isPLSphere_closure_of_isSphere2`: the combinatorial 2-spheres of `PonzanoRegge/` are exactly the
PL 2-spheres (`isSphere2_iff`), and its closed combinatorial 3-manifolds are exactly the closed
combinatorial 3-manifolds of `PL/` (`isCombManifold_iff_ofComplex3`).

## Main results

* `IsConnected.reflTransGen`: in a connected complex any two vertices are joined by a path of edges.
* `euler_closure`: for a family of triangles, the Euler characteristic of the generated complex is
  `euler2` of `PonzanoRegge/`.
* `isSurfaceSphere_of_isPLSphere`: a family of triangles generating a PL 2-sphere is an intrinsic
  triangulated 2-sphere.
* `isSphere2_iff`, `isCombManifold_iff_ofComplex3`: the combinatorial 2-spheres and closed
  combinatorial 3-manifolds of `PonzanoRegge/` are exactly those of `PL/`.
-/

open Finset Lightlike.PR

namespace Lightlike.PL

open SComplex

variable {V : Type*} [DecidableEq V]

/-- **In a connected complex any two vertices are joined by a path of edges.** -/
theorem SComplex.IsConnected.reflTransGen {K : SComplex V} (h : K.IsConnected) {u v : V}
    (hu : u ∈ K.verts) (hv : v ∈ K.verts) :
    Relation.ReflTransGen (fun x y => ({x, y} : Finset V) ∈ K) u v := by
  classical
  obtain ⟨-, hconn⟩ := h
  have hS : Separates (K.verts.filter fun w =>
      Relation.ReflTransGen (fun x y => ({x, y} : Finset V) ∈ K) u w) K := by
    intro s hs
    by_cases hd : Disjoint s (K.verts.filter fun w =>
        Relation.ReflTransGen (fun x y => ({x, y} : Finset V) ∈ K) u w)
    · exact .inr hd
    · left
      obtain ⟨w, hws, hwS⟩ := not_disjoint_iff.1 hd
      intro z hz
      have hwz : ({w, z} : Finset V) ∈ K :=
        down_mem hs (insert_subset hws (singleton_subset_iff.2 hz))
      exact mem_filter.2 ⟨subset_verts hs hz, (mem_filter.1 hwS).2.tail hwz⟩
  rcases hconn _ hS with h' | h'
  · exact (mem_filter.1 (h' hv)).2
  · exact absurd (mem_filter.2 ⟨hu, .refl⟩) (disjoint_left.1 h' hu)

/-- A path whose steps are equalities or steps of `R'` is a path of `R'`. -/
lemma reflTransGen_of_imp {α : Type*} {R R' : α → α → Prop} (hRR' : ∀ x y, R x y → x = y ∨ R' x y)
    {u v : α} (h : Relation.ReflTransGen R u v) : Relation.ReflTransGen R' u v := by
  induction h with
  | refl => exact .refl
  | tail _ hbc ih =>
    rcases hRR' _ _ hbc with rfl | h'
    · exact ih
    · exact ih.tail h'

lemma verts_closure (L : Finset (Finset V)) : (SComplex.closure L).verts = verts2 L := by
  ext x
  rw [mem_verts, mem_closure, mem_verts2]
  simp

/-- A pair of distinct vertices spans a face of the generated complex exactly when it is an edge. -/
lemma pair_mem_closure_iff {L : Finset (Finset V)} {x y : V} (hxy : x ≠ y) :
    ({x, y} : Finset V) ∈ SComplex.closure L ↔ ({x, y} : Finset V) ∈ edges2 L := by
  rw [mem_closure, mem_edges2]
  constructor
  · rintro ⟨τ, hτ, hs⟩
    exact ⟨τ, hτ, hs, card_pair hxy⟩
  · rintro ⟨τ, hτ, hs, -⟩
    exact ⟨τ, hτ, hs⟩

/-- **The Euler characteristic of the complex generated by a family of triangles is `euler2`.** -/
theorem euler_closure {L : Finset (Finset V)} (hT : IsTri2 L) :
    (SComplex.closure L).euler = euler2 L := by
  set S := (SComplex.closure L).faces.erase ∅ with hS
  have hmemS : ∀ {s : Finset V}, s ∈ S ↔ s ≠ ∅ ∧ ∃ τ ∈ L, s ⊆ τ := by
    intro s
    rw [hS, mem_erase, mem_faces, mem_closure]
  have h1 : S.filter (fun s => #s = 1) = (verts2 L).image ({·}) := by
    ext s
    rw [mem_filter, hmemS, mem_image]
    constructor
    · rintro ⟨⟨-, τ, hτ, hs⟩, h1⟩
      obtain ⟨x, rfl⟩ := card_eq_one.1 h1
      exact ⟨x, mem_verts2.2 ⟨τ, hτ, singleton_subset_iff.1 hs⟩, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨τ, hτ, hxτ⟩ := mem_verts2.1 hx
      exact ⟨⟨singleton_ne_empty x, τ, hτ, singleton_subset_iff.2 hxτ⟩, card_singleton x⟩
  have h2 : (S.filter fun s => ¬ #s = 1).filter (fun s => #s = 2) = edges2 L := by
    ext s
    rw [mem_filter, mem_filter, hmemS, mem_edges2]
    constructor
    · rintro ⟨⟨⟨-, τ, hτ, hs⟩, -⟩, h2⟩
      exact ⟨τ, hτ, hs, h2⟩
    · rintro ⟨τ, hτ, hs, h2⟩
      exact ⟨⟨⟨fun h => by rw [h, card_empty] at h2; omega, τ, hτ, hs⟩, by omega⟩, h2⟩
  have h3 : (S.filter fun s => ¬ #s = 1).filter (fun s => ¬ #s = 2) = L := by
    ext s
    rw [mem_filter, mem_filter, hmemS]
    constructor
    · rintro ⟨⟨⟨hs0, τ, hτ, hs⟩, h1⟩, h2⟩
      have hle := card_le_card hs
      rw [hT τ hτ] at hle
      have h0 : 0 < #s := card_pos.2 (nonempty_iff_ne_empty.2 hs0)
      have : s = τ := eq_of_subset_of_card_le hs (by rw [hT τ hτ]; omega)
      rwa [this]
    · intro hs
      have h3 := hT s hs
      exact ⟨⟨⟨fun h => by rw [h, card_empty] at h3; omega, s, hs, subset_rfl⟩, by omega⟩,
        by omega⟩
  rw [euler, ← hS, ← sum_filter_add_sum_filter_not S (fun s => #s = 1),
    ← sum_filter_add_sum_filter_not (S.filter fun s => ¬ #s = 1) (fun s => #s = 2), h1, h2, h3,
    sum_image fun x _ y _ h => singleton_injective h]
  have e2 : ∑ s ∈ edges2 L, (-1 : ℤ) ^ (#s + 1) = -#(edges2 L) := by
    have : ∀ s ∈ edges2 L, (-1 : ℤ) ^ (#s + 1) = -1 := by
      intro s hs
      obtain ⟨_, _, _, h2⟩ := mem_edges2.1 hs
      rw [h2]
      norm_num
    rw [sum_congr rfl this]
    simp
  have e3 : ∑ s ∈ L, (-1 : ℤ) ^ (#s + 1) = #L := by
    have : ∀ s ∈ L, (-1 : ℤ) ^ (#s + 1) = 1 := by
      intro s hs
      rw [hT s hs]
      norm_num
    rw [sum_congr rfl this]
    simp
  rw [e2, e3, euler2]
  simp
  ring

/-- **A family of triangles generating a PL 2-sphere is an intrinsic triangulated 2-sphere**: every
edge lies in exactly two triangles, every vertex link and the 1-skeleton are connected, and the
Euler characteristic is `2`. -/
theorem isSurfaceSphere_of_isPLSphere {L : Finset (Finset V)} (hT : IsTri2 L)
    (h : IsPLSphere 2 (SComplex.closure L)) : IsSurfaceSphere L where
  card := hT
  closed := by
    intro f hf
    obtain ⟨τ₀, hτ₀, hfτ₀, hf2⟩ := mem_edges2.1 hf
    have hfK : f ∈ SComplex.closure L := mem_closure.2 ⟨τ₀, hτ₀, hfτ₀⟩
    have hlk := h.isClosedCombManifold.isPLSphere_link hfK (card_pos.1 (by omega))
      (by omega)
    rw [hf2] at hlk
    have h2 := hlk.card_verts_zero
    rw [← h2]
    have he : L.filter (f ⊆ ·) = ((SComplex.closure L).link f).verts.image (insert · f) := by
      ext τ
      rw [mem_filter, mem_image]
      constructor
      · rintro ⟨hτ, hfτ⟩
        have hc : #(τ \ f) = 1 := by
          rw [card_sdiff_of_subset hfτ, hT τ hτ, hf2]
        obtain ⟨w, hw⟩ := card_eq_one.1 hc
        have hwτ : w ∈ τ \ f := hw ▸ mem_singleton_self w
        rw [mem_sdiff] at hwτ
        refine ⟨w, mem_verts.2 (mem_link'.2 ⟨disjoint_singleton_right.2 hwτ.2, ?_⟩), ?_⟩
        · exact mem_closure.2 ⟨τ, hτ, union_subset hfτ (singleton_subset_iff.2 hwτ.1)⟩
        · rw [← sdiff_union_of_subset hfτ, hw, insert_eq]
      · rintro ⟨w, hw, rfl⟩
        obtain ⟨hwf, hwK⟩ := mem_link'.1 (mem_verts.1 hw)
        obtain ⟨τ, hτ, hsub⟩ := mem_closure.1 hwK
        have hwf' : w ∉ f := disjoint_singleton_right.1 hwf
        have : insert w f = τ := by
          refine eq_of_subset_of_card_le (by rwa [insert_eq, union_comm]) ?_
          rw [hT τ hτ, card_insert_of_notMem hwf', hf2]
        exact ⟨this ▸ hτ, subset_insert w f⟩
    rw [he, card_image_of_injOn]
    intro w hw w' hw' hww'
    have hwf : w ∉ f := disjoint_singleton_right.1 (mem_link'.1 (mem_verts.1 hw)).1
    have hwf' : w' ∉ f := disjoint_singleton_right.1 (mem_link'.1 (mem_verts.1 hw')).1
    have := congrArg (· \ f) hww'
    simp only [insert_sdiff_of_notMem _ hwf, insert_sdiff_of_notMem _ hwf', sdiff_self,
      bot_eq_empty, insert_empty, singleton_inj] at this
    exact this
  link := by
    intro v hv
    rw [← verts_closure] at hv
    have hlk : (SComplex.closure L).link {v} = SComplex.closure (lk2 L v) := link_closure L v
    have hS := isClosedCombManifold_succ_iff.1 h.isClosedCombManifold v hv
    rw [hlk] at hS
    have hconn := (hS : IsPLSphere (0 + 1) _).isConnected
    intro u hu w hw
    rw [← verts_closure] at hu hw
    refine reflTransGen_of_imp ?_ (hconn.reflTransGen hu hw)
    intro x y hxy
    by_cases he : x = y
    · exact .inl he
    · right
      obtain ⟨e, he', hsub⟩ := mem_closure.1 hxy
      obtain ⟨hve, hveL⟩ := mem_lk2.1 he'
      have hc : #e = 2 := by
        have := hT _ hveL
        rw [card_insert_of_notMem hve] at this
        omega
      have : ({x, y} : Finset V) = e :=
        eq_of_subset_of_card_le hsub (by rw [hc, card_pair he])
      rwa [this]
  connected := by
    intro u hu w hw
    rw [← verts_closure] at hu hw
    refine reflTransGen_of_imp ?_ ((h.isConnected (n := 1)).reflTransGen hu hw)
    intro x y hxy
    by_cases he : x = y
    · exact .inl he
    · exact .inr ((pair_mem_closure_iff he).1 hxy)
  euler := by
    rw [← euler_closure hT, h.euler]
    norm_num

/-- **The combinatorial 2-spheres of `PonzanoRegge/` are exactly the PL 2-spheres**: a family `L`
is reached from the boundary of a tetrahedron by 2-dimensional bistellar moves if and only if its
members are triangles and they generate a PL 2-sphere. -/
theorem isSphere2_iff {L : Finset (Finset V)} :
    IsSphere2 L ↔ IsTri2 L ∧ IsPLSphere 2 (SComplex.closure L) :=
  ⟨fun h => ⟨h.isSurfaceSphere.card, isPLSphere_closure_of_isSphere2 h⟩,
    fun ⟨hT, h⟩ => (isSurfaceSphere_of_isPLSphere hT h).isSphere2⟩

/-- **The closed combinatorial 3-manifolds of `PonzanoRegge/` are exactly those of `PL/`**: every
vertex link of `K` is a combinatorial 2-sphere if and only if every vertex link of `ofComplex3 K`
is a PL 2-sphere. -/
theorem isCombManifold_iff_ofComplex3 {K : Complex3 V} :
    IsCombManifold K ↔ IsClosedCombManifold 3 (ofComplex3 K) := by
  refine ⟨isClosedCombManifold_ofComplex3, fun h v hv => ?_⟩
  have hv' : v ∈ (ofComplex3 K).verts := by rwa [verts_ofComplex3]
  have hS := isClosedCombManifold_succ_iff.1 h v hv'
  rw [link_ofComplex3] at hS
  refine isSphere2_iff.2 ⟨fun τ hτ => ?_, hS⟩
  obtain ⟨hvτ, hτK⟩ := Complex3.mem_link.1 hτ
  have := K.card_eq _ hτK
  rw [card_insert_of_notMem hvτ] at this
  omega

end Lightlike.PL
