module

public import Mathlib

/-!
# Finite-dimensional quantum mechanics

Setting: a finite-dimensional complex Hilbert space `H`
(`[InnerProductSpace ℂ H] [FiniteDimensional ℂ H]`; completeness is automatic).

* **States** are unit vectors (`ψ ∈ Metric.sphere 0 1`).
* **Observables** are self-adjoint operators: Mathlib's `selfAdjoint (H →L[ℂ] H)`
  (`IsSelfAdjoint A ↔ A† = A`).
* **Time evolution** generated by a Hamiltonian `Hm` is `U(t) = exp(-i t Hm)`, built with
  Mathlib's `selfAdjoint.expUnitary`, so `U(t)` lies in the unitary group *by construction*.
* **Born rule**: for an observable `A` with eigenvalues `μ` and eigenspaces `E_μ`, the probability
  of outcome `μ` in state `ψ` is `‖P_μ ψ‖²` where `P_μ` is the orthogonal projection onto `E_μ`.
  This is basis-independent (it does not depend on choosing eigenvectors in degenerate eigenspaces).

Main results
* `evolve_zero`, `evolve_add` - `U(0) = 1`, `U(s+t) = U(s)U(t)` (one-parameter group).
* `norm_evolve`, `inner_evolve` - `U(t)` preserves norms and inner products.
* `schrodinger` - `ψ(t) = U(t)ψ` satisfies `dψ/dt = -i Hm ψ(t)` (Schrödinger equation).
* `bornProb_nonneg`, `sum_bornProb` - Born probabilities are `≥ 0` and sum to `‖ψ‖² = 1`.
* `bornPMF` - the Born rule as a `PMF` (Mathlib's probability mass function) on the eigenvalues.
* `expectation_eq_sum` - `⟨ψ, Aψ⟩ = Σ_μ μ · P(μ)`.
* `bornProb_eigenstate` - in an eigenstate with eigenvalue `μ`, outcome `μ` has probability 1.
* `bornProb_evolve_of_commute` - if `[A, Hm] = 0` then Born probabilities for `A` are conserved
  in time.

**References.** M. A. Nielsen and I. L. Chuang, *Quantum Computation and Quantum Information* (Cambridge University Press, 2000), ch. 2 (the postulates of quantum mechanics); B. C. Hall, *Quantum Theory for Mathematicians* (Springer, 2013).
-/

@[expose] public section

open Complex Module End
open scoped InnerProductSpace

noncomputable section

namespace Lightlike.QM

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]

/-- An **observable**: a self-adjoint (bounded) operator on `H`. -/
abbrev Observable (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [FiniteDimensional ℂ H] :=
  selfAdjoint (H →L[ℂ] H)

/-- A **pure state**: a unit vector. -/
abbrev State (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  Metric.sphere (0 : H) 1

/-! ## Unitary time evolution -/

/-- The self-adjoint operator `-t · Hm` (built directly on the subtype to avoid an expensive
`Module ℝ (selfAdjoint _)` instance search). -/
def scaledHam (Hm : Observable H) (t : ℝ) : Observable H :=
  ⟨((-t : ℝ) : ℂ) • (Hm : H →L[ℂ] H), IsSelfAdjoint.smul (Complex.conj_ofReal _) Hm.2⟩

/-- Time evolution `U(t) = exp(-i t Hm)` generated by a Hamiltonian `Hm`, as an element of the
unitary group of `H →L[ℂ] H` (Mathlib's `selfAdjoint.expUnitary a = exp(i a)` with `a = -t Hm`). -/
def evolve (Hm : Observable H) (t : ℝ) : unitary (H →L[ℂ] H) :=
  selfAdjoint.expUnitary (scaledHam Hm t)

@[simp] lemma evolve_zero (Hm : Observable H) : evolve Hm 0 = 1 := by
  have : scaledHam Hm 0 = 0 := Subtype.ext (by simp [scaledHam])
  simp [evolve, this]

/-- `U(s + t) = U(s) U(t)`: time evolution is a one-parameter group. -/
theorem evolve_add (Hm : Observable H) (s t : ℝ) :
    evolve Hm (s + t) = evolve Hm s * evolve Hm t := by
  unfold evolve
  rw [show scaledHam Hm (s + t) = scaledHam Hm s + scaledHam Hm t from
    Subtype.ext (by
      simp only [scaledHam, AddMemClass.coe_add]
      rw [← add_smul]; congr 1; push_cast; ring)]
  apply Commute.expUnitary_add
  exact ((Commute.refl (Hm : H →L[ℂ] H)).smul_left _).smul_right _

/-- Unitary evolution preserves the norm (total probability). -/
theorem norm_evolve (Hm : Observable H) (t : ℝ) (ψ : H) :
    ‖(evolve Hm t : H →L[ℂ] H) ψ‖ = ‖ψ‖ :=
  (evolve Hm t : H →L[ℂ] H).norm_map_of_mem_unitary (evolve Hm t).2 ψ

/-- Unitary evolution preserves inner products (transition amplitudes). -/
theorem inner_evolve (Hm : Observable H) (t : ℝ) (φ ψ : H) :
    ⟪(evolve Hm t : H →L[ℂ] H) φ, (evolve Hm t : H →L[ℂ] H) ψ⟫_ℂ = ⟪φ, ψ⟫_ℂ :=
  (evolve Hm t : H →L[ℂ] H).inner_map_map_of_mem_unitary (evolve Hm t).2 φ ψ

/-- States evolve into states. -/
def State.evolve (Hm : Observable H) (t : ℝ) (ψ : State H) : State H :=
  ⟨(Lightlike.QM.evolve Hm t : H →L[ℂ] H) ψ, by simp [norm_evolve]⟩

/-- `U(t) = exp(t • X)` with `X = -i Hm` (real scalar `t`). -/
lemma evolve_coe_eq (Hm : Observable H) (t : ℝ) :
    ((evolve Hm t : unitary (H →L[ℂ] H)) : H →L[ℂ] H) =
      NormedSpace.exp (t • (-I • (Hm : H →L[ℂ] H))) := by
  simp only [evolve, selfAdjoint.expUnitary_coe, scaledHam]
  congr 1
  rw [← Complex.coe_smul, smul_smul, smul_smul]
  congr 1
  push_cast
  ring

/-- **Schrödinger equation.** `ψ(t) = U(t) ψ₀` satisfies `ψ'(t) = -i Hm ψ(t)`, i.e.
`i dψ/dt = Hm ψ`. -/
theorem schrodinger (Hm : Observable H) (ψ₀ : H) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (evolve Hm s : H →L[ℂ] H) ψ₀)
      (-I • (Hm : H →L[ℂ] H) ((evolve Hm t : H →L[ℂ] H) ψ₀)) t := by
  set X : H →L[ℂ] H := -I • (Hm : H →L[ℂ] H)
  have hexp : HasDerivAt (fun u : ℝ => NormedSpace.exp (u • X)) (X * NormedSpace.exp (t • X)) t :=
    hasDerivAt_exp_smul_const' X t
  set L : (H →L[ℂ] H) →L[ℝ] H := (ContinuousLinearMap.apply ℂ H ψ₀).restrictScalars ℝ
  have happ := L.hasFDerivAt.comp_hasDerivAt t hexp
  have hfun : (fun s : ℝ => (evolve Hm s : H →L[ℂ] H) ψ₀) =
      L ∘ fun u => NormedSpace.exp (u • X) := by
    funext s; simp only [Function.comp, evolve_coe_eq]; rfl
  rw [hfun]
  convert happ using 1
  simp [L, X, evolve_coe_eq, _root_.mul_apply_eq_comp]

/-! ## The Born rule -/

variable (A : Observable H)

/-- The linear map underlying an observable, as an endomorphism. -/
abbrev toEnd : Module.End ℂ H := ((A : H →L[ℂ] H) : H →ₗ[ℂ] H)

lemma isSymm : (toEnd A).IsSymmetric := A.2.isSymmetric

/-- Possible measurement outcomes of `A`: its eigenvalues (a finite type). -/
abbrev Outcome := Module.End.Eigenvalues (toEnd A)

/-- Measurement outcomes are real numbers (eigenvalues of self-adjoint operators are real). -/
lemma outcome_im_eq_zero (μ : Outcome A) : (μ : ℂ).im = 0 :=
  Complex.conj_eq_iff_im.mp ((isSymm A).conj_eigenvalue_eq_self μ.2)

/-- Orthogonal projection onto the eigenspace `E_μ` of `A`. -/
def proj (μ : Outcome A) : H →L[ℂ] eigenspace (toEnd A) (μ : ℂ) :=
  (eigenspace (toEnd A) (μ : ℂ)).orthogonalProjectionOnto

/-- **Born probability** of outcome `μ` when measuring `A` in state `ψ`: `‖P_μ ψ‖²`. -/
def bornProb (ψ : H) (μ : Outcome A) : ℝ := ‖proj A μ ψ‖ ^ 2

lemma bornProb_nonneg (ψ : H) (μ : Outcome A) : 0 ≤ bornProb A ψ μ := sq_nonneg _

/-- The spectral-theorem isometry `H ≃ ⊕_μ E_μ` (Mathlib's `diagonalization`) sends `ψ` to the
family of its eigenspace projections. -/
lemma diagonalization_apply (ψ : H) (μ : Outcome A) :
    ((isSymm A).diagonalization ψ μ) = proj A μ ψ := by
  set D := (isSymm A).diagonalization
  have hψ : ψ = ∑ ν, (D ψ ν : H) := by
    conv_lhs => rw [← D.symm_apply_apply ψ]
    rw [LinearMap.IsSymmetric.diagonalization_symm_apply]
  have horth := (isSymm A).orthogonalFamily_eigenspaces'
  apply Subtype.ext
  symm
  rw [proj]
  conv_lhs => rw [hψ]
  rw [map_sum, Submodule.coe_sum, Finset.sum_eq_single μ]
  · rw [Submodule.orthogonalProjectionOnto_mem_subspace_eq_self]
  · intro ν _ hν
    have : (D ψ ν : H) ∈ (eigenspace (toEnd A) (μ : ℂ))ᗮ := by
      rw [Submodule.mem_orthogonal]
      intro u hu
      exact horth (Ne.symm hν) ⟨u, hu⟩ (D ψ ν)
    rw [Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr this]
    rfl
  · simp

/-- Parseval for the eigenspace decomposition: `Σ_μ ‖P_μ ψ‖² = ‖ψ‖²`. -/
theorem sum_bornProb_eq_norm_sq (ψ : H) : ∑ μ, bornProb A ψ μ = ‖ψ‖ ^ 2 := by
  have h := PiLp.norm_sq_eq_of_L2 _ ((isSymm A).diagonalization ψ)
  rw [LinearIsometryEquiv.norm_map] at h
  rw [h]
  refine Finset.sum_congr rfl fun μ _ => ?_
  rw [bornProb, ← diagonalization_apply]

/-- **Born probabilities sum to one** in any (unit-norm) state. -/
theorem sum_bornProb (ψ : State H) : ∑ μ, bornProb A ψ μ = 1 := by
  rw [sum_bornProb_eq_norm_sq, mem_sphere_zero_iff_norm.mp ψ.2, one_pow]

/-- **The Born rule as a probability distribution** on the outcomes (eigenvalues) of `A`. -/
def bornPMF (ψ : State H) : PMF (Outcome A) :=
  PMF.ofFintype (fun μ => ENNReal.ofReal (bornProb A ψ μ)) (by
    rw [← ENNReal.ofReal_sum_of_nonneg (fun μ _ => bornProb_nonneg A ψ μ), sum_bornProb,
      ENNReal.ofReal_one])

/-- The Born distribution assigns to each outcome its Born probability `bornProb A ψ μ`. -/
lemma bornPMF_apply (ψ : State H) (μ : Outcome A) :
    (bornPMF A ψ μ).toReal = bornProb A ψ μ := by
  simp [bornPMF, ENNReal.toReal_ofReal (bornProb_nonneg A ψ μ)]

/-- **Expectation value** `⟨ψ, A ψ⟩ = Σ_μ μ · P(μ)`. -/
theorem expectation_eq_sum (ψ : H) :
    ⟪ψ, (A : H →L[ℂ] H) ψ⟫_ℂ = ∑ μ : Outcome A, (μ : ℂ) * (bornProb A ψ μ : ℂ) := by
  set D := (isSymm A).diagonalization
  rw [← D.inner_map_map, PiLp.inner_apply]
  refine Finset.sum_congr rfl fun μ _ => ?_
  have h := (isSymm A).diagonalization_apply_self_apply ψ μ
  simp only [toEnd, ContinuousLinearMap.coe_coe] at h
  rw [h, inner_smul_right, inner_self_eq_norm_sq_to_K, bornProb, ← diagonalization_apply]
  push_cast
  rfl

/-- In an eigenstate with eigenvalue `μ`, the outcome `μ` is certain. -/
theorem bornProb_eigenstate (ψ : State H) (μ : Outcome A)
    (hψ : (A : H →L[ℂ] H) ψ = (μ : ℂ) • (ψ : H)) : bornProb A ψ μ = 1 := by
  have hmem : (ψ : H) ∈ eigenspace (toEnd A) (μ : ℂ) := by
    rw [Module.End.mem_eigenspace_iff]; exact hψ
  rw [bornProb, proj, Submodule.orthogonalProjectionOnto_mem_subspace_eq_self ⟨_, hmem⟩]
  simp [mem_sphere_zero_iff_norm.mp ψ.2]

/-- **Conservation law.** If the observable `A` commutes with the Hamiltonian, the Born
distribution of `A` does not change under time evolution. -/
theorem bornProb_evolve_of_commute (Hm : Observable H)
    (hc : Commute (A : H →L[ℂ] H) (Hm : H →L[ℂ] H)) (t : ℝ) (ψ : H) (μ : Outcome A) :
    bornProb A ((evolve Hm t : H →L[ℂ] H) ψ) μ = bornProb A ψ μ := by
  set U : H →L[ℂ] H := ↑(evolve Hm t)
  have hU : U ∈ unitary (H →L[ℂ] H) := (evolve Hm t).2
  -- `U` commutes with `A`, hence maps each eigenspace `E_ν` into itself, and so does `U⁻¹ = U†`.
  have hcomm : Commute (A : H →L[ℂ] H) U := by
    rw [show U = NormedSpace.exp (t • (-I • (Hm : H →L[ℂ] H))) from evolve_coe_eq Hm t]
    exact (((hc.smul_right _).smul_right _)).exp_right
  have hUstar : Commute (A : H →L[ℂ] H) (star U) := by
    have := hcomm.star_star
    rwa [A.2.star_eq] at this
  have hinv : ∀ (V : H →L[ℂ] H), Commute (A : H →L[ℂ] H) V → ∀ ν : Outcome A, ∀ x ∈
      eigenspace (toEnd A) (ν : ℂ), V x ∈ eigenspace (toEnd A) (ν : ℂ) := by
    intro V hV ν x hx
    rw [Module.End.mem_eigenspace_iff] at hx ⊢
    simp only [toEnd, ContinuousLinearMap.coe_coe] at hx ⊢
    rw [← _root_.mul_apply_eq_comp, hV.eq, _root_.mul_apply_eq_comp, hx, map_smul]
  -- So `U` commutes with each projection `P_μ`, and `‖P_μ (Uψ)‖ = ‖U (P_μ ψ)‖ = ‖P_μ ψ‖`.
  have hP : (proj A μ (U ψ) : H) = U (proj A μ ψ) := by
    set K := eigenspace (toEnd A) (μ : ℂ)
    have hKU : ∀ x ∈ K, U x ∈ K := hinv U hcomm μ
    have hKUs : ∀ x ∈ Kᗮ, U x ∈ Kᗮ := by
      intro x hx
      rw [Submodule.mem_orthogonal] at hx ⊢
      intro u hu
      rw [← ContinuousLinearMap.adjoint_inner_left, ← ContinuousLinearMap.star_eq_adjoint]
      exact hx _ (hinv (star U) hUstar μ u hu)
    have hsub : U ψ - U (proj A μ ψ : H) ∈ Kᗮ := by
      rw [← map_sub]
      exact hKUs _ (by
        rw [proj, Submodule.coe_orthogonalProjectionOnto_apply]
        exact Submodule.sub_starProjection_mem_orthogonal ψ)
    rw [proj, Submodule.coe_orthogonalProjectionOnto_apply]
    exact Submodule.eq_starProjection_of_mem_orthogonal (hKU _ (proj A μ ψ).2) hsub
  rw [bornProb, bornProb, ← Submodule.norm_coe, hP, U.norm_map_of_mem_unitary hU,
    Submodule.norm_coe]

end Lightlike.QM
