    : (b0 * y0 + b1 * y1 + b2 * y2 + b3 * y3 + b4 * y4 + b5 * y5) + (b0 * x10 + b1 * x11 + b2 * x12 + b3 * x13 + b4 * x14 + b5 * x15) + (b0 * x20 + b1 * x21 + b2 * x22 + b3 * x23 + b4 * x24 + b5 * x25) + (b0 * x30 + b1 * x31 + b2 * x32 + b3 * x33 + b4 * x34 + b5 * x35) + (b0 * x40 + b1 * x41 + b2 * x42 + b3 * x43 + b4 * x44 + b5 * x45) + (b0 * x50 + b1 * x51 + b2 * x52 + b3 * x53 + b4 * x54 + b5 * x55) + (b0 * x60 + b1 * x61 + b2 * x62 + b3 * x63 + b4 * x64 + b5 * x65) =
