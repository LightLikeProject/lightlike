/-- The tetrahedron of every incidence is nondegenerate. -/
theorem trip_ne (σ h : Fin 6) : trip (wv σ h) (xv σ h) (yv σ h) ≠ 0 := by
  fin_cases σ <;> fin_cases h <;>
    simp [trip, wv, xv, yv, kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num

/-- The Gram squared lengths of an incidence in terms of its three edge vectors. -/
theorem incQ_eq_vec (g : (Fin 3 → ℝ) → Matrix (Fin 3) (Fin 3) ℝ) (m : Fin 3 → ℝ) (σ h : Fin 6) :
    incQ g m σ h = ![wv σ h ⬝ᵥ (g m *ᵥ wv σ h), xv σ h ⬝ᵥ (g m *ᵥ xv σ h),
      (xv σ h - wv σ h) ⬝ᵥ (g m *ᵥ (xv σ h - wv σ h)), yv σ h ⬝ᵥ (g m *ᵥ yv σ h),
      (yv σ h - wv σ h) ⬝ᵥ (g m *ᵥ (yv σ h - wv σ h)),
      (yv σ h - xv σ h) ⬝ᵥ (g m *ᵥ (yv σ h - xv σ h))] := by
  have e1 : (fun i => kpos σ h (hR h) i - kpos σ h (hQ h) i) = xv σ h - wv σ h := by
    ext i; simp [xv, wv]
  have e2 : (fun i => kpos σ h (hS h) i - kpos σ h (hQ h) i) = yv σ h - wv σ h := by
    ext i; simp [yv, wv]
  have e3 : (fun i => kpos σ h (hS h) i - kpos σ h (hR h) i) = yv σ h - xv σ h := by
    ext i; simp [yv, xv]
  simp only [incQ, incVec, edgeQ, e1, e2, e3]
  rfl

/-- **The Gram tetrahedra are admissible.** For a positive definite `g m` every incidence has admissible squared lengths (`Valid`). -/
theorem valid_incQ {g : (Fin 3 → ℝ) → Matrix (Fin 3) (Fin 3) ℝ} {m : Fin 3 → ℝ}
    (hG : (g m).PosDef) (σ h : Fin 6) : Valid (incQ g m σ h) := by
  have hs := posDef_symm hG
  have hw := wv_ne σ h
  have ha := posDef_dpos hG hw
  obtain ⟨hx, hy⟩ := bf_pos_of_trip hG hw (trip_ne σ h)
  have hgram := gram_id (g m) hs (wv σ h) (xv σ h) (yv σ h) ha.ne'
  have hdet := hG.det_pos
  have hpos : 0 < (g m).det / (wv σ h ⬝ᵥ (g m *ᵥ wv σ h)) * trip (wv σ h) (xv σ h) (yv σ h) ^ 2 :=
    mul_pos (div_pos hdet ha) (by have := trip_ne σ h; positivity)
  have hP : ∀ X : Fin 3 → ℝ, Pp (wv σ h ⬝ᵥ (g m *ᵥ wv σ h)) (X ⬝ᵥ (g m *ᵥ X))
      ((X - wv σ h) ⬝ᵥ (g m *ᵥ (X - wv σ h))) = bf (g m) (wv σ h) X X := by
    intro X
    have hsym : ∀ a b : Fin 3 → ℝ, a ⬝ᵥ (g m *ᵥ b) = b ⬝ᵥ (g m *ᵥ a) := fun a b => by
      rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hs, dotProduct_comm]
    unfold Pp bf
    simp only [Matrix.mulVec_sub, dotProduct_sub, sub_dotProduct]
    rw [hsym (wv σ h) X]
    have := ha.ne'
    field_simp
    ring
  have hc := cosSq_bf hs (wv σ h) (xv σ h) (yv σ h) ha.ne'
  rw [incQ_eq_vec]
  refine ⟨ha, ?_, ?_, ?_⟩
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, hP]; exact hx
  · simp only [Matrix.cons_val_zero, Matrix.cons_val, hP]; exact hy
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, hc]
    set A := bf (g m) (wv σ h) (xv σ h) (xv σ h)
    set B := bf (g m) (wv σ h) (yv σ h) (yv σ h)
    set C := bf (g m) (wv σ h) (xv σ h) (yv σ h)
    have hAB : 0 < A * B := mul_pos hx hy
    have : (C / √(A * B)) ^ 2 = C ^ 2 / (A * B) := by
      rw [div_pow, Real.sq_sqrt hAB.le]
    rw [this]
    have h1 : C ^ 2 < A * B := by nlinarith
    rw [sub_pos, div_lt_one hAB]
    exact h1

/-- **The Gram star is flat.** For a positive definite `g m`, the dihedral angles of the Gram tetrahedra in each of the seven edge classes add up to `2π`. -/
theorem jet_angle_sum {g : (Fin 3 → ℝ) → Matrix (Fin 3) (Fin 3) ℝ} {m : Fin 3 → ℝ}
    (hG : (g m).PosDef) (k : Fin 7) :
    clsSum (dirs k) (fun σ h => Dsq (incQ g m σ h)) = 2 * π := by
  fin_cases k
  · exact cls0_sum hG
  · exact cls1_sum hG
  · exact cls2_sum hG
  · exact cls3_sum hG
  · exact cls4_sum hG
  · exact cls5_sum hG
  · exact cls6_sum hG

