import Lightlike.Regge.Conv3.JetCore

/-!
# The Gram star of a positive definite chart metric is flat

For a positive definite Gram matrix `G` at a point, the 36 incidences (tetrahedron, hinge) of the
Kuhn triangulation of the cube have admissible squared lengths (`valid_incQ`), and in each of the
seven edge classes the dihedral angles add up to `2π` (`jet_angle_sum`).

For `G = 1` this is the orthoscheme computation of `KuhnCore`. For a general `G` the angles are
not known numbers. Instead, the tetrahedra of one class are fans around the hinge axis `w`. In the
plane quotient (the `G`-orthogonal complement of `w`) a vector `v` has the complex coordinate
`ι v`, with `conj (ι u) * ι v = bf u v + i κ trip w u v`, where `bf` is the Schur-complement form,
`trip` the triple product and `κ² = det G / (w G w)`. The dihedral angle of consecutive vectors of a
positively oriented fan is `arg (conj (ι v_i) * ι v_{i+1})`, the arguments add up to a multiple
of `2π` because the product of the ratios is a positive real, and the bounds `0 < arg < π` fix the
multiple. The seven fans are listed explicitly; the lists are generated by
`scripts/regge/gen_star_angle.py`.

## Main results

* `valid_incQ`: the Gram squared lengths of every incidence are admissible.
* `jet_angle_sum`: the Gram star is flat in each class.
-/

open Matrix Complex Real Lightlike

namespace Lightlike.Regge.Conv3

/-- The scalar triple product `det (w, u, v)`. -/
def trip (w u v : Fin 3 → ℝ) : ℝ :=
  w 0 * (u 1 * v 2 - u 2 * v 1) - w 1 * (u 0 * v 2 - u 2 * v 0) + w 2 * (u 0 * v 1 - u 1 * v 0)

/-- The Schur-complement form of `G` on the quotient by `w`:
`bf w u v = uᵀ G v - (uᵀ G w)(wᵀ G v) / (wᵀ G w)`. -/
noncomputable def bf (G : Matrix (Fin 3) (Fin 3) ℝ) (w u v : Fin 3 → ℝ) : ℝ :=
  u ⬝ᵥ (G *ᵥ v) - (u ⬝ᵥ (G *ᵥ w)) * (w ⬝ᵥ (G *ᵥ v)) / (w ⬝ᵥ (G *ᵥ w))

/-- **Gram identity for the plane quotient.** `bf u u * bf v v - bf u v ^ 2 = det G / (w G w) * trip w u v ^ 2`. -/
theorem gram_id (G : Matrix (Fin 3) (Fin 3) ℝ) (hG : Gᵀ = G) (w u v : Fin 3 → ℝ)
    (ha : w ⬝ᵥ (G *ᵥ w) ≠ 0) :
    bf G w u u * bf G w v v - bf G w u v ^ 2 = G.det / (w ⬝ᵥ (G *ᵥ w)) * trip w u v ^ 2 := by
  have h01 : G 1 0 = G 0 1 := by simpa using congrFun (congrFun hG 0) 1
  have h02 : G 2 0 = G 0 2 := by simpa using congrFun (congrFun hG 0) 2
  have h12 : G 2 1 = G 1 2 := by simpa using congrFun (congrFun hG 1) 2
  unfold bf at *
  simp only [Matrix.det_fin_three, trip, dotProduct, Fin.sum_univ_three, Matrix.mulVec, h01, h02, h12] at *
  field_simp
  ring

/-- Imaginary part of the Plücker-type identity `ζ(u,t) ζ(t,v) = bf t t ζ(u,v)`. -/
theorem pl_im (G : Matrix (Fin 3) (Fin 3) ℝ) (hG : Gᵀ = G) (w u v t : Fin 3 → ℝ)
    (ha : w ⬝ᵥ (G *ᵥ w) ≠ 0) :
    bf G w u t * trip w t v + trip w u t * bf G w t v = bf G w t t * trip w u v := by
  have h01 : G 1 0 = G 0 1 := by simpa using congrFun (congrFun hG 0) 1
  have h02 : G 2 0 = G 0 2 := by simpa using congrFun (congrFun hG 0) 2
  have h12 : G 2 1 = G 1 2 := by simpa using congrFun (congrFun hG 1) 2
  unfold bf at *
  simp only [trip, dotProduct, Fin.sum_univ_three, Matrix.mulVec, h01, h02, h12] at *
  field_simp
  ring

/-- Real part of the Plücker-type identity `ζ(u,t) ζ(t,v) = bf t t ζ(u,v)`. -/
theorem pl_re (G : Matrix (Fin 3) (Fin 3) ℝ) (hG : Gᵀ = G) (w u v t : Fin 3 → ℝ)
    (ha : w ⬝ᵥ (G *ᵥ w) ≠ 0) :
    bf G w u t * bf G w t v - G.det / (w ⬝ᵥ (G *ᵥ w)) * (trip w u t * trip w t v)
      = bf G w t t * bf G w u v := by
  have h01 : G 1 0 = G 0 1 := by simpa using congrFun (congrFun hG 0) 1
  have h02 : G 2 0 = G 0 2 := by simpa using congrFun (congrFun hG 0) 2
  have h12 : G 2 1 = G 1 2 := by simpa using congrFun (congrFun hG 1) 2
  unfold bf at *
  simp only [Matrix.det_fin_three, trip, dotProduct, Fin.sum_univ_three, Matrix.mulVec, h01, h02, h12] at *
  field_simp
  ring


/-- A positive definite matrix has positive quadratic form on a nonzero vector. -/
theorem posDef_dpos {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {x : Fin 3 → ℝ} (hx : x ≠ 0) :
    0 < x ⬝ᵥ (G *ᵥ x) := by
  simpa using hG.dotProduct_mulVec_pos hx

/-- A positive definite real matrix is symmetric. -/
theorem posDef_symm {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) : Gᵀ = G := by
  simpa using hG.isHermitian.eq

/-- `bf` is nonnegative on the diagonal: it is a value of `G` on a vector. -/
theorem bf_diag_nonneg {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    (u : Fin 3 → ℝ) : 0 ≤ bf G w u u := by
  have ha := posDef_dpos hG hw
  have hs := posDef_symm hG
  set c := (u ⬝ᵥ (G *ᵥ w)) / (w ⬝ᵥ (G *ᵥ w)) with hc
  have h1 : 0 ≤ (u - c • w) ⬝ᵥ (G *ᵥ (u - c • w)) := by
    by_cases h0 : u - c • w = 0
    · rw [h0, Matrix.mulVec_zero, dotProduct_zero]
    · exact (posDef_dpos hG h0).le
  have h01 : G 1 0 = G 0 1 := by simpa using congrFun (congrFun hs 0) 1
  have h02 : G 2 0 = G 0 2 := by simpa using congrFun (congrFun hs 0) 2
  have h12 : G 2 1 = G 1 2 := by simpa using congrFun (congrFun hs 1) 2
  have ha' := ha.ne'
  have hsym : w ⬝ᵥ (G *ᵥ u) = u ⬝ᵥ (G *ᵥ w) := by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hs, dotProduct_comm]
  have e : (u - c • w) ⬝ᵥ (G *ᵥ (u - c • w)) = bf G w u u := by
    unfold bf
    simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, sub_dotProduct,
      dotProduct_smul, smul_dotProduct, smul_eq_mul, hsym]
    rw [hc]
    field_simp
    ring
  linarith

/-- `bf` is symmetric in its last two arguments. -/
theorem bf_comm {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : Gᵀ = G) (w u v : Fin 3 → ℝ) :
    bf G w u v = bf G w v u := by
  have hsym : ∀ a b : Fin 3 → ℝ, a ⬝ᵥ (G *ᵥ b) = b ⬝ᵥ (G *ᵥ a) := fun a b => by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hG, dotProduct_comm]
  unfold bf
  rw [hsym u v, hsym u w, hsym w v]; ring

/-- The triple product is antisymmetric in its last two arguments. -/
theorem trip_antisym (w u v : Fin 3 → ℝ) : trip w u v = - trip w v u := by
  simp only [trip]; ring

/-- The complex number `bf w u v + i κ trip w u v`, with `κ = √(det G / wᵀ G w)`. -/
noncomputable def zeta (G : Matrix (Fin 3) (Fin 3) ℝ) (w u v : Fin 3 → ℝ) : ℂ :=
  ⟨bf G w u v, √(G.det / (w ⬝ᵥ (G *ᵥ w))) * trip w u v⟩

/-- The squared norm of `zeta u v` is `bf u u * bf v v`. -/
theorem zeta_normSq {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    (u v : Fin 3 → ℝ) : Complex.normSq (zeta G w u v) = bf G w u u * bf G w v v := by
  have ha := posDef_dpos hG hw
  have hd := hG.det_pos
  have hk : √(G.det / (w ⬝ᵥ (G *ᵥ w))) ^ 2 = G.det / (w ⬝ᵥ (G *ᵥ w)) :=
    Real.sq_sqrt (div_pos hd ha).le
  have := gram_id G (posDef_symm hG) w u v ha.ne'
  rw [Complex.normSq_apply]
  simp only [zeta]
  nlinarith [hk, this]

/-- If `w, u, v` are linearly independent, `bf u u` and `bf v v` are positive. -/
theorem bf_pos_of_trip {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    {u v : Fin 3 → ℝ} (h : trip w u v ≠ 0) : 0 < bf G w u u ∧ 0 < bf G w v v := by
  have ha := posDef_dpos hG hw
  have hd := hG.det_pos
  have g := gram_id G (posDef_symm hG) w u v ha.ne'
  have hp : 0 < bf G w u u * bf G w v v := by
    have : 0 < G.det / (w ⬝ᵥ (G *ᵥ w)) * trip w u v ^ 2 :=
      mul_pos (div_pos hd ha) (by positivity)
    nlinarith [sq_nonneg (bf G w u v)]
  have h1 := bf_diag_nonneg hG hw u
  have h2 := bf_diag_nonneg hG hw v
  exact ⟨lt_of_le_of_ne h1 (fun e => by rw [← e] at hp; simp at hp),
    lt_of_le_of_ne h2 (fun e => by rw [← e] at hp; simp at hp)⟩

/-- The dihedral angle is the argument of `zeta`. -/
theorem arccos_eq_arg {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    {x y : Fin 3 → ℝ} (h : 0 < trip w x y) :
    arccos (bf G w x y / √(bf G w x x * bf G w y y)) = arg (zeta G w x y) := by
  have hd := hG.det_pos
  have ha := posDef_dpos hG hw
  have him : 0 ≤ (zeta G w x y).im := by
    simp only [zeta]; exact mul_nonneg (Real.sqrt_nonneg _) h.le
  have hne : zeta G w x y ≠ 0 := by
    intro e
    have := congrArg Complex.im e
    simp only [zeta, Complex.zero_im] at this
    have hk : 0 < √(G.det / (w ⬝ᵥ (G *ᵥ w))) := Real.sqrt_pos.2 (div_pos hd ha)
    exact (mul_pos hk h).ne' this
  rw [Complex.arg_of_im_nonneg_of_ne_zero him hne]
  have : ‖zeta G w x y‖ = √(bf G w x x * bf G w y y) := by
    rw [Complex.norm_def, zeta_normSq hG hw]
  rw [this]; rfl

/-- The Plücker-type identity `ζ(u,t) ζ(t,v) = bf t t ζ(u,v)` for the complex numbers `zeta`. -/
theorem zeta_mul {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    (u t v : Fin 3 → ℝ) :
    zeta G w u t * zeta G w t v = (bf G w t t : ℂ) * zeta G w u v := by
  have ha := posDef_dpos hG hw
  have hd := hG.det_pos
  have hs := posDef_symm hG
  have hk : √(G.det / (w ⬝ᵥ (G *ᵥ w))) ^ 2 = G.det / (w ⬝ᵥ (G *ᵥ w)) :=
    Real.sq_sqrt (div_pos hd ha).le
  have r := pl_re G hs w u v t ha.ne'
  have i := pl_im G hs w u v t ha.ne'
  apply Complex.ext
  · simp only [zeta, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
    linear_combination r - (trip w u t * trip w t v) * hk
  · simp only [zeta, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
    linear_combination (√(G.det / (w ⬝ᵥ (G *ᵥ w)))) * i

/-- The complex coordinate of `v` in the plane quotient, with `t` on the real axis. -/
noncomputable def iota (G : Matrix (Fin 3) (Fin 3) ℝ) (w t v : Fin 3 → ℝ) : ℂ :=
  zeta G w t v / (√(bf G w t t) : ℝ)

/-- `conj (ι u) * ι v = ζ(u,v)`: the complex coordinates realise the quotient inner product and the orientation. -/
theorem conj_iota_mul {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    {t : Fin 3 → ℝ} (ht : 0 < bf G w t t) (u v : Fin 3 → ℝ) :
    starRingEnd ℂ (iota G w t u) * iota G w t v = zeta G w u v := by
  have hs := posDef_symm hG
  have hconj : starRingEnd ℂ (zeta G w t u) = zeta G w u t := by
    apply Complex.ext
    · simp [zeta, bf_comm hs w t u]
    · simp [zeta, trip_antisym w u t]
  have h2 : ((√(bf G w t t) : ℝ) : ℂ) ^ 2 = (bf G w t t : ℂ) := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt ht.le]
  have hs0 : ((√(bf G w t t) : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.2 ht).ne'
  have hb0 : (bf G w t t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  unfold iota
  rw [map_div₀, hconj, Complex.conj_ofReal]
  rw [div_mul_div_comm, zeta_mul hG hw, ← sq, h2]
  field_simp


/-- The arguments of consecutive products `conj z_i * z_{i+1}` add up to the argument of `conj z_0 * z_n`, modulo `2π`. -/
theorem fan_angle {n : ℕ} (z : ℕ → ℂ) (hz : ∀ i ≤ n, z i ≠ 0)
    (him : ∀ i < n, 0 < (starRingEnd ℂ (z i) * z (i + 1)).im) :
    ∃ k : ℤ, ∑ i ∈ Finset.range n, arg (starRingEnd ℂ (z i) * z (i + 1))
      = arg (starRingEnd ℂ (z 0) * z n) + 2 * π * k := by
  induction n with
  | zero =>
    refine ⟨0, ?_⟩
    have h0 : z 0 ≠ 0 := hz 0 le_rfl
    have : starRingEnd ℂ (z 0) * z 0 = ((Complex.normSq (z 0) : ℝ) : ℂ) := by
      rw [Complex.normSq_eq_conj_mul_self]
    rw [this, Complex.arg_ofReal_of_nonneg (Complex.normSq_nonneg _)]
    simp
  | succ n ih =>
    obtain ⟨k, hk⟩ := ih (fun i hi => hz i (by omega)) (fun i hi => him i (by omega))
    have h0 : z 0 ≠ 0 := hz 0 (by omega)
    have hn : z n ≠ 0 := hz n (by omega)
    have hn1 : z (n + 1) ≠ 0 := hz (n + 1) le_rfl
    have hprod : starRingEnd ℂ (z 0) * z n * (starRingEnd ℂ (z n) * z (n + 1))
        = ((Complex.normSq (z n) : ℝ) : ℂ) * (starRingEnd ℂ (z 0) * z (n + 1)) := by
      rw [Complex.normSq_eq_conj_mul_self]; ring
    have hang : ((arg (starRingEnd ℂ (z 0) * z n) : ℝ) : Real.Angle)
        + ((arg (starRingEnd ℂ (z n) * z (n + 1)) : ℝ) : Real.Angle)
        = ((arg (starRingEnd ℂ (z 0) * z (n + 1)) : ℝ) : Real.Angle) := by
      rw [← Complex.arg_mul_coe_angle (by simp [h0, hn]) (by simp [hn, hn1]), hprod,
        Complex.arg_real_mul _ (Complex.normSq_pos.2 hn)]
    have hdiff : ((∑ i ∈ Finset.range (n + 1), arg (starRingEnd ℂ (z i) * z (i + 1)) : ℝ) : Real.Angle)
        = ((arg (starRingEnd ℂ (z 0) * z (n + 1)) : ℝ) : Real.Angle) := by
      rw [Finset.sum_range_succ, hk, Real.Angle.coe_add, ← hang]
      have : ((2 * π * k : ℝ) : Real.Angle) = 0 := by
        rw [show (2 * π * k : ℝ) = (k : ℤ) • (2 * π) by simp [mul_comm, mul_assoc]]
        rw [Real.Angle.coe_zsmul, Real.Angle.coe_two_pi, smul_zero]
      rw [Real.Angle.coe_add, this]; simp [add_assoc]
    obtain ⟨m, hm⟩ := (Real.Angle.angle_eq_iff_two_pi_dvd_sub).1 hdiff
    refine ⟨m, ?_⟩
    push_cast at hm ⊢
    linarith

/-- A complex number with positive imaginary part has argument in `(0, π)`. -/
theorem arg_pos_of_im {w : ℂ} (h : 0 < w.im) : 0 < arg w ∧ arg w < π :=
  ⟨lt_of_le_of_ne (Complex.arg_nonneg_iff.2 h.le) (fun h0 => by
      have := Complex.arg_eq_zero_iff.1 h0.symm
      linarith [this.2]), Complex.arg_lt_pi_iff.2 (Or.inr h.ne')⟩

/-- Four positively oriented steps that return to the start add up to `2π`. -/
theorem fan_two_pi_quad (z : ℕ → ℂ) (hz : ∀ i ≤ 4, z i ≠ 0)
    (him : ∀ i < 4, 0 < (starRingEnd ℂ (z i) * z (i + 1)).im) (hc : z 4 = z 0) :
    ∑ i ∈ Finset.range 4, arg (starRingEnd ℂ (z i) * z (i + 1)) = 2 * π := by
  obtain ⟨k, hk⟩ := fan_angle z hz him
  have h0 : starRingEnd ℂ (z 0) * z 4 = ((Complex.normSq (z 0) : ℝ) : ℂ) := by
    rw [hc, Complex.normSq_eq_conj_mul_self]
  rw [h0, Complex.arg_ofReal_of_nonneg (Complex.normSq_nonneg _)] at hk
  have hb : ∀ i < 4, 0 < arg (starRingEnd ℂ (z i) * z (i + 1)) ∧
      arg (starRingEnd ℂ (z i) * z (i + 1)) < π := fun i hi => arg_pos_of_im (him i hi)
  have b0 := hb 0 (by norm_num); have b1 := hb 1 (by norm_num)
  have b2 := hb 2 (by norm_num); have b3 := hb 3 (by norm_num)
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at hk ⊢
  have hpi := Real.pi_pos
  have k1 : (0 : ℝ) < k ∧ (k : ℝ) < 2 := by
    constructor <;> nlinarith [b0.1, b1.1, b2.1, b3.1, b0.2, b1.2, b2.2, b3.2]
  have : k = 1 := by
    have h1 : (0 : ℤ) < k := by exact_mod_cast k1.1
    have h2 : k < 2 := by exact_mod_cast k1.2
    omega
  subst this
  push_cast at hk
  linarith

/-- Three positively oriented steps from `z 0` to a negative multiple of `z 0` add up to `π`. -/
theorem fan_pi_three (z : ℕ → ℂ) (hz : ∀ i ≤ 3, z i ≠ 0)
    (him : ∀ i < 3, 0 < (starRingEnd ℂ (z i) * z (i + 1)).im) {c : ℝ} (hc : 0 < c)
    (h3 : z 3 = -(c : ℂ) * z 0) :
    ∑ i ∈ Finset.range 3, arg (starRingEnd ℂ (z i) * z (i + 1)) = π := by
  obtain ⟨k, hk⟩ := fan_angle z hz him
  have h0 : starRingEnd ℂ (z 0) * z 3 = ((-(c * Complex.normSq (z 0)) : ℝ) : ℂ) := by
    rw [h3]; push_cast; rw [Complex.normSq_eq_conj_mul_self]; ring
  have hz0 : 0 < c * Complex.normSq (z 0) := mul_pos hc (Complex.normSq_pos.2 (hz 0 (by norm_num)))
  rw [h0, Complex.arg_ofReal_of_neg (by linarith)] at hk
  have hb : ∀ i < 3, 0 < arg (starRingEnd ℂ (z i) * z (i + 1)) ∧
      arg (starRingEnd ℂ (z i) * z (i + 1)) < π := fun i hi => arg_pos_of_im (him i hi)
  have b0 := hb 0 (by norm_num); have b1 := hb 1 (by norm_num); have b2 := hb 2 (by norm_num)
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at hk ⊢
  have hpi := Real.pi_pos
  have k1 : (-1 : ℝ) < k ∧ (k : ℝ) < 1 := by
    constructor <;> nlinarith [b0.1, b1.1, b2.1, b0.2, b1.2, b2.2]
  have : k = 0 := by
    have h1 : (-1 : ℤ) < k := by exact_mod_cast k1.1
    have h2 : k < 1 := by exact_mod_cast k1.2
    omega
  subst this
  push_cast at hk
  linarith

/-- Adding a multiple of the axis `w` does not change the complex coordinate. -/
theorem iota_lin_w {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    (t : Fin 3 → ℝ) (c : ℝ) (v : Fin 3 → ℝ) :
    iota G w t (v + c • w) = iota G w t v := by
  have ha := posDef_dpos hG hw
  have hs := posDef_symm hG
  have hsym : ∀ a b : Fin 3 → ℝ, a ⬝ᵥ (G *ᵥ b) = b ⬝ᵥ (G *ᵥ a) := fun a b => by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hs, dotProduct_comm]
  have e1 : bf G w t (v + c • w) = bf G w t v := by
    unfold bf
    simp only [Matrix.mulVec_add, Matrix.mulVec_smul, dotProduct_add, dotProduct_smul, smul_eq_mul,
      add_dotProduct, smul_dotProduct]
    rw [hsym w w]
    field_simp
    ring
  have e2 : trip w t (v + c • w) = trip w t v := by simp only [trip, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
  unfold iota zeta
  rw [e1, e2]

/-- The complex coordinate is odd. -/
theorem iota_neg {G : Matrix (Fin 3) (Fin 3) ℝ} (t v : Fin 3 → ℝ) :
    iota G w t (-v) = - iota G w t v := by
  have e1 : bf G w t (-v) = - bf G w t v := by
    unfold bf; simp [dotProduct_neg, Matrix.mulVec_neg, neg_dotProduct]; ring
  have e2 : trip w t (-v) = - trip w t v := by simp only [trip, Pi.neg_apply]; ring
  unfold iota zeta
  rw [e1, e2]
  apply Complex.ext <;> simp [Complex.div_re, Complex.div_im] <;> ring

/-- The angle between the quotient vectors of `x` and `y` modulo the axis `w`. -/
noncomputable def fanAng (G : Matrix (Fin 3) (Fin 3) ℝ) (w x y : Fin 3 → ℝ) : ℝ :=
  arccos (bf G w x y / √(bf G w x x * bf G w y y))

/-- The complex coordinate of a vector independent of the axis is nonzero. -/
theorem iota_ne {G : Matrix (Fin 3) (Fin 3) ℝ} (hG : G.PosDef) {w : Fin 3 → ℝ} (hw : w ≠ 0)
    {t v : Fin 3 → ℝ} (ht : 0 < bf G w t t) (hv : 0 < bf G w v v) : iota G w t v ≠ 0 := by
  intro e
