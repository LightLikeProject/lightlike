    have kq : (fun i => kpos 2 1 (hQ 1) i) = ![(1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
