/-- **The displaced Kuhn star around an edge of class 3 has dihedral angle sum `2π`.** -/
theorem cls3_disp (hg : IsRiemMetric g U) (hm : m ∈ U) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), clsSum (dirs 3) (fun σ h => Dsq (dispLen g m ε σ h)) = 2 * π := by
  have hG := hg.posDef m hm
  have hs := posDef_symm hG
  have hw : (![(1 : ℝ), (1 : ℝ), (0 : ℝ)] : Fin 3 → ℝ) ≠ 0 := by
    intro e; have := congrFun e 0; have := congrFun e 1; have := congrFun e 2; simp_all
  set wE : ℝ → Fin 3 → ℝ := fun ε => Pdisp g m ε ![(1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] with hwE
  set xs : ℕ → ℝ → Fin 3 → ℝ := fun i ε =>
    Pdisp g m ε (([![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)], ![(1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)], ![(-1/2 : ℝ), (-1/2 : ℝ), (-1 : ℝ)], ![(-1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)], ![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] with hxsd
  have hxs0 : ∀ ε : ℝ, xs 0 ε = Pdisp g m ε ![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs1 : ∀ ε : ℝ, xs 1 ε = Pdisp g m ε ![(1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs2 : ∀ ε : ℝ, xs 2 ε = Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (-1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs3 : ∀ ε : ℝ, xs 3 ε = Pdisp g m ε ![(-1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs4 : ∀ ε : ℝ, xs 4 ε = Pdisp g m ε ![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxsall : ∀ i ε, xs i ε = Pdisp g m ε (([![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)], ![(1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)], ![(-1/2 : ℝ), (-1/2 : ℝ), (-1 : ℝ)], ![(-1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)], ![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) - Pdisp g m ε ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] :=
    fun _ _ => rfl
  have hwc : Continuous wE := (continuous_Pdisp _).sub (continuous_Pdisp _)
  have hxc : ∀ i, Continuous (xs i) := fun i => (continuous_Pdisp _).sub (continuous_Pdisp _)
  have hw0e : wE 0 = ![(1 : ℝ), (1 : ℝ), (0 : ℝ)] := by
    ext i; fin_cases i <;> simp [wE, Pdisp_zero] <;> norm_num
  have hx0 : ∀ i ≤ 4, xs i 0 = (([![(1 : ℝ), (1 : ℝ), (1 : ℝ)], ![(1 : ℝ), (0 : ℝ), (0 : ℝ)], ![(0 : ℝ), (0 : ℝ), (-1 : ℝ)], ![(0 : ℝ), (1 : ℝ), (0 : ℝ)], ![(1 : ℝ), (1 : ℝ), (1 : ℝ)]] : List (Fin 3 → ℝ))).getD i 0 := by
    intro i hi
    interval_cases i <;> (rw [hxsall, Pdisp_zero, Pdisp_zero]; ext j; fin_cases j <;> simp <;> norm_num)
  have hpos0 : ∀ i < 4, 0 < trip (wE 0) (xs i 0) (xs (i + 1) 0) := by
    intro i hi
    rw [hw0e, hx0 i (by omega), hx0 (i + 1) (by omega)]
    interval_cases i <;> simp [trip] <;> norm_num
  have hclose : ∀ ε, xs 4 ε = xs 0 ε := fun ε => by simp [xs]
  have H := quad_fan hG hw (fun i : ℕ => ([![(1 : ℝ), (1 : ℝ), (1 : ℝ)], ![(1 : ℝ), (0 : ℝ), (0 : ℝ)], ![(0 : ℝ), (0 : ℝ), (-1 : ℝ)], ![(0 : ℝ), (1 : ℝ), (0 : ℝ)], ![(1 : ℝ), (1 : ℝ), (1 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) (by intro i hi; interval_cases i <;> simp [trip] <;> norm_num) ⟨(0:ℝ), by ext i; fin_cases i <;> simp <;> norm_num⟩
  have hS0 : ∑ i ∈ Finset.range 4, fanAng (g m) (wE 0) (xs i 0) (xs (i + 1) 0) = 2 * π := by
    rw [← H]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi' := Finset.mem_range.1 hi
    rw [hw0e, hx0 i (by omega), hx0 (i + 1) (by omega)]
  have hpin := closed_class_pin hG (by norm_num : 0 < 4) wE xs hwc hxc (by rw [hw0e]; exact hw)
    hpos0 hclose hS0
  have hWev : ∀ᶠ ε in 𝓝 (0 : ℝ), wE ε ≠ 0 :=
    hwc.continuousAt.eventually_ne (by rw [hw0e]; exact hw)
  filter_upwards [hpin, hWev] with ε hε hWε
  rw [cls3_expand]
  simp only [dispLen_eq_lens3 hg.coord hm]
  have m0 : Dsq (lens3 (g m) (dvec g m ε 0 1 (hP 1) (hQ 1)) (dvec g m ε 0 1 (hP 1) (hR 1))
      (dvec g m ε 0 1 (hP 1) (hS 1))) = fanAng (g m) (wE ε) (xs 0 ε) (xs 1 ε) := by
    have kp : (fun i => kpos 0 1 (hP 1) i) = ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 0 1 (hQ 1) i) = ![(1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 0 1 (hR 1) i) = ![(1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 0 1 (hS 1) i) = ![(1/2 : ℝ), (1/2 : ℝ), (1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 0 1 (hP 1) (hQ 1) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 0 1 (hP 1) (hR 1) = xs 1 ε := by
      simp only [dvec, xs, kp, kr, hxs1]
    have d3 : dvec g m ε 0 1 (hP 1) (hS 1) = xs 0 ε := by
      simp only [dvec, xs, kp, ks, hxs0]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
    exact fanAng_swap hs _ _ _
  have m1 : Dsq (lens3 (g m) (dvec g m ε 3 4 (hP 4) (hQ 4)) (dvec g m ε 3 4 (hP 4) (hR 4))
      (dvec g m ε 3 4 (hP 4) (hS 4))) = fanAng (g m) (wE ε) (xs 1 ε) (xs 2 ε) := by
    have kp : (fun i => kpos 3 4 (hP 4) i) = ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 3 4 (hQ 4) i) = ![(1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 3 4 (hR 4) i) = ![(-1/2 : ℝ), (-1/2 : ℝ), (-1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 3 4 (hS 4) i) = ![(1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 3 4 (hP 4) (hQ 4) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 3 4 (hP 4) (hR 4) = xs 2 ε := by
      simp only [dvec, xs, kp, kr, hxs2]
    have d3 : dvec g m ε 3 4 (hP 4) (hS 4) = xs 1 ε := by
      simp only [dvec, xs, kp, ks, hxs1]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
    exact fanAng_swap hs _ _ _
  have m2 : Dsq (lens3 (g m) (dvec g m ε 5 4 (hP 4) (hQ 4)) (dvec g m ε 5 4 (hP 4) (hR 4))
      (dvec g m ε 5 4 (hP 4) (hS 4))) = fanAng (g m) (wE ε) (xs 2 ε) (xs 3 ε) := by
    have kp : (fun i => kpos 5 4 (hP 4) i) = ![(-1/2 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 5 4 (hQ 4) i) = ![(1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 5 4 (hR 4) i) = ![(-1/2 : ℝ), (-1/2 : ℝ), (-1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 5 4 (hS 4) i) = ![(-1/2 : ℝ), (1/2 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 5 4 (hP 4) (hQ 4) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 5 4 (hP 4) (hR 4) = xs 2 ε := by
      simp only [dvec, xs, kp, kr, hxs2]
    have d3 : dvec g m ε 5 4 (hP 4) (hS 4) = xs 3 ε := by
      simp only [dvec, xs, kp, ks, hxs3]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
  have m3 : Dsq (lens3 (g m) (dvec g m ε 2 1 (hP 1) (hQ 1)) (dvec g m ε 2 1 (hP 1) (hR 1))
      (dvec g m ε 2 1 (hP 1) (hS 1))) = fanAng (g m) (wE ε) (xs 3 ε) (xs 4 ε) := by
