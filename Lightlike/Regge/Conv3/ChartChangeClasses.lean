    have kr : (fun i => kpos 1 2 (hR 2) i) = ![(1/2 : ℝ), (-1/2 : ℝ), (-1/2 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 1 2 (hS 2) i) = ![(1/2 : ℝ), (-1/2 : ℝ), (1/2 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 1 2 (hP 2) (hQ 2) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 1 2 (hP 2) (hR 2) = xs 6 ε := by
      simp only [dvec, xs, kp, kr, hxs6]
    have d3 : dvec g m ε 1 2 (hP 2) (hS 2) = xs 5 ε := by
      simp only [dvec, xs, kp, ks, hxs5]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
    exact fanAng_swap hs _ _ _
  rw [m0, m1, m2, m3, m4, m5]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add] at hε
  simpa using hε

end Lightlike.Regge.Conv3
