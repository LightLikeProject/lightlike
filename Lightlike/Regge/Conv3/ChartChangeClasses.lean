import Lightlike.Regge.Conv3.ClassPin
import Lightlike.Regge.Conv3.StarAngle

/-!
# The edge classes of the displaced Kuhn star are closed fans

For a Riemannian metric `g` on `U` and a point `m ∈ U`, displace every point `k` of the Kuhn star around
a hinge to `k + (ε/2) Γ(k, k)` (`Pdisp`). In each of the seven edge classes the dihedral angles of the
displaced tetrahedra (`Dsq (dispLen g m ε σ h)`) add up to `2π` for all small `ε`: the tetrahedra form a
closed fan around the displaced hinge axis, which is positively oriented at `ε = 0`, and the sum is `2π`
there (`closed_class_pin`). The statements `cls0_disp, …, cls6_disp` are generated by
`scripts/regge/gen_chart_change.py`.

**Limits.** Local in `ε` (a neighbourhood of `0`, no explicit radius); the point `m` and the Christoffel
symbols are those of the single metric `g`; the Kuhn triangulation is the standard cubical one.
-/

open Real Matrix Lightlike Filter Topology
namespace Lightlike.Regge.Conv3
open Lightlike.Geodesic

variable {g : (Fin 3 → ℝ) → Matrix (Fin 3) (Fin 3) ℝ} {m : Fin 3 → ℝ} {U : Set (Fin 3 → ℝ)}

/-- The displaced position is continuous in `ε`. -/
theorem continuous_Pdisp (k : Fin 3 → ℝ) : Continuous (fun ε : ℝ => Pdisp g m ε k) := by
  unfold Pdisp
  exact continuous_const.add ((continuous_id.div_const 2).smul continuous_const)

/-- Without displacement the position is unchanged. -/
theorem Pdisp_zero (k : Fin 3 → ℝ) : Pdisp g m 0 k = k := by simp [Pdisp]


/-- **The displaced Kuhn star around an edge of class 0 has dihedral angle sum `2π`.** -/
theorem cls0_disp (hg : IsRiemMetric g U) (hm : m ∈ U) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), clsSum (dirs 0) (fun σ h => Dsq (dispLen g m ε σ h)) = 2 * π := by
  have hG := hg.posDef m hm
  have hs := posDef_symm hG
  have hw : (![(1 : ℝ), (0 : ℝ), (0 : ℝ)] : Fin 3 → ℝ) ≠ 0 := by
    intro e; have := congrFun e 0; have := congrFun e 1; have := congrFun e 2; simp_all
  set wE : ℝ → Fin 3 → ℝ := fun ε => Pdisp g m ε ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] with hwE
  set xs : ℕ → ℝ → Fin 3 → ℝ := fun i ε =>
    Pdisp g m ε (([![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)], ![(1/2 : ℝ), (1 : ℝ), (1 : ℝ)], ![(1/2 : ℝ), (0 : ℝ), (1 : ℝ)], ![(-1/2 : ℝ), (-1 : ℝ), (0 : ℝ)], ![(-1/2 : ℝ), (-1 : ℝ), (-1 : ℝ)], ![(-1/2 : ℝ), (0 : ℝ), (-1 : ℝ)], ![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] with hxsd
  have hxs0 : ∀ ε : ℝ, xs 0 ε = Pdisp g m ε ![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs1 : ∀ ε : ℝ, xs 1 ε = Pdisp g m ε ![(1/2 : ℝ), (1 : ℝ), (1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs2 : ∀ ε : ℝ, xs 2 ε = Pdisp g m ε ![(1/2 : ℝ), (0 : ℝ), (1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs3 : ∀ ε : ℝ, xs 3 ε = Pdisp g m ε ![(-1/2 : ℝ), (-1 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs4 : ∀ ε : ℝ, xs 4 ε = Pdisp g m ε ![(-1/2 : ℝ), (-1 : ℝ), (-1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs5 : ∀ ε : ℝ, xs 5 ε = Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (-1 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs6 : ∀ ε : ℝ, xs 6 ε = Pdisp g m ε ![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxsall : ∀ i ε, xs i ε = Pdisp g m ε (([![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)], ![(1/2 : ℝ), (1 : ℝ), (1 : ℝ)], ![(1/2 : ℝ), (0 : ℝ), (1 : ℝ)], ![(-1/2 : ℝ), (-1 : ℝ), (0 : ℝ)], ![(-1/2 : ℝ), (-1 : ℝ), (-1 : ℝ)], ![(-1/2 : ℝ), (0 : ℝ), (-1 : ℝ)], ![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] :=
    fun _ _ => rfl
  have hwc : Continuous wE := (continuous_Pdisp _).sub (continuous_Pdisp _)
  have hxc : ∀ i, Continuous (xs i) := fun i => (continuous_Pdisp _).sub (continuous_Pdisp _)
  have hw0e : wE 0 = ![(1 : ℝ), (0 : ℝ), (0 : ℝ)] := by
    ext i; fin_cases i <;> simp [wE, Pdisp_zero] <;> norm_num
  have hx0 : ∀ i ≤ 6, xs i 0 = (([![(1 : ℝ), (1 : ℝ), (0 : ℝ)], ![(1 : ℝ), (1 : ℝ), (1 : ℝ)], ![(1 : ℝ), (0 : ℝ), (1 : ℝ)], ![(0 : ℝ), (-1 : ℝ), (0 : ℝ)], ![(0 : ℝ), (-1 : ℝ), (-1 : ℝ)], ![(0 : ℝ), (0 : ℝ), (-1 : ℝ)], ![(1 : ℝ), (1 : ℝ), (0 : ℝ)]] : List (Fin 3 → ℝ))).getD i 0 := by
    intro i hi
    interval_cases i <;> (rw [hxsall, Pdisp_zero, Pdisp_zero]; ext j; fin_cases j <;> simp <;> norm_num)
  have hpos0 : ∀ i < 6, 0 < trip (wE 0) (xs i 0) (xs (i + 1) 0) := by
    intro i hi
    rw [hw0e, hx0 i (by omega), hx0 (i + 1) (by omega)]
    interval_cases i <;> simp [trip] <;> norm_num
  have hclose : ∀ ε, xs 6 ε = xs 0 ε := fun ε => by simp [xs]
  have H := hex_fan hG hw (fun i : ℕ => ([![(1 : ℝ), (1 : ℝ), (0 : ℝ)], ![(1 : ℝ), (1 : ℝ), (1 : ℝ)], ![(1 : ℝ), (0 : ℝ), (1 : ℝ)], ![(0 : ℝ), (-1 : ℝ), (0 : ℝ)], ![(0 : ℝ), (-1 : ℝ), (-1 : ℝ)], ![(0 : ℝ), (0 : ℝ), (-1 : ℝ)], ![(1 : ℝ), (1 : ℝ), (0 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) (by intro i hi; interval_cases i <;> simp [trip] <;> norm_num) ⟨(1:ℝ), by ext i; fin_cases i <;> simp <;> norm_num⟩ ⟨(1:ℝ), by ext i; fin_cases i <;> simp <;> norm_num⟩
  have hS0 : ∑ i ∈ Finset.range 6, fanAng (g m) (wE 0) (xs i 0) (xs (i + 1) 0) = 2 * π := by
    rw [← H]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi' := Finset.mem_range.1 hi
    rw [hw0e, hx0 i (by omega), hx0 (i + 1) (by omega)]
  have hpin := closed_class_pin hG (by norm_num : 0 < 6) wE xs hwc hxc (by rw [hw0e]; exact hw)
    hpos0 hclose hS0
  have hWev : ∀ᶠ ε in 𝓝 (0 : ℝ), wE ε ≠ 0 :=
    hwc.continuousAt.eventually_ne (by rw [hw0e]; exact hw)
  filter_upwards [hpin, hWev] with ε hε hWε
  rw [cls0_expand]
  simp only [dispLen_eq_lens3 hg.coord hm]
  have m0 : Dsq (lens3 (g m) (dvec g m ε 0 0 (hP 0) (hQ 0)) (dvec g m ε 0 0 (hP 0) (hR 0))
      (dvec g m ε 0 0 (hP 0) (hS 0))) = fanAng (g m) (wE ε) (xs 0 ε) (xs 1 ε) := by
    have kp : (fun i => kpos 0 0 (hP 0) i) = ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 0 0 (hQ 0) i) = ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 0 0 (hR 0) i) = ![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 0 0 (hS 0) i) = ![(1/2 : ℝ), (1 : ℝ), (1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 0 0 (hP 0) (hQ 0) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 0 0 (hP 0) (hR 0) = xs 0 ε := by
      simp only [dvec, xs, kp, kr, hxs0]
    have d3 : dvec g m ε 0 0 (hP 0) (hS 0) = xs 1 ε := by
      simp only [dvec, xs, kp, ks, hxs1]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
  have m1 : Dsq (lens3 (g m) (dvec g m ε 1 0 (hP 0) (hQ 0)) (dvec g m ε 1 0 (hP 0) (hR 0))
      (dvec g m ε 1 0 (hP 0) (hS 0))) = fanAng (g m) (wE ε) (xs 1 ε) (xs 2 ε) := by
    have kp : (fun i => kpos 1 0 (hP 0) i) = ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 1 0 (hQ 0) i) = ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 1 0 (hR 0) i) = ![(1/2 : ℝ), (0 : ℝ), (1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 1 0 (hS 0) i) = ![(1/2 : ℝ), (1 : ℝ), (1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 1 0 (hP 0) (hQ 0) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 1 0 (hP 0) (hR 0) = xs 2 ε := by
      simp only [dvec, xs, kp, kr, hxs2]
    have d3 : dvec g m ε 1 0 (hP 0) (hS 0) = xs 1 ε := by
      simp only [dvec, xs, kp, ks, hxs1]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
    exact fanAng_swap hs _ _ _
  have m2 : Dsq (lens3 (g m) (dvec g m ε 2 3 (hP 3) (hQ 3)) (dvec g m ε 2 3 (hP 3) (hR 3))
      (dvec g m ε 2 3 (hP 3) (hS 3))) = fanAng (g m) (wE ε) (xs 2 ε) (xs 3 ε) := by
    have kp : (fun i => kpos 2 3 (hP 3) i) = ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 2 3 (hQ 3) i) = ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 2 3 (hR 3) i) = ![(-1/2 : ℝ), (-1 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 2 3 (hS 3) i) = ![(1/2 : ℝ), (0 : ℝ), (1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 2 3 (hP 3) (hQ 3) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 2 3 (hP 3) (hR 3) = xs 3 ε := by
      simp only [dvec, xs, kp, kr, hxs3]
    have d3 : dvec g m ε 2 3 (hP 3) (hS 3) = xs 2 ε := by
      simp only [dvec, xs, kp, ks, hxs2]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
    exact fanAng_swap hs _ _ _
  have m3 : Dsq (lens3 (g m) (dvec g m ε 5 5 (hP 5) (hQ 5)) (dvec g m ε 5 5 (hP 5) (hR 5))
      (dvec g m ε 5 5 (hP 5) (hS 5))) = fanAng (g m) (wE ε) (xs 3 ε) (xs 4 ε) := by
    have kp : (fun i => kpos 5 5 (hP 5) i) = ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 5 5 (hQ 5) i) = ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 5 5 (hR 5) i) = ![(-1/2 : ℝ), (-1 : ℝ), (-1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 5 5 (hS 5) i) = ![(-1/2 : ℝ), (-1 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 5 5 (hP 5) (hQ 5) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 5 5 (hP 5) (hR 5) = xs 4 ε := by
      simp only [dvec, xs, kp, kr, hxs4]
    have d3 : dvec g m ε 5 5 (hP 5) (hS 5) = xs 3 ε := by
      simp only [dvec, xs, kp, ks, hxs3]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
    exact fanAng_swap hs _ _ _
  have m4 : Dsq (lens3 (g m) (dvec g m ε 4 5 (hP 5) (hQ 5)) (dvec g m ε 4 5 (hP 5) (hR 5))
      (dvec g m ε 4 5 (hP 5) (hS 5))) = fanAng (g m) (wE ε) (xs 4 ε) (xs 5 ε) := by
    have kp : (fun i => kpos 4 5 (hP 5) i) = ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 4 5 (hQ 5) i) = ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 4 5 (hR 5) i) = ![(-1/2 : ℝ), (-1 : ℝ), (-1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 4 5 (hS 5) i) = ![(-1/2 : ℝ), (0 : ℝ), (-1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 4 5 (hP 5) (hQ 5) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 4 5 (hP 5) (hR 5) = xs 4 ε := by
      simp only [dvec, xs, kp, kr, hxs4]
    have d3 : dvec g m ε 4 5 (hP 5) (hS 5) = xs 5 ε := by
      simp only [dvec, xs, kp, ks, hxs5]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
  have m5 : Dsq (lens3 (g m) (dvec g m ε 3 3 (hP 3) (hQ 3)) (dvec g m ε 3 3 (hP 3) (hR 3))
      (dvec g m ε 3 3 (hP 3) (hS 3))) = fanAng (g m) (wE ε) (xs 5 ε) (xs 6 ε) := by
    have kp : (fun i => kpos 3 3 (hP 3) i) = ![(-1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kq : (fun i => kpos 3 3 (hQ 3) i) = ![(1/2 : ℝ), (0 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have kr : (fun i => kpos 3 3 (hR 3) i) = ![(-1/2 : ℝ), (0 : ℝ), (-1 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have ks : (fun i => kpos 3 3 (hS 3) i) = ![(1/2 : ℝ), (1 : ℝ), (0 : ℝ)] := (by ext i; fin_cases i <;> simp [kpos, kv, perms, hP, hQ, hR, hS] <;> norm_num)
    have d1 : dvec g m ε 3 3 (hP 3) (hQ 3) = wE ε := by simp only [dvec, wE, kp, kq]
    have d2 : dvec g m ε 3 3 (hP 3) (hR 3) = xs 5 ε := by
      simp only [dvec, xs, kp, kr, hxs5]
    have d3 : dvec g m ε 3 3 (hP 3) (hS 3) = xs 6 ε := by
      simp only [dvec, xs, kp, ks, hxs6]
    rw [d1, d2, d3, Dsq_lens3 hG hWε]
  rw [m0, m1, m2, m3, m4, m5]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add] at hε
  simpa using hε


/-- **The displaced Kuhn star around an edge of class 1 has dihedral angle sum `2π`.** -/
theorem cls1_disp (hg : IsRiemMetric g U) (hm : m ∈ U) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), clsSum (dirs 1) (fun σ h => Dsq (dispLen g m ε σ h)) = 2 * π := by
  have hG := hg.posDef m hm
  have hs := posDef_symm hG
  have hw : (![(0 : ℝ), (1 : ℝ), (0 : ℝ)] : Fin 3 → ℝ) ≠ 0 := by
    intro e; have := congrFun e 0; have := congrFun e 1; have := congrFun e 2; simp_all
  set wE : ℝ → Fin 3 → ℝ := fun ε => Pdisp g m ε ![(0 : ℝ), (1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] with hwE
  set xs : ℕ → ℝ → Fin 3 → ℝ := fun i ε =>
    Pdisp g m ε (([![(-1 : ℝ), (-1/2 : ℝ), (0 : ℝ)], ![(0 : ℝ), (1/2 : ℝ), (1 : ℝ)], ![(1 : ℝ), (1/2 : ℝ), (1 : ℝ)], ![(1 : ℝ), (1/2 : ℝ), (0 : ℝ)], ![(0 : ℝ), (-1/2 : ℝ), (-1 : ℝ)], ![(-1 : ℝ), (-1/2 : ℝ), (-1 : ℝ)], ![(-1 : ℝ), (-1/2 : ℝ), (0 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] with hxsd
  have hxs0 : ∀ ε : ℝ, xs 0 ε = Pdisp g m ε ![(-1 : ℝ), (-1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs1 : ∀ ε : ℝ, xs 1 ε = Pdisp g m ε ![(0 : ℝ), (1/2 : ℝ), (1 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs2 : ∀ ε : ℝ, xs 2 ε = Pdisp g m ε ![(1 : ℝ), (1/2 : ℝ), (1 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs3 : ∀ ε : ℝ, xs 3 ε = Pdisp g m ε ![(1 : ℝ), (1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs4 : ∀ ε : ℝ, xs 4 ε = Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (-1 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs5 : ∀ ε : ℝ, xs 5 ε = Pdisp g m ε ![(-1 : ℝ), (-1/2 : ℝ), (-1 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
  have hxs6 : ∀ ε : ℝ, xs 6 ε = Pdisp g m ε ![(-1 : ℝ), (-1/2 : ℝ), (0 : ℝ)] - Pdisp g m ε ![(0 : ℝ), (-1/2 : ℝ), (0 : ℝ)] := fun ε => by simp [xs]
