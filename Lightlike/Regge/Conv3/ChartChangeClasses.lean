  have hxsall : ∀ i ε, xs i ε = Pdisp g m ε (([![(1/2 : ℝ), (0 : ℝ), (-1/2 : ℝ)], ![(1/2 : ℝ), (1 : ℝ), (1/2 : ℝ)], ![(-1/2 : ℝ), (0 : ℝ), (1/2 : ℝ)], ![(-1/2 : ℝ), (-1 : ℝ), (-1/2 : ℝ)], ![(1/2 : ℝ), (0 : ℝ), (-1/2 : ℝ)]] : List (Fin 3 → ℝ)).getD i 0) - Pdisp g m ε ![(-1/2 : ℝ), (0 : ℝ), (-1/2 : ℝ)] :=
