import Lightlike.Regge.Linear3.SaintVenantHvec

/-!
# The weighted hinge-length derivative of the incidences of the Kuhn tetrahedron 2

For each of the six hinges `h` of the Kuhn tetrahedron `σ = 2`, `-(qf H (hvec σ h)) / (2 |hvec σ h|²) · dth h (lenR dd σ h)`
is an explicit polynomial, bilinear in the entries of the symmetric matrix `H` and of the symmetric second derivatives `dd`
(`sv_inc_2_h`, generated by `scripts/regge/gen_sv_sigma.py`). Summed over the 36 incidences of the Kuhn star they give the
Saint-Venant pairing (`SaintVenantCore.lean`).

## Main results

* `sv_inc_2_0`, …, `sv_inc_2_5`: the six per-hinge identities of this tetrahedron.

**Limits.** Identities at one point for symmetric `H` and symmetric second derivatives.
-/

open Real
namespace Lightlike.Regge.Linear3
open Lightlike.Regge.Conv3

theorem sv_inc_2_0 (H : Fin 3 → Fin 3 → ℝ) (dd : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ)
    (hH : ∀ i j, H i j = H j i) (hd1 : ∀ k l i j, dd k l i j = dd l k i j)
    (hd2 : ∀ k l i j, dd k l i j = dd k l j i) :
    (-(qf H (hvec 2 0)) / (2 * hbase 0 0)) * dth 0 (lenR dd 2 0) =
      (1 / 48 : ℝ) * H 1 1 * dd 0 0 0 0 +
      (1 / 24 : ℝ) * H 1 1 * dd 0 0 0 2 +
      (-5 / 48 : ℝ) * H 1 1 * dd 0 0 2 2 +
      (1 / 32 : ℝ) * H 1 1 * dd 0 1 0 0 +
      (1 / 16 : ℝ) * H 1 1 * dd 0 1 0 2 +
      (-3 / 32 : ℝ) * H 1 1 * dd 0 1 2 2 +
      (1 / 24 : ℝ) * H 1 1 * dd 0 2 0 0 +
      (1 / 12 : ℝ) * H 1 1 * dd 0 2 0 2 +
      (-1 / 12 : ℝ) * H 1 1 * dd 0 2 2 2 +
      (1 / 64 : ℝ) * H 1 1 * dd 1 1 0 0 +
      (1 / 32 : ℝ) * H 1 1 * dd 1 1 0 2 +
      (-1 / 64 : ℝ) * H 1 1 * dd 1 1 2 2 +
      (1 / 32 : ℝ) * H 1 1 * dd 1 2 0 0 +
      (1 / 16 : ℝ) * H 1 1 * dd 1 2 0 2 +
      (-1 / 32 : ℝ) * H 1 1 * dd 1 2 2 2 +
      (1 / 48 : ℝ) * H 1 1 * dd 2 2 0 0 +
      (1 / 24 : ℝ) * H 1 1 * dd 2 2 0 2 +
      (-1 / 48 : ℝ) * H 1 1 * dd 2 2 2 2 := by
  simp only [lenR_2_0, hvec, kv, perms, hP, hQ, hR, hS, hbase, dth, rf, ddq, qf, Fin.sum_univ_three,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Matrix.head_cons]
  simp only [hH 1 0, hH 2 0, hH 2 1, hd1 1 0, hd1 2 0, hd1 2 1, hd2 _ _ 1 0, hd2 _ _ 2 0, hd2 _ _ 2 1]
  ring

