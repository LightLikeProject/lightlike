import Lightlike.DynamicalTriangulations.DehnSommerville
import Lightlike.PL.Complex4

/-!
# The Einstein–Regge action of four-dimensional dynamical triangulations

For a triangulation `K` of a 4-manifold by equilateral 4-simplices the Regge action reduces to
`S(K) = −κ₂ N₂ + κ₄ N₄`, with `N₂` the number of triangles and `N₄` the number of 4-simplices
(Ambjørn–Jurkiewicz–Loll 2001; Ambjørn–Durhuus–Jónsson 1997). The couplings `κ₂` and `κ₄` are the
inverse Newton constant and the cosmological constant, up to the edge length.

For a closed combinatorial 4-manifold the Dehn–Sommerville relations leave two independent face
numbers: `N₂ = 2N₀ + 2N₄ − 2χ`. So the action depends on `K` only through `N₀`, `N₄` and the Euler
characteristic, and a Pachner move changes it in a way that is fixed by its type.

## Main results

* `dtAction κ₂ κ₄ K = −κ₂ N₂ + κ₄ N₄`.
* `IsCombManifold4.card_triangles`: `N₂ = 2N₀ + 2N₄ − 2χ`.
* `dtAction_eq`: `S = −2κ₂ N₀ + (κ₄ − 2κ₂) N₄ + 2κ₂ χ`.
* `Complex4.card_faces_zero_move`: the 2-4, 3-3 and 4-2 moves keep the number of vertices.
* `dtAction_move`: a move with `2 ≤ #σ` and `2 ≤ #τ` changes the action by
  `(#σ − #τ)(κ₄ − 2κ₂)`; in particular the 3-3 move leaves it unchanged.
-/

open Finset Lightlike.FourD

namespace Lightlike.DynamicalTriangulations

variable {V : Type*} [DecidableEq V]

open Lightlike.PL

/-- The **Einstein–Regge action** of a triangulation by equilateral 4-simplices:
`S = −κ₂ N₂ + κ₄ N₄`, with `N₂` triangles and `N₄` 4-simplices. -/
def dtAction (κ₂ κ₄ : ℝ) (K : Complex4 V) : ℝ :=
  -κ₂ * #(K.faces 2) + κ₄ * #(K.faces 4)

/-- The faces of the complex generated by `K` with `k + 1` vertices are the `k`-faces of `K`. -/
lemma card_filter_ofComplex4 (K : Complex4 V) (k : ℕ) :
    #((ofComplex4 K).faces.filter fun s => #s = k + 1) = #(K.faces k) := by
  congr 1
  ext s
  simp only [mem_filter, SComplex.mem_faces, ofComplex4, SComplex.mem_closure, Complex4.mem_faces]
  constructor
  · rintro ⟨⟨t, ht, hst⟩, hs⟩
    exact ⟨t, ht, hst, hs⟩
  · rintro ⟨t, ht, hst, hs⟩
    exact ⟨⟨t, ht, hst⟩, hs⟩

end Lightlike.DynamicalTriangulations

namespace Lightlike.PL

variable {V : Type*} [DecidableEq V]

open Lightlike.DynamicalTriangulations

/-- **The face numbers of a closed combinatorial 4-manifold satisfy `N₂ = 2N₀ + 2N₄ − 2χ`.** -/
theorem IsCombManifold4.card_triangles {K : Complex4 V} (hK : IsCombManifold4 K) :
    (#(K.faces 2) : ℤ) = 2 * #(K.faces 0) + 2 * #(K.faces 4) - 2 * K.euler4 := by
  have h8 := SComplex.IsClosedCombManifold.dehnSommerville hK
  have h3 := SComplex.IsClosedCombManifold.two_mul_card_eq (n := 4) (by norm_num) hK
  have h3' : (2 * #((ofComplex4 K).faces.filter fun s => #s = 4) : ℤ) =
      5 * #((ofComplex4 K).faces.filter fun s => #s = 5) := by exact_mod_cast h3
  have e1 := card_filter_ofComplex4 K 1
  have e2 := card_filter_ofComplex4 K 2
  have e3 := card_filter_ofComplex4 K 3
  have e4 := card_filter_ofComplex4 K 4
  simp only [Nat.reduceAdd] at e1 e2 e3 e4
  rw [e1, e2, e3, e4] at h8
  rw [e3, e4] at h3'
  simp only [Complex4.euler4, sum_range_succ, sum_range_zero]
  push_cast
  linarith

end Lightlike.PL

namespace Lightlike.DynamicalTriangulations

variable {V : Type*} [DecidableEq V]

open Lightlike.PL

/-- The action in terms of the number of vertices and 4-simplices: for a closed combinatorial
4-manifold, `S = −2κ₂ N₀ + (κ₄ − 2κ₂) N₄ + 2κ₂ χ`. -/
theorem dtAction_eq (κ₂ κ₄ : ℝ) {K : Complex4 V} (hK : IsCombManifold4 K) :
    dtAction κ₂ κ₄ K =
      -2 * κ₂ * #(K.faces 0) + (κ₄ - 2 * κ₂) * #(K.faces 4) + 2 * κ₂ * (K.euler4 : ℝ) := by
  have h : (#(K.faces 2) : ℝ) = 2 * #(K.faces 0) + 2 * #(K.faces 4) - 2 * (K.euler4 : ℝ) := by
    exact_mod_cast hK.card_triangles
  rw [dtAction, h]
  ring

end Lightlike.DynamicalTriangulations

namespace Lightlike.FourD.Complex4

variable {V : Type*} [DecidableEq V] {K : Complex4 V} {σ τ : Finset V}

/-- If `#σ ≥ 2`, a move does not lose vertices. -/
lemma verts_subset_move (h : IsMove K σ τ) (hσ : 2 ≤ #σ) : K.verts ⊆ (move K h).verts := by
  intro v hv
  obtain ⟨s, hs, hvs⟩ := mem_verts.1 hv
  by_cases hσs : σ ⊆ s
  · obtain ⟨w, hw, rfl⟩ := h.star s hs hσs
    obtain ⟨hvw, hvS⟩ := mem_erase.1 hvs
    -- choose `u ∈ σ` with `u ≠ v`
    obtain ⟨u, hu, huv⟩ : ∃ u ∈ σ, u ≠ v := by
      by_contra hcon
      have : σ ⊆ {v} := fun x hx => mem_singleton.2 (by_contra fun hne => hcon ⟨x, hx, hne⟩)
      have := card_le_card this
      simp at this
      omega
    refine mem_verts.2 ⟨(σ ∪ τ).erase u, mem_move.2 (Or.inr ⟨u, hu, rfl⟩), ?_⟩
    exact mem_erase.2 ⟨fun h => huv h.symm, hvS⟩
  · exact mem_verts.2 ⟨s, mem_move.2 (Or.inl ⟨hs, hσs⟩), hvs⟩

/-- The 2-4, 3-3 and 4-2 moves (`2 ≤ #σ`, `2 ≤ #τ`) keep the number of vertices. -/
theorem card_faces_zero_move (h : IsMove K σ τ) (hσ : 2 ≤ #σ) (hτ : 2 ≤ #τ) :
    #((move K h).faces 0) = #(K.faces 0) := by
  rw [card_faces_zero, card_faces_zero]
  apply le_antisymm
  · have h1 := verts_subset_move h.symm hτ
    rw [move_move] at h1
    exact card_le_card h1
  · exact card_le_card (verts_subset_move h hσ)

/-- The 1-5 move (`#τ = 1`) adds exactly one vertex. -/
theorem card_faces_zero_move_one_five (h : IsMove K σ τ) (hτ : #τ = 1) :
    #((move K h).faces 0) = #(K.faces 0) + 1 := by
  obtain ⟨v, rfl⟩ := card_eq_one.1 hτ
  have hσ : #σ = 5 := by have := h.card; omega
  have hvτ : v ∈ ({v} : Finset V) := mem_singleton_self v
  have hvσ : v ∉ σ := disjoint_right.1 h.disj hvτ
  have hvK : v ∉ K.verts := fun hv => by
    obtain ⟨s, hs, hvs⟩ := mem_verts.1 hv
    exact h.fresh s hs (singleton_subset_iff.2 hvs)
  have hver : (move K h).verts = insert v K.verts := by
    apply Subset.antisymm
    · intro w hw
      obtain ⟨s, hs, hws⟩ := mem_verts.1 hw
      rcases mem_move.1 hs with ⟨hsK, -⟩ | ⟨u, hu, rfl⟩
      · exact mem_insert_of_mem (mem_verts.2 ⟨s, hsK, hws⟩)
      · obtain ⟨hwu, hwS⟩ := mem_erase.1 hws
        rcases mem_union.1 hwS with hwσ | hwv
        · refine mem_insert_of_mem (mem_verts.2 ⟨(σ ∪ {v}).erase v, h.mem v hvτ, ?_⟩)
          exact mem_erase.2 ⟨fun e => hvσ (e ▸ hwσ), mem_union_left _ hwσ⟩
        · exact mem_insert.2 (Or.inl (mem_singleton.1 hwv))
    · refine insert_subset ?_ (verts_subset_move h (by omega))
      obtain ⟨u, hu⟩ := h.nonempty_left
      exact mem_verts.2 ⟨(σ ∪ {v}).erase u, mem_move.2 (Or.inr ⟨u, hu, rfl⟩),
        mem_erase.2 ⟨fun e => hvσ (e ▸ hu), mem_union_right _ hvτ⟩⟩
  rw [card_faces_zero, card_faces_zero, hver, card_insert_of_notMem hvK]

end Lightlike.FourD.Complex4

namespace Lightlike.DynamicalTriangulations

variable {V : Type*} [DecidableEq V]

open Lightlike.PL

/-- **The change of the Einstein–Regge action under a Pachner move.** For a move with `2 ≤ #σ` and
`2 ≤ #τ` (the 2-4, 3-3 and 4-2 moves) on a closed combinatorial 4-manifold,
`ΔS = (#σ − #τ)(κ₄ − 2κ₂)`. The 3-3 move leaves the action unchanged. -/
theorem dtAction_move (κ₂ κ₄ : ℝ) {K : Complex4 V} {σ τ : Finset V} (h : Complex4.IsMove K σ τ)
    (hK : IsCombManifold4 K) (hσ : 2 ≤ #σ) (hτ : 2 ≤ #τ) :
    dtAction κ₂ κ₄ (K.move h) - dtAction κ₂ κ₄ K = ((#σ : ℝ) - #τ) * (κ₄ - 2 * κ₂) := by
  have hK' : IsCombManifold4 (K.move h) := (isCombManifold4_move_iff h).2 hK
  rw [dtAction_eq κ₂ κ₄ hK', dtAction_eq κ₂ κ₄ hK, FourD.Complex4.card_faces_zero_move h hσ hτ,
    Complex4.euler4_move h]
  have h4 : (#((K.move h).faces 4) : ℝ) = #(K.faces 4) + #σ - #τ := by
    have := Complex4.card_simps_move h
    rw [Complex4.faces_four, Complex4.faces_four]
    have : (#(K.move h).simps : ℝ) + #τ = #K.simps + #σ := by exact_mod_cast this
    linarith
  rw [h4]
  ring

/-- **The 1-5 move changes the action by `−2κ₂ + 4(κ₄ − 2κ₂)`**: it adds one vertex and four
4-simplices (`#σ = 5`, `#τ = 1`), so `N₀` changes as well. -/
theorem dtAction_move_one_five (κ₂ κ₄ : ℝ) {K : Complex4 V} {σ τ : Finset V}
    (h : Complex4.IsMove K σ τ) (hK : IsCombManifold4 K) (hτ : #τ = 1) :
    dtAction κ₂ κ₄ (K.move h) - dtAction κ₂ κ₄ K = -2 * κ₂ + 4 * (κ₄ - 2 * κ₂) := by
  have hK' : IsCombManifold4 (K.move h) := (isCombManifold4_move_iff h).2 hK
  have hσ : #σ = 5 := by have := h.card; omega
  rw [dtAction_eq κ₂ κ₄ hK', dtAction_eq κ₂ κ₄ hK, Complex4.card_faces_zero_move_one_five h hτ,
    Complex4.euler4_move h]
  have h4 : (#((K.move h).faces 4) : ℝ) = #(K.faces 4) + 4 := by
    have := Complex4.card_simps_move h
    rw [Complex4.faces_four, Complex4.faces_four]
    have : (#(K.move h).simps : ℝ) + #τ = #K.simps + #σ := by exact_mod_cast this
    rw [hσ, hτ] at this; push_cast at this; linarith
  rw [h4]
  push_cast
  ring

end Lightlike.DynamicalTriangulations
