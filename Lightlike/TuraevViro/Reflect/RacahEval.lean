import Lightlike.TuraevViro.Reflect.RacahBase
import Mathlib.Tactic.FieldSimp

/-!
# Evaluation of the product factors of the q-Racah recurrence

Each factor `fQ0, fNa, ..., fW1` of the cleared recurrence is a `Poly`; here its value at the
environment `(u, p1, p2, p3, p4, q2, q3, Z)` is computed as an ordinary product of brackets
`bk x = x - x⁻¹` and `ck x = x + x⁻¹`. Generated by `scripts/qracah/gen_eval.py`.
-/

set_option maxRecDepth 100000

namespace Lightlike.TV.Refl

variable {K : Type*} [Field K]

/-- `x - x⁻¹`. -/
def bk (x : K) : K := x - x⁻¹
/-- `x + x⁻¹`. -/
def ck (x : K) : K := x + x⁻¹

theorem eval_br {E : Env K} (m : Mono) : Poly.eval E (br m) = bk (Mono.eval E m) := by
  simp only [br, eval_add, Poly.eval, bk]
  have : Mono.eval E ⟨-m.e0, -m.e1, -m.e2, -m.e3, -m.e4, -m.e5, -m.e6, -m.e7⟩ = (Mono.eval E m)⁻¹ := by
    simp only [Mono.eval, zpow_neg, mul_inv]
  rw [this]; simp; ring

theorem eval_cn {E : Env K} (m : Mono) : Poly.eval E (cn m) = ck (Mono.eval E m) := by
  simp only [cn, eval_add, Poly.eval, ck]
  have : Mono.eval E ⟨-m.e0, -m.e1, -m.e2, -m.e3, -m.e4, -m.e5, -m.e6, -m.e7⟩ = (Mono.eval E m)⁻¹ := by
    simp only [Mono.eval, zpow_neg, mul_inv]
  rw [this]; simp

/-- The environment `(u, p1, p2, p3, p4, q2, q3, Z)`. -/
def env (u p1 p2 p3 p4 q2 q3 Z : K) : Env K := ⟨u, p1, p2, p3, p4, q2, q3, Z⟩

section Facs
variable {u p1 p2 p3 p4 q2 q3 Z : K} (h0 : u ≠ 0) (h1 : p1 ≠ 0) (h2 : p2 ≠ 0) (h3 : p3 ≠ 0)
  (h4 : p4 ≠ 0) (h5 : q2 ≠ 0) (h6 : q3 ≠ 0) (h7 : Z ≠ 0)
include h0 h1 h2 h3 h4 h5 h6 h7

theorem eval_fQ0 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fQ0 = (bk (p2⁻¹ * p3⁻¹ * q2 * q3)) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fQ0, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fQ1 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fQ1 = (bk (u * p2⁻¹ * p3⁻¹ * q2 * q3)) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fQ1, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fQ2 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fQ2 = (bk (u^2 * p2⁻¹ * p3⁻¹ * q2 * q3)) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fQ2, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fNa : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fNa = ((((bk (u * p3⁻¹ * q3)) * (bk (u * p2⁻¹ * q2))) * (bk (u * p3⁻¹ * q2))) * (bk (u * p2⁻¹ * q3))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fNa, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fNc : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fNc = ((((bk (u * p1)) * (bk (u * p4))) * (bk (u * p1 * p2 * p3 * q2⁻¹ * q3⁻¹))) * (bk (u * p2 * p3 * p4 * q2⁻¹ * q3⁻¹))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fNc, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fbn : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fbn = (((((ck (u * p1 * p2 * q2⁻¹)) * (ck (u * p3 * p4 * q2⁻¹))) + ((ck (u * p1 * p3 * q3⁻¹)) * (ck (u * p2 * p4 * q3⁻¹)))) * (ck (u * p2⁻¹ * p3⁻¹ * q2 * q3))) + (-((((1 : K) * (u)) + ((1 : K) * (u⁻¹))) * (((ck (u * p1 * p2 * q2⁻¹)) * (ck (u * p2 * p4 * q3⁻¹))) + ((ck (u * p1 * p3 * q3⁻¹)) * (ck (u * p3 * p4 * q2⁻¹))))))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fbn, eval_mul hE, eval_add, eval_neg, eval_cn]
  simp only [Mono.eval, env, ck, Poly.eval]
  field_simp
  try ring

theorem eval_fM0 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fM0 = ((((((bk (u * p1⁻¹ * Z)) * (bk (u * p2⁻¹ * Z))) * (bk (u * p3⁻¹ * Z))) * (bk (u * p4⁻¹ * Z))) * (bk (u * q2 * Z⁻¹))) * (bk (u * q3 * Z⁻¹))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fM0, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fMp : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fMp = ((((((bk (p1⁻¹ * Z)) * (bk (u * p1⁻¹ * Z))) * (bk (u * p2⁻¹ * Z))) * (bk (u * p3⁻¹ * Z))) * (bk (p4⁻¹ * Z))) * (bk (u * p4⁻¹ * Z))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fMp, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fMm : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fMm = ((((((bk (u * p2⁻¹ * Z)) * (bk (u * p3⁻¹ * Z))) * (bk (q2 * Z⁻¹))) * (bk (u * q2 * Z⁻¹))) * (bk (q3 * Z⁻¹))) * (bk (u * q3 * Z⁻¹))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fMm, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fW0 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fW0 = ((((((bk (p2⁻¹ * Z)) * (bk (p3⁻¹ * Z))) * (bk (u * p1⁻¹ * Z))) * (bk (u * p2⁻¹ * Z))) * (bk (u * p3⁻¹ * Z))) * (bk (u * p4⁻¹ * Z))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fW0, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fW1 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fW1 = (-((((((bk (u^2 * Z)) * (bk (p1 * p2 * p3 * p4 * q2⁻¹ * q3⁻¹ * Z⁻¹))) * (bk (u * q2 * Z⁻¹))) * (bk (u * q3 * Z⁻¹))) * (bk (u * p2⁻¹ * Z))) * (bk (u * p3⁻¹ * Z)))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fW1, eval_mul hE, eval_neg, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

theorem eval_fCq : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fCq = (ck (u * p1⁻¹ * p4⁻¹ * q2 * q3)) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fCq, eval_cn]
  simp only [Mono.eval, env, ck]
  field_simp

theorem eval_fQ012 : Poly.eval (env u p1 p2 p3 p4 q2 q3 Z) fQ012 = (((bk (p2⁻¹ * p3⁻¹ * q2 * q3)) * (bk (u * p2⁻¹ * p3⁻¹ * q2 * q3))) * (bk (u^2 * p2⁻¹ * p3⁻¹ * q2 * q3))) := by
  have hE : (env u p1 p2 p3 p4 q2 q3 Z).NZ := ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
  simp only [fQ012, fQ0, fQ1, fQ2, eval_mul hE, eval_br]
  simp only [Mono.eval, env, bk]
  field_simp

end Facs

end Lightlike.TV.Refl
