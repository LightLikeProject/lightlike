def X0 : Poly := (add (add T1 T2) (add T3 (neg T4)))
/-- The polynomial `X0`, written as a sum of certificate terms. -/
def bigX0 : Poly := (add (add (add (add (add (add (scale ((muInv.mul (Zk 0)), -2) B0_0) (scale ((muInv.mul (Zk 2)), -2) B2_0)) (scale ((muInv.mul (Zk 4)), -2) B4_0)) (scale ((muInv.mul (Zk 6)), -2) B6_0)) (scale ((muInv.mul (Zk 8)), -2) B8_0)) (scale ((muInv.mul (Zk 10)), -2) B10_0)) (scale ((muInv.mul (Zk 12)), -2) B12_0))
theorem tree_X0 : X0 = bigX0 := by
  unfold X0; rw [tY1, tY2, tY3, tY4]; decide +kernel

end Lightlike.TV.Refl
