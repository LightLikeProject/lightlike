import Lightlike.TuraevViro.Reflect.RacahCert0
import Lightlike.TuraevViro.Reflect.RacahCert2
import Lightlike.TuraevViro.Reflect.RacahCert4
import Lightlike.TuraevViro.Reflect.RacahCert6
import Lightlike.TuraevViro.Reflect.RacahCert8
import Lightlike.TuraevViro.Reflect.RacahCert10
import Lightlike.TuraevViro.Reflect.RacahCert12

import Lightlike.TuraevViro.Reflect.RacahBase

/-!
# The product tree `E5` of the cleared q-Racah recurrence

`E5` is the polynomial multiplying `c5` in the cleared recurrence identity, built as a product
of the factor polynomials `fQ…`, `fNa`, …. It is checked against its expansion `bigE5`, a sum of
the certificate terms of `RacahCert0` to `RacahCert12`, by `decide +kernel`. Generated by `scripts/qracah/gen_core.py`.

## Main results

* `tree_E5`: `E5 = bigE5`.
-/

set_option maxRecDepth 100000

namespace Lightlike.TV.Refl

/-- The polynomial multiplying `c5` in the cleared recurrence identity. -/
def E5 : Poly := (neg (mul (mul ftwo fQ012) (add (mul [(⟨2, 0, 0, 0, 0, 0, 0, 2⟩, 1)] fW1) (neg (mul [(⟨0, 0, 0, 0, 0, 0, 0, 2⟩, 1)] fW0)))))
/-- The polynomial `E5`, written as a sum of certificate terms. -/
def bigE5 : Poly := (add (add (add (add (add (scale ((muInv.mul (Zk 2)), -2) B2_3) (scale ((muInv.mul (Zk 4)), -2) B4_3)) (scale ((muInv.mul (Zk 6)), -2) B6_3)) (scale ((muInv.mul (Zk 8)), -2) B8_3)) (scale ((muInv.mul (Zk 10)), -2) B10_3)) (scale ((muInv.mul (Zk 12)), -2) B12_2))
theorem tree_E5 : E5 = bigE5 := by decide +kernel

end Lightlike.TV.Refl
